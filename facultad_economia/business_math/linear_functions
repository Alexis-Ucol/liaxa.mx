/* ── CANVAS ──────────────────────────────────────────────────────────────── */
function initCanvas(canvas){
  var dpr=window.devicePixelRatio||1; var rect=canvas.getBoundingClientRect();
  canvas.width=rect.width*dpr; canvas.height=rect.height*dpr;
  var ctx=canvas.getContext('2d'); ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.scale(dpr,dpr);
  var drawing=false, lastX=0, lastY=0, mode='pen', color='#1a4a8a', lineW=2;
  function getXY(e){
    var r=canvas.getBoundingClientRect(),src=e.touches?e.touches[0]:e;
    return {x:(src.clientX-r.left),y:(src.clientY-r.top)};
  }
  function down(e){e.preventDefault();drawing=true;var p=getXY(e);lastX=p.x;lastY=p.y;}
  function move(e){
    e.preventDefault(); if(!drawing) return;
    var p=getXY(e); ctx.beginPath();
    if(mode==='erase'){ctx.globalCompositeOperation='destination-out';ctx.lineWidth=18;}
    else{ctx.globalCompositeOperation='source-over';ctx.strokeStyle=color;ctx.lineWidth=(mode==='mark'?8:lineW);}
    ctx.lineCap='round'; ctx.moveTo(lastX,lastY); ctx.lineTo(p.x,p.y); ctx.stroke();
    lastX=p.x; lastY=p.y;
  }
  function up(){drawing=false; ctx.globalCompositeOperation='source-over'; saveSession();}
  canvas.addEventListener('mousedown',down); canvas.addEventListener('mousemove',move);
  canvas.addEventListener('mouseup',up); canvas.addEventListener('mouseleave',up);
  canvas.addEventListener('touchstart',down,{passive:false}); canvas.addEventListener('touchmove',move,{passive:false});
  canvas.addEventListener('touchend',up);
  var wrap=canvas.closest('.cvwrap');
  if(wrap){
    wrap.querySelector('.bpen').addEventListener('click',function(){mode='pen';setToolBtn(this,wrap);});
    wrap.querySelector('.bmarker').addEventListener('click',function(){mode='mark';setToolBtn(this,wrap);});
    wrap.querySelector('.beraser').addEventListener('click',function(){mode='erase';setToolBtn(this,wrap);});
    wrap.querySelectorAll('.cdot').forEach(function(d){d.addEventListener('click',function(){
      color=this.dataset.color; wrap.querySelectorAll('.cdot').forEach(function(x){x.classList.remove('sel');}); this.classList.add('sel');
    });});
    wrap.querySelector('.clrbtn').addEventListener('click',function(){
      ctx.globalCompositeOperation='source-over'; ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,canvas.width/dpr,canvas.height/dpr); saveSession();
    });
  }
}
function setToolBtn(btn,wrap){wrap.querySelectorAll('.tbtn2').forEach(function(b){b.classList.remove('on');});btn.classList.add('on');}
