/* ════════════════════════════════════════════════════════════════════════════
   buildLesson(rng)
   ════════════════════════════════════════════════════════════════════════════ */
function buildLesson(rng) {
  /*
   * CONCEPT ARC
   * topic        : Funciones Lineales / Linear Functions
   * prerequisite : El estudiante reconoce expresiones algebraicas con una variable
   *                y sabe sustituir valores numéricos en una expresión.
   * sequence     : 1. ¿Qué es una función lineal? — definición y forma y = mx + b
   *                2. Identificar pendiente e intercepto — leer m y b directamente
   *                3. Pendiente visual — rise/run en una cuadrícula cartesiana
   *                4. Calcular pendiente con la fórmula m = (y₂−y₁)/(x₂−x₁)
   *                5. Interpretar la función lineal en contexto real
   * why_this_order: Reconocer la forma general (1) es condición para localizar
   *                 sus componentes (2); la intuición visual de la pendiente (3)
   *                 da significado geométrico a la fórmula algebraica (4); y la
   *                 interpretación (5) exige dominar ambos registros (ecuacional
   *                 y numérico) antes de conectarlos con la realidad.
   */

  /* ── PRE-GENERATE ALL SEEDED VALUES ─────────────────────────────────────── */
  /* Concept 1 worked example */
  var ex1m = Math.floor(rng()*5)+2;            /* slope 2–6 */
  var ex1b = Math.floor(rng()*9)+1;            /* intercept 1–9 */
  var ex1a = Math.floor(rng()*3)+2;            /* quadratic coeff 2–4 */

  /* Concept 2 worked example */
  var ex2signs = [-3,-2,-1,2,3,4];
  var ex2m = pick(ex2signs, rng);
  var ex2b_raw = Math.floor(rng()*9)+1;
  var ex2b_sign = rng()<0.4?-1:1;
  var ex2b = ex2b_raw * ex2b_sign;

  /* Widget 2 – 3 rounds */
  var w2r = [];
  for(var ri=0;ri<3;ri++){
    var wm=pick([-4,-3,-2,-1,2,3,4,5],rng);
    var wb=(Math.floor(rng()*8)+1)*(rng()<0.4?-1:1);
    w2r.push({m:wm,b:wb});
  }

  /* Widget 3 – slope canvas configs */
  var w3pool=[
    {A:[0,0],B:[2,4],C:[4,8],m:2,rise:4,run:2},
    {A:[0,1],B:[3,4],C:[6,7],m:1,rise:3,run:3},
    {A:[2,6],B:[4,4],C:[6,2],m:-1,rise:-2,run:2},
    {A:[0,8],B:[2,4],C:[4,0],m:-2,rise:-4,run:2}
  ];
  var w3cfg = pick(w3pool,rng);

  /* Concept 4 worked example */
  var ex4pool=[
    {P:[1,3],Q:[4,9],dy:6,dx:3,m:2},
    {P:[0,5],Q:[3,2],dy:-3,dx:3,m:-1},
    {P:[2,0],Q:[6,8],dy:8,dx:4,m:2},
    {P:[1,7],Q:[4,1],dy:-6,dx:3,m:-2}
  ];
  var ex4 = pick(ex4pool,rng);

  /* Widget 4 – slope formula 3 rounds */
  var w4pool=[
    {P:[0,2],Q:[3,8],dy:6,dx:3,m:2},
    {P:[1,5],Q:[4,2],dy:-3,dx:3,m:-1},
    {P:[2,0],Q:[5,6],dy:6,dx:3,m:2},
    {P:[0,6],Q:[3,0],dy:-6,dx:3,m:-2},
    {P:[1,1],Q:[4,4],dy:3,dx:3,m:1},
    {P:[2,7],Q:[5,4],dy:-3,dx:3,m:-1}
  ];
  var w4cfgs = shuffle(w4pool,rng).slice(0,3);

  /* Concept 5 scenario */
  var ex5pool=[
    {ctx:{es:'ventas de una tienda de bebidas en función de la temperatura',
          en:'beverage store sales as a function of temperature'},
     fn:'V(t) = 5t + 20',
     var_es:'t (temperatura en °C)', var_en:'t (temperature in °C)',
     out_es:'V (ventas en unidades)', out_en:'V (sales in units)',
     m:5, b:20,
     m_es:'por cada grado adicional de temperatura, las ventas aumentan 5 unidades',
     m_en:'for each additional degree of temperature, sales increase by 5 units',
     b_es:'cuando t = 0 °C, las ventas base son 20 unidades',
     b_en:'when t = 0 °C, baseline sales are 20 units'},
    {ctx:{es:'costo de producción de una empresa en función de unidades producidas',
          en:'production cost as a function of units produced'},
     fn:'C(u) = 12u + 350',
     var_es:'u (unidades producidas)', var_en:'u (units produced)',
     out_es:'C (costo en pesos)', out_en:'C (cost in pesos)',
     m:12, b:350,
     m_es:'cada unidad adicional agrega $12 al costo total',
     m_en:'each additional unit adds $12 to total cost',
     b_es:'el costo fijo (sin producir) es de $350',
     b_en:'the fixed cost (producing nothing) is $350'}
  ];
  var ex5 = pick(ex5pool,rng);

  /* Problem P2: y = p2m·x + p2b */
  var p2m = pick([-5,-4,-3,-2,3,4,5,6],rng);
  var p2b = (Math.floor(rng()*8)+1)*(rng()<0.4?-1:1);
  var p2b_disp = p2b>0?' + '+p2b:(p2b<0?' \u2212 '+Math.abs(p2b):'');

  /* Problem P3: slope from two points */
  var p3pool=[
    {x1:0,y1:1,x2:2,y2:5,m:2,wrong1:'\u00bd',wrong2:4,wrong3:'2\u00bd'},
    {x1:1,y1:2,x2:3,y2:8,m:3,wrong1:'\u2153',wrong2:6,wrong3:'3\u00bd'},
    {x1:0,y1:4,x2:2,y2:8,m:2,wrong1:'\u00bd',wrong2:4,wrong3:'1\u00bd'}
  ];
  var p3 = pick(p3pool,rng);

  /* Problem P4: slope from two points */
  var p4pool=[
    {x1:-1,y1:3,x2:2,y2:9,m:2,d1:6,d2:3,w1:3,w2:'\u00bd',w3:'4'},
    {x1:0,y1:5,x2:4,y2:1,m:-1,d1:-4,d2:4,w1:'1',w2:4,w3:'-4'},
    {x1:1,y1:-2,x2:4,y2:4,m:2,d1:6,d2:3,w1:3,w2:'\u00bd',w3:'6'}
  ];
  var p4 = pick(p4pool,rng);

  /* Problem P7: compare slopes */
  var p7f1m = pick([2,3,4,5],rng);
  var p7f2m = p7f1m + pick([1,2],rng);
  var p7f1b = Math.floor(rng()*7)+1;
  var p7f2b = Math.floor(rng()*7)+1;

  /* Problem P8: find x given y */
  var p8m = pick([3,4,5,6],rng);
  var p8b = pick([10,12,15,20],rng);
  var p8y = p8m * pick([3,4,5],rng) + p8b;
  var p8x = (p8y - p8b) / p8m;

  /* Problem P10: find value */
  var p10slope = pick([-3,-2,-1,2,3],rng);
  var p10int   = pick([10,15,20,24,30],rng);
  var p10x     = pick([2,3,4,5],rng);
  var p10y     = p10slope*p10x + p10int;

  /* ────────────────────────────────────────────────────────────────────────
     CONCEPT 1 — ¿Qué es una función lineal?
     ──────────────────────────────────────────────────────────────────────── */
  addSection(function(L){
    var ex = 'y = '+ex1m+'x + '+ex1b;
    var exNL = 'y = '+ex1a+'x\u00b2 + '+ex1b;
    return L==='es'
      ? '<div class="stag">Concepto 1 de 5</div>'
        +'<h2>¿Qué es una función lineal?</h2>'
        +'<p>Una <strong>función lineal</strong> es toda relación entre dos variables que puede escribirse en la forma:</p>'
        +'<div class="callout" style="text-align:center"><strong style="font-family:\'IBM Plex Mono\',monospace;font-size:1.2rem">y = mx + b</strong>'
        +'<p style="margin-top:.5rem">donde <strong>m</strong> y <strong>b</strong> son constantes reales, y <strong>x</strong> aparece únicamente con potencia 1.</p></div>'
        +'<p>La característica definitoria es que la variable x tiene exponente 1 —  ni cuadrada, ni raíz, ni en el denominador. Por eso su gráfica es siempre una <strong>línea recta</strong>.</p>'
        +'<p><strong>Ejemplo resuelto.</strong> Determina si cada expresión es una función lineal:</p>'
        +'<div class="rules-grid">'
        +'<div class="rcard"><div class="rname">Expresión A</div><div class="rform">'+ex+'</div><div class="rnote" style="color:var(--ok)">✓ Lineal — x tiene exponente 1</div></div>'
        +'<div class="rcard"><div class="rname">Expresión B</div><div class="rform">'+exNL+'</div><div class="rnote" style="color:var(--bad)">✗ No lineal — x está elevada al cuadrado</div></div>'
        +'<div class="rcard"><div class="rname">Expresión C</div><div class="rform">y = \u221a x</div><div class="rnote" style="color:var(--bad)">✗ No lineal — x bajo una raíz (exp. \u00bd)</div></div>'
        +'</div>'
        +'<p style="margin-top:.8rem">La prueba rápida: ¿puedo reescribir la expresión como <em>y = número·x + número</em> sin raíces, potencias ni divisores con x? Si sí, es lineal.</p>'
      : '<div class="stag">Concept 1 of 5</div>'
        +'<h2>What is a linear function?</h2>'
        +'<p>A <strong>linear function</strong> is any relationship between two variables that can be written in the form:</p>'
        +'<div class="callout" style="text-align:center"><strong style="font-family:\'IBM Plex Mono\',monospace;font-size:1.2rem">y = mx + b</strong>'
        +'<p style="margin-top:.5rem">where <strong>m</strong> and <strong>b</strong> are real constants, and <strong>x</strong> appears only with exponent 1.</p></div>'
        +'<p>The defining feature is that x has exponent 1 — not squared, not a root, not in a denominator. That is why its graph is always a <strong>straight line</strong>.</p>'
        +'<p><strong>Worked example.</strong> Determine whether each expression is a linear function:</p>'
        +'<div class="rules-grid">'
        +'<div class="rcard"><div class="rname">Expression A</div><div class="rform">'+ex+'</div><div class="rnote" style="color:var(--ok)">✓ Linear — x has exponent 1</div></div>'
        +'<div class="rcard"><div class="rname">Expression B</div><div class="rform">'+exNL+'</div><div class="rnote" style="color:var(--bad)">✗ Not linear — x is squared</div></div>'
        +'<div class="rcard"><div class="rname">Expression C</div><div class="rform">y = \u221a x</div><div class="rnote" style="color:var(--bad)">✗ Not linear — x under a root (exp. \u00bd)</div></div>'
        +'</div>'
        +'<p style="margin-top:.8rem">Quick test: can I rewrite the expression as <em>y = number·x + number</em> with no roots, powers, or x in a denominator? If yes, it is linear.</p>';
  });

  /* ── WIDGET 1: Linear Function Classifier (Mode C) ───────────────────── */
  var w1host = document.createElement('div');
  w1host.className = 'gcrd section';
  w1host.setAttribute('data-widget','linear-classifier');
  document.getElementById('lessonBody').appendChild(w1host);

  var w1funcs = shuffle([
    {expr:'y = 4x \u2212 7',    linear:true,
     why_es:'Forma y = mx + b con m = 4, b = \u22127. La variable x tiene exponente 1.',
     why_en:'Form y = mx + b with m = 4, b = \u22127. Variable x has exponent 1.'},
    {expr:'y = x\u00b2 + 3',   linear:false,
     why_es:'La x está elevada al cuadrado (exponente 2). No puede reescribirse como y = mx + b.',
     why_en:'x is squared (exponent 2). Cannot be rewritten as y = mx + b.'},
    {expr:'y = \u22122x + 9',  linear:true,
     why_es:'Forma y = mx + b con m = \u22122, b = 9. Pendiente negativa, pero sigue siendo lineal.',
     why_en:'Form y = mx + b with m = \u22122, b = 9. Negative slope, still linear.'},
    {expr:'y = 1/x',            linear:false,
     why_es:'La x aparece en el denominador, equivalente a x elevada a \u22121. No es lineal.',
     why_en:'x appears in the denominator, equivalent to x raised to \u22121. Not linear.'},
    {expr:'y = 6x',             linear:true,
     why_es:'Es y = mx + b con m = 6 y b = 0 (intercepto en el origen). Totalmente lineal.',
     why_en:'This is y = mx + b with m = 6 and b = 0 (intercept at origin). Fully linear.'},
    {expr:'y = \u221ax + 2',   linear:false,
     why_es:'La raíz cuadrada equivale a exponente \u00bd. El exponente de x no es 1.',
     why_en:'Square root is exponent \u00bd. The exponent of x is not 1.'},
    {expr:'y = 3x \u2212 5',   linear:true,
     why_es:'Forma estándar y = mx + b con m = 3, b = \u22125.',
     why_en:'Standard form y = mx + b with m = 3, b = \u22125.'},
    {expr:'y = x\u00b3',       linear:false,
     why_es:'La x está elevada al cubo (exponente 3). La gráfica es curva, no recta.',
     why_en:'x is cubed (exponent 3). The graph is a curve, not a line.'}
  ],rng);

  var w1idx=0, w1correct=0, w1misses=0;
  function drawW1(){
    if(w1idx>=w1funcs.length){
      var pct=Math.round(w1correct/w1funcs.length*100);
      w1host.innerHTML='<div class="iw-head"><span class="iw-tag">'+
        (LANG==='es'?'PRÁCTICA':'PRACTICE')+'</span><span class="iw-title">'+
        (LANG==='es'?'Clasificador de Funciones':'Function Classifier')+'</span></div>'+
        '<div style="text-align:center;padding:1rem 0">'+
        '<div style="font-size:2rem;font-weight:700;color:var(--green)">'+w1correct+'/'+w1funcs.length+'</div>'+
        '<div style="color:var(--text2);font-size:.88rem;margin-top:.3rem">'+
        (LANG==='es'?'clasificadas correctamente ('+pct+'%)':'classified correctly ('+pct+'%)') +'</div>'+
        '<button class="verify-btn" style="margin-top:.9rem" onclick="w1restart()">'+
        (LANG==='es'?'Reiniciar clasificador':'Restart classifier')+'</button>'+
        '</div>';
      return;
    }
    var fn=w1funcs[w1idx];
    w1host.innerHTML='<div class="iw-head"><span class="iw-tag">'+
      (LANG==='es'?'PRÁCTICA':'PRACTICE')+'</span><span class="iw-title">'+
      (LANG==='es'?'Clasificador de Funciones':'Function Classifier')+'</span></div>'+
      '<div class="clf-prog">'+(LANG==='es'?'Función ':'Function ')+(w1idx+1)+' de / of '+w1funcs.length+'</div>'+
      '<div class="iw-sub">'+(LANG==='es'
        ?'¿La siguiente expresión es una función lineal?'
        :'Is the following expression a linear function?')+'</div>'+
      '<div class="clf-card"><div class="clf-expr">'+fn.expr+'</div>'+
      '<div class="clf-btns">'+
      '<button class="clf-btn" id="w1-yes">'+
        (LANG==='es'?'Lineal':'Linear')+'</button>'+
      '<button class="clf-btn" id="w1-no">'+
        (LANG==='es'?'No lineal':'Not linear')+'</button>'+
      '</div></div>'+
      '<div class="iw-fb"></div>';
    var fb=w1host.querySelector('.iw-fb');
    function attempt(userLinear){
      var correct=(userLinear===fn.linear);
      if(correct){
        w1correct++;
        fb.className='iw-fb good';
        fb.innerHTML='\u2713 '+(LANG==='es'?fn.why_es:fn.why_en);
        setTimeout(function(){w1idx++;w1misses=0;drawW1();},1800);
      } else {
        w1misses++;
        if(w1misses>=3){
          fb.className='iw-fb warm';
          fb.innerHTML=(LANG==='es'?'Respuesta: ':' Answer: ')+(fn.linear?(LANG==='es'?'Lineal.':'Linear.'):( LANG==='es'?'No lineal.':'Not linear.'))+' '+(LANG==='es'?fn.why_es:fn.why_en);
          setTimeout(function(){w1idx++;w1misses=0;drawW1();},2200);
        } else {
          fb.className='iw-fb miss';
          fb.innerHTML=(LANG==='es'?'No es correcto. Revisa la potencia de x en la expresión. Intento '+w1misses+' de 3.'
            :'Not correct. Check the power of x in the expression. Attempt '+w1misses+' of 3.');
        }
      }
    }
    w1host.querySelector('#w1-yes').onclick=function(){attempt(true);};
    w1host.querySelector('#w1-no').onclick=function(){attempt(false);};
  }
  window.w1restart=function(){w1idx=0;w1correct=0;w1misses=0;drawW1();};
  widgets.push(drawW1);
  drawW1();

  /* ── PROBLEM 1 ─────────────────────────────────────────────────────────── */
  var o1=shuffleOpts(
    ['y = 7x \u2212 3','y = x\u00b2 + 5','y = 2\u02e3','y = \u221ax'],
    ['y = 7x \u2212 3','y = x\u00b2 + 5','y = 2\u02e3','y = \u221ax'],rng);
  problems.push({
    i18n:{
      title:{es:'Identificación',en:'Identification'},
      q:{es:'¿Cuál de las siguientes expresiones representa una función lineal?',
         en:'Which of the following expressions represents a linear function?'},
      hint:{es:'Una función lineal tiene la forma y = mx + b. La variable x aparece solo con exponente 1, sin raíces ni potencias mayores.',
            en:'A linear function has the form y = mx + b. The variable x appears only with exponent 1 — no roots or higher powers.'},
      exp:{es:'y = 7x − 3 tiene la forma y = mx + b (m = 7, b = −3): x con exponente 1. Las otras expresiones tienen x², 2ˣ o √x.',
           en:'y = 7x − 3 has the form y = mx + b (m = 7, b = −3): x with exponent 1. The other expressions have x², 2ˣ or √x.'},
      opts:{es:o1.es,en:o1.en}},
    title:'Identificación', questionText:'¿Cuál de las siguientes expresiones representa una función lineal?',
    options:o1.es, correctIdx:o1.correctIdx,
    explanation:'y = 7x \u2212 3 tiene la forma y = mx + b (m = 7, b = \u22123): x con exponente 1.',
    hint:'Una función lineal tiene la forma y = mx + b. La variable x aparece solo con exponente 1, sin raíces ni potencias mayores.',
    showWork:false, fn:'', studentChoice:null, pendingChoice:null
  });
  buildOneCard(problems[problems.length-1], problems.length-1);

  /* ────────────────────────────────────────────────────────────────────────
     CONCEPT 2 — Pendiente e intercepto: leer m y b en y = mx + b
     ──────────────────────────────────────────────────────────────────────── */
  addSection(function(L){
    var mSign = ex2m>=0?'':'\u2212';
    var mAbs  = Math.abs(ex2m);
    var bSign = ex2b>=0?' + ':' \u2212 ';
    var bAbs  = Math.abs(ex2b);
    var eq    = 'y = '+ex2m+'x'+(ex2b>=0?' + '+ex2b:' \u2212 '+bAbs);
    return L==='es'
      ? '<div class="stag">Concepto 2 de 5</div>'
        +'<h2>Pendiente e intercepto: leer m y b</h2>'
        +'<p>Porque ya sabemos que una función lineal tiene la forma y = mx + b, ahora podemos identificar sus dos parámetros directamente al leer la ecuación:</p>'
        +'<div class="callout"><strong>m — la pendiente</strong><p>Es el coeficiente que multiplica a x. Indica cuánto cambia y por cada unidad que aumenta x.</p>'
        +'<strong>b — el intercepto</strong><p>Es el término que no acompaña a x (el término independiente). Es el valor de y cuando x = 0.</p></div>'
        +'<p><strong>Regla práctica:</strong> el intercepto es el número que "está solo"; la pendiente es el número que "tiene la x".</p>'
        +'<p><strong>Ejemplo resuelto.</strong> Identifica m y b en la función: <span style="font-family:\'IBM Plex Mono\',monospace;font-size:1rem;color:var(--green-dark)">'+eq+'</span></p>'
        +'<div class="rules-grid">'
        +'<div class="rcard"><div class="rname">Pendiente (m)</div><div class="rform">m = '+ex2m+'</div><div class="rnote">Coeficiente de x</div></div>'
        +'<div class="rcard"><div class="rname">Intercepto (b)</div><div class="rform">b = '+ex2b+'</div><div class="rnote">Término independiente</div></div>'
        +'</div>'
        +'<p style="margin-top:.8rem">Atención: si la ecuación fuera y = '+ex2m+'x (sin término suelto), entonces b = 0. Si fuera y = '+ex2m+'x + 0, b también es 0.</p>'
      : '<div class="stag">Concept 2 of 5</div>'
