    var ansBoxH=8+chLines.length*5.5+coLines.length*5+exLines.length*5+6;
    doc.setFillColor(isOk?232:255,isOk?240:232,isOk?232:228);
    doc.roundedRect(M,wy,TW,ansBoxH,2,2,'F');
    doc.setFillColor(isOk?26:176,isOk?106:48,isOk?74:16); doc.circle(M+7,wy+8,3.5,'F');
    doc.setTextColor(255,255,255); doc.setFontSize(9); doc.setFont('helvetica','bold');
    doc.text(isOk?'v':'x',M+5.2,wy+10.5);
    var ay=wy+7;
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
    chLines.forEach(function(ln,li){doc.text(ln,M+14,ay+li*5.5);}); ay+=chLines.length*5.5+3;
    doc.setTextColor(26,106,74); doc.setFontSize(8); doc.setFont('helvetica','normal');
    coLines.forEach(function(ln,li){doc.text(ln,M+14,ay+li*5);}); ay+=coLines.length*5+3;
    doc.setTextColor(90,85,80); doc.setFontSize(7.5);
    exLines.forEach(function(ln,li){doc.text(ln,M+14,ay+li*5);}); wy+=ansBoxH+5;
    var dc=document.getElementById('dc'+i);
    if(dc){
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255); doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,wy,TW,8,'F'); doc.text(t('pdf-work'),M+4,wy+5.5); wy+=11;
      try{var imgD=dc.toDataURL('image/png');var ar=dc.height/dc.width,iw=TW,ih=Math.min(iw*ar,68);doc.addImage(imgD,'PNG',M,wy,iw,ih);wy+=ih+4;}catch(e){}
    }
    var ta=document.getElementById('ta'+i);
    if(ta&&ta.value.trim()){
      if(wy>PH-30){doc.addPage();wy=20;}
      doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('courier','normal');
      var taLines=doc.splitTextToSize(ta.value,TW);
      taLines.slice(0,16).forEach(function(ln){if(wy>PH-15){doc.addPage();wy=20;}doc.text(ln,M,wy);wy+=5;}); wy+=2;
    }
    var pp=document.getElementById('pp'+i);
    if(pp&&pp.src&&pp.src.indexOf('data:')===0){
      if(wy>PH-55){doc.addPage();wy=20;}
      try{doc.addImage(pp.src,'JPEG',M,wy,TW,68);wy+=72;}catch(e){}
    }
  });
  var pages=doc.internal.getNumberOfPages();
  for(var p=1;p<=pages;p++){doc.setPage(p);doc.setFillColor(pAR,pAG,pAB);doc.rect(0,PH-3,PW,3,'F');doc.setTextColor(130,140,160);doc.setFontSize(6.5);doc.setFont('helvetica','normal');doc.text(name+' \u00b7 '+group+' \u00b7 '+t('pdf-code')+code+' \u00b7 '+t('pdf-page')+p+'/'+pages,PW/2,PH-5,{align:'center'});}
  var _fn=SCHOOL.filePrefix+'_'+name.replace(/\s+/g,'_')+'_'+group.replace(/\s+/g,'_')+'.pdf';
  var _blob=doc.output('blob');
  function _restoreBtn(){btn.textContent=t('btn-pdf');btn.disabled=false;}
  function _openInline(b){var u=URL.createObjectURL(b);var w=window.open(u,'_blank');if(!w){window.location.href=u;}setTimeout(function(){URL.revokeObjectURL(u);},60000);}
  var _isIOS=/iPad|iPhone|iPod/.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
  if(_isIOS){var _file=new File([_blob],_fn,{type:'application/pdf'});if(navigator.canShare&&navigator.canShare({files:[_file]})){navigator.share({files:[_file],title:_fn}).then(_restoreBtn).catch(function(e){if(e&&e.name==='AbortError'){_restoreBtn();return;}_openInline(_blob);_restoreBtn();});return;}_openInline(_blob);_restoreBtn();return;}
  var _dlUrl=URL.createObjectURL(_blob);var _dlA=document.createElement('a');_dlA.href=_dlUrl;_dlA.download=_fn;document.body.appendChild(_dlA);_dlA.click();setTimeout(function(){document.body.removeChild(_dlA);URL.revokeObjectURL(_dlUrl);},200);_restoreBtn();
  }catch(err){btn.textContent=t('btn-pdf');btn.disabled=false;}
}
