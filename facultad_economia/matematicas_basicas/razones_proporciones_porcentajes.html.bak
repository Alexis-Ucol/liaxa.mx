/* ════════════════════════════════════════════════════════════════════════
   THEME
   ════════════════════════════════════════════════════════════════════════ */
var THEME_KEY = 'fac_econ_mat__theme';
function applyThemeVars(mode) {
  var r = document.documentElement.style;
  if (mode === 'dark') {
    r.setProperty('--green',      SCHOOL.darkPrimary);
    r.setProperty('--green-dark', SCHOOL.darkPrimaryDark);
    r.setProperty('--green-bg',   SCHOOL.darkPrimaryBg);
    r.setProperty('--gold',       SCHOOL.darkAccent);
    r.setProperty('--gold-bg',    SCHOOL.darkAccentBg);
  } else {
    r.setProperty('--green',      SCHOOL.primary);
    r.setProperty('--green-dark', SCHOOL.primaryDark);
    r.setProperty('--green-bg',   SCHOOL.primaryBg);
    r.setProperty('--gold',       SCHOOL.accent);
    r.setProperty('--gold-bg',    SCHOOL.accentBg);
  }
}
function toggleTheme() {
  var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  applyThemeVars(next);
  document.getElementById('themeBtn').textContent = next === 'dark' ? '☀️' : '🌙';
  try { localStorage.setItem(THEME_KEY, next); } catch(e) {}
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
}
(function() {
  document.documentElement.setAttribute('data-theme', 'light');
  applyThemeVars('light');
  try {
    var th = localStorage.getItem(THEME_KEY);
    if (th === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      applyThemeVars('dark');
      document.addEventListener('DOMContentLoaded', function() {
        var b = document.getElementById('themeBtn');
        if (b) b.textContent = '☀️';
      });
    }
  } catch(e) {}
})();

/* ════════════════════════════════════════════════════════════════════════
   ATTEMPT COUNTER + SEEDED RNG
   ════════════════════════════════════════════════════════════════════════ */
function getAttemptKey(name, group) {
  return 'fac_econ_mat__mat_razones__att__' + (name + '__' + group).replace(/\s+/g, '_');
}
function nextAttempt(name, group) {
  var k = getAttemptKey(name, group), n = 0;
  try { n = parseInt(localStorage.getItem(k) || '0', 10) || 0; } catch(e) {}
  n++;
  try { localStorage.setItem(k, String(n)); } catch(e) {}
  return n;
}
function currentAttempt(name, group) {
  var k = getAttemptKey(name, group);
  try { return parseInt(localStorage.getItem(k) || '1', 10) || 1; } catch(e) { return 1; }
}
function seededRng(seed) {
  var s = 0;
  for (var i = 0; i < seed.length; i++) s = (Math.imul(31, s) + seed.charCodeAt(i)) | 0;
  return function() {
    s = (s + 0x9e3779b9) | 0;
    var t2 = s ^ (s >>> 16);
    t2 = Math.imul(t2, 0x21f0aaad);
    t2 ^= (t2 >>> 15);
    t2 = Math.imul(t2, 0x735a2d97);
    return ((t2 ^ (t2 >>> 15)) >>> 0) / 4294967296;
  };
}
function pick(arr, rng) { return arr[Math.floor(rng() * arr.length)]; }
function shuffle(arr, rng) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(rng() * (i + 1));
    var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
  }
  return a;
}
/* Shuffles the four options once and keeps both language versions aligned. */
function shuffleOpts(rawEs, rawEn, rng) {
  var p = shuffle([0, 1, 2, 3], rng);
  return {
    es: p.map(function(j) { return rawEs[j]; }),
    en: p.map(function(j) { return rawEn[j]; }),
    correctIdx: p.indexOf(0)
  };
}

/* ════════════════════════════════════════════════════════════════════════
   NUMBER HELPERS
   ════════════════════════════════════════════════════════════════════════ */
function nf(x) {
  var neg = x < 0, v = Math.abs(x);
  var s = (Math.round(v * 10) / 10).toString().split('.');
  s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return (neg ? '−' : '') + s.join('.');
}
function nfD(x, d) {
  var neg = x < 0, v = Math.abs(x);
  var s = v.toFixed(d).split('.');
  s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return (neg ? '−' : '') + s.join('.');
}
function money(v)  { return '$' + nf(Math.round(v)); }
function money2(v) { return '$' + nfD(v, 2); }
function dec1(x)   { return x.toFixed(1); }
function dec2(x)   { return x.toFixed(2); }
function dec3(x)   { return x.toFixed(3); }
/* Rate as an option value, always two decimals so four choices stay distinct. */
function pct2(x)   { return (x * 100).toFixed(2) + '%'; }
function pct1(x)   { return nfD(x * 100, 1) + '%'; }
function pct0(x)   { return nf(Math.round(x * 100)) + '%'; }
function intN(x)   { return nf(Math.round(x)); }
function cssv(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }
/* Money on a chart axis, where the value may legitimately be negative. */
function moneyAx(v) { return v < 0 ? '−$' + nf(Math.round(-v)) : '$' + nf(Math.round(v)); }

/* Units and periods, named in the language of the reader. */
function kilosEs(x)   { return intN(x) + ' kilos'; }
function kilosEn(x)   { return intN(x) + ' kilos'; }
function boxesEs(x)   { return intN(x) + ' cajas'; }
function boxesEn(x)   { return intN(x) + ' boxes'; }
function hoursEs(x)   { return dec1(x) + ' horas'; }
function hoursEn(x)   { return dec1(x) + ' hours'; }
function packersEs(x) { return intN(x) + ' empacadores'; }
function packersEn(x) { return intN(x) + ' packers'; }
function stopsEs(x)   { return intN(x) + ' paradas'; }
function stopsEn(x)   { return intN(x) + ' stops'; }
function perKiloEs(v) { return money2(v) + ' por kilo'; }
function perKiloEn(v) { return money2(v) + ' per kilo'; }
/* A ratio said the way a report says it, with the two terms already reduced. */
function gcdInt(a, b) {
  a = Math.abs(Math.round(a)); b = Math.abs(Math.round(b));
  while (b) { var tmp = a % b; a = b; b = tmp; }
  return a || 1;
}
function ratioEs(a, b) { var g = gcdInt(a, b); return intN(a / g) + ' a ' + intN(b / g); }
function ratioEn(a, b) { var g = gcdInt(a, b); return intN(a / g) + ' to ' + intN(b / g); }
/* A percentage change named by its direction, so no minus sign meets a percent sign. */
function moveEs(v) { return v >= 0 ? pct2(v) + ' por encima' : pct2(-v) + ' por debajo'; }
function moveEn(v) { return v >= 0 ? pct2(v) + ' above'      : pct2(-v) + ' below'; }

/* ── 1 · RATIOS, RATES AND THE UNIT RATE ─────────────────────────────────
   A ratio compares two quantities by division, and the unit rate is the
   only form in which two offers of different size can be set side by side.
   Two sacks with different weights are two fractions with different
   denominators: they cannot be compared until both are taken to one kilo. */
function unitRate(price, weight)  { return weight <= 0 ? null : price / weight; }
function sackPrice(rate, weight)  { return rate * weight; }
/* The rate of the whole purchase, where each sack weighs on the average in
   proportion to the kilos it brings, not one vote per supplier. */
function pooledRate(prices, weights) {
  var p = 0, w = 0;
  for (var i = 0; i < prices.length; i++) { p += prices[i]; w += weights[i]; }
  return w <= 0 ? null : p / w;
}
/* The average a report produces when it forgets that the sacks differ. */
function plainMeanRate(rates) {
  var s = 0;
  for (var i = 0; i < rates.length; i++) s += rates[i];
  return s / rates.length;
}
function partOfWhole(part, other) { return part / (part + other); }

/* ── 2 · PROPORTIONS, DIRECT AND INVERSE ─────────────────────────────────
   In a direct proportion the quotient stays fixed; in an inverse one the
   product does. Which of the two a situation obeys is a business fact and
   never a matter of style.                                                */
function scaleDirect(known, fromQ, toQ) { return fromQ === 0 ? null : known * toQ / fromQ; }
function kilosNeeded(boxes, kgPerBox, yield_) { return yield_ <= 0 ? null : boxes * kgPerBox / yield_; }
function wasteKilos(boxes, kgPerBox, yield_) { return kilosNeeded(boxes, kgPerBox, yield_) - boxes * kgPerBox; }
function inverseHours(w0, h0, w1) { return w1 <= 0 ? null : h0 * w0 / w1; }
function directHours(w0, h0, w1)  { return w0 <= 0 ? null : h0 * w1 / w0; }
/* The floor a line hits when there are more hands than posts to stand at. */
function floorHours(w0, h0, posts) { return posts <= 0 ? null : h0 * w0 / posts; }

/* ── 3 · PROPORTIONAL ALLOCATION ─────────────────────────────────────────
   Splitting a common cost is dividing it by the total of the base and
   handing each party its own share of that base. The arithmetic is easy;
   choosing the base is the decision.                                      */
function allocFactor(amount, baseTotal) { return baseTotal <= 0 ? null : amount / baseTotal; }
function allocShare(amount, base, baseTotal) { return baseTotal <= 0 ? null : amount * base / baseTotal; }
function equalShare(amount, n) { return n <= 0 ? null : amount / n; }

/* ── 4 · PERCENTAGES, THEIR BASE AND THE TWO MARGINS ─────────────────────
   A percentage is a ratio with one hundred underneath, and it says nothing
   until its base is named. Undoing a percentage divides; it never subtracts. */
function netOfTax(gross, iva)   { return gross / (1 + iva); }
function marginOnPrice(price, cost) { return price <= 0 ? null : (price - cost) / price; }
function markupOnCost(price, cost)  { return cost  <= 0 ? null : (price - cost) / cost; }
function marginToMarkup(m) { return m >= 1 ? null : m / (1 - m); }
function listFromInvoice(total, iva, disc) { return disc >= 1 ? null : total / ((1 + iva) * (1 - disc)); }
function chainChange(up, down) { return (1 + up) * (1 - down) - 1; }

/* ════════════════════════════════════════════════════════════════════════
   OPTION BUILDERS · the key is always the first value handed in
   ════════════════════════════════════════════════════════════════════════ */
/* Four distinct numbers, each rendered once per language and kept aligned.
   The key is always the first value handed in. */
function valOpts2(correct, wrongs, fmtEs, fmtEn, rng) {
  var seen = {}, vals = [];
  function add(v) {
    if (typeof v !== 'number' || !isFinite(v)) return;
    var s = fmtEn(v);
    if (seen[s]) return;
    seen[s] = 1; vals.push(v);
  }
  add(correct);
  for (var i = 0; i < wrongs.length && vals.length < 4; i++) add(wrongs[i]);
  for (var j = 1; vals.length < 4 && j < 900; j++) {
    add(correct * (1 + j * 0.11 * (j % 2 ? 1 : -1)));
  }
  for (var k = 1; vals.length < 4 && k < 900; k++) add(correct + k * 0.41);
  return shuffleOpts(vals.map(fmtEs), vals.map(fmtEn), rng);
}
function valOpts(correct, wrongs, fmt, rng) {
  return valOpts2(correct, wrongs, fmt, fmt, rng);
}

/* ════════════════════════════════════════════════════════════════════════
   SESSION PERSISTENCE
   ════════════════════════════════════════════════════════════════════════ */
function lsKey() {
  var n = (studentData.name || '').trim(), g = (studentData.group || '').trim();
  return 'fac_econ_mat__mat_razones__' + (n + '__' + g).replace(/\s+/g, '_');
}
function saveSession() {
  if (!studentData.name) return;
  var drawings = [], texts = [], photos = [];
  problems.forEach(function(p, i) {
    var dc = document.getElementById('dc' + i);
    if (dc && dc.width) {
      var blank = document.createElement('canvas');
      blank.width = dc.width; blank.height = dc.height;
      drawings.push(dc.toDataURL() === blank.toDataURL() ? null : dc.toDataURL('image/png'));
    } else { drawings.push(null); }
    var ta = document.getElementById('ta' + i);
    texts.push(ta ? ta.value : '');
    var pp = document.getElementById('pp' + i);
    photos.push((pp && pp.src && pp.src.indexOf('data:') === 0) ? pp.src : null);
  });
  var state = {
    name: studentData.name, group: studentData.group,
    answeredCount: answeredCount, correctCount: correctCount,
    choices: problems.map(function(p) { return p.studentChoice; }),
    drawings: drawings, texts: texts, photos: photos
  };
  try { localStorage.setItem(lsKey(), JSON.stringify(state)); } catch(e) {}
}
function loadSession(name, group) {
  var key = 'fac_econ_mat__mat_razones__' + (name + '__' + group).replace(/\s+/g, '_');
  try { var r = localStorage.getItem(key); return r ? JSON.parse(r) : null; } catch(e) { return null; }
}
function dismissRestore() { document.getElementById('restoreBar').style.display = 'none'; }
function checkForSavedSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  if (!name || !group) { document.getElementById('restoreBar').style.display = 'none'; return; }
  var saved = loadSession(name, group);
  var bar = document.getElementById('restoreBar');
  bar.style.display = (saved && saved.choices && saved.choices.some(function(c) { return c !== null; })) ? 'block' : 'none';
}
function observeSections() {
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('vis'); });
  }, { threshold: 0.05 });
  document.querySelectorAll('.section').forEach(function(s) { obs.observe(s); });
}

/* ════════════════════════════════════════════════════════════════════════
   START / RESTORE
   ════════════════════════════════════════════════════════════════════════ */
function startLesson() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var err   = document.getElementById('startErr');
  if (!name || !group) { err.textContent = t('err-fields'); return; }
  err.textContent = '';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = nextAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
}
function restoreSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var saved = loadSession(name, group);
  if (!saved) return;
  document.getElementById('restoreBar').style.display = 'none';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = currentAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
  saved.choices.forEach(function(choice, idx) {
    if (choice !== null && choice !== undefined) confirmMC(idx, choice);
  });
  setTimeout(function() {
    if (saved.drawings) saved.drawings.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var dc = document.getElementById('dc' + i);
      if (!dc || !dc.width) return;
      var img = new Image();
      img.onload = function() {
        var dpr = window.devicePixelRatio || 1;
        dc.getContext('2d').drawImage(img, 0, 0, dc.width / dpr, dc.height / dpr);
      };
      img.src = dataUrl;
    });
    if (saved.texts) saved.texts.forEach(function(txt, i) {
      if (!txt) return;
      var ta = document.getElementById('ta' + i);
      if (ta) ta.value = txt;
    });
    if (saved.photos) saved.photos.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var pp = document.getElementById('pp' + i);
      if (!pp) return;
      pp.src = dataUrl; pp.style.display = 'block';
      var pz = document.getElementById('pz' + i);
      if (pz) pz.style.opacity = '0.4';
    });
  }, 300);
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS / TABS / PHOTO / HINT / RESULTS
   ════════════════════════════════════════════════════════════════════════ */
function initCanvas(canvas) {
  var dpr  = window.devicePixelRatio || 1;
  var rect = canvas.getBoundingClientRect();
  canvas.width  = rect.width  * dpr;
  canvas.height = rect.height * dpr;
  var ctx = canvas.getContext('2d');
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.scale(dpr, dpr);
  ctx.strokeStyle = '#2d5a27';
  ctx.lineWidth   = 2;
  ctx.lineCap     = 'round';
  ctx.lineJoin    = 'round';
  var drawing = false, lx = 0, ly = 0;
  var tb = canvas.closest('.cvwrap').querySelector('.ctoolbar');
  function getPos(e) {
    var r = canvas.getBoundingClientRect();
    var src = e.touches ? e.touches[0] : e;
    return [src.clientX - r.left, src.clientY - r.top];
  }
  function onDown(e) { e.preventDefault(); drawing = true; var p = getPos(e); lx = p[0]; ly = p[1]; }
  function onMove(e) { e.preventDefault(); if (!drawing) return; var p = getPos(e); ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p[0], p[1]); ctx.stroke(); lx = p[0]; ly = p[1]; }
  function onUp() { drawing = false; saveSession(); }
  canvas.addEventListener('mousedown',  onDown, { passive:false });
  canvas.addEventListener('mousemove',  onMove, { passive:false });
  canvas.addEventListener('mouseup',    onUp);
  canvas.addEventListener('mouseleave', onUp);
  canvas.addEventListener('touchstart', onDown, { passive:false });
  canvas.addEventListener('touchmove',  onMove, { passive:false });
  canvas.addEventListener('touchend',   onUp);
  tb.querySelectorAll('.tbtn2').forEach(function(btn) {
    btn.addEventListener('click', function() {
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      if (btn.classList.contains('bpen'))    { ctx.lineWidth = 2; }
      if (btn.classList.contains('bmarker')) { ctx.lineWidth = 10; ctx.globalAlpha = 0.45; }
      if (btn.classList.contains('beraser')) { ctx.globalCompositeOperation = 'destination-out'; ctx.lineWidth = 20; }
    });
  });
  tb.querySelectorAll('.cdot').forEach(function(dot) {
    dot.addEventListener('click', function() {
      tb.querySelectorAll('.cdot').forEach(function(d) { d.classList.remove('sel'); });
      dot.classList.add('sel');
      ctx.strokeStyle = dot.dataset.color;
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      tb.querySelector('.bpen').classList.add('on');
    });
  });
  tb.querySelector('.clrbtn').addEventListener('click', function() {
    ctx.clearRect(0, 0, canvas.width / dpr, canvas.height / dpr);
  });
}
function switchTab(idx, panel, btn) {
  var prefix = 'wp_' + idx + '_';
  document.querySelectorAll('[id^="' + prefix + '"]').forEach(function(p) { p.classList.remove('active'); });
  document.getElementById(prefix + panel).classList.add('active');
  btn.closest('.wtabs').querySelectorAll('.wtab').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
}
function handlePhoto(idx, input) {
  if (!input.files || !input.files[0]) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var img = document.getElementById('pp' + idx);
    img.src = e.target.result;
    img.style.display = 'block';
    document.getElementById('pz' + idx).style.opacity = '0.4';
    saveSession();
  };
  reader.readAsDataURL(input.files[0]);
}
function toggleHint(idx) { document.getElementById('hint' + idx).classList.toggle('show'); }
function showResults() {
  var rb = document.getElementById('s_results');
  if (!rb) return;
  rb.style.display = 'block';
  setTimeout(function() {
    rb.classList.add('vis');
    rb.scrollIntoView({ behavior:'smooth', block:'center' });
  }, 50);
}

/* ════════════════════════════════════════════════════════════════════════
   ANSWER HANDLER · two taps to confirm
   ════════════════════════════════════════════════════════════════════════ */
function handleMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  if (prob.pendingChoice === chosenIdx) {
    prob.studentChoice = chosenIdx;
    prob.pendingChoice = null;
    var isOk = (chosenIdx === prob.correctIdx);
    opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
    opts.forEach(function(o, i) {
      if (i === prob.correctIdx) o.classList.add('rc');
      if (i === chosenIdx && isOk)  o.classList.add('sc');
      if (i === chosenIdx && !isOk) o.classList.add('sw');
    });
    var fb = document.getElementById('fb' + probIdx);
    fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.explanation;
    fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
    document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
    if (isOk) correctCount++;
    answeredCount++;
    document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
    saveSession();
    if (answeredCount === problems.length) setTimeout(showResults, 700);
    return;
  }
  prob.pendingChoice = chosenIdx;
  opts.forEach(function(o) { o.classList.remove('pending'); });
  opts[chosenIdx].classList.add('pending');
}
function confirmMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (!prob || prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  prob.studentChoice = chosenIdx;
  prob.pendingChoice = null;
  var isOk = (chosenIdx === prob.correctIdx);
  opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
  opts.forEach(function(o, i) {
    if (i === prob.correctIdx) o.classList.add('rc');
    if (i === chosenIdx && isOk)  o.classList.add('sc');
    if (i === chosenIdx && !isOk) o.classList.add('sw');
  });
  var fb = document.getElementById('fb' + probIdx);
  fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.explanation;
  fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
  document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
  if (isOk) correctCount++;
  answeredCount++;
  document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
  saveSession();
  if (answeredCount === problems.length) setTimeout(showResults, 700);
}

/* ════════════════════════════════════════════════════════════════════════
   BUILD ONE CARD · appended inline, right after its concept
   The statement ends with the question. No formula is printed anywhere in
   the card: translating the situation into an operation is the exercise.
   ════════════════════════════════════════════════════════════════════════ */
function buildOneCard(prob, i) {
  var opts = prob.options.map(function(opt, oi) {
    return '<div class="mcopt" onclick="handleMC(' + i + ',' + oi + ')">' + opt + '</div>';
  }).join('');
  var work = '';
  if (prob.showWork) {
    work =
      '<div style="margin-bottom:.85rem">' +
        '<div class="wtabs">' +
          '<button class="wtab active" onclick="switchTab(' + i + ',\'draw\',this)">' + t('tab-draw') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'type\',this)">' + t('tab-type') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'photo\',this)">' + t('tab-photo') + '</button>' +
        '</div>' +
        '<div class="wpanel active" id="wp_' + i + '_draw">' +
          '<div class="cvwrap">' +
            '<canvas class="dcanvas" id="dc' + i + '"></canvas>' +
            '<div class="ctoolbar">' +
              '<button class="tbtn2 bpen on">' + t('tool-pen') + '</button>' +
              '<button class="tbtn2 bmarker">' + t('tool-mark') + '</button>' +
              '<button class="tbtn2 beraser">' + t('tool-erase') + '</button>' +
              '<div class="cdot sel" data-color="#2d5a27" style="background:#2d5a27"></div>' +
              '<div class="cdot"     data-color="#1a1a16" style="background:#1a1a16"></div>' +
              '<div class="cdot"     data-color="#8b2500" style="background:#8b2500"></div>' +
              '<div class="cdot"     data-color="#1d4e89" style="background:#1d4e89"></div>' +
              '<button class="clrbtn">' + t('tool-clear') + '</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_type">' +
          '<textarea class="wtextarea" id="ta' + i + '" placeholder="' + t('ph-work') + '" oninput="saveSession()"></textarea>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_photo">' +
          '<div class="pzone" id="pz' + i + '">' +
            '<input type="file" accept="image/*" onchange="handlePhoto(' + i + ',this)">' +
            '<div class="pzicon">📸</div>' +
            '<div class="pztxt">' + t('ph-photo') + '</div>' +
          '</div>' +
          '<img class="ppreview" id="pp' + i + '" alt="' + t('alt-work') + '">' +
        '</div>' +
      '</div>';
  }
  var card = document.createElement('div');
  card.className = 'pcrd section';
  card.id = 'pc' + i;
  card.innerHTML =
    '<div class="phdr"><div class="pnum">' + (i + 1) + '</div><div class="ptitle">' + prob.title + '</div></div>' +
    '<div class="pbody">' +
      '<div class="pstmt">' + prob.questionText + '</div>' +
      work +
      '<button class="hintbtn" onclick="toggleHint(' + i + ')">' + t('btn-hint') + '</button>' +
      '<div class="hintbox" id="hint' + i + '">' + (prob.hint || '') + '</div>' +
      '<div style="margin-top:.7rem">' +
        '<div style="font-family:\'IBM Plex Mono\',monospace;font-size:.65rem;letter-spacing:.1em;color:var(--text3);text-transform:uppercase;margin-bottom:.5rem">' + t('lbl-answer') + '</div>' +
        '<div class="mcopts">' + opts + '</div>' +
        '<div class="mcfb" id="fb' + i + '"></div>' +
      '</div>' +
    '</div>';
  document.getElementById('lessonBody').appendChild(card);
  if (prob.showWork) setTimeout(function() { var c = document.getElementById('dc' + i); if (c) initCanvas(c); }, 80);
}

/* ════════════════════════════════════════════════════════════════════════
   SECTION REGISTRY  (concept text is re-rendered on language switch)
   ════════════════════════════════════════════════════════════════════════ */
function addSection(fn) {
  var d = document.createElement('div');
  d.className = 'section';
  d.innerHTML = fn(LANG);
  document.getElementById('lessonBody').appendChild(d);
  sectionDefs.push({ el: d, fn: fn });
}
function applySectionLang() {
  sectionDefs.forEach(function(s) { s.el.innerHTML = s.fn(LANG); });
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS PRIMITIVES FOR THE WIDGETS
   ════════════════════════════════════════════════════════════════════════ */
function fitCanvas(cv, h) {
  var dpr = window.devicePixelRatio || 1;
  var w = Math.max(240, cv.clientWidth || cv.parentNode.clientWidth || 300);
  cv.style.height = h + 'px';
  cv.width  = Math.round(w * dpr);
  cv.height = Math.round(h * dpr);
  var ctx = cv.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);
  return { ctx: ctx, w: w, h: h };
}
function palette() {
  return {
    green: cssv('--green'), dark: cssv('--green-dark'), tint: cssv('--green-bg'),
    gold: cssv('--gold'), bad: cssv('--bad'), border: cssv('--border'),
    text: cssv('--text'), text2: cssv('--text2'), text3: cssv('--text3')
  };
}
function kindColor(P, kind) {
  if (kind === 'gold') return P.gold;
  if (kind === 'bad')  return P.bad;
  if (kind === 'tint') return P.tint;
  if (kind === 'soft') return P.text3;
  return P.dark;
}
/* Plots any curve given as a function of a quantity, a price or a count.
   A cost per kilo, the hours a crew needs and the share of a common cost
   are all the same picture to this routine.
     opts.marks  points worth naming, such as the offer standing today
     opts.band   the stretch of the horizontal axis worth highlighting
     opts.hline  a reference amount drawn as a horizontal line
     opts.asym   the limit a curve approaches without reaching
     opts.at     where the student is standing right now                     */
function drawCurveChart(g, xMin, xMax, series, opts) {
  var ctx = g.ctx, P = palette(), W = g.w, H = g.h, i;
  var padL = 56, padR = 12, padT = 18, padB = 28;
  opts = opts || {};
  var fmtY  = opts.fmtY || function(v) { return intN(v); };
  var fmtX  = opts.fmtX || function(v) { return intN(v); };
  var STEPS = 140;
  var yLo = null, yHi = null;
  function note(v) {
    if (typeof v !== 'number' || !isFinite(v)) return;
    if (yLo === null || v < yLo) yLo = v;
    if (yHi === null || v > yHi) yHi = v;
  }
  series.forEach(function(s) {
    for (i = 0; i <= STEPS; i++) note(s.f(xMin + (xMax - xMin) * i / STEPS));
  });
  note(opts.yFloor); note(opts.yCeil);
  if (opts.hline) note(opts.hline.y);
  if (opts.asym)  note(opts.asym.y);
  if (yLo === null) { yLo = 0; yHi = 1; }
  if (yHi - yLo < 1) yHi = yLo + 1;
  var pd = (yHi - yLo) * 0.10;
  yLo -= pd; yHi += pd;
  function X(v) { return padL + (v - xMin) / (xMax - xMin) * (W - padL - padR); }
  function Y(v) { return H - padB - (v - yLo) / (yHi - yLo) * (H - padT - padB); }
  function Yc(v) { return Math.max(padT - 10, Math.min(H - padB + 10, Y(v))); }

  if (opts.band && opts.band.to > opts.band.from) {
    var b1 = X(Math.max(xMin, opts.band.from)), b2 = X(Math.min(xMax, opts.band.to));
    if (b2 > b1) {
      ctx.save();
      ctx.fillStyle = P.tint;
      ctx.fillRect(b1, padT - 8, b2 - b1, H - padB - padT + 8);
      ctx.restore();
    }
  }
  ctx.strokeStyle = P.border; ctx.lineWidth = 1;
  ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Mono", monospace';
  for (i = 0; i <= 3; i++) {
    var gv = yLo + (yHi - yLo) * i / 3;
    ctx.beginPath(); ctx.moveTo(padL, Y(gv)); ctx.lineTo(W - padR, Y(gv)); ctx.stroke();
    var gl = fmtY(gv);
    ctx.fillText(gl, Math.max(1, padL - 4 - ctx.measureText(gl).width), Y(gv) + 3);
  }
  if (yLo < 0 && yHi > 0) {
    ctx.save();
    ctx.strokeStyle = P.text3; ctx.lineWidth = 1.4; ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(padL, Y(0)); ctx.lineTo(W - padR, Y(0)); ctx.stroke();
    ctx.restore();
  }
  if (opts.asym) {
    ctx.save();
    ctx.strokeStyle = P.bad; ctx.lineWidth = 1.3; ctx.setLineDash([5, 4]);
    ctx.beginPath(); ctx.moveTo(padL, Y(opts.asym.y)); ctx.lineTo(W - padR, Y(opts.asym.y)); ctx.stroke();
    ctx.restore();
    if (opts.asym.label) {
      ctx.fillStyle = P.bad; ctx.font = '600 9px "IBM Plex Sans", sans-serif';
      ctx.fillText(opts.asym.label, padL + 4, Math.max(10, Y(opts.asym.y) - 4));
    }
  }
  if (opts.hline) {
    ctx.save();
    ctx.strokeStyle = P.gold; ctx.lineWidth = 1.5; ctx.setLineDash([6, 3]);
    ctx.beginPath(); ctx.moveTo(padL, Y(opts.hline.y)); ctx.lineTo(W - padR, Y(opts.hline.y)); ctx.stroke();
    ctx.restore();
    if (opts.hline.label) {
      ctx.fillStyle = P.gold; ctx.font = '600 9px "IBM Plex Sans", sans-serif';
      var hw = ctx.measureText(opts.hline.label).width;
      ctx.fillText(opts.hline.label, W - padR - hw - 2, Math.max(10, Y(opts.hline.y) - 4));
    }
  }
  series.forEach(function(s) {
    ctx.strokeStyle = kindColor(P, s.kind); ctx.lineWidth = 2.2;
    ctx.beginPath();
    var started = false;
    for (i = 0; i <= STEPS; i++) {
      var xv = xMin + (xMax - xMin) * i / STEPS;
      var yv = s.f(xv);
      if (typeof yv !== 'number' || !isFinite(yv)) { started = false; continue; }
      var px = X(xv), py = Yc(yv);
      if (!started) { ctx.moveTo(px, py); started = true; } else { ctx.lineTo(px, py); }
    }
    ctx.stroke();
  });
  (opts.marks || []).forEach(function(m) {
    if (typeof m.x !== 'number' || !isFinite(m.x) || m.x < xMin || m.x > xMax) return;
    var cx = X(m.x), cy = Yc(m.y);
    ctx.save();
    ctx.strokeStyle = kindColor(P, m.kind || 'gold'); ctx.lineWidth = 1.4; ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(cx, H - padB); ctx.lineTo(cx, cy); ctx.stroke();
    ctx.restore();
    ctx.fillStyle = kindColor(P, m.kind || 'gold');
    ctx.beginPath(); ctx.arc(cx, cy, 4.2, 0, Math.PI * 2); ctx.fill();
    if (m.label) {
      ctx.font = '600 10px "IBM Plex Sans", sans-serif';
      var mw = ctx.measureText(m.label).width;
      ctx.fillText(m.label, Math.min(Math.max(2, cx - mw / 2), W - mw - 2), Math.max(10, cy - 9));
    }
  });
  if (typeof opts.at === 'number' && opts.at >= xMin && opts.at <= xMax) {
    ctx.save();
    ctx.strokeStyle = P.bad; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(X(opts.at), H - padB); ctx.lineTo(X(opts.at), padT - 6); ctx.stroke();
    ctx.restore();
  }
  ctx.strokeStyle = P.border; ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.moveTo(padL, padT - 8); ctx.lineTo(padL, H - padB); ctx.lineTo(W - padR, H - padB); ctx.stroke();
  ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Mono", monospace';
  [xMin, (xMin + xMax) / 2, xMax].forEach(function(v) {
    var lab = fmtX(v), lw = ctx.measureText(lab).width;
    ctx.fillText(lab, Math.min(Math.max(1, X(v) - lw / 2), W - lw - 1), H - padB + 13);
  });
  var legX = padL + 4;
  ctx.font = '600 9.5px "IBM Plex Sans", sans-serif';
  series.forEach(function(s) {
    if (!s.label) return;
    ctx.fillStyle = kindColor(P, s.kind);
    ctx.fillRect(legX, 9, 9, 3);
    ctx.fillText(s.label, legX + 12, 13);
    legX += 12 + ctx.measureText(s.label).width + 12;
  });
  if (opts.xLabel) {
    ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Sans", sans-serif';
    var xl = opts.xLabel;
    ctx.fillText(xl, W - padR - ctx.measureText(xl).width, H - 3);
  }
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 1 · two offers that only meet at the kilo
   ════════════════════════════════════════════════════════════════════════ */
function widgetRate(LA0, WA0, LB0, WB0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { view: 'kilo', LA: LA0, WA: WA0, LB: LB0, WB: WB0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'kilo',  es: 'El precio de la arpilla contra el precio del kilo', en: 'The price of the sack against the price of the kilo' },
      { id: 'total', es: 'Lo que cuesta surtir el pedido completo',           en: 'What filling the whole order costs' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.view ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="razon-tasa-unitaria-y-comparacion-de-ofertas">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Dos ofertas solo se comparan en el kilo' : 'Two offers only meet at the kilo') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'El área de compras de Cítricos de Tecomán recibe dos ofertas de limón el mismo día y ninguna de las dos viene en la misma presentación: cada huerto entrega su arpilla con distinto peso y a distinto precio. La primera vista deja fijo el precio de la arpilla del primer huerto y mueve su peso a lo largo del eje. La curva verde es lo que cuesta el kilo y la línea dorada marca lo que cuesta el kilo en el segundo huerto. Arrastra el peso y observa dos cosas: la curva baja siempre, porque el mismo precio repartido entre más kilos deja un kilo más barato, y cruza la línea dorada en un punto exacto, que es el peso al que las dos ofertas valen lo mismo. Ese cruce es la única comparación honesta que se puede hacer, porque comparar precios de arpillas de distinto peso es comparar dos razones con denominadores distintos. La segunda vista lleva las dos ofertas al pedido completo: dos rectas que salen del origen, y la pendiente de cada una es justamente su precio por kilo, de modo que la razón que buscabas es la inclinación de la recta.'
          : 'The buying desk at Cítricos de Tecomán gets two offers of limes on the same day and neither of them comes in the same presentation: every grove delivers its sack at a different weight and a different price. The first view holds the sack price of the first grove fixed and moves its weight along the axis. The green curve is what the kilo costs and the gold line marks what the kilo costs at the second grove. Drag the weight and watch two things: the curve always falls, because the same price spread over more kilos leaves a cheaper kilo, and it crosses the gold line at one exact point, which is the weight at which the two offers are worth the same. That crossing is the only honest comparison available, because comparing the prices of sacks of different weights is comparing two ratios with different denominators. The second view carries both offers through to the whole order: two straight lines out of the origin, and the slope of each one is precisely its price per kilo, so the ratio you were after is the steepness of the line.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Precio de la arpilla del huerto uno' : 'Sack price at grove one') + ': <span class="cval" id="w1LAl"></span></label>' +
          '<input type="range" min="180" max="460" step="10" id="w1LA" value="' + state.LA + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Kilos que trae esa arpilla' : 'Kilos in that sack') + ': <span class="cval" id="w1WAl"></span></label>' +
          '<input type="range" min="12" max="34" step="1" id="w1WA" value="' + state.WA + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Precio de la arpilla del huerto dos' : 'Sack price at grove two') + ': <span class="cval" id="w1LBl"></span></label>' +
          '<input type="range" min="180" max="460" step="10" id="w1LB" value="' + state.LB + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Kilos que trae esa arpilla' : 'Kilos in that sack') + ': <span class="cval" id="w1WBl"></span></label>' +
          '<input type="range" min="12" max="34" step="1" id="w1WB" value="' + state.WB + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="w1cv"></canvas>' +
        '<div class="dlist" id="w1steps"></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Kilo del huerto uno' : 'Kilo at grove one') + '</div><div class="mnum cs" id="w1rA"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Kilo del huerto dos' : 'Kilo at grove two') + '</div><div class="mnum ps" id="w1rB"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'La oferta que conviene' : 'The offer that suits') + '</div><div class="mnum ts" id="w1win"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Diferencia por kilo' : 'Difference per kilo') + '</div><div class="mnum ps" id="w1dif"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Ahorro en mil kilos' : 'Saving on a thousand kilos') + '</div><div class="mnum cs" id="w1sav"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Razón entre los pesos' : 'Ratio between the weights') + '</div><div class="mnum ts" id="w1rat"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="w1read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.view = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#w1LA').addEventListener('input', function() { state.LA = parseInt(this.value, 10); update(); });
    host.querySelector('#w1WA').addEventListener('input', function() { state.WA = parseInt(this.value, 10); update(); });
    host.querySelector('#w1LB').addEventListener('input', function() { state.LB = parseInt(this.value, 10); update(); });
    host.querySelector('#w1WB').addEventListener('input', function() { state.WB = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var LA = state.LA, WA = state.WA, LB = state.LB, WB = state.WB;
    var rA = unitRate(LA, WA), rB = unitRate(LB, WB);
    var dif = Math.abs(rA - rB);
    var win = rA < rB ? (es ? 'huerto uno' : 'grove one') : (rB < rA ? (es ? 'huerto dos' : 'grove two') : (es ? 'las dos igual' : 'both the same'));
    var evenW = rB > 0 ? LA / rB : null;
    host.querySelector('#w1LAl').textContent = money(LA);
    host.querySelector('#w1WAl').textContent = es ? kilosEs(WA) : kilosEn(WA);
    host.querySelector('#w1LBl').textContent = money(LB);
    host.querySelector('#w1WBl').textContent = es ? kilosEs(WB) : kilosEn(WB);
    host.querySelector('#w1rA').textContent  = money2(rA);
    host.querySelector('#w1rB').textContent  = money2(rB);
    host.querySelector('#w1win').textContent = win;
    host.querySelector('#w1dif').textContent = money2(dif);
    host.querySelector('#w1sav').textContent = money2(dif * 1000);
    host.querySelector('#w1rat').textContent = es ? ratioEs(WA, WB) : ratioEn(WA, WB);
    host.querySelector('#w1steps').textContent = es
      ? 'La arpilla del huerto uno trae ' + kilosEs(WA) + ' por ' + money(LA) + ', así que el kilo sale en ' + money2(rA) + '  ·  ' +
        'la del huerto dos trae ' + kilosEs(WB) + ' por ' + money(LB) + ', y ahí el kilo sale en ' + money2(rB) + '  ·  ' +
        'la diferencia es de ' + money2(dif) + ' por kilo  ·  ' +
        'en mil kilos esa diferencia vale ' + money2(dif * 1000)
      : 'The sack from grove one brings ' + kilosEn(WA) + ' for ' + money(LA) + ', so the kilo comes to ' + money2(rA) + '  ·  ' +
        'the one from grove two brings ' + kilosEn(WB) + ' for ' + money(LB) + ', and there the kilo comes to ' + money2(rB) + '  ·  ' +
        'the difference is ' + money2(dif) + ' per kilo  ·  ' +
        'on a thousand kilos that difference is worth ' + money2(dif * 1000);
    var g = fitCanvas(host.querySelector('#w1cv'), 185);
    if (state.view === 'kilo') {
      drawCurveChart(g, 8, 38, [
        { f: function(x) { return LA / x; }, kind: 'green', label: (es ? 'Precio del kilo, huerto uno' : 'Price of the kilo, grove one') }
      ], {
        yFloor: 0, fmtY: function(y) { return money2(y); }, fmtX: function(x) { return intN(x); },
        hline: { y: rB, label: (es ? 'kilo del huerto dos' : 'kilo at grove two') },
        marks: (evenW !== null && evenW >= 8 && evenW <= 38) ? [{ x: evenW, y: rB, label: intN(evenW), kind: 'gold' }] : [],
        at: WA,
        xLabel: (es ? 'kilos que trae la arpilla del huerto uno' : 'kilos in the sack from grove one')
      });
    } else {
      drawCurveChart(g, 0, 2000, [
        { f: function(x) { return rA * x; }, kind: 'green', label: (es ? 'Huerto uno' : 'Grove one') },
        { f: function(x) { return rB * x; }, kind: 'soft',  label: (es ? 'Huerto dos' : 'Grove two') }
      ], {
        yFloor: 0, fmtY: function(y) { return money(y); }, fmtX: function(x) { return intN(x); },
        at: 1000,
        xLabel: (es ? 'kilos de limón que se compran' : 'kilos of limes purchased')
      });
    }
    host.querySelector('#w1read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> el kilo del huerto uno cuesta ' + money2(rA) + ' y el del huerto dos ' + money2(rB) + ', de modo que hoy conviene ' + win + ' por ' + money2(dif) + ' de diferencia en cada kilo. ' +
        (evenW !== null ? 'La oferta del huerto uno igualaría a la otra si su arpilla trajera ' + kilosEs(evenW) + ', y ese punto de indiferencia es el que hay que renegociar cuando el proveedor cambia la presentación sin cambiar el precio. ' : '') +
        'Fíjate en que la arpilla más barata en la lista no tiene por qué dejar el kilo más barato: los pesos están en razón de ' + ratioEs(WA, WB) + ', así que las dos cifras de la lista no son comparables entre sí. En la vista del pedido completo cada oferta es una recta que sale del origen, y su inclinación es la tasa unitaria: elegir proveedor es elegir pendiente, y sobre mil kilos esa elección vale ' + money2(dif * 1000) + '.'
      : '<strong>Business reading:</strong> the kilo at grove one costs ' + money2(rA) + ' and the one at grove two ' + money2(rB) + ', so today ' + win + ' is the one that suits, by ' + money2(dif) + ' of difference on every kilo. ' +
        (evenW !== null ? 'The offer from grove one would match the other one if its sack brought ' + kilosEn(evenW) + ', and that point of indifference is what has to be renegotiated when a supplier changes the presentation without changing the price. ' : '') +
        'Notice that the cheapest sack on the price list need not leave the cheapest kilo: the weights stand in a ratio of ' + ratioEn(WA, WB) + ', so the two figures on the list are not comparable with each other. In the whole-order view each offer is a straight line out of the origin, and its steepness is the unit rate: choosing a supplier is choosing a slope, and over a thousand kilos that choice is worth ' + money2(dif * 1000) + '.';
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 2 · the two proportionalities of one packing line
   ════════════════════════════════════════════════════════════════════════ */
function widgetProportion(q0, kgb0, y0, w0, wh0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { view: 'directa', q: q0, kgb: kgb0, y: y0, w: w0, wh: wh0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'directa', es: 'Directa: más cajas piden más fruta',  en: 'Direct: more boxes ask for more fruit' },
      { id: 'inversa', es: 'Inversa: más manos, menos horas',     en: 'Inverse: more hands, fewer hours' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.view ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="proporcionalidad-directa-e-inversa">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Las dos proporcionalidades de una línea de empaque' : 'The two proportionalities of one packing line') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Un pedido llega a la planta y arrastra dos preguntas distintas: cuánta fruta hay que recibir y en cuánto tiempo sale. La primera vista es la proporcionalidad directa. La recta verde dice cuántos kilos hay que recibir para armar cada cantidad de cajas, y la gris dice cuántos kilos pesan las cajas ya armadas. Las dos salen del origen, las dos son rectas y la distancia entre ellas es la merma: la fruta que se recibe y no llega a la caja. Mueve el rendimiento y verás que la recta verde gira sin despegarse del origen, porque en una proporción directa lo que se mantiene fijo es el cociente entre los kilos y las cajas, y ese cociente es la constante de proporcionalidad que la planta usa para comprar. La segunda vista cambia de relación: la fruta ya está, lo que se reparte ahora es el trabajo. La curva verde son las horas que tarda el lote según cuántos empacadores lo tomen, y aquí lo que se mantiene fijo es el producto y no el cociente, así que la curva se dobla y nunca toca el cero por más gente que se sume. La recta gris es la lectura equivocada de quien trata este caso como si fuera directo: sube cuando debería bajar.'
          : 'An order reaches the plant and drags two different questions behind it: how much fruit has to come in and how long the batch takes. The first view is direct proportionality. The green line says how many kilos have to be received to build each quantity of boxes, and the grey one says how many kilos the finished boxes weigh. Both leave the origin, both are straight, and the gap between them is the waste: the fruit that comes in and never reaches a box. Move the yield and you will see the green line pivot without ever leaving the origin, because what stays fixed in a direct proportion is the quotient between kilos and boxes, and that quotient is the constant of proportionality the plant buys with. The second view changes the relation: the fruit is already there and what gets shared out now is the work. The green curve is the hours the batch takes depending on how many packers take it on, and here what stays fixed is the product rather than the quotient, so the curve bends and never touches zero however many hands are added. The grey line is the misreading of somebody treating this case as a direct one: it rises where it ought to fall.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Cajas del pedido' : 'Boxes in the order') + ': <span class="cval" id="w2ql"></span></label>' +
          '<input type="range" min="400" max="2400" step="100" id="w2q" value="' + state.q + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Kilos que lleva cada caja' : 'Kilos in every box') + ': <span class="cval" id="w2kl"></span></label>' +
          '<input type="range" min="4" max="12" step="1" id="w2k" value="' + state.kgb + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Fruta que pasa el estándar' : 'Fruit that passes the standard') + ': <span class="cval" id="w2yl"></span></label>' +
          '<input type="range" min="55" max="95" step="5" id="w2y" value="' + Math.round(state.y * 100) + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Empacadores en la línea' : 'Packers on the line') + ': <span class="cval" id="w2wl"></span></label>' +
          '<input type="range" min="3" max="30" step="1" id="w2w" value="' + state.w + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="w2cv"></canvas>' +
        '<div class="dlist" id="w2steps"></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Kilos que hay que recibir' : 'Kilos that have to come in') + '</div><div class="mnum cs" id="w2need"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Kilos que se quedan en el piso' : 'Kilos left on the floor') + '</div><div class="mnum ps" id="w2waste"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Kilos por caja ya con la merma' : 'Kilos per box once waste is in') + '</div><div class="mnum ts" id="w2const"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Horas con esta cuadrilla' : 'Hours with this crew') + '</div><div class="mnum cs" id="w2hrs"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Horas si la cuadrilla se duplica' : 'Hours if the crew doubles') + '</div><div class="mnum ts" id="w2hrs2"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Lo que diría la lectura directa' : 'What the direct reading claims') + '</div><div class="mnum ps" id="w2wrong"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="w2read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.view = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#w2q').addEventListener('input', function() { state.q = parseInt(this.value, 10); update(); });
    host.querySelector('#w2k').addEventListener('input', function() { state.kgb = parseInt(this.value, 10); update(); });
    host.querySelector('#w2y').addEventListener('input', function() { state.y = parseInt(this.value, 10) / 100; update(); });
    host.querySelector('#w2w').addEventListener('input', function() { state.w = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var q = state.q, kgb = state.kgb, y = state.y, w = state.w, wh = state.wh;
    var need  = kilosNeeded(q, kgb, y);
    var waste = wasteKilos(q, kgb, y);
    var kcons = kgb / y;
    var hrs   = wh / w;
    var hrs2  = wh / (w * 2);
    var wrongDirect = (wh / w) * 2;
    host.querySelector('#w2ql').textContent = es ? boxesEs(q) : boxesEn(q);
    host.querySelector('#w2kl').textContent = es ? kilosEs(kgb) : kilosEn(kgb);
    host.querySelector('#w2yl').textContent = pct0(y);
    host.querySelector('#w2wl').textContent = es ? packersEs(w) : packersEn(w);
    host.querySelector('#w2need').textContent  = es ? kilosEs(need) : kilosEn(need);
    host.querySelector('#w2waste').textContent = es ? kilosEs(waste) : kilosEn(waste);
    host.querySelector('#w2const').textContent = dec2(kcons);
    host.querySelector('#w2hrs').textContent   = es ? hoursEs(hrs) : hoursEn(hrs);
    host.querySelector('#w2hrs2').textContent  = es ? hoursEs(hrs2) : hoursEn(hrs2);
    host.querySelector('#w2wrong').textContent = es ? hoursEs(wrongDirect) : hoursEn(wrongDirect);
    host.querySelector('#w2steps').textContent = es
      ? 'El pedido pide ' + boxesEs(q) + ' de ' + kilosEs(kgb) + ' cada una  ·  ' +
        'solo ' + pct0(y) + ' de la fruta que entra pasa el estándar  ·  ' +
        'hay que recibir ' + kilosEs(need) + ' para armarlas  ·  ' +
        'el lote pide ' + intN(wh) + ' horas de empacador y con ' + packersEs(w) + ' sale en ' + hoursEs(hrs)
      : 'The order asks for ' + boxesEn(q) + ' of ' + kilosEn(kgb) + ' each  ·  ' +
        'only ' + pct0(y) + ' of the fruit that comes in passes the standard  ·  ' +
        kilosEn(need) + ' have to be received to build them  ·  ' +
        'the batch asks for ' + intN(wh) + ' packer hours and with ' + packersEn(w) + ' it comes out in ' + hoursEn(hrs);
    var g = fitCanvas(host.querySelector('#w2cv'), 185);
    if (state.view === 'directa') {
      drawCurveChart(g, 0, Math.max(600, q * 1.6), [
        { f: function(x) { return x * kgb / y; }, kind: 'green', label: (es ? 'Kilos que hay que recibir' : 'Kilos to receive') },
        { f: function(x) { return x * kgb; },     kind: 'soft',  label: (es ? 'Kilos que salen en caja' : 'Kilos that leave in a box') }
      ], {
        yFloor: 0, fmtY: function(v) { return intN(v); }, fmtX: function(x) { return intN(x); },
        at: q,
        xLabel: (es ? 'cajas del pedido' : 'boxes in the order')
      });
    } else {
      drawCurveChart(g, 2, 36, [
        { f: function(x) { return wh / x; },     kind: 'green', label: (es ? 'Horas que tarda el lote' : 'Hours the batch takes') },
        { f: function(x) { return (wh / state.w) * x / state.w; }, kind: 'soft', label: (es ? 'Lectura directa equivocada' : 'The wrong direct reading') }
      ], {
        yFloor: 0, fmtY: function(v) { return dec1(v); }, fmtX: function(x) { return intN(x); },
        asym: { y: 0, label: (es ? 'nunca llega a cero horas' : 'never reaches zero hours') },
        at: w,
        xLabel: (es ? 'empacadores en la línea' : 'packers on the line')
      });
    }
    host.querySelector('#w2read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> con ' + pct0(y) + ' de fruta aprovechable, cada caja de ' + kilosEs(kgb) + ' obliga a recibir ' + dec2(kcons) + ' kilos, y por eso el pedido de ' + boxesEs(q) + ' se compra como ' + kilosEs(need) + ' y no como ' + kilosEs(q * kgb) + '. La diferencia de ' + kilosEs(waste) + ' no es un error de cálculo, es fruta que se queda en el piso y que alguien ya pagó. ' +
        'Esa es una proporción directa: si el pedido se duplica, los kilos se duplican, porque lo que no cambia es el cociente. ' +
        'El tiempo se comporta al revés. El lote pide ' + intN(wh) + ' horas de empacador, así que con ' + packersEs(w) + ' sale en ' + hoursEs(hrs) + ' y al duplicar la cuadrilla baja a ' + hoursEs(hrs2) + ', nunca a cero. Quien aplica aquí la misma regla de tres de la vista anterior anuncia ' + hoursEs(wrongDirect) + ', que es el doble de lo que debería y además va en la dirección contraria.'
      : '<strong>Business reading:</strong> with ' + pct0(y) + ' of usable fruit, every box of ' + kilosEn(kgb) + ' forces ' + dec2(kcons) + ' kilos to be received, and that is why the order of ' + boxesEn(q) + ' is bought as ' + kilosEn(need) + ' and not as ' + kilosEn(q * kgb) + '. The gap of ' + kilosEn(waste) + ' is not a slip in the arithmetic, it is fruit left on the floor that somebody has already paid for. ' +
        'That is a direct proportion: double the order and the kilos double, because what does not change is the quotient. ' +
        'Time behaves the other way round. The batch asks for ' + intN(wh) + ' packer hours, so with ' + packersEn(w) + ' it comes out in ' + hoursEn(hrs) + ' and doubling the crew brings it down to ' + hoursEn(hrs2) + ', never to zero. Whoever applies the rule of three from the previous view here announces ' + hoursEn(wrongDirect) + ', which is twice what it should be and points the wrong way as well.';
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 3 · one freight bill split three ways
   ════════════════════════════════════════════════════════════════════════ */
function widgetAllocation(F0, a0, b0, c0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { view: 'reparto', F: F0, a: a0, b: b0, c: c0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'reparto', es: 'Lo que le toca al cliente grande', en: 'What the large customer is charged' },
      { id: 'factor',  es: 'El factor de reparto por kilo',    en: 'The allocation factor per kilo' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.view ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="reparto-proporcional-de-un-costo-comun">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Un flete y tres clientes' : 'One freight bill and three customers') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Cítricos de Tecomán consolida en un solo camión el limón de tres clientes y recibe una sola factura de flete. El costo es común, la responsabilidad no. La primera vista dibuja lo que le toca pagar al cliente más grande según los kilos que embarque, dejando fijos los kilos de los otros dos. La curva crece, pero fíjate en cómo se dobla: nunca alcanza la línea roja del flete completo, porque mientras los otros dos embarquen algo, algo les toca pagar. La línea gris es lo que pagaría ese mismo cliente si el flete se dividiera en partes iguales, y el punto donde las dos se cruzan es exactamente donde el cliente grande deja de salir beneficiado por el reparto parejo. Ahí está la decisión del bloque: repartir en partes iguales no es neutral, es una regla que le cobra de más a quien menos embarca. La segunda vista muestra el factor de reparto, que es el flete dividido entre el total de kilos: una sola cifra, en pesos por kilo, que multiplicada por los kilos de cada cliente reparte el costo completo sin que sobre ni falte un peso. Mueve los kilos de cualquiera y observa que el factor baja para todos, porque el camión se llena mejor.'
          : 'Cítricos de Tecomán consolidates the limes of three customers into a single truck and gets a single freight invoice. The cost is shared; the responsibility is not. The first view draws what the largest customer has to pay depending on the kilos it ships, holding the kilos of the other two fixed. The curve rises, but look at how it bends: it never reaches the red line of the whole freight bill, because as long as the other two ship anything, something falls to them. The grey line is what that same customer would pay if the freight were split into equal parts, and the point where the two cross is exactly where the large customer stops being favoured by the even split. That is the decision of this block: an equal split is not neutral, it is a rule that overcharges whoever ships least. The second view shows the allocation factor, which is the freight divided by the total kilos: one single figure, in pesos per kilo, that multiplied by each customer’s kilos hands out the whole cost with nothing left over and nothing missing. Move anybody’s kilos and watch the factor fall for everyone, because the truck is filled better.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Flete del camión consolidado' : 'Freight for the consolidated truck') + ': <span class="cval" id="w3Fl"></span></label>' +
          '<input type="range" min="24000" max="72000" step="2000" id="w3F" value="' + state.F + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Kilos del cliente grande' : 'Kilos of the large customer') + ': <span class="cval" id="w3al"></span></label>' +
          '<input type="range" min="4000" max="24000" step="1000" id="w3a" value="' + state.a + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Kilos del segundo cliente' : 'Kilos of the second customer') + ': <span class="cval" id="w3bl"></span></label>' +
          '<input type="range" min="2000" max="16000" step="1000" id="w3b" value="' + state.b + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Kilos del tercer cliente' : 'Kilos of the third customer') + ': <span class="cval" id="w3cl"></span></label>' +
          '<input type="range" min="1000" max="12000" step="1000" id="w3c" value="' + state.c + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="w3cv"></canvas>' +
        '<div class="dlist" id="w3steps"></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Paga el cliente grande' : 'The large customer pays') + '</div><div class="mnum cs" id="w3sa"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Paga el segundo' : 'The second one pays') + '</div><div class="mnum ts" id="w3sb"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Paga el tercero' : 'The third one pays') + '</div><div class="mnum ts" id="w3sc"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Factor de reparto' : 'Allocation factor') + '</div><div class="mnum ps" id="w3fac"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'En partes iguales' : 'Split into equal parts') + '</div><div class="mnum ps" id="w3eq"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Las tres partes suman' : 'The three shares add up to') + '</div><div class="mnum ts" id="w3sum"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="w3read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.view = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#w3F').addEventListener('input', function() { state.F = parseInt(this.value, 10); update(); });
    host.querySelector('#w3a').addEventListener('input', function() { state.a = parseInt(this.value, 10); update(); });
    host.querySelector('#w3b').addEventListener('input', function() { state.b = parseInt(this.value, 10); update(); });
    host.querySelector('#w3c').addEventListener('input', function() { state.c = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var F = state.F, a = state.a, b = state.b, c = state.c;
    var tot = a + b + c;
    var fac = allocFactor(F, tot);
    var sa  = allocShare(F, a, tot), sb = allocShare(F, b, tot), sc = allocShare(F, c, tot);
    var eq  = equalShare(F, 3);
    var cross = (b + c) / 2;
    host.querySelector('#w3Fl').textContent = money(F);
    host.querySelector('#w3al').textContent = es ? kilosEs(a) : kilosEn(a);
    host.querySelector('#w3bl').textContent = es ? kilosEs(b) : kilosEn(b);
    host.querySelector('#w3cl').textContent = es ? kilosEs(c) : kilosEn(c);
    host.querySelector('#w3sa').textContent  = money2(sa);
    host.querySelector('#w3sb').textContent  = money2(sb);
    host.querySelector('#w3sc').textContent  = money2(sc);
    host.querySelector('#w3fac').textContent = money2(fac);
    host.querySelector('#w3eq').textContent  = money2(eq);
    host.querySelector('#w3sum').textContent = money2(sa + sb + sc);
    host.querySelector('#w3steps').textContent = es
      ? 'El camión lleva ' + kilosEs(tot) + ' y el flete cuesta ' + money(F) + '  ·  ' +
        'el factor de reparto es ' + money2(fac) + ' por kilo  ·  ' +
        'al cliente grande le tocan ' + money2(sa) + ' por sus ' + kilosEs(a) + '  ·  ' +
        'a los otros dos, ' + money2(sb) + ' y ' + money2(sc)
      : 'The truck carries ' + kilosEn(tot) + ' and the freight costs ' + money(F) + '  ·  ' +
        'the allocation factor is ' + money2(fac) + ' per kilo  ·  ' +
        'the large customer is charged ' + money2(sa) + ' for its ' + kilosEn(a) + '  ·  ' +
        'the other two, ' + money2(sb) + ' and ' + money2(sc);
    var g = fitCanvas(host.querySelector('#w3cv'), 185);
    if (state.view === 'reparto') {
      drawCurveChart(g, 0, Math.max(26000, a * 1.5), [
        { f: function(x) { return F * x / (x + b + c); }, kind: 'green', label: (es ? 'Reparto por kilos' : 'Allocation by kilos') },
        { f: function(x) { return eq; },                  kind: 'soft',  label: (es ? 'En partes iguales' : 'Equal parts') }
      ], {
        yFloor: 0, fmtY: function(v) { return money(v); }, fmtX: function(x) { return intN(x); },
        asym: { y: F, label: (es ? 'el flete completo' : 'the whole freight bill') },
        marks: [{ x: cross, y: eq, label: (es ? 'aquí se igualan' : 'they meet here'), kind: 'gold' }],
        at: a,
        xLabel: (es ? 'kilos que embarca el cliente grande' : 'kilos shipped by the large customer')
      });
    } else {
      drawCurveChart(g, 6000, Math.max(40000, tot * 1.4), [
        { f: function(x) { return F / x; }, kind: 'green', label: (es ? 'Pesos de flete por kilo' : 'Pesos of freight per kilo') }
      ], {
        yFloor: 0, fmtY: function(v) { return money2(v); }, fmtX: function(x) { return intN(x); },
        hline: { y: fac, label: (es ? 'factor de hoy' : 'today’s factor') },
        at: tot,
        xLabel: (es ? 'kilos totales que van en el camión' : 'total kilos riding in the truck')
      });
    }
    host.querySelector('#w3read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> el camión lleva ' + kilosEs(tot) + ' y el flete de ' + money(F) + ' deja un factor de ' + money2(fac) + ' por kilo. Con ese factor el cliente grande paga ' + money2(sa) + ', el segundo ' + money2(sb) + ' y el tercero ' + money2(sc) + ', y la suma da ' + money2(sa + sb + sc) + ': un reparto proporcional bien hecho siempre cierra contra el monto original, y esa suma es la primera verificación que hay que hacer antes de facturar. ' +
        'En partes iguales cada quien pagaría ' + money2(eq) + ', que le conviene al que más embarca y castiga al que menos. Las dos reglas se igualan cuando el cliente grande embarca ' + kilosEs(cross) + ', es decir la mitad de lo que embarcan los otros dos juntos. ' +
        'Nota que el factor no es un precio de mercado sino el resultado de una división, así que baja en cuanto el camión se llena: llenar el camión es, literalmente, bajarle el costo a todos.'
      : '<strong>Business reading:</strong> the truck carries ' + kilosEn(tot) + ' and the freight of ' + money(F) + ' leaves a factor of ' + money2(fac) + ' per kilo. With that factor the large customer pays ' + money2(sa) + ', the second one ' + money2(sb) + ' and the third one ' + money2(sc) + ', and the sum comes to ' + money2(sa + sb + sc) + ': a proportional allocation done properly always closes back onto the original amount, and that sum is the first check to run before invoicing. ' +
        'Split into equal parts everybody would pay ' + money2(eq) + ', which suits whoever ships most and punishes whoever ships least. The two rules coincide when the large customer ships ' + kilosEn(cross) + ', that is, half of what the other two ship together. ' +
        'Notice that the factor is not a market price but the result of a division, so it falls as soon as the truck fills up: filling the truck is, quite literally, lowering the cost for everyone.';
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 4 · the same peso read as two different margins
   ════════════════════════════════════════════════════════════════════════ */
function widgetMargin(cost0, shelf0, disc0, kilos0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var IVA = 0.16;
  var state = { view: 'margenes', c: cost0, pf: shelf0, d: disc0, k: kilos0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'margenes', es: 'Sobre el precio o sobre el costo',      en: 'On the price or on the cost' },
      { id: 'reversa',  es: 'Del precio de anaquel al de lista',     en: 'From the shelf price back to the list price' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.view ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="margen-sobre-precio-o-sobre-costo-y-porcentaje-inverso">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'El mismo peso de ganancia, dos porcentajes' : 'The same peso of profit, two percentages') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'El área de precios discute una sola cifra: lo que deja un kilo de limón. La primera vista dibuja los dos porcentajes que describen esa misma ganancia según de dónde cuelguen. La curva verde es el margen sobre el precio de venta, el que se reporta al consejo; la gris es el margen sobre el costo, el que usa el comprador para poner el precio. Las dos nacen juntas en el punto donde el precio iguala al costo y se separan cada vez más conforme el precio sube. Fíjate en la línea roja: el margen sobre el precio se acerca al cien por ciento y nunca lo alcanza, porque el costo no puede desaparecer del precio, mientras el margen sobre el costo sigue subiendo sin techo. Decir treinta por ciento sin decir sobre qué base deja al lector eligiendo entre dos precios distintos. La segunda vista recorre el camino inverso, que es el que más se equivoca en la práctica: el precio de anaquel ya trae el impuesto y ya trae el descuento comercial, y para volver al precio de lista hay que deshacer los dos porcentajes dividiendo, nunca restando. La curva verde hace eso bien y la gris resta los porcentajes; empieza con descuentos pequeños, donde casi coinciden, y súbelos para ver cuánto dinero cabe entre las dos.'
          : 'The pricing desk is arguing about a single figure: what a kilo of limes leaves behind. The first view draws the two percentages that describe that same profit depending on what they hang from. The green curve is the margin on the selling price, the one reported to the board; the grey one is the margin on cost, the one the buyer uses to set the price. Both are born together at the point where price equals cost and they drift apart as the price rises. Look at the red line: the margin on price approaches one hundred percent and never reaches it, because the cost cannot vanish out of the price, while the margin on cost keeps climbing with no ceiling at all. Saying thirty percent without saying on what base leaves the reader choosing between two different prices. The second view runs the road backwards, which is where practice goes wrong most often: the shelf price already carries the tax and already carries the trade discount, and getting back to the list price means undoing both percentages by dividing, never by subtracting. The green curve does that properly and the grey one subtracts the percentages; start with small discounts, where they almost coincide, and raise them to see how much money fits between the two.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Costo del kilo puesto en bodega' : 'Cost of the kilo in the warehouse') + ': <span class="cval" id="w4cl"></span></label>' +
          '<input type="range" min="16" max="48" step="1" id="w4c" value="' + state.c + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Precio de anaquel con impuesto' : 'Shelf price with tax') + ': <span class="cval" id="w4pl"></span></label>' +
          '<input type="range" min="34" max="96" step="1" id="w4p" value="' + state.pf + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Descuento comercial a la cadena' : 'Trade discount to the chain') + ': <span class="cval" id="w4dl"></span></label>' +
          '<input type="range" min="0" max="32" step="1" id="w4d" value="' + Math.round(state.d * 100) + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Kilos del pedido' : 'Kilos in the order') + ': <span class="cval" id="w4kl"></span></label>' +
          '<input type="range" min="200" max="4000" step="100" id="w4k" value="' + state.k + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="w4cv"></canvas>' +
        '<div class="dlist" id="w4steps"></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Precio sin impuesto' : 'Price without tax') + '</div><div class="mnum ts" id="w4net"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Margen sobre el precio' : 'Margin on the price') + '</div><div class="mnum cs" id="w4mp"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Margen sobre el costo' : 'Margin on the cost') + '</div><div class="mnum ps" id="w4mc"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Ganancia por kilo' : 'Profit per kilo') + '</div><div class="mnum cs" id="w4gp"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Precio de lista del pedido' : 'List price of the order') + '</div><div class="mnum ts" id="w4list"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Si los porcentajes se restaran' : 'If the percentages were subtracted') + '</div><div class="mnum ps" id="w4bad"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="w4read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.view = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#w4c').addEventListener('input', function() { state.c  = parseInt(this.value, 10); update(); });
    host.querySelector('#w4p').addEventListener('input', function() { state.pf = parseInt(this.value, 10); update(); });
    host.querySelector('#w4d').addEventListener('input', function() { state.d  = parseInt(this.value, 10) / 100; update(); });
    host.querySelector('#w4k').addEventListener('input', function() { state.k  = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var c = state.c, pf = state.pf, d = state.d, k = state.k;
    var pn = netOfTax(pf, IVA);
    var mp = marginOnPrice(pn, c);
    var mc = markupOnCost(pn, c);
    var gain = pn - c;
    var listOrder = listFromInvoice(pf * k, IVA, d);
    var badOrder  = pf * k * (1 - IVA) * (1 + d);
    host.querySelector('#w4cl').textContent = money(c);
    host.querySelector('#w4pl').textContent = money(pf);
    host.querySelector('#w4dl').textContent = pct0(d);
    host.querySelector('#w4kl').textContent = es ? kilosEs(k) : kilosEn(k);
    host.querySelector('#w4net').textContent  = money2(pn);
    host.querySelector('#w4mp').textContent   = pct2(mp);
    host.querySelector('#w4mc').textContent   = pct2(mc);
    host.querySelector('#w4gp').textContent   = money2(gain);
    host.querySelector('#w4list').textContent = money2(listOrder);
    host.querySelector('#w4bad').textContent  = money2(badOrder);
    host.querySelector('#w4steps').textContent = es
      ? 'El anaquel marca ' + money(pf) + ' con impuesto, que sin impuesto son ' + money2(pn) + '  ·  ' +
        'el kilo cuesta ' + money(c) + ', así que deja ' + money2(gain) + '  ·  ' +
        'esa misma ganancia es ' + pct2(mp) + ' del precio y ' + pct2(mc) + ' del costo  ·  ' +
        'el pedido de ' + kilosEs(k) + ' vale ' + money2(listOrder) + ' a precio de lista'
      : 'The shelf says ' + money(pf) + ' with tax, which without tax is ' + money2(pn) + '  ·  ' +
        'the kilo costs ' + money(c) + ', so it leaves ' + money2(gain) + '  ·  ' +
        'that same profit is ' + pct2(mp) + ' of the price and ' + pct2(mc) + ' of the cost  ·  ' +
        'the order of ' + kilosEn(k) + ' is worth ' + money2(listOrder) + ' at list price';
    var g = fitCanvas(host.querySelector('#w4cv'), 185);
    if (state.view === 'margenes') {
      drawCurveChart(g, c, c * 3, [
        { f: function(x) { return (x - c) / x; }, kind: 'green', label: (es ? 'Margen sobre el precio' : 'Margin on the price') },
        { f: function(x) { return (x - c) / c; }, kind: 'soft',  label: (es ? 'Margen sobre el costo' : 'Margin on the cost') }
      ], {
        yFloor: 0, fmtY: function(v) { return pct0(v); }, fmtX: function(x) { return money(x); },
        asym: { y: 1, label: (es ? 'el margen sobre el precio no llega al cien' : 'the margin on price never reaches a hundred') },
        at: pn,
        xLabel: (es ? 'precio de venta sin impuesto' : 'selling price without tax')
      });
    } else {
      drawCurveChart(g, 0, 0.40, [
        { f: function(x) { return listFromInvoice(pf * k, IVA, x); },   kind: 'green', label: (es ? 'Deshaciendo los porcentajes' : 'Undoing the percentages') },
        { f: function(x) { return pf * k * (1 - IVA) * (1 + x); },      kind: 'soft',  label: (es ? 'Restando los porcentajes' : 'Subtracting the percentages') }
      ], {
        yFloor: 0, fmtY: function(v) { return money(v); }, fmtX: function(x) { return pct0(x); },
        at: d,
        xLabel: (es ? 'descuento comercial concedido' : 'trade discount granted')
      });
    }
    host.querySelector('#w4read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> el kilo se vende en ' + money2(pn) + ' sin impuesto y cuesta ' + money(c) + ', así que deja ' + money2(gain) + '. Esa única cantidad de dinero se puede reportar como ' + pct2(mp) + ' si se mide sobre el precio o como ' + pct2(mc) + ' si se mide sobre el costo, y las dos son ciertas: lo que no es cierto es usarlas como si fueran la misma. ' +
        'La primera sirve para comparar productos entre sí, porque todas las ventas se miden contra la misma base; la segunda sirve para poner precio, porque el comprador parte del costo. ' +
        'En la vista inversa, el pedido de ' + kilosEs(k) + ' que el anaquel valora en ' + money2(pf * k) + ' corresponde a ' + money2(listOrder) + ' de precio de lista. Quien deshace los porcentajes restando llega a ' + money2(badOrder) + ', y la diferencia crece con el descuento: deshacer un porcentaje es dividir, porque el porcentaje se aplicó multiplicando.'
      : '<strong>Business reading:</strong> the kilo sells at ' + money2(pn) + ' without tax and costs ' + money(c) + ', so it leaves ' + money2(gain) + '. That single amount of money can be reported as ' + pct2(mp) + ' if it is measured on the price or as ' + pct2(mc) + ' if it is measured on the cost, and both are true: what is not true is using them as though they were the same. ' +
        'The first one serves to compare products with each other, because every sale is measured against the same base; the second one serves to set prices, because the buyer starts from the cost. ' +
        'In the reverse view, the order of ' + kilosEn(k) + ' that the shelf values at ' + money2(pf * k) + ' corresponds to ' + money2(listOrder) + ' of list price. Whoever undoes the percentages by subtracting lands on ' + money2(badOrder) + ', and the gap grows with the discount: undoing a percentage means dividing, because the percentage was applied by multiplying.';
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   LESSON CONTENT
   ════════════════════════════════════════════════════════════════════════ */
function mk(i18n, correctIdx, showWork) {
  return {
    i18n: i18n, correctIdx: correctIdx, showWork: showWork,
    title: i18n.title[LANG], questionText: i18n.q[LANG],
    hint: i18n.hint[LANG], explanation: i18n.exp[LANG],
    options: i18n.opts[LANG].slice()
  };
}
function frac(a, b) {
  return '<span class="mf-outer"><span class="mf-num">' + a + '</span><span class="mf-den">' + b + '</span></span>';
}
/* ── Deterministic guards against two options landing on the same number ──
   Every distractor here is built from the same drawn parameters, so a few
   draws make two of them coincide. Each guard walks one drawn value until
   the four options separate, and it always terminates in a step or two.  */
function fixMeanRate(rA, rB, rC) {
  var r = rC;
  for (var i = 0; i < 8; i++) {
    var mean = plainMeanRate([rA, rB, r]);
    var s = [money2(rA), money2(rB), money2(r), money2(mean)];
    if (s[0] !== s[1] && s[0] !== s[2] && s[0] !== s[3] &&
        s[1] !== s[2] && s[1] !== s[3] && s[2] !== s[3]) return r;
    r += 0.5;
  }
  return r;
}
function fixOldOrder(q1, q2, kgb, y) {
  var a = q1;
  for (var i = 0; i < 6 && a > 150; i++) {
    var s = [intN(q2 * kgb / y), intN(q2 * kgb), intN(q2 * kgb * y), intN(a * kgb / y)];
    if (s[0] !== s[1] && s[0] !== s[2] && s[0] !== s[3] &&
        s[1] !== s[2] && s[1] !== s[3] && s[2] !== s[3]) return a;
    a -= 150;
  }
  return a;
}
function fixCrewHours(w1, h0, add) {
  var h = h0, w2 = w1 + add;
  for (var i = 0; i < 6; i++) {
    var s = [dec1(h * w1 / w2), dec1(h * w2 / w1), dec1(h * (1 - add / w1)), dec1(h - add)];
    if (s[0] !== s[1] && s[0] !== s[2] && s[0] !== s[3] &&
        s[1] !== s[2] && s[1] !== s[3] && s[2] !== s[3]) return h;
    h += 3;
  }
  return h;
}

function buildLesson(rng) {
  problems = []; sectionDefs = []; widgets = [];
  document.getElementById('lessonBody').innerHTML = '';
  var IVA = 0.16;

  /* ── every number in the guide comes from the seeded rng ── */
  /* Concept 1 · ratios, rates and the unit rate */
  var c1rA = pick([12, 13, 14], rng);
  var c1wA = pick([18, 20, 25], rng);
  var c1rB = pick([11.5, 12.5, 13.5], rng);
  var c1wB = pick([12, 16, 20], rng);
  var c1k  = pick([5, 10, 20], rng);
  var w1LA = pick([260, 300, 340], rng);                 // widget 1 opening state
  var w1WA = pick([18, 22, 26], rng);
  var w1LB = pick([220, 280, 320], rng);
  var w1WB = pick([14, 18, 24], rng);
  var p1rA = pick([12, 13, 14], rng);                    // item 1
  var p1wA = pick([18, 20, 25], rng);
  var p1rB = pick([11.5, 12.5, 13.5], rng);
  var p1wB = pick([12, 16, 20], rng);
  var p1rC = fixMeanRate(p1rA, p1rB, pick([11.75, 12.75, 13.75], rng));
  var p1wC = pick([24, 28, 32], rng);
  var p2k  = pick([4, 9, 19], rng);                      // item 2

  /* Concept 2 · direct and inverse proportion */
  var c2q  = pick([800, 1000, 1200], rng);
  var c2kg = pick([5, 8, 10], rng);
  var c2y  = pick([0.75, 0.80, 0.90], rng);
  var c2w  = pick([6, 8, 10], rng);
  var c2h  = pick([12, 15, 18], rng);
  var c2w2 = c2w + pick([2, 4, 6], rng);
  var w2q  = pick([800, 1200, 1600], rng);               // widget 2 opening state
  var w2kg = pick([5, 8, 10], rng);
  var w2y  = pick([0.70, 0.80, 0.90], rng);
  var w2w  = pick([8, 12, 16], rng);
  var w2wh = w2w * pick([9, 12, 15], rng);
  var p3q2 = pick([1500, 1800, 2100], rng);              // item 3
  var p3kg = pick([5, 8, 10], rng);
  var p3y  = pick([0.75, 0.80, 0.90], rng);
  var p3q1 = fixOldOrder(p3q2 - pick([300, 600, 900], rng), p3q2, p3kg, p3y);
  var p4w1 = pick([6, 8, 9], rng);                       // item 4
  var p4add = pick([2, 3, 4], rng);
  var p4h  = fixCrewHours(p4w1, pick([12, 15, 18], rng), p4add);

  /* Concept 3 · proportional allocation */
  var c3F = pick([30000, 36000, 45000], rng);
  var c3a = pick([10000, 12000, 15000], rng);
  var c3b = pick([5000, 6000, 8000], rng);
  var c3c = pick([2000, 3000, 4000], rng);
  var w3F = pick([32000, 44000, 56000], rng);            // widget 3 opening state
  var w3a = pick([9000, 12000, 15000], rng);
  var w3b = pick([5000, 8000, 11000], rng);
  var w3c = pick([2000, 4000, 6000], rng);
  var p5F = pick([36000, 42000, 54000], rng);            // item 5
  var p5a = pick([12000, 15000, 18000], rng);
  var p5b = pick([6000, 8000, 9000], rng);
  var p5c = pick([3000, 4000, 5000], rng);
  var p5sa = pick([2, 3], rng);
  var p5sb = pick([3, 4], rng);
  var p5sc = pick([4, 5], rng);

  /* Concept 4 · percentages, their base and the two margins */
  var c4c  = pick([26, 30, 34], rng);
  var c4pf = pick([50, 56, 62], rng);
  var c4d  = pick([0.08, 0.10, 0.12], rng);
  var c4k  = pick([600, 900, 1200], rng);
  var w4c  = pick([22, 28, 34], rng);                    // widget 4 opening state
  var w4pf = pick([44, 54, 64], rng);
  var w4d  = pick([0.05, 0.10, 0.15], rng);
  var w4k  = pick([600, 1200, 1800], rng);
  var p6c  = pick([28, 32, 36], rng);                    // item 6
  var p6pf = pick([52, 58, 64], rng);

  /* Final assessment */
  var p7L = pick([48000, 56000, 64000], rng);            // item 7
  var p7d = pick([0.08, 0.10, 0.12], rng);
  var p8u = pick([0.10, 0.15, 0.20], rng);               // item 8
  var p9w = pick([4, 5, 6], rng);                        // item 9
  var p9h = pick([9, 10, 12], rng);
  var p9m = pick([6, 9], rng);
  var p9p = pick([12, 15, 18], rng);
  var p10y = pick([0.72, 0.80, 0.85], rng);              // item 10
  var p10r = pick([0.05, 0.10], rng);

  /* ═══════════════════════ CONCEPT 1 ═══════════════════════ */
  var c1pA = sackPrice(c1rA, c1wA);
  var c1pB = sackPrice(c1rB, c1wB);
  var c1uA = unitRate(c1pA, c1wA);
  var c1uB = unitRate(c1pB, c1wB);
  var c1best = Math.min(c1uA, c1uB);
  var c1dif  = Math.abs(c1uA - c1uB);
  var c1merma = 1 / c1k;

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 1</div>' +
      '<h2>Razones, tasas y la tasa unitaria</h2>' +
      '<p>Toda esta guía transcurre dentro de una sola empresa: Cítricos de Tecomán, una empacadora que compra limón a los huertos de la región, lo lava, lo clasifica por calibre y lo vende en cajas a cadenas de supermercados y a un exportador. Cada bloque te sienta en una silla distinta de esa empresa, la de compras, la de producción, la de costos y la de precios. En las cuatro aparece el mismo problema: comparar cantidades que no vienen en la misma escala. Esa comparación es exactamente lo que hace una razón, y por eso la razón es la herramienta más usada de la administración y la que más se maltrata.</p>' +
      '<p>Una <strong>razón</strong> compara dos cantidades por cociente y no por diferencia. Decir que una arpilla pesa cinco kilos más que otra es una comparación aditiva; decir que pesa una vez y media lo que la otra es una comparación por razón, y solo la segunda sobrevive al cambio de escala. Conviene distinguir desde el principio dos maneras de armarla. La razón <strong>parte contra parte</strong> compara dos pedazos entre sí, como la fruta rechazada contra la aceptada. La razón <strong>parte contra todo</strong> compara un pedazo con el conjunto completo, y es la única que se puede convertir directamente en un porcentaje. Confundirlas es el error más caro de este bloque porque no salta a la vista: las dos se escriben igual y las dos suenan razonables.</p>' +
      '<p>Cuando las dos cantidades comparadas tienen unidades distintas, la razón recibe el nombre de <strong>tasa</strong>: pesos por kilo, cajas por hora, kilos por caja. La <strong>tasa unitaria</strong> es la tasa llevada a una unidad del denominador, y es el único terreno donde dos ofertas de distinto tamaño se pueden comparar sin trampa. Dos arpillas de distinto peso son dos fracciones con distinto denominador, y comparar sus precios de lista es comparar cosas que no se corresponden. Llevarlas al kilo es lo mismo que llevar dos fracciones a un denominador común, y es también lo que hace cualquier comparador de precios cuando publica el precio por litro debajo del precio de la botella.</p>' +
      '<p>Dos razones son <strong>equivalentes</strong> cuando describen la misma proporción aunque estén escritas con números distintos, y se reconocen porque al simplificarlas por su divisor común quedan iguales. Esa simplificación tiene un uso práctico inmediato: reducir una razón a sus términos mínimos es la forma de escribirla en un reporte para que otro la entienda sin calculadora. Y una advertencia que vale para todo el bloque: las tasas no se promedian sumándolas y dividiendo entre cuántas son, porque cada una viene respaldada por una cantidad distinta de kilos. Promediar tasas exige ponderarlas, y ese será el error que veas disfrazado varias veces a lo largo de la guía.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Razón parte contra todo</div><div class="rform">' + frac('parte', 'total') + '</div><div class="rnote">Esta sí se vuelve porcentaje.</div></div>' +
        '<div class="rcard"><div class="rname">Razón parte contra parte</div><div class="rform">' + frac('una parte', 'la otra parte') + '</div><div class="rnote">El total no aparece por ningún lado.</div></div>' +
        '<div class="rcard"><div class="rname">Tasa unitaria</div><div class="rform">' + frac('precio', 'kilos') + '</div><div class="rnote">Lleva todo a una unidad.</div></div>' +
        '<div class="rcard"><div class="rname">Razón reducida</div><div class="rform">' + frac('a entre su divisor', 'b entre su divisor') + '</div><div class="rnote">La misma razón, legible.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Compras recibe dos ofertas de limón el mismo día. El primer huerto entrega la arpilla de ' + kilosEs(c1wA) + ' en ' + money(c1pA) + '; el segundo entrega la suya, de ' + kilosEs(c1wB) + ', en ' + money(c1pB) + '. Además, el jefe de recibo advierte que de cada ' + kilosEs(c1k) + ' que entran a la banda, uno se va a la merma.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El kilo del primer huerto sale en ' + money2(c1uA) + ', porque el precio de la arpilla se reparte entre los kilos que trae.<br>' +
      '<strong>Paso 2.</strong> El del segundo sale en ' + money2(c1uB) + ', y hasta este momento las dos ofertas no eran comparables.<br>' +
      '<strong>Paso 3.</strong> La diferencia es de ' + money2(c1dif) + ' por kilo, y la oferta que conviene deja el kilo en ' + money2(c1best) + '.<br>' +
      '<strong>Paso 4.</strong> La merma es una razón parte contra todo: uno de cada ' + intN(c1k) + ' kilos, es decir ' + pct2(c1merma) + ' de lo que entra, y no uno contra los ' + intN(c1k - 1) + ' que sí pasan.<br>' +
      '<strong>Lectura de negocio.</strong> Las dos arpillas están en razón de ' + ratioEs(c1wA, c1wB) + ' por su peso, así que sus precios de lista dicen muy poco por sí solos. Nota además que la merma se aplica sobre los kilos que se reciben y no sobre los que se venden, de modo que el costo real por kilo vendido es todavía mayor que el que acabas de calcular. Ese ajuste es el que separa un precio de compra de un costo de operación.</p></div>';
    return '' +
      '<div class="stag">Concept 1</div>' +
      '<h2>Ratios, rates and the unit rate</h2>' +
      '<p>This whole guide takes place inside a single company: Cítricos de Tecomán, a packing house that buys limes from the groves of the region, washes them, sorts them by size and sells them in boxes to supermarket chains and to an exporter. Each block sits you in a different chair of that company, the buying desk, production, costing and pricing. In all four the same problem turns up: comparing quantities that do not come on the same scale. That comparison is exactly what a ratio does, which is why the ratio is the most used tool in management and the one most often mistreated.</p>' +
      '<p>A <strong>ratio</strong> compares two quantities by division and not by difference. Saying that one sack weighs five kilos more than another is an additive comparison; saying that it weighs one and a half times the other is a comparison by ratio, and only the second survives a change of scale. It is worth separating two ways of building one from the start. A <strong>part to part</strong> ratio compares two pieces with each other, such as the fruit rejected against the fruit accepted. A <strong>part to whole</strong> ratio compares one piece with the complete set, and it is the only one that turns straight into a percentage. Confusing them is the most expensive mistake in this block precisely because it does not show: both are written the same way and both sound reasonable.</p>' +
      '<p>When the two quantities being compared carry different units, the ratio takes the name of <strong>rate</strong>: pesos per kilo, boxes per hour, kilos per box. The <strong>unit rate</strong> is that rate taken down to one unit of the denominator, and it is the only ground where two offers of different size can be compared without cheating. Two sacks of different weight are two fractions with different denominators, and comparing their list prices is comparing things that do not correspond to each other. Bringing them to the kilo is the same move as bringing two fractions to a common denominator, and it is also what any price comparison does when it prints the price per litre under the price of the bottle.</p>' +
      '<p>Two ratios are <strong>equivalent</strong> when they describe the same proportion even though they are written with different numbers, and you recognise them because dividing both terms by their common divisor leaves them identical. That reduction has an immediate practical use: taking a ratio down to its lowest terms is how you write it in a report so that somebody else understands it without a calculator. And one warning that holds for the whole block: rates are not averaged by adding them up and dividing by how many there are, because each one is backed by a different quantity of kilos. Averaging rates calls for weighting them, and that is the mistake you will meet in several disguises along the way.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Part to whole ratio</div><div class="rform">' + frac('part', 'total') + '</div><div class="rnote">This one becomes a percentage.</div></div>' +
        '<div class="rcard"><div class="rname">Part to part ratio</div><div class="rform">' + frac('one part', 'the other part') + '</div><div class="rnote">The total appears nowhere.</div></div>' +
        '<div class="rcard"><div class="rname">Unit rate</div><div class="rform">' + frac('price', 'kilos') + '</div><div class="rnote">Takes everything to one unit.</div></div>' +
        '<div class="rcard"><div class="rname">Reduced ratio</div><div class="rform">' + frac('a over its divisor', 'b over its divisor') + '</div><div class="rnote">The same ratio, made readable.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> The buying desk gets two offers of limes on the same day. The first grove delivers its sack of ' + kilosEn(c1wA) + ' for ' + money(c1pA) + '; the second delivers its own, of ' + kilosEn(c1wB) + ', for ' + money(c1pB) + '. On top of that, the receiving supervisor points out that of every ' + kilosEn(c1k) + ' that reach the belt, one goes to waste.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The kilo from the first grove comes to ' + money2(c1uA) + ', because the price of the sack is spread over the kilos it brings.<br>' +
      '<strong>Step 2.</strong> The one from the second comes to ' + money2(c1uB) + ', and until this moment the two offers were not comparable at all.<br>' +
      '<strong>Step 3.</strong> The difference is ' + money2(c1dif) + ' per kilo, and the offer that suits leaves the kilo at ' + money2(c1best) + '.<br>' +
      '<strong>Step 4.</strong> The waste is a part to whole ratio: one of every ' + intN(c1k) + ' kilos, that is ' + pct2(c1merma) + ' of what comes in, and not one against the ' + intN(c1k - 1) + ' that do pass.<br>' +
      '<strong>Business reading.</strong> The two sacks stand in a ratio of ' + ratioEn(c1wA, c1wB) + ' by weight, so their list prices say very little on their own. Notice as well that the waste applies to the kilos received and not to the kilos sold, so the real cost per kilo sold is higher still than the one you have just worked out. That adjustment is what separates a purchase price from an operating cost.</p></div>';
  });

  widgetRate(w1LA, w1WA, w1LB, w1WB);

  /* ── Item 1 ── */
  var s1pA = sackPrice(p1rA, p1wA), s1pB = sackPrice(p1rB, p1wB), s1pC = sackPrice(p1rC, p1wC);
  var s1uA = unitRate(s1pA, p1wA), s1uB = unitRate(s1pB, p1wB), s1uC = unitRate(s1pC, p1wC);
  var s1best = Math.min(s1uA, Math.min(s1uB, s1uC));
  var s1oth1 = (s1uA === s1best) ? s1uB : s1uA;
  var s1oth2 = (s1uC === s1best) ? s1uB : s1uC;
  if (s1oth1 === s1oth2) s1oth2 = (s1uB === s1best) ? s1uC : s1uB;
  var s1mean = plainMeanRate([s1uA, s1uB, s1uC]);
  var s1pool = pooledRate([s1pA, s1pB, s1pC], [p1wA, p1wB, p1wC]);
  var o1 = valOpts2(s1best, [s1oth1, s1oth2, s1mean], perKiloEs, perKiloEn, rng);
  var q1i = {
    title: { es: 'Tres arpillas que no se parecen en nada', en: 'Three sacks with nothing in common' },
    q: { es: 'El área de compras de Cítricos de Tecomán tiene tres ofertas de limón sobre el escritorio y ninguna viene en la misma presentación. El huerto de la sierra entrega la arpilla de ' + kilosEs(p1wA) + ' en ' + money(s1pA) + '. El de la costa entrega la suya, de ' + kilosEs(p1wB) + ', en ' + money(s1pB) + '. La sociedad de productores del valle entrega arpillas de ' + kilosEs(p1wC) + ' en ' + money(s1pC) + '. Toda la compra del día se hará con un solo proveedor y la compradora debe anotar en la orden el costo por kilo al que va a comprar. ¿Qué costo por kilo debe anotar?',
        en: 'The buying desk at Cítricos de Tecomán has three offers of limes on the table and none of them comes in the same presentation. The grove in the hills delivers its sack of ' + kilosEn(p1wA) + ' for ' + money(s1pA) + '. The one on the coast delivers its own, of ' + kilosEn(p1wB) + ', for ' + money(s1pB) + '. The growers society of the valley delivers sacks of ' + kilosEn(p1wC) + ' for ' + money(s1pC) + '. The whole purchase of the day will go to a single supplier and the buyer has to write on the order the cost per kilo she is buying at. Which cost per kilo should she write?' },
    opts: { es: o1.es, en: o1.en },
    hint: { es: 'Los tres precios que ves están escritos sobre denominadores distintos, así que tal como están no se pueden ordenar de menor a mayor. Lleva cada oferta al mismo terreno, el de un kilo, antes de decidir cuál gana. Y desconfía del atajo de promediar las tres cifras que obtengas: un promedio simple trataría a las tres arpillas como si pesaran lo mismo.',
            en: 'The three prices you see are written over different denominators, so as they stand they cannot be ranked from smallest to largest. Take every offer to the same ground, that of one kilo, before deciding which one wins. And be wary of the shortcut of averaging the three figures you get: a plain average would treat the three sacks as though they all weighed the same.' },
    exp: { es: 'La arpilla de la sierra deja el kilo en ' + money2(s1uA) + ', la de la costa en ' + money2(s1uB) + ' y la del valle en ' + money2(s1uC) + ', de modo que la oferta que conviene deja el kilo en ' + money2(s1best) + ' y esa es la cifra que va en la orden. Las otras dos tasas, ' + money2(s1oth1) + ' y ' + money2(s1oth2) + ', son respuestas a preguntas distintas: la arpilla más barata de la lista y la arpilla más pesada no tienen por qué ser la compra más barata, porque cada precio está escrito sobre un peso diferente. La opción de ' + money2(s1mean) + ' promedia las tres tasas como si cada proveedor pesara lo mismo en la compra; un promedio de tasas solo es válido ponderado por los kilos de cada uno, y de hecho el costo por kilo de comprarles a los tres en esas cantidades sería ' + money2(s1pool) + ', que tampoco coincide con el promedio simple. Compara siempre en el kilo, que es el denominador común de las tres ofertas.',
           en: 'The sack from the hills leaves the kilo at ' + money2(s1uA) + ', the one from the coast at ' + money2(s1uB) + ' and the one from the valley at ' + money2(s1uC) + ', so the offer that suits leaves the kilo at ' + money2(s1best) + ' and that is the figure that goes on the order. The other two rates, ' + money2(s1oth1) + ' and ' + money2(s1oth2) + ', answer different questions: the cheapest sack on the list and the heaviest sack need not be the cheapest purchase, because each price is written over a different weight. The option of ' + money2(s1mean) + ' averages the three rates as though every supplier weighed the same in the purchase; an average of rates is only valid when it is weighted by each one’s kilos, and in fact the cost per kilo of buying from all three in those quantities would be ' + money2(s1pool) + ', which does not match the plain average either. Always compare at the kilo, which is the common denominator of the three offers.' }
  };
  var d1 = mk(q1i, o1.correctIdx, true);
  problems.push({ i18n: d1.i18n, title: d1.title, questionText: d1.questionText, options: d1.options, correctIdx: d1.correctIdx, explanation: d1.explanation, hint: d1.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 2 ── */
  var s2whole = partOfWhole(1, p2k);
  var s2part  = 1 / p2k;
  var s2acc   = p2k / (p2k + 1);
  var o2 = shuffleOpts(
    ['Que la merma es ' + pct2(s2whole) + ' de la fruta que entra, porque la razón compara la parte rechazada con la parte aceptada y no con el total: de cada ' + kilosEs(p2k + 1) + ' que entran, uno se rechaza.',
     'Que la merma es ' + pct2(s2part) + ' de la fruta que entra, ya que la razón indicada se convierte en porcentaje dividiendo el primer término entre el segundo.',
     'Que la merma es ' + pct2(s2acc) + ' de la fruta que entra, porque el porcentaje se obtiene comparando la fruta aceptada con la rechazada.',
     'Que la razón no puede expresarse en porcentaje mientras no se conozcan los kilos que entraron a la banda durante el turno.'],
    ['That the waste is ' + pct2(s2whole) + ' of the fruit coming in, because the ratio compares the rejected part with the accepted part and not with the total: of every ' + kilosEn(p2k + 1) + ' coming in, one is rejected.',
     'That the waste is ' + pct2(s2part) + ' of the fruit coming in, since the stated ratio turns into a percentage by dividing the first term by the second.',
     'That the waste is ' + pct2(s2acc) + ' of the fruit coming in, because the percentage comes from comparing the accepted fruit with the rejected fruit.',
     'That the ratio cannot be expressed as a percentage until the kilos that reached the belt during the shift are known.'], rng);
  var q2i = {
    title: { es: 'La merma que el reporte anota mal', en: 'The waste the report gets wrong' },
    q: { es: 'El supervisor de la banda de selección reporta el turno con una sola frase: por cada kilo de limón que se rechaza por calibre o por daño, ' + kilosEs(p2k) + ' pasan al empaque. En el resumen que sube a dirección, el auxiliar traduce esa frase y escribe que la merma del turno fue de ' + pct2(s2part) + ' de la fruta recibida. La jefa de planta le pide que revise la traducción antes de enviarla. ¿Qué debe decir el resumen?',
        en: 'The supervisor of the sorting belt reports the shift in a single sentence: for every kilo of limes rejected for size or damage, ' + kilosEn(p2k) + ' go through to packing. In the summary that goes up to management, the assistant translates that sentence and writes that the waste for the shift was ' + pct2(s2part) + ' of the fruit received. The plant manager asks him to check the translation before sending it. What should the summary say?' },
    opts: { es: o2.es, en: o2.en },
    hint: { es: 'Escribe primero cuántos kilos representa un lote completo si se cumple justo esa relación: cuenta el kilo rechazado y también los que pasan. Un porcentaje siempre cuelga del total, así que el denominador que necesitas es la suma de las dos partes y no una de ellas. Fíjate en que la frase del supervisor compara una parte con otra parte, no una parte con el conjunto.',
            en: 'Write down first how many kilos a complete batch amounts to if that relation holds exactly: count the rejected kilo and also the ones that pass. A percentage always hangs from the total, so the denominator you need is the sum of the two parts and not one of them. Notice that the supervisor’s sentence compares one part with another part, not a part with the set.' },
    exp: { es: 'La frase del supervisor es una razón parte contra parte: un kilo rechazado por cada ' + kilosEs(p2k) + ' aceptados. Para volverla porcentaje hay que compararla contra el total, y el total es la suma de las dos partes, ' + kilosEs(p2k + 1) + ', de modo que la merma real es ' + pct2(s2whole) + '. La cifra de ' + pct2(s2part) + ' que escribió el auxiliar divide el rechazo entre lo aceptado y no entre lo recibido, así que reporta una merma inflada; con las cantidades de esta planta esa diferencia se traduce en fruta que aparece perdida en el papel y no en la bodega. La opción de ' + pct2(s2acc) + ' es la proporción de fruta que sí pasó, es decir el complemento, y anunciarla como merma invierte el sentido del indicador. Y la que exige conocer los kilos del turno pide un dato que no hace falta: una razón ya trae la comparación dentro, y por eso puede volverse porcentaje sin conocer ninguna cantidad absoluta.',
           en: 'The supervisor’s sentence is a part to part ratio: one kilo rejected for every ' + kilosEn(p2k) + ' accepted. To turn it into a percentage it has to be compared against the total, and the total is the sum of both parts, ' + kilosEn(p2k + 1) + ', so the real waste is ' + pct2(s2whole) + '. The figure of ' + pct2(s2part) + ' the assistant wrote divides the rejection by what was accepted rather than by what was received, so it reports an inflated waste; at this plant’s volumes that difference turns into fruit that shows up as lost on paper and not in the warehouse. The option of ' + pct2(s2acc) + ' is the proportion of fruit that did pass, that is, the complement, and announcing it as waste turns the indicator upside down. And the one demanding the kilos of the shift asks for data that is not needed: a ratio already carries the comparison inside it, which is why it becomes a percentage without knowing any absolute quantity.' }
  };
  var d2 = mk(q2i, o2.correctIdx, false);
  problems.push({ i18n: d2.i18n, title: d2.title, questionText: d2.questionText, options: d2.options, correctIdx: d2.correctIdx, explanation: d2.explanation, hint: d2.hint, showWork: false, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPT 2 ═══════════════════════ */
  var c2need = kilosNeeded(c2q, c2kg, c2y);
  var c2waste = wasteKilos(c2q, c2kg, c2y);
  var c2const = c2kg / c2y;
  var c2hrs2 = inverseHours(c2w, c2h, c2w2);
  var c2bad2 = directHours(c2w, c2h, c2w2);

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 2</div>' +
      '<h2>Proporciones: la regla de tres directa y la inversa</h2>' +
      '<p>Una <strong>proporción</strong> es la igualdad de dos razones. Escribirla es afirmar algo fuerte sobre el negocio: que la relación entre dos cantidades se mantiene cuando las dos cambian de tamaño. De esa igualdad sale la regla del producto cruzado, que es el mecanismo detrás de la regla de tres, y es también la razón por la que una proporción se puede resolver por cualquiera de sus cuatro esquinas. La parte mecánica se aprende en diez minutos; la parte que se cobra en una empresa es decidir si la proporción existe.</p>' +
      '<p>En la <strong>proporcionalidad directa</strong> lo que permanece constante es el cociente entre las dos cantidades. Si el pedido se duplica, los kilos de fruta se duplican, y ese cociente fijo tiene nombre: la <strong>constante de proporcionalidad</strong>, que en la planta es simplemente cuántos kilos hay que recibir por cada caja armada. Dibujada, una relación directa es una recta que pasa por el origen, y la constante es su pendiente. Que pase por el origen no es un detalle geométrico: significa que sin pedido no hay consumo, y en cuanto aparece un consumo fijo que existe aunque no se produzca nada, la recta se despega del origen y la regla de tres deja de valer.</p>' +
      '<p>En la <strong>proporcionalidad inversa</strong> lo que permanece constante es el producto. El caso clásico es el trabajo: un lote pide una cierta cantidad de horas de empacador, y esas horas se reparten entre quienes las tomen, así que al doble de gente le corresponde la mitad del tiempo. Dibujada, la relación es una curva que se acerca a los ejes sin tocarlos, y esa forma dice algo que conviene leer con cuidado: por más manos que se agreguen el tiempo nunca llega a cero, y cada trabajador adicional recorta menos tiempo que el anterior. Confundir la inversa con la directa produce respuestas que además de equivocadas apuntan en la dirección contraria, y es un error que se detecta antes de calcular, con solo preguntarse si el resultado debería subir o bajar.</p>' +
      '<p>Queda la advertencia más importante del bloque: la regla de tres es un modelo y no una ley de la naturaleza. Solo aplica dentro del rango donde la relación se sostiene. Duplicar los empacadores no sirve de nada si la línea tiene un número fijo de puestos, y triplicar el pedido no triplica el flete si el camión ya iba a viajar. Antes de multiplicar conviene preguntar qué cambia cuando la cantidad crece y qué se queda quieto, porque todo lo que se queda quieto rompe la proporción.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Proporción</div><div class="rform">' + frac('a', 'b') + ' igual a ' + frac('c', 'd') + '</div><div class="rnote">De ahí sale el producto cruzado.</div></div>' +
        '<div class="rcard"><div class="rname">Directa</div><div class="rform">cociente constante</div><div class="rnote">Recta que sale del origen.</div></div>' +
        '<div class="rcard"><div class="rname">Inversa</div><div class="rform">producto constante</div><div class="rnote">Curva que no toca los ejes.</div></div>' +
        '<div class="rcard"><div class="rname">Constante de la planta</div><div class="rform">' + frac('kilos recibidos', 'caja armada') + '</div><div class="rnote">Ya trae la merma dentro.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> El exportador pide ' + boxesEs(c2q) + ' de limón, cada una con ' + kilosEs(c2kg) + ' de fruta que cumple el estándar de exportación, y en la banda solo ' + pct0(c2y) + ' de la fruta que entra alcanza ese estándar. En la línea de empaque, ' + packersEs(c2w) + ' arman ese lote en ' + hoursEs(c2h) + ', y para el siguiente turno la jefa de planta puede poner ' + packersEs(c2w2) + '.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> Cada caja obliga a recibir ' + dec2(c2const) + ' kilos, porque parte de lo que entra no llega a la caja.<br>' +
      '<strong>Paso 2.</strong> El pedido completo exige recibir ' + kilosEs(c2need) + ', de los cuales ' + kilosEs(c2waste) + ' se quedan en el piso de la banda.<br>' +
      '<strong>Paso 3.</strong> Esa primera relación es directa: al doble de cajas le corresponde el doble de kilos, y el cociente entre kilos y cajas no se mueve.<br>' +
      '<strong>Paso 4.</strong> El tiempo va al revés. El lote pide ' + intN(c2w * c2h) + ' horas de empacador, así que con ' + packersEs(c2w2) + ' baja a ' + hoursEs(c2hrs2) + ' y no sube a ' + hoursEs(c2bad2) + ', que es lo que daría tratar este caso como directo.<br>' +
      '<strong>Lectura de negocio.</strong> Las dos preguntas nacen del mismo pedido y obedecen a reglas opuestas, y el único modo de no confundirlas es preguntar qué cantidad se mantiene fija. En la compra se mantiene fijo el cociente; en el trabajo se mantiene fijo el producto. Nota además que la segunda respuesta vale mientras haya puesto y fruta para todos: el modelo inverso tiene un límite físico que el álgebra no conoce.</p></div>';
    return '' +
      '<div class="stag">Concept 2</div>' +
      '<h2>Proportions: the direct rule of three and the inverse one</h2>' +
      '<p>A <strong>proportion</strong> is the equality of two ratios. Writing one down is making a strong claim about the business: that the relation between two quantities holds as both change size. Out of that equality comes the cross product rule, which is the machinery behind the rule of three, and it is also why a proportion can be solved from any of its four corners. The mechanical part is learned in ten minutes; the part a company pays for is deciding whether the proportion exists at all.</p>' +
      '<p>In <strong>direct proportionality</strong> what stays constant is the quotient of the two quantities. If the order doubles, the kilos of fruit double, and that fixed quotient has a name: the <strong>constant of proportionality</strong>, which at the plant is simply how many kilos have to be received for every box built. Drawn, a direct relation is a straight line through the origin, and the constant is its slope. Passing through the origin is no geometric detail: it means that with no order there is no consumption, and the moment a fixed consumption appears that exists even when nothing is produced, the line leaves the origin and the rule of three stops holding.</p>' +
      '<p>In <strong>inverse proportionality</strong> what stays constant is the product. The classic case is work: a batch asks for a certain quantity of packer hours, and those hours are shared out among whoever takes them on, so twice the people get half the time. Drawn, the relation is a curve that approaches the axes without touching them, and that shape says something worth reading carefully: however many hands are added the time never reaches zero, and each extra worker cuts less time than the one before. Confusing the inverse with the direct produces answers that are not only wrong but point the wrong way, and it is a mistake you can catch before calculating, just by asking whether the result ought to rise or fall.</p>' +
      '<p>One warning remains, and it is the most important of the block: the rule of three is a model and not a law of nature. It applies only inside the range where the relation holds. Doubling the packers is useless if the line has a fixed number of posts, and tripling the order does not triple the freight if the truck was going to travel anyway. Before multiplying it is worth asking what changes when the quantity grows and what stays still, because everything that stays still breaks the proportion.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Proportion</div><div class="rform">' + frac('a', 'b') + ' equals ' + frac('c', 'd') + '</div><div class="rnote">The cross product comes from here.</div></div>' +
        '<div class="rcard"><div class="rname">Direct</div><div class="rform">constant quotient</div><div class="rnote">A line out of the origin.</div></div>' +
        '<div class="rcard"><div class="rname">Inverse</div><div class="rform">constant product</div><div class="rnote">A curve that misses the axes.</div></div>' +
        '<div class="rcard"><div class="rname">Constant of the plant</div><div class="rform">' + frac('kilos received', 'box built') + '</div><div class="rnote">Waste is already inside it.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> The exporter orders ' + boxesEn(c2q) + ' of limes, each with ' + kilosEn(c2kg) + ' of fruit meeting the export standard, and on the belt only ' + pct0(c2y) + ' of the fruit coming in reaches that standard. On the packing line, ' + packersEn(c2w) + ' build that batch in ' + hoursEn(c2h) + ', and for the next shift the plant manager can put ' + packersEn(c2w2) + ' on it.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> Every box forces ' + dec2(c2const) + ' kilos to be received, because part of what comes in never reaches a box.<br>' +
      '<strong>Step 2.</strong> The whole order calls for ' + kilosEn(c2need) + ' to come in, of which ' + kilosEn(c2waste) + ' stay on the floor of the belt.<br>' +
      '<strong>Step 3.</strong> That first relation is direct: twice the boxes get twice the kilos, and the quotient between kilos and boxes does not move.<br>' +
      '<strong>Step 4.</strong> Time runs the other way. The batch asks for ' + intN(c2w * c2h) + ' packer hours, so with ' + packersEn(c2w2) + ' it falls to ' + hoursEn(c2hrs2) + ' and does not rise to ' + hoursEn(c2bad2) + ', which is what treating this case as a direct one would give.<br>' +
      '<strong>Business reading.</strong> Both questions are born of the same order and obey opposite rules, and the only way not to mix them up is asking which quantity stays fixed. In the purchase the quotient stays fixed; in the work the product does. Notice as well that the second answer holds while there is a post and fruit for everybody: the inverse model has a physical limit the algebra knows nothing about.</p></div>';
  });

  widgetProportion(w2q, w2kg, w2y, w2w, w2wh);

  /* ── Item 3 ── */
  var s3need = kilosNeeded(p3q2, p3kg, p3y);
  var s3noWaste = p3q2 * p3kg;
  var s3times   = p3q2 * p3kg * p3y;
  var s3old     = kilosNeeded(p3q1, p3kg, p3y);
  var o3 = valOpts2(s3need, [s3noWaste, s3times, s3old], kilosEs, kilosEn, rng);
  var q3i = {
    title: { es: 'La fruta que hay que comprar para el pedido nuevo', en: 'The fruit to buy for the new order' },
    q: { es: 'El exportador amplía su pedido semanal de ' + boxesEs(p3q1) + ' a ' + boxesEs(p3q2) + '. Cada caja se arma con ' + kilosEs(p3kg) + ' de limón que cumple el estándar de exportación, y en la banda de selección solo ' + pct0(p3y) + ' de la fruta que entra alcanza ese estándar; el resto se vende como limón nacional de segunda y no sirve para estas cajas. La compradora tiene que cerrar hoy con los huertos el volumen de fruta que va a recibir la planta para surtir el pedido ampliado. ¿Cuántos kilos debe contratar?',
        en: 'The exporter raises its weekly order from ' + boxesEn(p3q1) + ' to ' + boxesEn(p3q2) + '. Every box is built with ' + kilosEn(p3kg) + ' of limes meeting the export standard, and on the sorting belt only ' + pct0(p3y) + ' of the fruit coming in reaches that standard; the rest is sold as second grade domestic limes and is no use for these boxes. The buyer has to close today with the groves the volume of fruit the plant will receive to fill the enlarged order. How many kilos should she contract?' },
    opts: { es: o3.es, en: o3.en },
    hint: { es: 'Empieza por los kilos que van a salir dentro de las cajas del pedido nuevo, que es una cuenta directa. Después pregúntate si esos kilos son los que entran a la planta o los que sobreviven a la selección, y ajusta en el sentido correcto: si solo una parte de lo que entra sirve, lo que hay que recibir tiene que ser más y no menos. Fíjate también en cuál de los dos pedidos es el que se va a surtir.',
            en: 'Start from the kilos that will leave inside the boxes of the new order, which is a direct calculation. Then ask yourself whether those kilos are the ones entering the plant or the ones surviving the sorting, and adjust in the right direction: if only part of what comes in is usable, what has to be received must be more and not less. Notice as well which of the two orders is the one being filled.' },
    exp: { es: 'Las ' + boxesEs(p3q2) + ' del pedido nuevo llevan ' + kilosEs(s3noWaste) + ' dentro de las cajas, pero esos son los kilos que salen, no los que entran. Como solo ' + pct0(p3y) + ' de la fruta recibida pasa el estándar, cada kilo empacado exige recibir más de un kilo, y el volumen que hay que contratar es ' + kilosEs(s3need) + '. La opción de ' + kilosEs(s3noWaste) + ' es justamente la que olvida la selección y deja a la planta corta de fruta a media semana. La de ' + kilosEs(s3times) + ' aplica el rendimiento en el sentido contrario, multiplicando en lugar de dividir, y produce una cifra todavía menor que los kilos que hay que empacar, lo cual ya es imposible antes de hacer ninguna cuenta. Y la de ' + kilosEs(s3old) + ' resuelve bien el problema pero para el pedido anterior de ' + boxesEs(p3q1) + '. Nota que la relación entre cajas y kilos es directa y por eso basta una constante, ' + dec2(p3kg / p3y) + ' kilos por caja, que ya trae la merma incorporada.',
           en: 'The ' + boxesEn(p3q2) + ' of the new order carry ' + kilosEn(s3noWaste) + ' inside the boxes, but those are the kilos that leave, not the ones that come in. Since only ' + pct0(p3y) + ' of the fruit received passes the standard, every kilo packed calls for more than a kilo received, and the volume to contract is ' + kilosEn(s3need) + '. The option of ' + kilosEn(s3noWaste) + ' is precisely the one that forgets the sorting and leaves the plant short of fruit by midweek. The one of ' + kilosEn(s3times) + ' applies the yield the wrong way round, multiplying instead of dividing, and produces a figure smaller than the kilos that have to be packed, which is impossible before any calculation at all. And the one of ' + kilosEn(s3old) + ' solves the problem properly but for the previous order of ' + boxesEn(p3q1) + '. Notice that the relation between boxes and kilos is direct, which is why one constant is enough, ' + dec2(p3kg / p3y) + ' kilos per box, with the waste already built into it.' }
  };
  var d3 = mk(q3i, o3.correctIdx, true);
  problems.push({ i18n: d3.i18n, title: d3.title, questionText: d3.questionText, options: d3.options, correctIdx: d3.correctIdx, explanation: d3.explanation, hint: d3.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 4 ── */
  var p4w2 = p4w1 + p4add;
  var s4ok    = inverseHours(p4w1, p4h, p4w2);
  var s4dir   = directHours(p4w1, p4h, p4w2);
  var s4share = p4h * (1 - p4add / p4w1);
  var s4sub   = p4h - p4add;
  var o4 = valOpts2(s4ok, [s4dir, s4share, s4sub], hoursEs, hoursEn, rng);
  var q4i = {
    title: { es: 'La cuadrilla que crece antes del turno', en: 'The crew that grows before the shift' },
    q: { es: 'El lote de limón que hoy tomó la línea de empaque lo terminaron ' + packersEs(p4w1) + ' en ' + hoursEs(p4h) + '. Mañana llega un lote del mismo tamaño y con la misma fruta, y la jefa de planta puede asignarle ' + packersEs(p4w2) + ', todos con la misma capacitación y con puesto disponible en la línea. Necesita avisarle al transportista a qué hora estará listo el embarque. ¿En cuánto tiempo saldrá el lote de mañana?',
        en: 'The batch of limes the packing line took today was finished by ' + packersEn(p4w1) + ' in ' + hoursEn(p4h) + '. Tomorrow a batch of the same size and the same fruit arrives, and the plant manager can assign ' + packersEn(p4w2) + ' to it, all with the same training and with a post available on the line. She needs to tell the carrier when the shipment will be ready. How long will tomorrow’s batch take?' },
    opts: { es: o4.es, en: o4.en },
    hint: { es: 'Antes de calcular decide en qué dirección debe moverse la respuesta: con más manos el lote no puede tardar más. Piensa después en la cantidad de trabajo que el lote exige, que no cambia de un día a otro aunque cambie la gente, y en cómo se reparte esa cantidad entre quienes la toman. Ahí verás que lo que se mantiene fijo es un producto y no un cociente.',
            en: 'Before calculating, decide which way the answer has to move: with more hands the batch cannot take longer. Then think about the quantity of work the batch demands, which does not change from one day to the next even though the people do, and about how that quantity is shared among whoever takes it on. There you will see that what stays fixed is a product and not a quotient.' },
    exp: { es: 'El lote pide ' + intN(p4w1 * p4h) + ' horas de empacador, y esa cantidad de trabajo no cambia porque llegue más gente: lo que cambia es entre cuántos se reparte. Con ' + packersEs(p4w2) + ' el lote sale en ' + hoursEs(s4ok) + '. La opción de ' + hoursEs(s4dir) + ' aplica una regla de tres directa y hace que el lote tarde más entre más manos lo tomen, un resultado que se descarta sin calcular nada. La de ' + hoursEs(s4share) + ' supone que el tiempo baja en la misma proporción en que creció la cuadrilla, es decir confunde el aumento relativo de la gente con la reducción relativa del tiempo, que son proporciones distintas porque cuelgan de bases distintas. La de ' + hoursEs(s4sub) + ' resta una hora por cada empacador agregado, tratando como aditiva una relación que es multiplicativa. Vale la pena notar que esta respuesta supone que hay puesto y fruta para los ' + packersEs(p4w2) + ': el modelo inverso deja de valer en cuanto la línea se satura.',
           en: 'The batch asks for ' + intN(p4w1 * p4h) + ' packer hours, and that quantity of work does not change because more people arrive: what changes is how many share it. With ' + packersEn(p4w2) + ' the batch comes out in ' + hoursEn(s4ok) + '. The option of ' + hoursEn(s4dir) + ' applies a direct rule of three and makes the batch take longer the more hands take it on, a result you can discard without calculating anything. The one of ' + hoursEn(s4share) + ' assumes the time falls in the same proportion in which the crew grew, that is, it confuses the relative rise in people with the relative cut in time, which are different proportions because they hang from different bases. The one of ' + hoursEn(s4sub) + ' takes off one hour for every packer added, treating as additive a relation that is multiplicative. It is worth noting that this answer assumes there is a post and fruit for all ' + packersEn(p4w2) + ': the inverse model stops holding the moment the line saturates.' }
  };
  var d4 = mk(q4i, o4.correctIdx, true);
  problems.push({ i18n: d4.i18n, title: d4.title, questionText: d4.questionText, options: d4.options, correctIdx: d4.correctIdx, explanation: d4.explanation, hint: d4.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPT 3 ═══════════════════════ */
  var c3tot = c3a + c3b + c3c;
  var c3fac = allocFactor(c3F, c3tot);
  var c3sa  = allocShare(c3F, c3a, c3tot);
  var c3sb  = allocShare(c3F, c3b, c3tot);
  var c3sc  = allocShare(c3F, c3c, c3tot);
  var c3eq  = equalShare(c3F, 3);

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 3</div>' +
      '<h2>Reparto proporcional: repartir un costo que es de todos</h2>' +
      '<p>Muchas cantidades de una empresa no nacen asignadas a nadie. El flete de un camión consolidado, la renta de la bodega, la energía de la cámara de frío y la utilidad de un ejercicio son montos únicos que después hay que repartir entre clientes, entre productos o entre socios. La aritmética del <strong>reparto proporcional</strong> es corta: se elige una base, se suman todas las bases, se divide el monto entre esa suma y el resultado se multiplica por la base de cada quien.</p>' +
      '<p>El cociente entre el monto y el total de la base se llama <strong>factor de reparto</strong> o constante de reparto, y conviene calcularlo siempre porque tiene significado propio: es lo que cuesta una unidad de la base, por ejemplo un peso de flete por kilo embarcado. Con el factor en la mano, cada parte se obtiene con una sola multiplicación, y hay una verificación que nunca debe saltarse: las partes tienen que sumar exactamente el monto original. Si no cierra, el error está en la base o en el redondeo, y en ambos casos el reporte todavía no está listo.</p>' +
      '<p>La elección de la base es la única decisión difícil, y no es aritmética sino de negocio. Un flete puede repartirse por kilos, por número de paradas, por valor facturado o por metros cúbicos ocupados, y cada base produce números distintos que son todos correctos dentro de su propia lógica. Repartir en <strong>partes iguales</strong> también es una regla, aunque casi nunca se anuncia como tal: equivale a decir que la base es uno por cabeza. No es una regla neutral, es la que más le cobra a quien menos usa el recurso, y por eso hay que sostenerla con un argumento o abandonarla.</p>' +
      '<p>Existe además el <strong>reparto inversamente proporcional</strong>, que reparte más a quien menos tiene de la base, y aparece en incentivos y en subsidios cruzados. Se resuelve como el directo pero tomando como base el recíproco de cada cantidad. Sea cual sea el caso, el reparto solo es defendible si la base se declara por escrito antes de conocer los montos: elegir la base después de ver los números deja de ser aritmética y empieza a ser negociación.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Factor de reparto</div><div class="rform">' + frac('monto por repartir', 'total de la base') + '</div><div class="rnote">Lo que cuesta una unidad.</div></div>' +
        '<div class="rcard"><div class="rname">Parte de cada quien</div><div class="rform">factor por su base</div><div class="rnote">Una sola multiplicación.</div></div>' +
        '<div class="rcard"><div class="rname">Verificación</div><div class="rform">las partes suman el monto</div><div class="rnote">Si no cierra, algo falta.</div></div>' +
        '<div class="rcard"><div class="rname">Partes iguales</div><div class="rform">' + frac('monto', 'número de partes') + '</div><div class="rnote">También es una base elegida.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Cítricos de Tecomán consolidó en un camión el limón de tres clientes y recibió una factura de flete de ' + money(c3F) + '. El primer cliente embarcó ' + kilosEs(c3a) + ', el segundo ' + kilosEs(c3b) + ' y el tercero ' + kilosEs(c3c) + '. El contrato dice que el flete se prorratea por kilos embarcados.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El camión llevó ' + kilosEs(c3tot) + ' en total, que es la base sobre la que se reparte.<br>' +
      '<strong>Paso 2.</strong> El factor de reparto es ' + money2(c3fac) + ' por kilo embarcado.<br>' +
      '<strong>Paso 3.</strong> Multiplicando por los kilos de cada uno, las partes quedan en ' + money2(c3sa) + ', ' + money2(c3sb) + ' y ' + money2(c3sc) + '.<br>' +
      '<strong>Paso 4.</strong> Las tres partes suman ' + money2(c3sa + c3sb + c3sc) + ', que es exactamente la factura: el reparto cierra.<br>' +
      '<strong>Lectura de negocio.</strong> En partes iguales cada cliente pagaría ' + money2(c3eq) + ', y basta comparar esa cifra con las tres anteriores para ver a quién beneficia cada regla. Nota que el factor no es un precio de mercado sino el resultado de una división, de modo que baja para todos cuando el camión viaja lleno; conseguir un cuarto cliente para el mismo viaje le rebaja el flete a los tres que ya estaban.</p></div>';
    return '' +
      '<div class="stag">Concept 3</div>' +
      '<h2>Proportional allocation: sharing out a cost that belongs to everybody</h2>' +
      '<p>Many quantities in a company are born assigned to nobody. The freight of a consolidated truck, the warehouse rent, the power of the cold room and the profit of a financial year are single amounts that afterwards have to be shared among customers, among products or among partners. The arithmetic of <strong>proportional allocation</strong> is short: choose a base, add up all the bases, divide the amount by that sum and multiply the result by each party’s base.</p>' +
      '<p>The quotient of the amount by the total of the base is called the <strong>allocation factor</strong>, and it is worth working out every time because it means something on its own: it is what one unit of the base costs, for instance one peso of freight per kilo shipped. With the factor in hand, each share comes from a single multiplication, and there is one check that must never be skipped: the shares have to add up to exactly the original amount. If it does not close, the error is in the base or in the rounding, and in either case the report is not ready yet.</p>' +
      '<p>Choosing the base is the only hard decision, and it is not an arithmetic one but a business one. Freight can be shared by kilos, by number of stops, by invoiced value or by cubic metres occupied, and every base produces different numbers that are all correct inside their own logic. Splitting into <strong>equal parts</strong> is a rule as well, although it is almost never announced as one: it amounts to saying that the base is one per head. It is not a neutral rule, it is the one that charges most to whoever uses the resource least, and that is why it has to be defended with an argument or dropped.</p>' +
      '<p>There is also <strong>inversely proportional allocation</strong>, which gives more to whoever has less of the base, and it turns up in incentives and cross subsidies. It is solved like the direct one but taking the reciprocal of each quantity as the base. Whatever the case, an allocation is only defensible if the base is stated in writing before the amounts are known: choosing the base after seeing the numbers stops being arithmetic and starts being negotiation.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Allocation factor</div><div class="rform">' + frac('amount to share', 'total of the base') + '</div><div class="rnote">What one unit costs.</div></div>' +
        '<div class="rcard"><div class="rname">Each party’s share</div><div class="rform">factor times its base</div><div class="rnote">A single multiplication.</div></div>' +
        '<div class="rcard"><div class="rname">The check</div><div class="rform">shares add up to the amount</div><div class="rnote">If it does not close, something is missing.</div></div>' +
        '<div class="rcard"><div class="rname">Equal parts</div><div class="rform">' + frac('amount', 'number of parts') + '</div><div class="rnote">Also a chosen base.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> Cítricos de Tecomán consolidated the limes of three customers into one truck and received a single freight invoice of ' + money(c3F) + '. The first customer shipped ' + kilosEn(c3a) + ', the second ' + kilosEn(c3b) + ' and the third ' + kilosEn(c3c) + '. The contract says freight is prorated by kilos shipped.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The truck carried ' + kilosEn(c3tot) + ' in total, which is the base the cost is shared over.<br>' +
      '<strong>Step 2.</strong> The allocation factor is ' + money2(c3fac) + ' per kilo shipped.<br>' +
      '<strong>Step 3.</strong> Multiplying by each one’s kilos, the shares come to ' + money2(c3sa) + ', ' + money2(c3sb) + ' and ' + money2(c3sc) + '.<br>' +
      '<strong>Step 4.</strong> The three shares add up to ' + money2(c3sa + c3sb + c3sc) + ', which is exactly the invoice: the allocation closes.<br>' +
      '<strong>Business reading.</strong> Split into equal parts each customer would pay ' + money2(c3eq) + ', and comparing that figure with the three above is enough to see whom each rule favours. Notice that the factor is not a market price but the result of a division, so it falls for everybody when the truck travels full; finding a fourth customer for the same trip lowers the freight for the three who were already on it.</p></div>';
  });

  widgetAllocation(w3F, w3a, w3b, w3c);

  /* ── Item 5 ── */
  var s5tot  = p5a + p5b + p5c;
  var s5ok   = allocShare(p5F, p5a, s5tot);
  var s5stop = allocShare(p5F, p5sa, p5sa + p5sb + p5sc);
  var s5eq   = equalShare(p5F, 3);
  var s5part = allocShare(p5F, p5a, p5a + p5b);
  var o5 = valOpts(s5ok, [s5stop, s5eq, s5part], money2, rng);
  var q5i = {
    title: { es: 'El flete del camión que llevó tres pedidos', en: 'The freight of the truck that carried three orders' },
    q: { es: 'Cítricos de Tecomán consolidó en un camión el limón de tres clientes y recibió una sola factura de flete por ' + money(p5F) + '. La cadena regional embarcó ' + kilosEs(p5a) + ' y recibe su mercancía en ' + stopsEs(p5sa) + '; la central de abastos embarcó ' + kilosEs(p5b) + ' en ' + stopsEs(p5sb) + '; el mayorista del puerto embarcó ' + kilosEs(p5c) + ' en ' + stopsEs(p5sc) + '. El contrato firmado con los tres dice que el flete se prorratea entre ellos según los kilos embarcados. ¿Cuánto flete debe facturarse a la cadena regional?',
        en: 'Cítricos de Tecomán consolidated the limes of three customers into one truck and received a single freight invoice of ' + money(p5F) + '. The regional chain shipped ' + kilosEn(p5a) + ' and takes delivery over ' + stopsEn(p5sa) + '; the wholesale market shipped ' + kilosEn(p5b) + ' over ' + stopsEn(p5sb) + '; the port wholesaler shipped ' + kilosEn(p5c) + ' over ' + stopsEn(p5sc) + '. The contract signed with all three says the freight is prorated among them according to the kilos shipped. How much freight should be invoiced to the regional chain?' },
    opts: { es: o5.es, en: o5.en },
    hint: { es: 'Antes de repartir, arma la base completa: el reparto se hace sobre todo lo que viajó en el camión y no sobre una parte de ello. Conviene calcular primero cuánto cuesta un kilo de flete, porque esa cifra sirve para los tres clientes y además permite comprobar el resultado. Ten cuidado con los datos que el contrato no menciona como base.',
            en: 'Before sharing anything out, build the full base: the allocation runs over everything that travelled in the truck and not over part of it. It is worth working out first what one kilo of freight costs, because that figure serves all three customers and also lets you check the result. Be careful with the data the contract does not name as the base.' },
    exp: { es: 'El camión llevó ' + kilosEs(s5tot) + ' en total, así que el factor de reparto es ' + money2(allocFactor(p5F, s5tot)) + ' por kilo y a la cadena regional le corresponden ' + money2(s5ok) + '; las tres partes juntas devuelven exactamente los ' + money(p5F) + ' de la factura, que es la verificación obligada. La opción de ' + money2(s5stop) + ' reparte por paradas en lugar de kilos: es un criterio defendible en otro contrato, pero no en este, y elegir la base después de ver los números es justamente lo que el contrato firmado impide. La de ' + money2(s5eq) + ' divide el flete en tres partes iguales y le cobra lo mismo al que embarcó ' + kilosEs(p5a) + ' que al que embarcó ' + kilosEs(p5c) + '. Y la de ' + money2(s5part) + ' deja fuera de la base al tercer cliente, con lo que las partes ya no suman la factura y alguien termina pagando de más.',
           en: 'The truck carried ' + kilosEn(s5tot) + ' in total, so the allocation factor is ' + money2(allocFactor(p5F, s5tot)) + ' per kilo and the regional chain is charged ' + money2(s5ok) + '; the three shares together give back exactly the ' + money(p5F) + ' of the invoice, which is the check that must be run. The option of ' + money2(s5stop) + ' allocates by stops rather than kilos: it is a defensible criterion in another contract, but not in this one, and choosing the base after seeing the numbers is exactly what the signed contract prevents. The one of ' + money2(s5eq) + ' divides the freight into three equal parts and charges the customer who shipped ' + kilosEn(p5a) + ' the same as the one who shipped ' + kilosEn(p5c) + '. And the one of ' + money2(s5part) + ' leaves the third customer out of the base, so the shares no longer add up to the invoice and somebody ends up paying too much.' }
  };
  var d5 = mk(q5i, o5.correctIdx, true);
  problems.push({ i18n: d5.i18n, title: d5.title, questionText: d5.questionText, options: d5.options, correctIdx: d5.correctIdx, explanation: d5.explanation, hint: d5.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPT 4 ═══════════════════════ */
  var c4pn = netOfTax(c4pf, IVA);
  var c4mp = marginOnPrice(c4pn, c4c);
  var c4mc = markupOnCost(c4pn, c4c);
  var c4list = listFromInvoice(c4pf * c4k, IVA, c4d);
  var c4bad  = c4pf * c4k * (1 - IVA) * (1 + c4d);

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 4</div>' +
      '<h2>Porcentajes: la base, la variación y los dos márgenes</h2>' +
      '<p>Un <strong>porcentaje</strong> es una razón parte contra todo escrita con cien en el denominador, y esa es toda su definición. Su utilidad viene de que todo el mundo lo lee sin explicación; su peligro viene de que casi nunca dice de qué cantidad cuelga. Un porcentaje sin base declarada no es información, es una impresión, y la mayor parte de los errores de este bloque se resuelven con una sola pregunta escrita en el margen del reporte: por ciento de qué.</p>' +
      '<p>La <strong>variación porcentual</strong> compara el cambio contra el punto de partida, no contra el punto de llegada. Esa asimetría explica un hecho que sorprende cada vez que aparece: un aumento y una disminución del mismo porcentaje no se cancelan, porque el segundo porcentaje se aplica a una cantidad distinta de la del primero. Lo mismo ocurre con varios cambios encadenados, que se multiplican como factores en lugar de sumarse. Un aumento del diez por ciento es multiplicar por uno punto uno, y encadenar cambios es multiplicar factores; en cuanto se ve así, la aritmética deja de dar sorpresas.</p>' +
      '<p>Deshacer un porcentaje es la operación que más se equivoca en la práctica. Si un precio ya trae el impuesto incluido, el precio sin impuesto no se obtiene restando ese mismo porcentaje, sino dividiendo entre el factor con el que se aplicó. Restar y dividir dan resultados parecidos cuando el porcentaje es pequeño, y esa cercanía es justamente lo que mantiene vivo el error durante años en una hoja de cálculo. El <strong>porcentaje inverso</strong> aparece en cada factura con impuesto incluido, en cada precio de anaquel con descuento y en cada cotización que hay que reconstruir hacia atrás.</p>' +
      '<p>Falta la distinción que más discusiones provoca en un área de precios: el <strong>margen sobre el precio de venta</strong> y el <strong>margen sobre el costo</strong>. Los dos describen exactamente la misma ganancia en pesos y solo cambian de base. El margen sobre el precio sirve para comparar productos entre sí, porque todos se miden contra sus ventas, y tiene un techo: nunca puede llegar al cien por ciento, porque el costo no puede desaparecer del precio. El margen sobre el costo sirve para poner precios, porque el comprador parte de lo que pagó, y no tiene techo. Reportar uno donde se esperaba el otro no es un matiz de redacción, es una diferencia de dinero que crece con el tamaño del pedido.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Porcentaje</div><div class="rform">' + frac('parte', 'base') + ' por cien</div><div class="rnote">La base siempre se declara.</div></div>' +
        '<div class="rcard"><div class="rname">Variación</div><div class="rform">' + frac('nuevo menos anterior', 'anterior') + '</div><div class="rnote">Cuelga del punto de partida.</div></div>' +
        '<div class="rcard"><div class="rname">Porcentaje inverso</div><div class="rform">' + frac('precio final', 'factor aplicado') + '</div><div class="rnote">Se divide, no se resta.</div></div>' +
        '<div class="rcard"><div class="rname">Los dos márgenes</div><div class="rform">' + frac('ganancia', 'precio') + ' o ' + frac('ganancia', 'costo') + '</div><div class="rnote">La misma ganancia, dos cifras.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> El limón de exportación de segunda calidad se vende en el anaquel del supermercado a ' + money(c4pf) + ' el kilo con impuesto incluido, y a Cítricos de Tecomán ese kilo le cuesta ' + money(c4c) + ' puesto en bodega. El pedido de la cadena es de ' + kilosEs(c4k) + ' y el contrato le concede ' + pct0(c4d) + ' de descuento comercial sobre el precio de lista.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El precio sin impuesto es ' + money2(c4pn) + ', porque el impuesto de ' + pct0(IVA) + ' se aplicó multiplicando y se deshace dividiendo.<br>' +
      '<strong>Paso 2.</strong> La ganancia del kilo es ' + money2(c4pn - c4c) + ', una sola cantidad de dinero.<br>' +
      '<strong>Paso 3.</strong> Esa ganancia es ' + pct2(c4mp) + ' medida sobre el precio y ' + pct2(c4mc) + ' medida sobre el costo, y las dos cifras son correctas mientras se nombre la base.<br>' +
      '<strong>Paso 4.</strong> Deshaciendo el impuesto y el descuento, el pedido corresponde a ' + money2(c4list) + ' de precio de lista; restando los dos porcentajes en lugar de dividir se llegaría a ' + money2(c4bad) + '.<br>' +
      '<strong>Lectura de negocio.</strong> Nota que el paso 3 no cambió ni un peso de la operación y aun así cambió el número que se reporta. Por eso las políticas de precios se escriben diciendo la base, y por eso conviene desconfiar de cualquier comparación de márgenes entre empresas mientras no se sepa cuál de los dos está usando cada una.</p></div>';
    return '' +
      '<div class="stag">Concept 4</div>' +
      '<h2>Percentages: the base, the change and the two margins</h2>' +
      '<p>A <strong>percentage</strong> is a part to whole ratio written with one hundred underneath, and that is its whole definition. Its usefulness comes from everybody reading it without an explanation; its danger comes from it almost never saying which quantity it hangs from. A percentage with no stated base is not information, it is an impression, and most of the mistakes in this block are settled by one question written in the margin of the report: percent of what.</p>' +
      '<p>A <strong>percentage change</strong> compares the change against the starting point, not against the finishing one. That asymmetry explains a fact that surprises people every time it appears: a rise and a fall of the same percentage do not cancel out, because the second percentage applies to a different quantity from the first. The same holds for several chained changes, which multiply as factors instead of adding up. A ten percent rise is multiplying by one point one, and chaining changes is multiplying factors; seen that way, the arithmetic stops springing surprises.</p>' +
      '<p>Undoing a percentage is the operation most often got wrong in practice. If a price already carries the tax, the price without tax does not come from subtracting that same percentage but from dividing by the factor it was applied with. Subtracting and dividing give similar results when the percentage is small, and that closeness is precisely what keeps the mistake alive for years inside a spreadsheet. The <strong>reverse percentage</strong> shows up in every invoice with tax included, in every shelf price with a discount and in every quotation that has to be rebuilt backwards.</p>' +
      '<p>One distinction remains, the one that causes most arguments in a pricing department: the <strong>margin on the selling price</strong> and the <strong>margin on cost</strong>. Both describe exactly the same profit in pesos and only change base. The margin on price serves to compare products with each other, because all of them are measured against their sales, and it has a ceiling: it can never reach one hundred percent, because the cost cannot vanish out of the price. The margin on cost serves to set prices, because the buyer starts from what was paid, and it has no ceiling at all. Reporting one where the other was expected is not a matter of wording, it is a difference in money that grows with the size of the order.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Percentage</div><div class="rform">' + frac('part', 'base') + ' times a hundred</div><div class="rnote">The base is always stated.</div></div>' +
        '<div class="rcard"><div class="rname">Percentage change</div><div class="rform">' + frac('new minus previous', 'previous') + '</div><div class="rnote">It hangs from the starting point.</div></div>' +
        '<div class="rcard"><div class="rname">Reverse percentage</div><div class="rform">' + frac('final price', 'factor applied') + '</div><div class="rnote">You divide, you do not subtract.</div></div>' +
        '<div class="rcard"><div class="rname">The two margins</div><div class="rform">' + frac('profit', 'price') + ' or ' + frac('profit', 'cost') + '</div><div class="rnote">One profit, two figures.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> Second grade export limes sell on the supermarket shelf at ' + money(c4pf) + ' a kilo with tax included, and that kilo costs Cítricos de Tecomán ' + money(c4c) + ' in the warehouse. The chain’s order is for ' + kilosEn(c4k) + ' and the contract grants it ' + pct0(c4d) + ' of trade discount on the list price.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The price without tax is ' + money2(c4pn) + ', because the ' + pct0(IVA) + ' tax was applied by multiplying and is undone by dividing.<br>' +
      '<strong>Step 2.</strong> The profit on the kilo is ' + money2(c4pn - c4c) + ', one single amount of money.<br>' +
      '<strong>Step 3.</strong> That profit is ' + pct2(c4mp) + ' measured on the price and ' + pct2(c4mc) + ' measured on the cost, and both figures are right as long as the base is named.<br>' +
      '<strong>Step 4.</strong> Undoing the tax and the discount, the order corresponds to ' + money2(c4list) + ' of list price; subtracting the two percentages instead of dividing would land on ' + money2(c4bad) + '.<br>' +
      '<strong>Business reading.</strong> Notice that step 3 did not change a single peso of the operation and still changed the number being reported. That is why pricing policies are written naming the base, and why any comparison of margins between companies deserves suspicion until you know which of the two each one is using.</p></div>';
  });

  widgetMargin(w4c, w4pf, w4d, w4k);

  /* ── Item 6 ── */
  var s6pn   = netOfTax(p6pf, IVA);
  var s6ok   = marginOnPrice(s6pn, p6c);
  var s6tax  = marginOnPrice(p6pf, p6c);
  var s6cost = markupOnCost(s6pn, p6c);
  var s6part = p6c / s6pn;
  var o6 = valOpts(s6ok, [s6tax, s6cost, s6part], pct2, rng);
  var q6i = {
    title: { es: 'El margen que pide el consejo', en: 'The margin the board is asking for' },
    q: { es: 'El kilo de limón nacional le cuesta a Cítricos de Tecomán ' + money(p6c) + ' puesto en bodega y se vende al público en ' + money(p6pf) + ', precio de anaquel que ya lleva el impuesto al valor agregado de ' + pct0(IVA) + '. El consejo pide el margen bruto de ese producto medido sobre el precio de venta, para poderlo comparar con el de las demás líneas de la empresa. ¿Qué margen debe reportarse?',
        en: 'A kilo of domestic limes costs Cítricos de Tecomán ' + money(p6c) + ' in the warehouse and sells to the public at ' + money(p6pf) + ', a shelf price that already carries value added tax of ' + pct0(IVA) + '. The board asks for the gross margin of that product measured on the selling price, so that it can be compared with the other lines of the company. Which margin should be reported?' },
    opts: { es: o6.es, en: o6.en },
    hint: { es: 'El precio que ves en el anaquel no es el ingreso de la empresa: una parte de él se entera al fisco y nunca fue venta. Antes de dividir cualquier cosa, deja el precio en la cantidad que de verdad se queda la empresa. Después decide con cuidado qué cantidad va abajo en la división, porque el consejo pidió una base específica y la otra base daría una cifra distinta.',
            en: 'The price you see on the shelf is not the company revenue: part of it goes to the tax authority and was never a sale. Before dividing anything, take the price down to the amount the company actually keeps. Then decide carefully which quantity goes underneath in the division, because the board asked for one specific base and the other base would give a different figure.' },
    exp: { es: 'El precio de anaquel de ' + money(p6pf) + ' incluye el impuesto, así que el ingreso real por kilo es ' + money2(s6pn) + ' y la ganancia es ' + money2(s6pn - p6c) + '. Medida sobre el precio de venta, esa ganancia representa ' + pct2(s6ok) + ', que es lo que el consejo pidió. La opción de ' + pct2(s6tax) + ' calcula el margen sin quitar el impuesto y por lo tanto reparte la ganancia sobre una base que incluye dinero que nunca fue de la empresa. La de ' + pct2(s6cost) + ' es la misma ganancia medida sobre el costo, la cifra que usa el comprador para poner precio, y siempre resulta mayor que la anterior porque el costo es menor que el precio. Y la de ' + pct2(s6part) + ' es la participación del costo dentro del precio, es decir el complemento del margen: sumada al margen correcto da el precio completo. Fíjate en que ninguna de las cuatro cambia un solo peso de la operación, solo cambia la base contra la que se divide.',
           en: 'The shelf price of ' + money(p6pf) + ' includes the tax, so the real revenue per kilo is ' + money2(s6pn) + ' and the profit is ' + money2(s6pn - p6c) + '. Measured on the selling price, that profit is ' + pct2(s6ok) + ', which is what the board asked for. The option of ' + pct2(s6tax) + ' works the margin out without taking the tax off and therefore spreads the profit over a base that includes money that was never the company’s. The one of ' + pct2(s6cost) + ' is the same profit measured on the cost, the figure the buyer uses to set prices, and it always comes out larger than the previous one because the cost is smaller than the price. And the one of ' + pct2(s6part) + ' is the share of the cost inside the price, that is, the complement of the margin: added to the correct margin it gives the whole price. Notice that none of the four changes a single peso of the operation, only the base they are divided by.' }
  };
  var d6 = mk(q6i, o6.correctIdx, true);
  problems.push({ i18n: d6.i18n, title: d6.title, questionText: d6.questionText, options: d6.options, correctIdx: d6.correctIdx, explanation: d6.explanation, hint: d6.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ FINAL ASSESSMENT ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Evaluación final</div>' +
      '<h2>Cuatro situaciones sin etiqueta</h2>' +
      '<p>Los cuatro reactivos que cierran la guía ya no vienen anunciados por un concepto. Cada uno describe una situación de Cítricos de Tecomán sin decirte de cuál de los cuatro bloques proviene, que es exactamente lo que ocurre cuando alguien llega a tu escritorio con una hoja de cálculo y una pregunta. Lee la situación completa antes de decidir qué relación la gobierna, porque la dificultad de estos reactivos no está en la aritmética sino en elegirla.</p>' +
      '<p>Los dos primeros piden un número y hay que producirlo: uno reconstruye una cotización hacia atrás y otro sigue un precio que subió y luego bajó. Los dos últimos piden un juicio y hay que sostenerlo, uno sobre hasta dónde alcanza una regla de tres y otro sobre dos indicadores que dicen lo mismo al derecho y al revés. En los cuatro casos la respuesta correcta es la que se puede defender frente a alguien que pregunte de qué cantidad cuelga cada porcentaje.</p>';
    return '' +
      '<div class="stag">Final assessment</div>' +
      '<h2>Four situations with no label on them</h2>' +
      '<p>The four items that close the guide no longer come announced by a concept. Each one describes a situation at Cítricos de Tecomán without telling you which of the four blocks it came from, which is exactly what happens when somebody arrives at your desk with a spreadsheet and a question. Read the whole situation before deciding which relation governs it, because the difficulty of these items lies not in the arithmetic but in choosing it.</p>' +
      '<p>The first two ask for a number and it has to be produced: one rebuilds a quotation backwards and the other follows a price that rose and then fell. The last two ask for a judgement and it has to be defended, one about how far a rule of three reaches and another about two indicators that say the same thing forwards and backwards. In all four cases the right answer is the one that can be defended in front of somebody asking which quantity each percentage hangs from.</p>';
  });

  /* ── Item 7 ── */
  var s7T    = p7L * (1 - p7d) * (1 + IVA);
  var s7ok   = listFromInvoice(s7T, IVA, p7d);
  var s7sub  = s7T * (1 - IVA) / (1 - p7d);
  var s7add  = s7T / (1 + IVA) * (1 + p7d);
  var s7net  = s7T / (1 + IVA);
  var o7 = valOpts(s7ok, [s7sub, s7add, s7net], money2, rng);
  var q7i = {
    title: { es: 'La cotización que hay que reconstruir', en: 'The quotation that has to be rebuilt' },
    q: { es: 'La cadena de supermercados devuelve una factura de Cítricos de Tecomán pidiendo que se le anexe la cotización original, que se traspapeló. De la factura solo se sabe que el total pagado fue ' + money2(s7T) + ', que ese total ya incluye el impuesto al valor agregado de ' + pct0(IVA) + ' y que el pedido llevó el ' + pct0(p7d) + ' de descuento comercial que marca el contrato. El auxiliar de facturación tiene que reconstruir el importe de lista del pedido, es decir el que aparecía en la cotización antes de cualquier descuento y antes del impuesto. ¿De cuánto era ese importe?',
        en: 'The supermarket chain sends back an invoice from Cítricos de Tecomán asking for the original quotation to be attached, since it has been mislaid. All that is known from the invoice is that the total paid was ' + money2(s7T) + ', that this total already includes value added tax of ' + pct0(IVA) + ' and that the order carried the ' + pct0(p7d) + ' trade discount set out in the contract. The billing assistant has to rebuild the list amount of the order, that is, the one shown on the quotation before any discount and before the tax. How much was that amount?' },
    opts: { es: o7.es, en: o7.en },
    hint: { es: 'Piensa el total de la factura como el resultado de dos operaciones encadenadas que partieron del importe de lista, una que lo redujo y otra que lo aumentó. Para volver al punto de partida hay que deshacer las dos, y deshacer un porcentaje que se aplicó multiplicando exige la operación contraria. Ten cuidado con el atajo de restar el mismo porcentaje que se sumó: la base ya no es la misma.',
            en: 'Think of the invoice total as the result of two chained operations that started from the list amount, one that shrank it and one that grew it. To get back to the starting point both have to be undone, and undoing a percentage that was applied by multiplying calls for the opposite operation. Be careful with the shortcut of subtracting the same percentage that was added: the base is no longer the same.' },
    exp: { es: 'El importe de lista se convirtió en el total de la factura al aplicarle el descuento del ' + pct0(p7d) + ' y después el impuesto del ' + pct0(IVA) + ', así que deshacer el camino significa dividir entre los dos factores y el importe de lista era ' + money2(s7ok) + '. La opción de ' + money2(s7sub) + ' quita el impuesto restando su porcentaje en lugar de dividir; parece casi igual y no lo es, porque restar el ' + pct0(IVA) + ' de un precio con impuesto no devuelve el precio sin impuesto. La de ' + money2(s7add) + ' quita bien el impuesto pero deshace el descuento sumándole ese mismo porcentaje al precio ya descontado, que es aplicar el porcentaje sobre una base más chica que la original. Y la de ' + money2(s7net) + ' se queda en el importe sin impuesto y nunca deshace el descuento, de modo que responde a la mitad de la pregunta. Comprueba el resultado al derecho: al importe correcto quítale el descuento y agrégale el impuesto, y tienes que caer otra vez en ' + money2(s7T) + '.',
           en: 'The list amount turned into the invoice total by having the ' + pct0(p7d) + ' discount applied and then the ' + pct0(IVA) + ' tax, so undoing the road means dividing by both factors, and the list amount was ' + money2(s7ok) + '. The option of ' + money2(s7sub) + ' takes the tax off by subtracting its percentage instead of dividing; it looks almost the same and is not, because subtracting ' + pct0(IVA) + ' from a price that carries tax does not give back the price without tax. The one of ' + money2(s7add) + ' takes the tax off properly but undoes the discount by adding that same percentage to the already discounted price, which applies the percentage to a smaller base than the original one. And the one of ' + money2(s7net) + ' stops at the amount without tax and never undoes the discount, so it answers half the question. Check the result forwards: take the discount off the correct amount and add the tax, and you have to land back on ' + money2(s7T) + '.' }
  };
  var d7 = mk(q7i, o7.correctIdx, true);
  problems.push({ i18n: d7.i18n, title: d7.title, questionText: d7.questionText, options: d7.options, correctIdx: d7.correctIdx, explanation: d7.explanation, hint: d7.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 8 ── */
  var s8net = Math.abs(chainChange(p8u, p8u));
  var o8 = shuffleOpts(
    ['Que el kilo quedó ' + pct2(s8net) + ' por debajo del precio de enero, porque la baja se aplicó sobre un precio que ya traía el aumento y por lo tanto sobre una base mayor.',
     'Que el kilo quedó exactamente en el precio de enero, porque el aumento y la baja fueron del mismo porcentaje y se cancelan entre sí.',
     'Que el kilo quedó ' + pct2(s8net) + ' por encima del precio de enero, porque el aumento se aplicó primero y por lo tanto pesa más que la baja posterior.',
     'Que no puede decirse en cuánto quedó mientras no se conozca en cuántos pesos estaba el kilo en enero.'],
    ['That the kilo ended ' + pct2(s8net) + ' below the January price, because the fall applied to a price that already carried the rise and therefore to a larger base.',
     'That the kilo ended exactly at the January price, because the rise and the fall were of the same percentage and cancel each other out.',
     'That the kilo ended ' + pct2(s8net) + ' above the January price, because the rise came first and therefore weighs more than the fall that followed.',
     'That nothing can be said about where it ended until the January price of the kilo is known in pesos.'], rng);
  var q8i = {
    title: { es: 'El precio que subió y luego bajó lo mismo', en: 'The price that rose and then fell by the same amount' },
    q: { es: 'El precio de referencia del limón en la central de abastos subió ' + pct0(p8u) + ' en febrero respecto de enero, y en marzo bajó ' + pct0(p8u) + ' respecto de febrero. En la junta de comercialización de Cítricos de Tecomán, el encargado de compras asegura que el mercado quedó justo donde estaba porque los dos movimientos fueron del mismo tamaño, y la dirección pide que se verifique esa afirmación antes de cerrar los contratos del trimestre. ¿Cómo quedó el precio de marzo frente al de enero?',
        en: 'The reference price of limes at the wholesale market rose ' + pct0(p8u) + ' in February against January, and in March it fell ' + pct0(p8u) + ' against February. In the trading meeting at Cítricos de Tecomán, the head of buying claims the market ended up right where it started because both movements were of the same size, and management asks for that claim to be verified before the quarter contracts are closed. Where did the March price end up against January?' },
    opts: { es: o8.es, en: o8.en },
    hint: { es: 'Un porcentaje no es una cantidad de pesos, es un factor que multiplica, así que dos cambios seguidos se encadenan multiplicando y no sumando. Pregúntate sobre qué cantidad se aplicó cada uno de los dos movimientos: no fue la misma en febrero que en marzo. Si te ayuda, imagina un precio cualquiera y sigue las dos operaciones, pero fíjate en que la respuesta en porcentaje no depende del precio que hayas imaginado.',
            en: 'A percentage is not an amount of pesos, it is a factor that multiplies, so two changes in a row chain together by multiplying and not by adding. Ask yourself which quantity each of the two movements was applied to: it was not the same in February as in March. If it helps, imagine any price at all and follow both operations, but notice that the answer in percentage terms does not depend on the price you imagined.' },
    exp: { es: 'El aumento de ' + pct0(p8u) + ' se aplicó al precio de enero y la baja de ' + pct0(p8u) + ' se aplicó al precio de febrero, que ya era mayor, de modo que la baja quitó más pesos de los que el aumento había puesto: el precio de marzo quedó ' + pct2(s8net) + ' por debajo del de enero. La opción que declara el precio sin cambio es la afirmación que había que verificar y es falsa justamente porque los dos porcentajes cuelgan de bases distintas; encadenar cambios es multiplicar factores y el producto de los dos factores no da uno. La opción que lo deja ' + pct2(s8net) + ' por encima invierte el orden del argumento: el que se aplica sobre la base mayor es el segundo movimiento, no el primero. Y la que exige conocer el precio de enero pide un dato innecesario, porque la variación porcentual acumulada es la misma sea cual sea el precio de partida. Nota que este resultado no depende del orden: bajar primero y subir después deja el precio en el mismo lugar.',
           en: 'The ' + pct0(p8u) + ' rise applied to the January price and the ' + pct0(p8u) + ' fall applied to the February price, which was already higher, so the fall took away more pesos than the rise had put in: the March price ended ' + pct2(s8net) + ' below the January one. The option declaring the price unchanged is the claim that had to be verified and it is false precisely because the two percentages hang from different bases; chaining changes is multiplying factors and the product of the two factors does not come to one. The option leaving it ' + pct2(s8net) + ' above turns the argument round: the one applied to the larger base is the second movement, not the first. And the one demanding the January price asks for data that is not needed, because the accumulated percentage change is the same whatever the starting price. Notice that this result does not depend on the order: falling first and rising afterwards leaves the price in the same place.' }
  };
  var d8 = mk(q8i, o8.correctIdx, true);
  problems.push({ i18n: d8.i18n, title: d8.title, questionText: d8.questionText, options: d8.options, correctIdx: d8.correctIdx, explanation: d8.explanation, hint: d8.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 9 ── */
  var s9crew  = p9w * p9m;
  var s9naive = p9h / p9m;
  var s9floor = floorHours(p9w, p9h, p9p);
  var s9dir   = p9h * p9m;
  var o9 = shuffleOpts(
    ['Que la relación inversa vale mientras haya puesto y fruta para cada empacador, y la línea tiene ' + intN(p9p) + ' puestos: con ' + packersEs(s9crew) + ' el lote no baja de ' + hoursEs(s9floor) + ', así que la meta de ' + hoursEs(s9naive) + ' no se alcanza por más gente que se contrate.',
     'Que el lote saldría exactamente en ' + hoursEs(s9naive) + ', porque el producto de empacadores por horas se mantiene constante para cualquier cantidad de gente.',
     'Que el lote tardaría ' + hoursEs(s9dir) + ', porque al aumentar los empacadores aumenta también la coordinación necesaria y el tiempo crece en la misma proporción.',
     'Que el tiempo no puede estimarse sin conocer el costo por hora de cada empacador, ya que ese dato es el que determina cuántos conviene contratar.'],
    ['That the inverse relation holds while there is a post and fruit for every packer, and the line has ' + intN(p9p) + ' posts: with ' + packersEn(s9crew) + ' the batch does not go below ' + hoursEn(s9floor) + ', so the target of ' + hoursEn(s9naive) + ' is out of reach however many people are hired.',
     'That the batch would come out in exactly ' + hoursEn(s9naive) + ', because the product of packers by hours stays constant for any number of people.',
     'That the batch would take ' + hoursEn(s9dir) + ', because more packers also means more coordination and the time grows in the same proportion.',
     'That the time cannot be estimated without knowing the cost per hour of each packer, since that figure is what determines how many are worth hiring.'], rng);
  var q9i = {
    title: { es: 'La promesa que se le hizo al exportador', en: 'The promise made to the exporter' },
    q: { es: 'En la línea de empaque de Cítricos de Tecomán, ' + packersEs(p9w) + ' terminan un lote de limón en ' + hoursEs(p9h) + '. El exportador pide que el próximo lote salga mucho antes y el gerente comercial le promete ' + hoursEs(s9naive) + ' contratando ' + packersEs(s9crew) + ' de eventualidad. La línea tiene ' + intN(p9p) + ' puestos de empaque, uno por persona, y no hay presupuesto para instalar más. La jefa de planta debe responder al gerente antes de que la promesa se firme. ¿Qué debe responderle?',
        en: 'On the packing line at Cítricos de Tecomán, ' + packersEn(p9w) + ' finish a batch of limes in ' + hoursEn(p9h) + '. The exporter asks for the next batch much sooner and the sales manager promises ' + hoursEn(s9naive) + ' by hiring ' + packersEn(s9crew) + ' on a temporary contract. The line has ' + intN(p9p) + ' packing posts, one per person, and there is no budget to install more. The plant manager has to answer the sales manager before the promise is signed. What should she answer?' },
    opts: { es: o9.es, en: o9.en },
    hint: { es: 'La regla de tres inversa describe bien el reparto del trabajo, pero como todo modelo tiene un rango de validez. Pregúntate qué necesita cada empacador adicional para poder recortar tiempo y qué pasa con los que llegan cuando eso se acaba. Fíjate en cuál es el dato de la planta que fija ese límite y calcula qué tiempo se alcanza justo en ese punto.',
            en: 'The inverse rule of three describes the sharing of work well, but like any model it has a range where it holds. Ask yourself what each extra packer needs in order to cut any time at all, and what happens to the ones who arrive once that runs out. Notice which figure from the plant sets that limit and work out what time is reached exactly at that point.' },
    exp: { es: 'El lote pide ' + intN(p9w * p9h) + ' horas de empacador y esas horas se reparten entre quienes puedan trabajar de verdad, no entre quienes estén contratados. Con los ' + intN(p9p) + ' puestos de la línea el tiempo llega a su piso en ' + hoursEs(s9floor) + ', y de ahí no baja aunque entren ' + packersEs(s9crew) + ': la promesa de ' + hoursEs(s9naive) + ' no se puede cumplir sin instalar puestos. La opción que la da por buena aplica la proporcionalidad inversa fuera de su rango, que es el error de tratar un modelo como si fuera una ley. La que anuncia ' + hoursEs(s9dir) + ' invierte la relación y hace crecer el tiempo con la gente, además de aplicarla también fuera de rango. Y la que pide el costo por hora confunde dos preguntas distintas: ese dato sirve para decidir si conviene contratar, no para saber en cuánto tiempo sale el lote. La conclusión práctica es la del bloque: antes de multiplicar hay que preguntar qué se queda quieto cuando la cantidad crece.',
           en: 'The batch asks for ' + intN(p9w * p9h) + ' packer hours and those hours are shared among whoever can actually work, not among whoever is on the payroll. With the ' + intN(p9p) + ' posts on the line the time reaches its floor at ' + hoursEn(s9floor) + ', and it does not go below that even if ' + packersEn(s9crew) + ' walk in: the promise of ' + hoursEn(s9naive) + ' cannot be kept without installing posts. The option that accepts it applies inverse proportionality outside its range, which is the mistake of treating a model as though it were a law. The one announcing ' + hoursEn(s9dir) + ' turns the relation upside down and makes time grow with the crew, on top of applying it out of range as well. And the one asking for the cost per hour confuses two different questions: that figure serves to decide whether hiring is worthwhile, not how long the batch takes. The practical conclusion is the one of this block: before multiplying, ask what stays still when the quantity grows.' }
  };
  var d9 = mk(q9i, o9.correctIdx, false);
  problems.push({ i18n: d9.i18n, title: d9.title, questionText: d9.questionText, options: d9.options, correctIdx: d9.correctIdx, explanation: d9.explanation, hint: d9.hint, showWork: false, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 10 ── */
  var s10y1   = p10y * (1 + p10r);
  var s10r0   = 1 / p10y;
  var s10r1   = 1 / s10y1;
  var s10drop = p10r / (1 + p10r);
  var o10 = shuffleOpts(
    ['Que los dos indicadores son lecturas recíprocas de la misma relación, así que ambos mejoran a la vez, pero sus variaciones porcentuales no coinciden: el rendimiento sube ' + pct2(p10r) + ' al pasar de ' + dec2(p10y) + ' a ' + dec2(s10y1) + ', mientras los kilos por caja bajan solo ' + pct2(s10drop) + ' al pasar de ' + dec2(s10r0) + ' a ' + dec2(s10r1) + ', porque cada porcentaje se mide contra una base distinta.',
     'Que si un indicador sube ' + pct2(p10r) + ', el otro tiene que bajar exactamente ' + pct2(p10r) + ', ya que se trata de la misma relación vista al derecho y al revés.',
     'Que los dos indicadores deben moverse en la misma dirección, porque los dos miden la eficiencia de la banda y una mejora del proceso tiene que aumentar a los dos por igual.',
     'Que los dos indicadores no son comparables entre sí porque están expresados en unidades distintas, de modo que no tiene sentido hablar de la variación de uno frente a la del otro.'],
    ['That the two indicators are reciprocal readings of the same relation, so both improve together, but their percentage changes do not match: the yield rises ' + pct2(p10r) + ' going from ' + dec2(p10y) + ' to ' + dec2(s10y1) + ', while the kilos per box fall only ' + pct2(s10drop) + ' going from ' + dec2(s10r0) + ' to ' + dec2(s10r1) + ', because each percentage is measured against a different base.',
     'That if one indicator rises ' + pct2(p10r) + ', the other has to fall by exactly ' + pct2(p10r) + ', since it is the same relation seen forwards and backwards.',
     'That both indicators have to move in the same direction, because both measure the efficiency of the belt and an improvement in the process has to raise them equally.',
     'That the two indicators cannot be compared with each other because they are expressed in different units, so it makes no sense to speak of the change in one against the change in the other.'], rng);
  var q10i = {
    title: { es: 'Dos indicadores que dicen lo mismo al revés', en: 'Two indicators saying the same thing backwards' },
    q: { es: 'Producción reporta el rendimiento de la banda como los kilos de limón exportable que salen por cada kilo recibido, y este mes pasó de ' + dec2(p10y) + ' a ' + dec2(s10y1) + '. Compras lleva el indicador al revés, como los kilos que hay que recibir por cada kilo exportable, y en su reporte esa cifra bajó de ' + dec2(s10r0) + ' a ' + dec2(s10r1) + '. En la junta mensual, el analista sostiene que uno de los dos reportes tiene un error porque los porcentajes de mejora no coinciden. ¿Qué debe concluir la junta?',
        en: 'Production reports the yield of the belt as the kilos of exportable limes leaving for every kilo received, and this month it went from ' + dec2(p10y) + ' to ' + dec2(s10y1) + '. Buying keeps the indicator the other way round, as the kilos that have to be received for every exportable kilo, and in its report that figure fell from ' + dec2(s10r0) + ' to ' + dec2(s10r1) + '. In the monthly meeting, the analyst maintains that one of the two reports has an error because the improvement percentages do not match. What should the meeting conclude?' },
    opts: { es: o10.es, en: o10.en },
    hint: { es: 'Los dos indicadores son la misma razón escrita con el numerador y el denominador intercambiados, así que uno es el recíproco del otro y ninguno puede contradecir al otro. Lo que sí cambia entre ellos es contra qué cantidad se mide cada variación porcentual. Piensa en cuál es el punto de partida de cada porcentaje antes de esperar que las dos cifras sean iguales.',
            en: 'The two indicators are the same ratio written with the numerator and denominator swapped, so each is the reciprocal of the other and neither can contradict the other. What does change between them is the quantity each percentage change is measured against. Think about the starting point of each percentage before expecting the two figures to be equal.' },
    exp: { es: 'Cada indicador es el recíproco del otro, de modo que los dos reportes describen la misma banda y ninguno tiene error. El rendimiento subió de ' + dec2(p10y) + ' a ' + dec2(s10y1) + ', es decir ' + pct2(p10r) + ' medido contra el rendimiento anterior; los kilos por kilo exportable bajaron de ' + dec2(s10r0) + ' a ' + dec2(s10r1) + ', que es ' + pct2(s10drop) + ' medido contra el consumo anterior. Las dos cifras difieren porque cada una cuelga de una base distinta, y esa es la única razón. La opción que exige la misma cifra en los dos supone que una razón y su recíproco varían en el mismo porcentaje, lo que solo ocurriría si el cambio fuera nulo. La que pide que los dos indicadores suban juntos ignora que uno mide lo que sale y el otro lo que hay que meter, así que mejorar el proceso necesariamente baja el segundo. Y la que los declara incomparables por sus unidades pasa por alto que ambos son razones entre kilos y kilos. En un tablero conviene reportar los dos con su base escrita al lado, porque la mejora se ve más grande en el que se mide contra la cantidad menor.',
           en: 'Each indicator is the reciprocal of the other, so both reports describe the same belt and neither has an error. The yield rose from ' + dec2(p10y) + ' to ' + dec2(s10y1) + ', that is ' + pct2(p10r) + ' measured against the previous yield; the kilos per exportable kilo fell from ' + dec2(s10r0) + ' to ' + dec2(s10r1) + ', which is ' + pct2(s10drop) + ' measured against the previous consumption. The two figures differ because each hangs from a different base, and that is the only reason. The option demanding the same figure in both assumes that a ratio and its reciprocal vary by the same percentage, which would only happen if the change were nil. The one asking both indicators to rise together ignores that one measures what comes out and the other what has to go in, so improving the process necessarily lowers the second. And the one declaring them incomparable because of their units overlooks that both are ratios of kilos to kilos. On a dashboard it is worth reporting both with their base written beside them, because the improvement looks larger in the one measured against the smaller quantity.' }
  };
  var d10 = mk(q10i, o10.correctIdx, false);
  problems.push({ i18n: d10.i18n, title: d10.title, questionText: d10.questionText, options: d10.options, correctIdx: d10.correctIdx, explanation: d10.explanation, hint: d10.hint, showWork: false, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);
}

/* ════════════════════════════════════════════════════════════════════════
   LANGUAGE SWITCHING
   ════════════════════════════════════════════════════════════════════════ */
function applyUIStrings() {
  var set = function(id, txt) { var e = document.getElementById(id); if (e) e.textContent = txt; };
  var ph  = function(id, txt) { var e = document.getElementById(id); if (e) e.placeholder = txt; };
  set('wtitle-el',    SCHOOL.guideTitle[LANG]);
  set('wcourse-el',   SCHOOL.courseName[LANG]);
  set('htitle-el',    SCHOOL.guideTitle[LANG]);
  set('lbl-name-el',  t('lbl-name'));
  set('lbl-group-el', t('lbl-group'));
  set('startBtn',     t('btn-start'));
  set('restoreTitle', t('restore-title'));
  set('restoreMsg',   t('restore-msg'));
  set('restoreBtn',   t('btn-restore'));
  set('dismissBtn',   t('btn-dismiss'));
  set('dlBtn',        t('btn-pdf'));
  ph('sName',  t('ph-name'));
  ph('sGroup', t('ph-group'));
  var ll = document.getElementById('logo-left');   if (ll) ll.alt = SCHOOL.logoLeftAlt;
  var lr = document.getElementById('logo-right');  if (lr) lr.alt = SCHOOL.logoRightAlt;
}
/* Rebuilds the visible text of every card without touching the numbers. */
function applyProblemLang() {
  problems.forEach(function(p, i) {
    var card = document.getElementById('pc' + i);
    if (!card || !p.i18n) return;
    p.title        = p.i18n.title[LANG];
    p.questionText = p.i18n.q[LANG];
    p.hint         = p.i18n.hint[LANG];
    p.explanation  = p.i18n.exp[LANG];
    p.options      = p.i18n.opts[LANG].slice();
    var ti = card.querySelector('.ptitle'); if (ti) ti.textContent = p.title;
    var st = card.querySelector('.pstmt');  if (st) st.innerHTML = p.questionText;
    var hb = card.querySelector('.hintbox'); if (hb) hb.innerHTML = p.hint;
    var hbtn = card.querySelector('.hintbtn'); if (hbtn) hbtn.textContent = t('btn-hint');
    card.querySelectorAll('.mcopt').forEach(function(o, oi) {
      if (p.options[oi] !== undefined) o.innerHTML = p.options[oi];
    });
    var tabs = card.querySelectorAll('.wtab');
    if (tabs.length === 3) {
      tabs[0].textContent = t('tab-draw');
      tabs[1].textContent = t('tab-type');
      tabs[2].textContent = t('tab-photo');
    }
    var tools = card.querySelectorAll('.tbtn2');
    if (tools.length === 3) {
      tools[0].textContent = t('tool-pen');
      tools[1].textContent = t('tool-mark');
      tools[2].textContent = t('tool-erase');
    }
    var clr = card.querySelector('.clrbtn'); if (clr) clr.textContent = t('tool-clear');
    var ta  = card.querySelector('.wtextarea'); if (ta) ta.placeholder = t('ph-work');
    var pzt = card.querySelector('.pztxt'); if (pzt) pzt.textContent = t('ph-photo');
    var lab = card.querySelector('.pbody > div:last-child > div:first-child');
    if (lab) lab.textContent = t('lbl-answer');
    var fb = card.querySelector('.mcfb');
    if (fb && fb.classList.contains('show')) {
      var isOk = (p.studentChoice === p.correctIdx);
      fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + p.explanation;
    }
  });
}
function setLang(l) {
  LANG = l;
  try { localStorage.setItem(LANG_KEY, l); } catch(e) {}
  document.documentElement.setAttribute('lang', l);
  var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
  if (be) be.classList.toggle('active', l === 'es');
  if (bn) bn.classList.toggle('active', l === 'en');
  applyUIStrings();
  applySectionLang();
  applyProblemLang();
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
  document.querySelectorAll('#lessonBody .section').forEach(function(s) { s.classList.add('vis'); });
}
(function() {
  try { var stored = localStorage.getItem(LANG_KEY); if (stored === 'es' || stored === 'en') LANG = stored; } catch(e) {}
  document.addEventListener('DOMContentLoaded', function() {
    document.documentElement.setAttribute('lang', LANG);
    var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
    if (be) be.classList.toggle('active', LANG === 'es');
    if (bn) bn.classList.toggle('active', LANG === 'en');
    applyUIStrings();
  });
})();

/* LOGO INJECTION */
document.addEventListener('DOMContentLoaded', function() {
  var wl = document.getElementById('logo-left');
  if (wl && SCHOOL.logoLeftB64) { wl.src = SCHOOL.logoLeftB64; wl.style.display = 'inline-block'; }
  var hl = document.getElementById('hlogo-left');
  if (hl && SCHOOL.logoLeftB64) { hl.src = SCHOOL.logoLeftB64; hl.style.display = 'inline-block'; }
});

/* ════════════════════════════════════════════════════════════════════════
   PDF
   ════════════════════════════════════════════════════════════════════════ */
async function generatePDF() {
  var btn = document.getElementById('dlBtn');
  btn.textContent = t('pdf-busy');
  btn.disabled = true;

  var jspdf   = window.jspdf;
  var doc     = new jspdf.jsPDF({ orientation:'portrait', unit:'mm', format:'letter' });
  var PW      = 215.9;
  var M       = 18;
  var TW      = PW - M * 2;
  var PH      = doc.internal.pageSize.height;
  var name    = studentData.name;
  var group   = studentData.group;
  var total   = problems.length;
  var pct     = Math.round(correctCount / total * 100);
  var dateStr = new Date().toLocaleString(LANG === 'es' ? 'es-MX' : 'en-US', { dateStyle:'long', timeStyle:'short' });

  var raw = name + '|' + group + '|' + correctCount + '|' + total + '|' + new Date().toDateString();
  var h = 0;
  for (var ci = 0; ci < raw.length; ci++) h = (Math.imul(31, h) + raw.charCodeAt(ci)) | 0;
  var code = Math.abs(h).toString(36).toUpperCase().slice(0, 8);

  var pBR = SCHOOL.pBR, pBG = SCHOOL.pBG, pBB = SCHOOL.pBB;
  var pAR = SCHOOL.pAR, pAG = SCHOOL.pAG, pAB = SCHOOL.pAB;

  function pdfText(html) {
    if (!html) return '';
    return html
      .replace(/<[^>]+>/g,'').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&')
      .replace(/&nbsp;/g,' ').replace(/&#[0-9]+;/g,'')
      .replace(/’/g, String.fromCharCode(39))
      .replace(/→/g,'->').replace(/−/g,'-').replace(/²/g,'^2')
      .replace(/³/g,'^3').replace(/×/g,'x').replace(/÷/g,'/')
      .replace(/≠/g,'!=').replace(/≤/g,'<=').replace(/≥/g,'>=')
      .replace(/√/g,'sqrt').replace(/π/g,'pi').replace(/…/g,'...')
      .replace(/μ/g,'mu').replace(/σ/g,'sigma').replace(/α/g,'alpha').replace(/β/g,'beta')
      .replace(/₀/g,'0').replace(/₁/g,'1').replace(/₂/g,'2').replace(/·/g,'*')
      .replace(/\s+/g,' ').trim();
  }

  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,2,'F');
  doc.setFillColor(255,255,255); doc.rect(0,2,PW,26,'F');
  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,28,PW,2,'F');
  doc.setFillColor(pBR,pBG,pBB); doc.rect(0,30,PW,34,'F');

  var fmtL = SCHOOL.logoLeftB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  var fmtR = SCHOOL.logoRightB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  try { doc.addImage(SCHOOL.logoLeftB64,  fmtL, M,  4.0, 22, 22); } catch(e) {}
  try { doc.addImage(SCHOOL.logoRightB64, fmtR, 48, 4.5, 48, 21); } catch(e) {}

  var lx = PW - M - 36;
  var ly = 10;
  doc.setDrawColor(pBR,pBG,pBB); doc.setLineWidth(0.7);
  doc.lines([[2.57-1.03,4.63-6.17],[4.11-2.57,5.14-4.63],[5.66-4.11,2.57-5.14]], lx+1.03, ly+6.17);
  doc.setFillColor(pAR,pAG,pAB); doc.circle(lx+5.66, ly+2.57, 0.9, 'F');
  doc.setDrawColor(pAR,pAG,pAB); doc.setLineWidth(0.7);
  doc.line(lx+8.23, ly+1.54, lx+8.23, ly+7.2);
  doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text('LIAXA', lx+10, ly+6.8);

  doc.setTextColor(240,244,238); doc.setFontSize(13); doc.setFont('helvetica','bold');
  doc.text(SCHOOL.guideTitle[LANG], M, 49);
  doc.setTextColor(198,214,192); doc.setFontSize(8); doc.setFont('helvetica','normal');
  doc.text(dateStr, M, 59);

  doc.setFillColor(237,240,245); doc.roundedRect(M,72,TW,20,3,3,'F');
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
  doc.text(t('pdf-student'), M+4, 79); doc.text(t('pdf-group'), 130, 79);
  doc.setTextColor(20,24,32); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text(name, M+4, 87); doc.text(group, 130, 87);

  var sc = pct>=70?[26,106,74]:pct>=50?[224,123,26]:[176,48,16];
  doc.setFillColor(255,255,255); doc.roundedRect(M,100,TW,34,4,4,'F');
  doc.setDrawColor(sc[0],sc[1],sc[2]); doc.setLineWidth(0.8);
  doc.roundedRect(M,100,TW,34,4,4,'S');
  doc.setTextColor(sc[0],sc[1],sc[2]); doc.setFontSize(40); doc.setFont('helvetica','bold');
  doc.text(pct+'%', PW/2, 124, {align:'center'});
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
  doc.text(correctCount+' '+t('pdf-score')+' '+total+' '+t('pdf-questions'), PW/2, 131, {align:'center'});

  doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
  doc.setFontSize(7); doc.setFont('helvetica','bold');
  doc.rect(M,142,TW,8,'F'); doc.text(t('pdf-summary'), M+4, 148);
  var sy = 154;
  problems.forEach(function(prob, i) {
    if (sy + 12 > PH - 15) {
      doc.addPage(); sy = 20;
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,sy,TW,8,'F'); doc.text(t('pdf-summary2'), M+4, sy+6);
      sy += 12;
    }
    var ok = document.getElementById('pc'+i).classList.contains('ok');
    doc.setFillColor(ok?232:255, ok?240:232, ok?232:228);
    doc.roundedRect(M,sy,TW,10,2,2,'F');
    doc.setFillColor(ok?26:176, ok?106:48, ok?74:16);
    doc.circle(M+6, sy+5, 2.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(7); doc.setFont('helvetica','bold');
    doc.text(ok?'v':'x', M+4.5, sy+6.5);
    doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('helvetica','normal');
    doc.text(t('pdf-item')+' '+(i+1)+': '+pdfText(prob.title), M+12, sy+6.5);
    doc.setTextColor(ok?26:176, ok?106:48, ok?74:16);
    doc.text(ok?t('pdf-ok'):t('pdf-bad'), PW-M-24, sy+6.5);
    sy += 12;
  });

  for (var i = 0; i < problems.length; i++) {
    var prob = problems[i];
    doc.addPage();
    var wy = 0;

    doc.setFillColor(pBR,pBG,pBB); doc.rect(0,0,PW,20,'F');
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,3,'F');
    doc.setTextColor(pAR,pAG,pAB); doc.setFontSize(7); doc.setFont('helvetica','normal');
    doc.text(SCHOOL.courseName[LANG]+'  ·  '+SCHOOL.guideTitle[LANG], M, 10);
    doc.setTextColor(240,244,238); doc.setFontSize(10.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-item')+' '+(i+1)+' '+t('pdf-of')+' '+total+'  ·  '+pdfText(prob.title), M, 17);
    wy = 25;

    var qRaw = pdfText(prob.questionText);
    doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qLines = doc.splitTextToSize(qRaw, TW-10);
    var qBoxH  = 8 + qLines.length*5 + 3;
    doc.setFillColor(237,240,245); doc.roundedRect(M,wy,TW,qBoxH,2,2,'F');
    doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(6.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-question'), M+4, wy+6);
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qy = wy+12;
    qLines.forEach(function(ln,li){ doc.text(ln, M+4, qy+li*5); });
    wy += qBoxH + 4;

    var isOk   = document.getElementById('pc'+i).classList.contains('ok');
    var chosen = prob.studentChoice != null ? pdfText(prob.options[prob.studentChoice]||'') : '';
    var corr   = pdfText(prob.options[prob.correctIdx]||'');
    var expRaw = pdfText(prob.explanation||'');
    doc.setFontSize(8.5); var chLines = doc.splitTextToSize(t('pdf-yours')+chosen, TW-18);
    doc.setFontSize(8);   var coLines = doc.splitTextToSize(t('pdf-key')+corr, TW-18);
    doc.setFontSize(7.5); var exLines = doc.splitTextToSize(t('pdf-sol')+expRaw, TW-18).slice(0,4);
    var ansBoxH = 8 + chLines.length*5.5 + coLines.length*5 + exLines.length*5 + 6;
    doc.setFillColor(isOk?232:255, isOk?240:232, isOk?232:228);
    doc.roundedRect(M,wy,TW,ansBoxH,2,2,'F');
    doc.setFillColor(isOk?26:176, isOk?106:48, isOk?74:16);
    doc.circle(M+7, wy+8, 3.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(9); doc.setFont('helvetica','bold');
    doc.text(isOk?'v':'x', M+5.2, wy+10.5);
    var ay = wy+7;
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
    chLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5.5); });
    ay += chLines.length*5.5 + 3;
    doc.setTextColor(26,106,74); doc.setFontSize(8); doc.setFont('helvetica','normal');
    coLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    ay += coLines.length*5 + 3;
    doc.setTextColor(90,85,80); doc.setFontSize(7.5);
    exLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    wy += ansBoxH + 5;

    var dc = document.getElementById('dc'+i);
    if (dc) {
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,wy,TW,8,'F'); doc.text(t('pdf-work'), M+4, wy+5.5);
      wy += 11;
      try {
        var imgD = dc.toDataURL('image/png');
        var ar   = dc.height / dc.width;
        var iw   = TW;
        var ih   = Math.min(iw * ar, 68);
        doc.addImage(imgD, 'PNG', M, wy, iw, ih);
        wy += ih + 4;
      } catch(e) {}
    }

    var ta = document.getElementById('ta'+i);
    if (ta && ta.value.trim()) {
      if (wy > PH-30) { doc.addPage(); wy = 20; }
      doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('courier','normal');
      var taLines = doc.splitTextToSize(ta.value, TW);
      taLines.slice(0,16).forEach(function(ln) {
        if (wy > PH-15) { doc.addPage(); wy = 20; }
        doc.text(ln, M, wy); wy += 5;
      });
      wy += 2;
    }

    var pp = document.getElementById('pp'+i);
    if (pp && pp.src && pp.src.indexOf('data:') === 0) {
      if (wy > PH-55) { doc.addPage(); wy = 20; }
      try { doc.addImage(pp.src, 'JPEG', M, wy, TW, 68); wy += 72; } catch(e) {}
    }
  }

  var pages = doc.internal.getNumberOfPages();
  for (var p = 1; p <= pages; p++) {
    doc.setPage(p);
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0, PH-3, PW, 3, 'F');
    doc.setTextColor(130,140,160); doc.setFontSize(6.5); doc.setFont('helvetica','normal');
    doc.text(name+'  ·  '+group+'  ·  '+t('pdf-code')+code+'  ·  '+t('pdf-page')+p+'/'+pages,
      PW/2, PH-5, {align:'center'});
  }

  var _fn = SCHOOL.filePrefix + '_' + name.replace(/\s+/g,'_') + '_' + group.replace(/\s+/g,'_') + '.pdf';
  var _pdfBlob = doc.output('blob');
  var _blobUrl = URL.createObjectURL(_pdfBlob);
  var _a = document.createElement('a');
  _a.href = _blobUrl;
  _a.download = _fn;
  document.body.appendChild(_a);
  _a.click();
  setTimeout(function(){ document.body.removeChild(_a); URL.revokeObjectURL(_blobUrl); }, 200);
  btn.textContent = t('btn-pdf');
  btn.disabled  = false;
}
</script>
</body>
</html>
