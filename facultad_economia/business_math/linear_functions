  <div class="wcard">
    <div class="wlogos" id="wlogos">
      <div style="font-family:'Crimson Pro',serif;font-size:2rem;font-weight:700;letter-spacing:.28em;color:#1a4a8a;line-height:1;text-indent:.28em">ALEXIS</div>
