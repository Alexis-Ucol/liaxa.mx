   STATE
   ════════════════════════════════════════════════════════════════════════ */
var studentData   = {};
var problems      = [];
var sectionDefs   = [];
var widgets       = [];
var answeredCount = 0;
var correctCount  = 0;

/* ════════════════════════════════════════════════════════════════════════
   THEME
   ════════════════════════════════════════════════════════════════════════ */
var THEME_KEY = 'fac_econ_neg__theme';
function applyThemeVars(mode) {
  var r = document.documentElement.style;
  if (mode === 'dark') {
    r.setProperty('--green',      SCHOOL.darkPrimary);
    r.setProperty('--green-dark', SCHOOL.darkPrimaryDark);
    r.setProperty('--green-bg',   SCHOOL.darkPrimaryBg);
    r.setProperty('--gold',       SCHOOL.darkAccent);
    r.setProperty('--gold-bg',    SCHOOL.darkAccentBg);
  } else {
    r.setProperty('--green',      SCHOOL.primary);
    r.setProperty('--green-dark', SCHOOL.primaryDark);
    r.setProperty('--green-bg',   SCHOOL.primaryBg);
    r.setProperty('--gold',       SCHOOL.accent);
    r.setProperty('--gold-bg',    SCHOOL.accentBg);
  }
}
function toggleTheme() {
  var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  applyThemeVars(next);
  document.getElementById('themeBtn').textContent = next === 'dark' ? '☀️' : '🌙';
  try { localStorage.setItem(THEME_KEY, next); } catch(e) {}
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
}
(function() {
  document.documentElement.setAttribute('data-theme', 'light');
  applyThemeVars('light');
  try {
    var th = localStorage.getItem(THEME_KEY);
    if (th === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      applyThemeVars('dark');
      document.addEventListener('DOMContentLoaded', function() {
        var b = document.getElementById('themeBtn');
        if (b) b.textContent = '☀️';
      });
    }
  } catch(e) {}
})();

/* ════════════════════════════════════════════════════════════════════════
   ATTEMPT COUNTER + SEEDED RNG
   ════════════════════════════════════════════════════════════════════════ */
function getAttemptKey(name, group) {
  return 'fac_econ_neg__neg_caso_integrador__att__' + (name + '__' + group).replace(/\s+/g, '_');
}
function nextAttempt(name, group) {
  var k = getAttemptKey(name, group), n = 0;
  try { n = parseInt(localStorage.getItem(k) || '0', 10) || 0; } catch(e) {}
  n++;
  try { localStorage.setItem(k, String(n)); } catch(e) {}
  return n;
}
function currentAttempt(name, group) {
  var k = getAttemptKey(name, group);
  try { return parseInt(localStorage.getItem(k) || '1', 10) || 1; } catch(e) { return 1; }
}
function seededRng(seed) {
  var s = 0;
  for (var i = 0; i < seed.length; i++) s = (Math.imul(31, s) + seed.charCodeAt(i)) | 0;
  return function() {
    s = (s + 0x9e3779b9) | 0;
    var t2 = s ^ (s >>> 16);
    t2 = Math.imul(t2, 0x21f0aaad);
    t2 ^= (t2 >>> 15);
    t2 = Math.imul(t2, 0x735a2d97);
    return ((t2 ^ (t2 >>> 15)) >>> 0) / 4294967296;
  };
}
function pick(arr, rng) { return arr[Math.floor(rng() * arr.length)]; }
function shuffle(arr, rng) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(rng() * (i + 1));
    var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
  }
  return a;
}
/* Shuffles the four options once and keeps both language versions aligned. */
function shuffleOpts(rawEs, rawEn, rng) {
  var p = shuffle([0, 1, 2, 3], rng);
  return {
    es: p.map(function(j) { return rawEs[j]; }),
    en: p.map(function(j) { return rawEn[j]; }),
    correctIdx: p.indexOf(0)
  };
}

/* ════════════════════════════════════════════════════════════════════════
   NUMBER HELPERS
   ════════════════════════════════════════════════════════════════════════ */
function nf(x) {
  var neg = x < 0, v = Math.abs(x);
  var s = (Math.round(v * 10) / 10).toString().split('.');
  s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return (neg ? '−' : '') + s.join('.');
}
function nfD(x, d) {
  var neg = x < 0, v = Math.abs(x);
  var s = v.toFixed(d).split('.');
  s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return (neg ? '−' : '') + s.join('.');
}
function money(v)  { return '$' + nf(Math.round(v)); }
function money2(v) { return '$' + nfD(v, 2); }
function dec1(x)   { return x.toFixed(1); }
function dec2(x)   { return x.toFixed(2); }
/* Rate written the way a bank quotes it: 18 and not 18.00, 1.5 and not 1.50. */
function pctS(x) {
  var v = Math.round(x * 1000000) / 10000;
  if (Math.abs(v - Math.round(v)) < 1e-9) return String(Math.round(v));
  return String(Math.round(v * 100) / 100);
}
/* Rate as an option value, always two decimals so four choices stay distinct. */
function pct2(x)   { return (x * 100).toFixed(2) + '%'; }
function intN(x)   { return nf(Math.round(x)); }
function cssv(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }

/* ── THE MODELS THE SIMULATED COMPANY RUNS ON ─────────────────────────────
   This guide follows one firm through a full cycle of decisions, so the
   models below are not four separate topics. They are four views of the
   same bottling plant: what it costs to run, what the market lets it
   charge, when the money actually moves, and whether the next machine is
   worth buying. Each view answers a question the previous one cannot.   */

/* ── 1 · The cost structure ───────────────────────────────────────────────
   The only figure that matters per unit is what a bottle leaves behind
   after paying for itself. Fixed cost does not belong in that figure,
   because it does not move when one more bottle is made.                */
function contribUnit(p, v)  { return p - v; }
function contribRatio(p, v) { return p <= 0 ? null : (p - v) / p; }
/* The volume at which the accumulated contribution has just paid for the
   whole month of fixed cost. Below it the firm loses money, above it the
   firm keeps the full margin on every extra bottle. */
function breakEvenUnits(F, p, v) { return p <= v ? null : F / (p - v); }
function breakEvenPesos(F, p, v) { return p <= v ? null : F * p / (p - v); }
function profitAt(q, p, v, F)    { return (p - v) * q - F; }
/* How far sales can fall before the month turns into a loss. */
function safetyMargin(q, F, p, v) {
  var be = breakEvenUnits(F, p, v);
  return (be === null || q <= 0) ? null : (q - be) / q;
}
/* How violently profit reacts to volume. A plant with heavy fixed cost
   and a wide margin multiplies both good news and bad news. */
function leverage(q, p, v, F) {
  var pr = profitAt(q, p, v, F);
  return pr <= 0 ? null : (p - v) * q / pr;
}
function unitsForProfit(F, target, p, v) { return p <= v ? null : (F + target) / (p - v); }

/* ── 2 · What the market lets the firm charge ─────────────────────────────
   Demand is written as a straight line: every peso added to the price
   costs the firm b bottles. The line is the whole model, and the price
   that maximises profit falls out of it.                                */
function qAt(a, b, p)      { return a - b * p; }
function chokePrice(a, b)  { return b <= 0 ? null : a / b; }
/* Profit peaks exactly halfway between the price at which nobody buys and
   the cost of making one more bottle. Revenue peaks halfway between that
   same choke price and zero, which is why the two prices never agree. */
function bestPrice(a, b, v) { return b <= 0 ? null : (a / b + v) / 2; }
function revPrice(a, b)     { return b <= 0 ? null : a / (2 * b); }
function profitAtPrice(a, b, v, F, p) { return (p - v) * qAt(a, b, p) - F; }
function revenueAtPrice(a, b, p)      { return p * qAt(a, b, p); }

/* ── 3 · When the money actually moves ────────────────────────────────────
   A sale is recorded on the day it is invoiced and collected some weeks
   later. Profit and cash are therefore two different calendars, and a
   growing firm can be profitable in every month and still run dry.      */
function collected(sPrev, sNow, c) { return c * sNow + (1 - c) * sPrev; }
function cashCycle(dso, dio, dpo)  { return dso + dio - dpo; }
/* Profit, corrected for everything the month tied up or released. */
function cashFromOps(profit, dAR, dInv, dAP) { return profit - dAR - dInv + dAP; }
function cashTxt(v, es) {
  if (v >= 0) return money(v) + (es ? ' de entrada neta' : ' of net cash in');
  return money(-v) + (es ? ' de salida neta' : ' of net cash out');
}

/* ── 4 · Whether the next machine is worth buying ─────────────────────────
   The extra line is judged on the cash it adds and on nothing else, and
   every peso of that cash is carried back to the day of the decision. */
function annFactor(i, n)    { return i === 0 ? n : (1 - Math.pow(1 + i, -n)) / i; }
function pvAnnuity(A, i, n) { return A * annFactor(i, n); }
function pvSingle(F, i, n)  { return F / Math.pow(1 + i, n); }
function npvLevel(I, A, i, n) { return pvAnnuity(A, i, n) - I; }
/* The annual cash the project must throw off for the outlay to be exactly
   worth making, which is the bridge back to the break-even of concept 1. */
function flowForZero(I, i, n) {
  var f = annFactor(i, n);
  return f <= 0 ? null : I / f;
}
function irrLevel(I, A, n) {
  if (A <= 0 || n <= 0) return null;
  var lo = 0.0001, hi = 3, mid, val;
  if (npvLevel(I, A, lo, n) < 0) return null;
  for (var k = 0; k < 80; k++) {
    mid = (lo + hi) / 2;
    val = npvLevel(I, A, mid, n);
    if (val > 0) lo = mid; else hi = mid;
  }
  return (lo + hi) / 2;
}
function payback(I, A) { return A <= 0 ? null : I / A; }
function npvTxt(v, es) {
  if (v >= 0) return money(v) + (es ? ' de valor agregado' : ' of value added');
  return money(-v) + (es ? ' de valor destruido' : ' of value destroyed');
}
function yearsTxt(v, es) {
  return v === null ? (es ? 'nunca' : 'never') : dec1(v) + (es ? ' años' : ' years');
}
/* Money on a chart axis, where the value may legitimately be negative. */
function moneyAx(v) { return v < 0 ? '\u2212$' + nf(Math.round(-v)) : '$' + nf(Math.round(v)); }
/* A profit that may legitimately turn out to be a loss. */
function profitTxt(v, es) {
  if (v >= 0) return money(v);
  return money(-v) + (es ? ' de pérdida' : ' of loss');
}
/* A year result named by what it actually is, profit or loss. */
function yearProfitTxt(v, es) {
  if (v >= 0) return money(v) + (es ? ' de utilidad' : ' of profit');
  return money(-v) + (es ? ' de pérdida' : ' of loss');
}
/* An improvement in profit, worded so a negative one never prints a minus
   sign glued to the currency symbol. */
function gainTxt(v, es) {
  if (v >= 0) return money(v) + (es ? ' al año' : ' a year');
  return money(-v) + (es ? ' menos al año' : ' less a year');
}
/* Shares are written the way a report writes them, with one decimal. */
function pct1(x) { return nfD(x * 100, 1) + '%'; }
function pct0(x) { return nf(Math.round(x * 100)) + '%'; }
function bottlesEs(x) { return intN(x) + ' botellas'; }
function bottlesEn(x) { return intN(x) + ' bottles'; }
function ptsEs(x) { return dec2(x * 100) + ' puntos'; }
function ptsEn(x) { return dec2(x * 100) + ' points'; }

/* ════════════════════════════════════════════════════════════════════════
   OPTION BUILDERS · the key is always the first value handed in
   ════════════════════════════════════════════════════════════════════════ */
/* Four distinct numbers, each rendered once per language and kept aligned.
   The key is always the first value handed in. */
function valOpts2(correct, wrongs, fmtEs, fmtEn, rng) {
  var seen = {}, vals = [];
  function add(v) {
    if (typeof v !== 'number' || !isFinite(v)) return;
    var s = fmtEn(v);
    if (seen[s]) return;
    seen[s] = 1; vals.push(v);
  }
  add(correct);
  for (var i = 0; i < wrongs.length && vals.length < 4; i++) add(wrongs[i]);
  for (var j = 1; vals.length < 4 && j < 900; j++) {
    add(correct * (1 + j * 0.11 * (j % 2 ? 1 : -1)));
  }
  for (var k = 1; vals.length < 4 && k < 900; k++) add(correct + k * 0.41);
  return shuffleOpts(vals.map(fmtEs), vals.map(fmtEn), rng);
}
function valOpts(correct, wrongs, fmt, rng) {
  return valOpts2(correct, wrongs, fmt, fmt, rng);
}

/* ════════════════════════════════════════════════════════════════════════
   SESSION PERSISTENCE
   ════════════════════════════════════════════════════════════════════════ */
function lsKey() {
  var n = (studentData.name || '').trim(), g = (studentData.group || '').trim();
  return 'fac_econ_neg__neg_caso_integrador__' + (n + '__' + g).replace(/\s+/g, '_');
}
function saveSession() {
  if (!studentData.name) return;
  var drawings = [], texts = [], photos = [];
  problems.forEach(function(p, i) {
    var dc = document.getElementById('dc' + i);
    if (dc && dc.width) {
      var blank = document.createElement('canvas');
      blank.width = dc.width; blank.height = dc.height;
      drawings.push(dc.toDataURL() === blank.toDataURL() ? null : dc.toDataURL('image/png'));
    } else { drawings.push(null); }
    var ta = document.getElementById('ta' + i);
    texts.push(ta ? ta.value : '');
    var pp = document.getElementById('pp' + i);
    photos.push((pp && pp.src && pp.src.indexOf('data:') === 0) ? pp.src : null);
  });
  var state = {
    name: studentData.name, group: studentData.group,
    answeredCount: answeredCount, correctCount: correctCount,
    choices: problems.map(function(p) { return p.studentChoice; }),
    drawings: drawings, texts: texts, photos: photos
  };
  try { localStorage.setItem(lsKey(), JSON.stringify(state)); } catch(e) {}
}
function loadSession(name, group) {
  var key = 'fac_econ_neg__neg_caso_integrador__' + (name + '__' + group).replace(/\s+/g, '_');
  try { var r = localStorage.getItem(key); return r ? JSON.parse(r) : null; } catch(e) { return null; }
}
function dismissRestore() { document.getElementById('restoreBar').style.display = 'none'; }
function checkForSavedSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  if (!name || !group) { document.getElementById('restoreBar').style.display = 'none'; return; }
  var saved = loadSession(name, group);
  var bar = document.getElementById('restoreBar');
  bar.style.display = (saved && saved.choices && saved.choices.some(function(c) { return c !== null; })) ? 'block' : 'none';
}
function observeSections() {
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('vis'); });
  }, { threshold: 0.05 });
  document.querySelectorAll('.section').forEach(function(s) { obs.observe(s); });
}

/* ════════════════════════════════════════════════════════════════════════
   START / RESTORE
   ════════════════════════════════════════════════════════════════════════ */
function startLesson() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var err   = document.getElementById('startErr');
  if (!name || !group) { err.textContent = t('err-fields'); return; }
  err.textContent = '';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = nextAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
}
function restoreSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var saved = loadSession(name, group);
  if (!saved) return;
  document.getElementById('restoreBar').style.display = 'none';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = currentAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
  saved.choices.forEach(function(choice, idx) {
    if (choice !== null && choice !== undefined) confirmMC(idx, choice);
  });
  setTimeout(function() {
    if (saved.drawings) saved.drawings.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var dc = document.getElementById('dc' + i);
      if (!dc || !dc.width) return;
      var img = new Image();
      img.onload = function() {
        var dpr = window.devicePixelRatio || 1;
        dc.getContext('2d').drawImage(img, 0, 0, dc.width / dpr, dc.height / dpr);
      };
      img.src = dataUrl;
    });
    if (saved.texts) saved.texts.forEach(function(txt, i) {
      if (!txt) return;
      var ta = document.getElementById('ta' + i);
      if (ta) ta.value = txt;
    });
    if (saved.photos) saved.photos.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var pp = document.getElementById('pp' + i);
      if (!pp) return;
      pp.src = dataUrl; pp.style.display = 'block';
      var pz = document.getElementById('pz' + i);
      if (pz) pz.style.opacity = '0.4';
    });
  }, 300);
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS / TABS / PHOTO / HINT / RESULTS
   ════════════════════════════════════════════════════════════════════════ */
function initCanvas(canvas) {
  var dpr  = window.devicePixelRatio || 1;
  var rect = canvas.getBoundingClientRect();
  canvas.width  = rect.width  * dpr;
  canvas.height = rect.height * dpr;
  var ctx = canvas.getContext('2d');
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.scale(dpr, dpr);
  ctx.strokeStyle = '#2d5a27';
  ctx.lineWidth   = 2;
  ctx.lineCap     = 'round';
  ctx.lineJoin    = 'round';
  var drawing = false, lx = 0, ly = 0;
  var tb = canvas.closest('.cvwrap').querySelector('.ctoolbar');
  function getPos(e) {
    var r = canvas.getBoundingClientRect();
    var src = e.touches ? e.touches[0] : e;
    return [src.clientX - r.left, src.clientY - r.top];
  }
  function onDown(e) { e.preventDefault(); drawing = true; var p = getPos(e); lx = p[0]; ly = p[1]; }
  function onMove(e) { e.preventDefault(); if (!drawing) return; var p = getPos(e); ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p[0], p[1]); ctx.stroke(); lx = p[0]; ly = p[1]; }
  function onUp() { drawing = false; saveSession(); }
  canvas.addEventListener('mousedown',  onDown, { passive:false });
  canvas.addEventListener('mousemove',  onMove, { passive:false });
  canvas.addEventListener('mouseup',    onUp);
  canvas.addEventListener('mouseleave', onUp);
  canvas.addEventListener('touchstart', onDown, { passive:false });
  canvas.addEventListener('touchmove',  onMove, { passive:false });
  canvas.addEventListener('touchend',   onUp);
  tb.querySelectorAll('.tbtn2').forEach(function(btn) {
    btn.addEventListener('click', function() {
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      if (btn.classList.contains('bpen'))    { ctx.lineWidth = 2; }
      if (btn.classList.contains('bmarker')) { ctx.lineWidth = 10; ctx.globalAlpha = 0.45; }
      if (btn.classList.contains('beraser')) { ctx.globalCompositeOperation = 'destination-out'; ctx.lineWidth = 20; }
    });
  });
  tb.querySelectorAll('.cdot').forEach(function(dot) {
    dot.addEventListener('click', function() {
      tb.querySelectorAll('.cdot').forEach(function(d) { d.classList.remove('sel'); });
      dot.classList.add('sel');
      ctx.strokeStyle = dot.dataset.color;
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      tb.querySelector('.bpen').classList.add('on');
    });
  });
  tb.querySelector('.clrbtn').addEventListener('click', function() {
    ctx.clearRect(0, 0, canvas.width / dpr, canvas.height / dpr);
  });
}
function switchTab(idx, panel, btn) {
  var prefix = 'wp_' + idx + '_';
  document.querySelectorAll('[id^="' + prefix + '"]').forEach(function(p) { p.classList.remove('active'); });
  document.getElementById(prefix + panel).classList.add('active');
  btn.closest('.wtabs').querySelectorAll('.wtab').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
}
function handlePhoto(idx, input) {
  if (!input.files || !input.files[0]) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var img = document.getElementById('pp' + idx);
    img.src = e.target.result;
    img.style.display = 'block';
    document.getElementById('pz' + idx).style.opacity = '0.4';
    saveSession();
  };
  reader.readAsDataURL(input.files[0]);
}
function toggleHint(idx) { document.getElementById('hint' + idx).classList.toggle('show'); }
function showResults() {
  var rb = document.getElementById('s_results');
  if (!rb) return;
  rb.style.display = 'block';
  setTimeout(function() {
    rb.classList.add('vis');
    rb.scrollIntoView({ behavior:'smooth', block:'center' });
  }, 50);
}

/* ════════════════════════════════════════════════════════════════════════
   ANSWER HANDLER · two taps to confirm
   ════════════════════════════════════════════════════════════════════════ */
function handleMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  if (prob.pendingChoice === chosenIdx) {
    prob.studentChoice = chosenIdx;
    prob.pendingChoice = null;
    var isOk = (chosenIdx === prob.correctIdx);
    opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
    opts.forEach(function(o, i) {
      if (i === prob.correctIdx) o.classList.add('rc');
      if (i === chosenIdx && isOk)  o.classList.add('sc');
      if (i === chosenIdx && !isOk) o.classList.add('sw');
    });
    var fb = document.getElementById('fb' + probIdx);
    fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.explanation;
    fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
    document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
    if (isOk) correctCount++;
    answeredCount++;
    document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
    saveSession();
    if (answeredCount === problems.length) setTimeout(showResults, 700);
    return;
  }
  prob.pendingChoice = chosenIdx;
  opts.forEach(function(o) { o.classList.remove('pending'); });
  opts[chosenIdx].classList.add('pending');
}
function confirmMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (!prob || prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  prob.studentChoice = chosenIdx;
  prob.pendingChoice = null;
  var isOk = (chosenIdx === prob.correctIdx);
  opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
  opts.forEach(function(o, i) {
    if (i === prob.correctIdx) o.classList.add('rc');
    if (i === chosenIdx && isOk)  o.classList.add('sc');
    if (i === chosenIdx && !isOk) o.classList.add('sw');
  });
  var fb = document.getElementById('fb' + probIdx);
  fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.explanation;
  fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
  document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
  if (isOk) correctCount++;
  answeredCount++;
  document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
  saveSession();
  if (answeredCount === problems.length) setTimeout(showResults, 700);
}

/* ════════════════════════════════════════════════════════════════════════
   BUILD ONE CARD · appended inline, right after its concept
   The statement ends with the question. No formula is printed anywhere in
   the card: translating the situation into an operation is the exercise.
   ════════════════════════════════════════════════════════════════════════ */
function buildOneCard(prob, i) {
  var opts = prob.options.map(function(opt, oi) {
    return '<div class="mcopt" onclick="handleMC(' + i + ',' + oi + ')">' + opt + '</div>';
  }).join('');
  var work = '';
  if (prob.showWork) {
    work =
      '<div style="margin-bottom:.85rem">' +
        '<div class="wtabs">' +
          '<button class="wtab active" onclick="switchTab(' + i + ',\'draw\',this)">' + t('tab-draw') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'type\',this)">' + t('tab-type') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'photo\',this)">' + t('tab-photo') + '</button>' +
        '</div>' +
        '<div class="wpanel active" id="wp_' + i + '_draw">' +
          '<div class="cvwrap">' +
            '<canvas class="dcanvas" id="dc' + i + '"></canvas>' +
            '<div class="ctoolbar">' +
              '<button class="tbtn2 bpen on">' + t('tool-pen') + '</button>' +
              '<button class="tbtn2 bmarker">' + t('tool-mark') + '</button>' +
              '<button class="tbtn2 beraser">' + t('tool-erase') + '</button>' +
              '<div class="cdot sel" data-color="#2d5a27" style="background:#2d5a27"></div>' +
              '<div class="cdot"     data-color="#1a1a16" style="background:#1a1a16"></div>' +
              '<div class="cdot"     data-color="#8b2500" style="background:#8b2500"></div>' +
              '<div class="cdot"     data-color="#1d4e89" style="background:#1d4e89"></div>' +
              '<button class="clrbtn">' + t('tool-clear') + '</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_type">' +
          '<textarea class="wtextarea" id="ta' + i + '" placeholder="' + t('ph-work') + '" oninput="saveSession()"></textarea>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_photo">' +
          '<div class="pzone" id="pz' + i + '">' +
            '<input type="file" accept="image/*" onchange="handlePhoto(' + i + ',this)">' +
            '<div class="pzicon">📸</div>' +
            '<div class="pztxt">' + t('ph-photo') + '</div>' +
          '</div>' +
          '<img class="ppreview" id="pp' + i + '" alt="' + t('alt-work') + '">' +
        '</div>' +
      '</div>';
  }
  var card = document.createElement('div');
  card.className = 'pcrd section';
  card.id = 'pc' + i;
  card.innerHTML =
    '<div class="phdr"><div class="pnum">' + (i + 1) + '</div><div class="ptitle">' + prob.title + '</div></div>' +
    '<div class="pbody">' +
      '<div class="pstmt">' + prob.questionText + '</div>' +
      work +
      '<button class="hintbtn" onclick="toggleHint(' + i + ')">' + t('btn-hint') + '</button>' +
      '<div class="hintbox" id="hint' + i + '">' + (prob.hint || '') + '</div>' +
      '<div style="margin-top:.7rem">' +
        '<div style="font-family:\'IBM Plex Mono\',monospace;font-size:.65rem;letter-spacing:.1em;color:var(--text3);text-transform:uppercase;margin-bottom:.5rem">' + t('lbl-answer') + '</div>' +
        '<div class="mcopts">' + opts + '</div>' +
        '<div class="mcfb" id="fb' + i + '"></div>' +
      '</div>' +
    '</div>';
  document.getElementById('lessonBody').appendChild(card);
  if (prob.showWork) setTimeout(function() { var c = document.getElementById('dc' + i); if (c) initCanvas(c); }, 80);
}

/* ════════════════════════════════════════════════════════════════════════
   SECTION REGISTRY  (concept text is re-rendered on language switch)
   ════════════════════════════════════════════════════════════════════════ */
function addSection(fn) {
  var d = document.createElement('div');
  d.className = 'section';
  d.innerHTML = fn(LANG);
  document.getElementById('lessonBody').appendChild(d);
  sectionDefs.push({ el: d, fn: fn });
}
function applySectionLang() {
  sectionDefs.forEach(function(s) { s.el.innerHTML = s.fn(LANG); });
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS PRIMITIVES FOR THE WIDGETS
   ════════════════════════════════════════════════════════════════════════ */
function fitCanvas(cv, h) {
  var dpr = window.devicePixelRatio || 1;
  var w = Math.max(240, cv.clientWidth || cv.parentNode.clientWidth || 300);
  cv.style.height = h + 'px';
  cv.width  = Math.round(w * dpr);
  cv.height = Math.round(h * dpr);
  var ctx = cv.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);
  return { ctx: ctx, w: w, h: h };
}
function palette() {
  return {
    green: cssv('--green'), dark: cssv('--green-dark'), tint: cssv('--green-bg'),
    gold: cssv('--gold'), bad: cssv('--bad'), border: cssv('--border'),
    text: cssv('--text'), text2: cssv('--text2'), text3: cssv('--text3')
  };
}
function kindColor(P, kind) {
  if (kind === 'gold') return P.gold;
  if (kind === 'bad')  return P.bad;
  if (kind === 'tint') return P.tint;
  if (kind === 'soft') return P.text3;
  return P.dark;
}
/* Plots any curve given as a function of time or of a rate. A balance that
   grows, a promise that shrinks as its date moves away and a loan balance
   that falls to zero are all the same picture to this routine.
     opts.marks  points worth naming, such as the year a balance doubles
     opts.band   the stretch of the horizontal axis worth highlighting
     opts.hline  a reference amount drawn as a horizontal line
     opts.asym   the limit a curve approaches without reaching
     opts.at     where the student is standing right now                     */
function drawCurveChart(g, xMin, xMax, series, opts) {
  var ctx = g.ctx, P = palette(), W = g.w, H = g.h, i;
  var padL = 56, padR = 12, padT = 18, padB = 28;
  opts = opts || {};
  var fmtY  = opts.fmtY || function(v) { return intN(v); };
  var fmtX  = opts.fmtX || function(v) { return intN(v); };
  var STEPS = 140;
  var yLo = null, yHi = null;
  function note(v) {
    if (typeof v !== 'number' || !isFinite(v)) return;
    if (yLo === null || v < yLo) yLo = v;
    if (yHi === null || v > yHi) yHi = v;
  }
  series.forEach(function(s) {
    for (i = 0; i <= STEPS; i++) note(s.f(xMin + (xMax - xMin) * i / STEPS));
  });
  note(opts.yFloor); note(opts.yCeil);
  if (opts.hline) note(opts.hline.y);
  if (opts.asym)  note(opts.asym.y);
  if (yLo === null) { yLo = 0; yHi = 1; }
  if (yHi - yLo < 1) yHi = yLo + 1;
  var pd = (yHi - yLo) * 0.10;
  yLo -= pd; yHi += pd;
  function X(v) { return padL + (v - xMin) / (xMax - xMin) * (W - padL - padR); }
  function Y(v) { return H - padB - (v - yLo) / (yHi - yLo) * (H - padT - padB); }
  function Yc(v) { return Math.max(padT - 10, Math.min(H - padB + 10, Y(v))); }

  if (opts.band && opts.band.to > opts.band.from) {
    var b1 = X(Math.max(xMin, opts.band.from)), b2 = X(Math.min(xMax, opts.band.to));
    if (b2 > b1) {
      ctx.save();
      ctx.fillStyle = P.tint;
      ctx.fillRect(b1, padT - 8, b2 - b1, H - padB - padT + 8);
      ctx.restore();
    }
  }
  ctx.strokeStyle = P.border; ctx.lineWidth = 1;
  ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Mono", monospace';
  for (i = 0; i <= 3; i++) {
    var gv = yLo + (yHi - yLo) * i / 3;
    ctx.beginPath(); ctx.moveTo(padL, Y(gv)); ctx.lineTo(W - padR, Y(gv)); ctx.stroke();
    var gl = fmtY(gv);
    ctx.fillText(gl, Math.max(1, padL - 4 - ctx.measureText(gl).width), Y(gv) + 3);
  }
  if (yLo < 0 && yHi > 0) {
    ctx.save();
    ctx.strokeStyle = P.text3; ctx.lineWidth = 1.4; ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(padL, Y(0)); ctx.lineTo(W - padR, Y(0)); ctx.stroke();
    ctx.restore();
  }
  if (opts.asym) {
    ctx.save();
    ctx.strokeStyle = P.bad; ctx.lineWidth = 1.3; ctx.setLineDash([5, 4]);
    ctx.beginPath(); ctx.moveTo(padL, Y(opts.asym.y)); ctx.lineTo(W - padR, Y(opts.asym.y)); ctx.stroke();
    ctx.restore();
    if (opts.asym.label) {
      ctx.fillStyle = P.bad; ctx.font = '600 9px "IBM Plex Sans", sans-serif';
      ctx.fillText(opts.asym.label, padL + 4, Math.max(10, Y(opts.asym.y) - 4));
    }
  }
  if (opts.hline) {
    ctx.save();
    ctx.strokeStyle = P.gold; ctx.lineWidth = 1.5; ctx.setLineDash([6, 3]);
    ctx.beginPath(); ctx.moveTo(padL, Y(opts.hline.y)); ctx.lineTo(W - padR, Y(opts.hline.y)); ctx.stroke();
    ctx.restore();
    if (opts.hline.label) {
      ctx.fillStyle = P.gold; ctx.font = '600 9px "IBM Plex Sans", sans-serif';
      var hw = ctx.measureText(opts.hline.label).width;
      ctx.fillText(opts.hline.label, W - padR - hw - 2, Math.max(10, Y(opts.hline.y) - 4));
    }
  }
  series.forEach(function(s) {
    ctx.strokeStyle = kindColor(P, s.kind); ctx.lineWidth = 2.2;
    ctx.beginPath();
    var started = false;
    for (i = 0; i <= STEPS; i++) {
      var xv = xMin + (xMax - xMin) * i / STEPS;
      var yv = s.f(xv);
      if (typeof yv !== 'number' || !isFinite(yv)) { started = false; continue; }
      var px = X(xv), py = Yc(yv);
      if (!started) { ctx.moveTo(px, py); started = true; } else { ctx.lineTo(px, py); }
    }
    ctx.stroke();
  });
  (opts.marks || []).forEach(function(m) {
    if (typeof m.x !== 'number' || !isFinite(m.x) || m.x < xMin || m.x > xMax) return;
    var cx = X(m.x), cy = Yc(m.y);
    ctx.save();
    ctx.strokeStyle = kindColor(P, m.kind || 'gold'); ctx.lineWidth = 1.4; ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(cx, H - padB); ctx.lineTo(cx, cy); ctx.stroke();
    ctx.restore();
    ctx.fillStyle = kindColor(P, m.kind || 'gold');
    ctx.beginPath(); ctx.arc(cx, cy, 4.2, 0, Math.PI * 2); ctx.fill();
    if (m.label) {
      ctx.font = '600 10px "IBM Plex Sans", sans-serif';
      var mw = ctx.measureText(m.label).width;
      ctx.fillText(m.label, Math.min(Math.max(2, cx - mw / 2), W - mw - 2), Math.max(10, cy - 9));
    }
  });
  if (typeof opts.at === 'number' && opts.at >= xMin && opts.at <= xMax) {
    ctx.save();
    ctx.strokeStyle = P.bad; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(X(opts.at), H - padB); ctx.lineTo(X(opts.at), padT - 6); ctx.stroke();
    ctx.restore();
  }
  ctx.strokeStyle = P.border; ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.moveTo(padL, padT - 8); ctx.lineTo(padL, H - padB); ctx.lineTo(W - padR, H - padB); ctx.stroke();
  ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Mono", monospace';
  [xMin, (xMin + xMax) / 2, xMax].forEach(function(v) {
    var lab = fmtX(v), lw = ctx.measureText(lab).width;
    ctx.fillText(lab, Math.min(Math.max(1, X(v) - lw / 2), W - lw - 1), H - padB + 13);
  });
  var legX = padL + 4;
  ctx.font = '600 9.5px "IBM Plex Sans", sans-serif';
  series.forEach(function(s) {
    if (!s.label) return;
    ctx.fillStyle = kindColor(P, s.kind);
    ctx.fillRect(legX, 9, 9, 3);
    ctx.fillText(s.label, legX + 12, 13);
    legX += 12 + ctx.measureText(s.label).width + 12;
  });
  if (opts.xLabel) {
    ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Sans", sans-serif';
    var xl = opts.xLabel;
    ctx.fillText(xl, W - padR - ctx.measureText(xl).width, H - 3);
  }
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 1 · the volume at which the plant stops losing money
   ════════════════════════════════════════════════════════════════════════ */
function widgetCVP(p0, v0, F0, q0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { view: 'total', p: p0, v: v0, F: F0, q: q0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'total', es: 'Ingreso y costo del mes completo', en: 'Revenue and cost for the whole month' },
      { id: 'unit',  es: 'Lo que cuesta cada botella',       en: 'What each bottle costs' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.view ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="estructura-de-costos-y-punto-de-equilibrio">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'El volumen en el que la planta deja de perder' : 'The volume where the plant stops losing money') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'La empresa simulada embotella agua de limón. Empieza por la primera vista: la recta dorada es lo que entra por vender y la verde es lo que cuesta producir, y la verde no arranca en cero porque la renta y los sueldos se pagan aunque la línea esté parada. Donde las dos rectas se cruzan está el punto de equilibrio, y el ancho que se abre entre ellas a la derecha del cruce es la utilidad del mes. Mueve el precio y observa que el cruce se recorre hacia la izquierda mucho antes de lo que esperarías: un peso más de precio es un peso íntegro de margen. Pasa luego a la segunda vista, donde la curva es lo que realmente cuesta cada botella cuando el costo fijo se reparte entre todas. Esa curva baja rápido al principio y después casi se detiene sobre el costo variable, que es el piso al que se acerca sin tocarlo nunca. Ahí está la razón por la que producir más abarata, y también el límite de ese argumento.'
          : 'The simulated company bottles lime water. Start with the first view: the gold line is what comes in from selling and the green one is what production costs, and the green line does not start at zero because the rent and the wages are paid whether the line runs or not. Where the two lines cross is the break-even point, and the gap that opens between them to the right of the crossing is the profit for the month. Move the price and watch the crossing slide left far sooner than you would expect: one more peso of price is a whole peso of margin. Then switch to the second view, where the curve is what a bottle really costs once the fixed cost is spread across all of them. That curve drops fast at first and then almost stalls just above the variable cost, which is the floor it approaches and never touches. That is why making more makes each one cheaper, and it is also the limit of that argument.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Precio de cada botella' : 'Price of each bottle') + ': <span class="cval" id="k1pl"></span></label>' +
          '<input type="range" min="14" max="34" step="1" id="k1p" value="' + state.p + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Costo variable de cada botella' : 'Variable cost of each bottle') + ': <span class="cval" id="k1vl"></span></label>' +
          '<input type="range" min="5" max="20" step="1" id="k1v" value="' + state.v + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Costo fijo del mes' : 'Fixed cost for the month') + ': <span class="cval" id="k1Fl"></span></label>' +
          '<input type="range" min="40000" max="400000" step="10000" id="k1F" value="' + state.F + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Botellas vendidas en el mes' : 'Bottles sold in the month') + ': <span class="cval" id="k1ql"></span></label>' +
          '<input type="range" min="2000" max="60000" step="1000" id="k1q" value="' + state.q + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="k1cv"></canvas>' +
        '<div class="dlist" id="k1steps"></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Margen que deja cada botella' : 'Margin each bottle leaves') + '</div><div class="mnum cs" id="k1cm"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Parte del precio que es margen' : 'Share of the price that is margin') + '</div><div class="mnum ts" id="k1cr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Punto de equilibrio' : 'Break-even volume') + '</div><div class="mnum ps" id="k1be"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Utilidad del mes' : 'Profit for the month') + '</div><div class="mnum cs" id="k1pr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Caída de ventas que aguanta' : 'Drop in sales it can absorb') + '</div><div class="mnum ts" id="k1ms"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Costo real de cada botella hoy' : 'Real cost of each bottle today') + '</div><div class="mnum ps" id="k1ac"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="k1read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.view = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#k1p').addEventListener('input', function() { state.p = parseInt(this.value, 10); update(); });
    host.querySelector('#k1v').addEventListener('input', function() { state.v = parseInt(this.value, 10); update(); });
    host.querySelector('#k1F').addEventListener('input', function() { state.F = parseInt(this.value, 10); update(); });
    host.querySelector('#k1q').addEventListener('input', function() { state.q = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var p = state.p, v = state.v, F = state.F, q = state.q;
    var cm  = contribUnit(p, v);
    var be  = breakEvenUnits(F, p, v);
    var pr  = profitAt(q, p, v, F);
    var ms  = safetyMargin(q, F, p, v);
    var lev = leverage(q, p, v, F);
    var ac  = q > 0 ? F / q + v : null;
    host.querySelector('#k1pl').textContent = money(p);
    host.querySelector('#k1vl').textContent = money(v);
    host.querySelector('#k1Fl').textContent = money(F);
    host.querySelector('#k1ql').textContent = es ? bottlesEs(q) : bottlesEn(q);
    host.querySelector('#k1cm').textContent = money(cm);
    host.querySelector('#k1cr').textContent = cm > 0 ? pct1(contribRatio(p, v)) : (es ? 'sin margen' : 'no margin');
    host.querySelector('#k1be').textContent = (be === null || be > 400000) ? (es ? 'inalcanzable' : 'out of reach') : (es ? bottlesEs(be) : bottlesEn(be));
    host.querySelector('#k1pr').textContent = pr >= 0 ? money(pr) : (es ? money(-pr) + ' de pérdida' : money(-pr) + ' of loss');
    host.querySelector('#k1ms').textContent = (ms === null || ms <= 0) ? (es ? 'ninguna' : 'none') : pct1(ms);
    host.querySelector('#k1ac').textContent = ac === null ? (es ? 'sin volumen' : 'no volume') : money2(ac);
    host.querySelector('#k1steps').textContent = es
      ? 'Cada botella se vende en ' + money(p) + ' y cuesta ' + money(v) + ' de material y mano de obra directa  ·  ' +
        'deja ' + money(cm) + ' para el costo fijo  ·  ' +
        'el costo fijo del mes es ' + money(F) + ', así que hacen falta ' + (be === null ? (es ? 'un margen positivo' : 'a positive margin') : bottlesEs(be)) + ' solo para cubrirlo  ·  ' +
        'las ' + bottlesEs(q) + ' que se venden dejan ' + (pr >= 0 ? money(pr) + ' de utilidad' : money(-pr) + ' de pérdida')
      : 'Each bottle sells for ' + money(p) + ' and costs ' + money(v) + ' in materials and direct labour  ·  ' +
        'it leaves ' + money(cm) + ' towards the fixed cost  ·  ' +
        'the fixed cost for the month is ' + money(F) + ', so ' + (be === null ? 'a positive margin' : bottlesEn(be)) + ' are needed just to cover it  ·  ' +
        'the ' + bottlesEn(q) + ' actually sold leave ' + (pr >= 0 ? money(pr) + ' of profit' : money(-pr) + ' of loss');
    var g = fitCanvas(host.querySelector('#k1cv'), 185);
    var qMax = Math.max(q * 1.6, (be === null ? q * 2 : be * 1.8), 8000);
    if (state.view === 'total') {
      drawCurveChart(g, 0, qMax, [
        { f: function(x) { return p * x; },     kind: 'gold',  label: (es ? 'Ingreso' : 'Revenue') },
        { f: function(x) { return F + v * x; }, kind: 'green', label: (es ? 'Costo total' : 'Total cost') }
      ], {
        yFloor: 0, fmtY: function(y) { return money(y); }, fmtX: function(x) { return intN(x); },
        hline: { y: F, label: (es ? 'Costo fijo' : 'Fixed cost') },
        marks: (be !== null && be <= qMax) ? [{ x: be, y: p * be, label: intN(be), kind: 'bad' }] : [],
        at: q,
        xLabel: (es ? 'botellas vendidas en el mes' : 'bottles sold in the month')
      });
    } else {
      drawCurveChart(g, Math.max(500, qMax * 0.02), qMax, [
        { f: function(x) { return F / x + v; }, kind: 'green', label: (es ? 'Costo real por botella' : 'Real cost per bottle') },
        { f: function() { return p; },          kind: 'gold',  label: (es ? 'Precio' : 'Price') }
      ], {
        fmtY: function(y) { return money2(y); }, fmtX: function(x) { return intN(x); },
        asym: { y: v, label: (es ? 'costo variable' : 'variable cost') },
        marks: (be !== null && be <= qMax) ? [{ x: be, y: p, label: intN(be), kind: 'bad' }] : [],
        at: q,
        xLabel: (es ? 'botellas producidas en el mes' : 'bottles produced in the month')
      });
    }
    host.querySelector('#k1read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> con un precio de ' + money(p) + ' y un costo variable de ' + money(v) + ', cada botella aporta ' + money(cm) + ' al costo fijo, es decir ' + pct1(contribRatio(p, v)) + ' de lo que paga el cliente. ' +
        (be === null
          ? 'Mientras el costo variable no baje del precio no existe punto de equilibrio: vender más solo agranda la pérdida, y ningún volumen arregla eso.'
          : 'El costo fijo de ' + money(F) + ' exige ' + bottlesEs(be) + ' antes de ganar un peso, y a partir de ahí cada botella adicional entrega su margen completo a la utilidad. ') +
        (pr > 0
          ? 'Con ' + bottlesEs(q) + ' vendidas el mes cierra en ' + money(pr) + ' y las ventas pueden caer ' + pct1(ms) + ' antes de que la planta vuelva a perder. Esa holgura es la cifra que conviene vigilar, porque una empresa puede estar ganando dinero y aun así estar a un mal mes del equilibrio. El multiplicador de ' + dec2(lev) + ' dice cuántas veces se amplifica en la utilidad cualquier cambio de ventas: es la ventaja del costo fijo cuando el mercado crece y su castigo exacto cuando se encoge.'
          : 'Con ' + bottlesEs(q) + ' vendidas la planta todavía no llega al equilibrio y el mes cierra en números rojos. El costo real de cada botella hoy es ' + money2(ac) + ', por encima del precio de ' + money(p) + ', y esa comparación explica la pérdida mejor que cualquier otra cifra.')
      : '<strong>Business reading:</strong> with a price of ' + money(p) + ' and a variable cost of ' + money(v) + ', each bottle contributes ' + money(cm) + ' towards the fixed cost, which is ' + pct1(contribRatio(p, v)) + ' of what the customer pays. ' +
        (be === null
          ? 'While the variable cost sits above the price there is no break-even point: selling more only widens the loss, and no volume repairs that.'
          : 'The fixed cost of ' + money(F) + ' demands ' + bottlesEn(be) + ' before a single peso is earned, and from there every extra bottle hands its whole margin to profit. ') +
        (pr > 0
          ? 'With ' + bottlesEn(q) + ' sold the month closes at ' + money(pr) + ' and sales can fall ' + pct1(ms) + ' before the plant goes back to losing money. That headroom is the figure worth watching, because a company can be making money and still sit one bad month away from break-even. The multiplier of ' + dec2(lev) + ' says how many times over any change in sales is amplified in profit: it is the advantage of fixed cost when the market grows and its exact penalty when the market shrinks.'
          : 'With ' + bottlesEn(q) + ' sold the plant has not reached break-even and the month closes in the red. The real cost of each bottle today is ' + money2(ac) + ', above the price of ' + money(p) + ', and that comparison explains the loss better than any other figure.');
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 2 · the price the market allows and the price that pays best
   ════════════════════════════════════════════════════════════════════════ */
function widgetPrice(p0, v0, b0, k0, F0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { view: 'profit', p: p0, v: v0, b: b0, k: k0, F: F0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'profit', es: 'Utilidad según el precio',  en: 'Profit against the price' },
      { id: 'demand', es: 'Botellas e ingreso',        en: 'Bottles and revenue' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.view ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="precio-cantidad-y-utilidad-maxima">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Subir el precio no siempre sube la utilidad' : 'Raising the price does not always raise profit') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'El área comercial de la empresa simulada midió cuántas botellas se pierden por cada peso que sube el precio, y con ese dato la utilidad deja de ser una opinión. La primera vista dibuja la utilidad del mes contra el precio: es una curva que sube, alcanza una cima y vuelve a bajar, y las dos rebanadas de esa curva se explican solas. A la izquierda de la cima el margen es tan flaco que conviene cobrar más aunque se vendan menos botellas; a la derecha ya se están espantando más clientes de los que el margen extra compensa. La marca dorada señala el precio que maximiza la utilidad y la marca gris el que maximiza el ingreso, y lo importante es que nunca coinciden: el ingreso no sabe nada del costo de producir. Cambia el costo variable y observa cómo la cima se recorre mientras la marca del ingreso se queda quieta. La segunda vista muestra de dónde sale todo eso, con las botellas cayendo en línea recta y el ingreso subiendo y bajando.'
          : 'The sales team of the simulated company measured how many bottles are lost for every peso added to the price, and with that figure profit stops being a matter of opinion. The first view draws the profit for the month against the price: a curve that rises, reaches a peak and comes back down, and the two halves of that curve explain themselves. To the left of the peak the margin is so thin that charging more pays even though fewer bottles leave; to the right the price is now scaring off more customers than the extra margin makes up for. The gold marker shows the price that maximises profit and the grey one the price that maximises revenue, and the point is that they never coincide: revenue knows nothing about what production costs. Change the variable cost and watch the peak slide while the revenue marker stays exactly where it was. The second view shows where all of it comes from, with bottles falling in a straight line and revenue rising and then falling.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Precio que se cobra hoy' : 'Price charged today') + ': <span class="cval" id="k2pl"></span></label>' +
          '<input type="range" min="12" max="40" step="1" id="k2p" value="' + state.p + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Costo variable de cada botella' : 'Variable cost of each bottle') + ': <span class="cval" id="k2vl"></span></label>' +
          '<input type="range" min="5" max="20" step="1" id="k2v" value="' + state.v + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Botellas perdidas por cada peso de aumento' : 'Bottles lost per peso of increase') + ': <span class="cval" id="k2bl"></span></label>' +
          '<input type="range" min="1200" max="5000" step="200" id="k2b" value="' + state.b + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Tamaño del mercado' : 'Size of the market') + ': <span class="cval" id="k2kl"></span></label>' +
          '<input type="range" min="3" max="9" step="1" id="k2k" value="' + state.k + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="k2cv"></canvas>' +
        '<div class="dlist" id="k2steps"></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Botellas a este precio' : 'Bottles at this price') + '</div><div class="mnum ts" id="k2q"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Utilidad a este precio' : 'Profit at this price') + '</div><div class="mnum cs" id="k2pr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Precio que más deja' : 'Price that pays best') + '</div><div class="mnum ps" id="k2bp"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Utilidad en ese precio' : 'Profit at that price') + '</div><div class="mnum cs" id="k2bpr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Precio que más ingreso da' : 'Price with the most revenue') + '</div><div class="mnum ts" id="k2rp"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Utilidad que se deja en la mesa' : 'Profit left on the table') + '</div><div class="mnum ps" id="k2gap"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="k2read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.view = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#k2p').addEventListener('input', function() { state.p = parseInt(this.value, 10); update(); });
    host.querySelector('#k2v').addEventListener('input', function() { state.v = parseInt(this.value, 10); update(); });
    host.querySelector('#k2b').addEventListener('input', function() { state.b = parseInt(this.value, 10); update(); });
    host.querySelector('#k2k').addEventListener('input', function() { state.k = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var p = state.p, v = state.v, b = state.b, k = state.k, F = state.F;
    var a   = 2 * b * k + b * p;
    var bp  = bestPrice(a, b, v);
    var rp  = revPrice(a, b);
    var q   = qAt(a, b, p);
    var pr  = profitAtPrice(a, b, v, F, p);
    var bpr = profitAtPrice(a, b, v, F, bp);
    var gap = bpr - pr;
    host.querySelector('#k2pl').textContent = money(p);
    host.querySelector('#k2vl').textContent = money(v);
    host.querySelector('#k2bl').textContent = es ? bottlesEs(b) : bottlesEn(b);
    host.querySelector('#k2kl').textContent = es ? bottlesEs(2 * b * k) : bottlesEn(2 * b * k);
    host.querySelector('#k2q').textContent   = es ? bottlesEs(Math.max(0, q)) : bottlesEn(Math.max(0, q));
    host.querySelector('#k2pr').textContent  = pr >= 0 ? money(pr) : money(-pr) + (es ? ' de pérdida' : ' of loss');
    host.querySelector('#k2bp').textContent  = money2(bp);
    host.querySelector('#k2bpr').textContent = bpr >= 0 ? money(bpr) : money(-bpr) + (es ? ' de pérdida' : ' of loss');
    host.querySelector('#k2rp').textContent  = money2(rp);
    host.querySelector('#k2gap').textContent = money(Math.max(0, gap));
    host.querySelector('#k2steps').textContent = es
      ? 'A ' + money(p) + ' la botella el mercado toma ' + bottlesEs(Math.max(0, q)) + '  ·  ' +
        'cada peso de aumento cuesta ' + bottlesEs(b) + '  ·  ' +
        'el precio que maximiza la utilidad es ' + money2(bp) + ' y el que maximiza el ingreso es ' + money2(rp) + '  ·  ' +
        'moverse al primero agrega ' + money(Math.max(0, gap)) + ' al mes'
      : 'At ' + money(p) + ' a bottle the market takes ' + bottlesEn(Math.max(0, q)) + '  ·  ' +
        'every peso of increase costs ' + bottlesEn(b) + '  ·  ' +
        'the price that maximises profit is ' + money2(bp) + ' and the one that maximises revenue is ' + money2(rp) + '  ·  ' +
        'moving to the first adds ' + money(Math.max(0, gap)) + ' a month';
    var g = fitCanvas(host.querySelector('#k2cv'), 185);
    var pLo = Math.max(v, 6), pHi = chokePrice(a, b);
    if (state.view === 'profit') {
      drawCurveChart(g, pLo, pHi, [
        { f: function(x) { return profitAtPrice(a, b, v, F, x); }, kind: 'green', label: (es ? 'Utilidad del mes' : 'Profit for the month') }
      ], {
        fmtY: function(y) { return moneyAx(y); }, fmtX: function(x) { return money2(x); },
        marks: [
          { x: bp, y: bpr, label: money2(bp), kind: 'gold' },
          { x: rp, y: profitAtPrice(a, b, v, F, rp), label: money2(rp), kind: 'soft' }
        ],
        at: p,
        xLabel: (es ? 'precio de la botella' : 'price of the bottle')
      });
    } else {
      drawCurveChart(g, pLo, pHi, [
        { f: function(x) { return revenueAtPrice(a, b, x) / 20; }, kind: 'gold',  label: (es ? 'Ingreso entre veinte' : 'Revenue over twenty') },
        { f: function(x) { return qAt(a, b, x); },                 kind: 'green', label: (es ? 'Botellas vendidas' : 'Bottles sold') }
      ], {
        yFloor: 0, fmtY: function(y) { return intN(y); }, fmtX: function(x) { return money2(x); },
        marks: [{ x: rp, y: qAt(a, b, rp), label: money2(rp), kind: 'soft' }],
        at: p,
        xLabel: (es ? 'precio de la botella' : 'price of the bottle')
      });
    }
    host.querySelector('#k2read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> a ' + money(p) + ' la empresa coloca ' + bottlesEs(Math.max(0, q)) + ' y el mes deja ' + (pr >= 0 ? money(pr) : money(-pr) + ' de pérdida') + '. El precio que más deja es ' + money2(bp) + ', con ' + (bpr >= 0 ? money(bpr) : money(-bpr) + ' de pérdida') + ', ' +
        (Math.abs(bp - p) < 0.51
          ? 'de modo que el precio actual está prácticamente en la cima y no hay gran cosa que ganar moviéndolo.'
          : (bp > p
            ? 'así que la empresa está cobrando de menos: le sobra demanda y le falta margen, y las ' + bottlesEs(Math.max(0, qAt(a, b, p) - qAt(a, b, bp))) + ' que perdería al subir valen menos que el margen que ganaría en todas las demás.'
            : 'así que la empresa está cobrando de más: el margen unitario se ve bien en el reporte, pero está comprado con un volumen que ya no compensa.')) +
        ' Fíjate en que el precio de máximo ingreso es ' + money2(rp) + ', siempre por debajo del de máxima utilidad, y la distancia entre los dos es exactamente la mitad del costo variable. Vender al precio de máximo ingreso significa regalar margen para inflar una cifra que ningún accionista se lleva a casa. La lección práctica es que el precio se decide con el costo variable en la mano, nunca con la cifra de ventas en la mano.'
      : '<strong>Business reading:</strong> at ' + money(p) + ' the company places ' + bottlesEn(Math.max(0, q)) + ' and the month leaves ' + (pr >= 0 ? money(pr) : money(-pr) + ' of loss') + '. The price that pays best is ' + money2(bp) + ', worth ' + (bpr >= 0 ? money(bpr) : money(-bpr) + ' of loss') + ', ' +
        (Math.abs(bp - p) < 0.51
          ? 'so the current price sits practically at the peak and there is little to gain by moving it.'
          : (bp > p
            ? 'so the company is charging too little: it has demand to spare and margin to find, and the ' + bottlesEn(Math.max(0, qAt(a, b, p) - qAt(a, b, bp))) + ' it would lose by raising the price are worth less than the margin it would gain on all the rest.'
            : 'so the company is charging too much: the unit margin looks good on the report, but it has been bought with a volume that no longer pays for it.')) +
        ' Notice that the revenue-maximising price is ' + money2(rp) + ', always below the profit-maximising one, and the distance between them is exactly half the variable cost. Selling at the revenue-maximising price means giving away margin to inflate a figure no shareholder takes home. The practical lesson is that price is decided with the variable cost in hand, never with the sales figure in hand.';
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 3 · the month closes with a profit and the bank account falls
   ════════════════════════════════════════════════════════════════════════ */
function widgetCash(S0, g0, c0, m0, F0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { view: 'cum', S: S0, g: g0, c: c0, m: m0, F: F0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'cum',   es: 'Acumulado del año',   en: 'Running total for the year' },
      { id: 'month', es: 'Mes por mes',         en: 'Month by month' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.view ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="utilidad-contable-contra-flujo-de-caja">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'La utilidad sube y la cuenta del banco baja' : 'Profit climbs while the bank account falls') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'La empresa simulada factura a las tiendas y cobra semanas después, pero paga a sus proveedores y a su gente dentro del mismo mes. Las dos curvas de la vista acumulada son la misma operación contada por dos calendarios: la verde es la utilidad que reporta contabilidad y la dorada es lo que de verdad hay en el banco. Con las ventas creciendo, las dos se separan mes con mes y la distancia entre ellas no es un error, es el dinero que está parado en la cuenta por cobrar de los clientes. Baja la proporción que se cobra dentro del mes y verás la curva dorada hundirse por debajo de cero mientras la verde sigue subiendo con toda tranquilidad. Sube el crecimiento y la separación se agranda todavía más, que es el resultado incómodo del tema: crecer rápido consume caja precisamente porque va bien. Pasa a la vista mensual para ver que la diferencia de cada mes depende de cuánto aumentaron las ventas ese mes y no del tamaño de la empresa.'
          : 'The simulated company invoices the shops and collects weeks later, but pays its suppliers and its people within the same month. The two curves in the running-total view are the same operation told by two calendars: the green one is the profit accounting reports and the gold one is what is actually in the bank. With sales growing, the two drift apart month after month, and the distance between them is not an error; it is the money parked in what customers still owe. Lower the share collected within the month and you will see the gold curve sink below zero while the green one keeps climbing quite calmly. Raise the growth rate and the separation widens further still, which is the uncomfortable result in this topic: growing fast burns cash precisely because things are going well. Switch to the monthly view to see that the difference in any month depends on how much sales rose that month and not on the size of the company.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Ventas del primer mes' : 'Sales in the first month') + ': <span class="cval" id="k3Sl"></span></label>' +
          '<input type="range" min="200000" max="900000" step="20000" id="k3S" value="' + state.S + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Crecimiento mensual de ventas' : 'Monthly growth in sales') + ': <span class="cval" id="k3gl"></span></label>' +
          '<input type="range" min="0" max="14" step="1" id="k3g" value="' + Math.round((state.g - 1) * 100) + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Parte que se cobra dentro del mes' : 'Share collected within the month') + ': <span class="cval" id="k3cl"></span></label>' +
          '<input type="range" min="20" max="100" step="5" id="k3c" value="' + Math.round(state.c * 100) + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Margen sobre ventas' : 'Margin on sales') + ': <span class="cval" id="k3ml"></span></label>' +
          '<input type="range" min="20" max="60" step="1" id="k3m" value="' + Math.round(state.m * 100) + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="k3cv"></canvas>' +
        '<div class="dlist" id="k3steps"></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Ventas del mes doce' : 'Sales in month twelve') + '</div><div class="mnum ts" id="k3s12"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Utilidad acumulada del año' : 'Profit for the year') + '</div><div class="mnum cs" id="k3pr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Caja acumulada del año' : 'Cash for the year') + '</div><div class="mnum ps" id="k3ca"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Dinero parado en cuentas por cobrar' : 'Money parked in receivables') + '</div><div class="mnum ts" id="k3ar"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Peor saldo de caja del año' : 'Worst cash balance of the year') + '</div><div class="mnum ps" id="k3lo"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Crédito que haría falta' : 'Credit line it would need') + '</div><div class="mnum cs" id="k3nd"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="k3read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.view = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#k3S').addEventListener('input', function() { state.S = parseInt(this.value, 10); update(); });
    host.querySelector('#k3g').addEventListener('input', function() { state.g = 1 + parseInt(this.value, 10) / 100; update(); });
    host.querySelector('#k3c').addEventListener('input', function() { state.c = parseInt(this.value, 10) / 100; update(); });
    host.querySelector('#k3m').addEventListener('input', function() { state.m = parseInt(this.value, 10) / 100; update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var S = state.S, g = state.g, c = state.c, m = state.m, F = state.F;
    function sales(t)   { return t < 1 ? 0 : S * Math.pow(g, t - 1); }
    function profitM(t) { return t < 1 ? 0 : m * sales(t) - F; }
    function cashM(t)   { return t < 1 ? 0 : collected(sales(t - 1), sales(t), c) - (1 - m) * sales(t) - F; }
    function cumP(t) { var s = 0, i; for (i = 1; i <= Math.floor(t); i++) s += profitM(i); return s; }
    function cumC(t) { var s = 0, i; for (i = 1; i <= Math.floor(t); i++) s += cashM(i); return s; }
    var lo = 0, i;
    for (i = 1; i <= 12; i++) { if (cumC(i) < lo) lo = cumC(i); }
    var p12 = cumP(12), c12 = cumC(12), ar12 = (1 - c) * sales(12);
    host.querySelector('#k3Sl').textContent = money(S);
    host.querySelector('#k3gl').textContent = pct0(g - 1);
    host.querySelector('#k3cl').textContent = pct0(c);
    host.querySelector('#k3ml').textContent = pct0(m);
    host.querySelector('#k3s12').textContent = money(sales(12));
    host.querySelector('#k3pr').textContent = p12 >= 0 ? money(p12) : money(-p12) + (es ? ' de pérdida' : ' of loss');
    host.querySelector('#k3ca').textContent = cashTxt(c12, es);
    host.querySelector('#k3ar').textContent = money(ar12);
    host.querySelector('#k3lo').textContent = lo < 0 ? money(-lo) + (es ? ' en rojo' : ' overdrawn') : (es ? 'nunca en rojo' : 'never overdrawn');
    host.querySelector('#k3nd').textContent = lo < 0 ? money(-lo) : (es ? 'ninguno' : 'none');
    host.querySelector('#k3steps').textContent = es
      ? 'Las ventas pasan de ' + money(sales(1)) + ' en el mes uno a ' + money(sales(12)) + ' en el mes doce  ·  ' +
        'el año reporta ' + yearProfitTxt(p12, true) + '  ·  ' +
        'la caja del mismo año deja ' + cashTxt(c12, true) + '  ·  ' +
        'la diferencia de ' + money(Math.abs(p12 - c12)) + ' está en lo que los clientes todavía deben'
      : 'Sales move from ' + money(sales(1)) + ' in month one to ' + money(sales(12)) + ' in month twelve  ·  ' +
        'the year reports ' + yearProfitTxt(p12, false) + '  ·  ' +
        'the cash of that same year comes to ' + cashTxt(c12, false) + '  ·  ' +
        'the difference of ' + money(Math.abs(p12 - c12)) + ' sits in what customers still owe';
    var gg = fitCanvas(host.querySelector('#k3cv'), 185);
    if (state.view === 'cum') {
      drawCurveChart(gg, 1, 12, [
        { f: function(x) { return cumP(x); }, kind: 'green', label: (es ? 'Utilidad acumulada' : 'Profit to date') },
        { f: function(x) { return cumC(x); }, kind: 'gold',  label: (es ? 'Caja acumulada' : 'Cash to date') }
      ], {
        fmtY: function(y) { return moneyAx(y); }, fmtX: function(x) { return intN(x); },
        xLabel: (es ? 'mes del año' : 'month of the year')
      });
    } else {
      drawCurveChart(gg, 1, 12, [
        { f: function(x) { return profitM(Math.floor(x)); }, kind: 'green', label: (es ? 'Utilidad del mes' : 'Profit of the month') },
        { f: function(x) { return cashM(Math.floor(x)); },   kind: 'gold',  label: (es ? 'Caja del mes' : 'Cash of the month') }
      ], {
        fmtY: function(y) { return moneyAx(y); }, fmtX: function(x) { return intN(x); },
        xLabel: (es ? 'mes del año' : 'month of the year')
      });
    }
    host.querySelector('#k3read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> con ventas que arrancan en ' + money(sales(1)) + ' y crecen ' + pct0(g - 1) + ' al mes, el año cierra con ' + yearProfitTxt(p12, true) + ' según contabilidad y ' + cashTxt(c12, true) + '. ' +
        (lo < 0
          ? 'El punto delicado no es el cierre sino el camino: el peor momento del año deja la cuenta ' + money(-lo) + ' en rojo, y ese es el tamaño exacto de la línea de crédito que la empresa tiene que negociar antes de necesitarla. Un banco presta con gusto a una empresa rentable que planeó su faltante y presta muy mal a la misma empresa el día que ya no tiene con qué pagar la nómina.'
          : 'Aquí la caja aguanta todo el año sin ponerse en rojo, pero conviene notar cuánto se estrecha: basta cobrar un poco más tarde o crecer un poco más rápido para que deje de aguantar.') +
        ' La cifra que explica todo es ' + money(ar12) + ', el dinero de la empresa que está en manos de sus clientes al cerrar el año. Ese dinero se ganó y se reportó, pero no se puede gastar. De ahí sale la advertencia que cierra el tema: la utilidad dice si el negocio sirve y la caja dice si sobrevive hasta que se note, y son dos preguntas distintas que se contestan con dos estados distintos.'
      : '<strong>Business reading:</strong> with sales starting at ' + money(sales(1)) + ' and growing ' + pct0(g - 1) + ' a month, the year closes with ' + yearProfitTxt(p12, false) + ' as accounting reports it and ' + cashTxt(c12, false) + '. ' +
        (lo < 0
          ? 'The delicate part is not the close but the road: the worst moment of the year leaves the account ' + money(-lo) + ' overdrawn, and that is the exact size of the credit line the company has to negotiate before it needs one. A bank lends happily to a profitable company that planned its shortfall and lends very badly to the same company on the day it cannot make payroll.'
          : 'Here the cash holds up all year without going into the red, but it is worth noticing how narrow the margin is: collecting a little later or growing a little faster is enough to break it.') +
        ' The figure that explains all of it is ' + money(ar12) + ', the money of the company sitting in the hands of its customers as the year closes. That money was earned and it was reported, but it cannot be spent. Hence the warning that closes this topic: profit tells you whether the business works and cash tells you whether it survives long enough for anyone to notice, and those are two different questions answered by two different statements.';
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 4 · the second line, judged at the rate the owners demand
   ════════════════════════════════════════════════════════════════════════ */
function widgetProject(I0, A0, n0, r0, mUnit, fExtra) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { view: 'rate', I: I0, A: A0, n: n0, r: r0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'rate', es: 'Valor del proyecto según la tasa', en: 'Value of the project against the rate' },
      { id: 'time', es: 'Lo recuperado año con año',        en: 'What has been recovered year by year' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.view ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="valor-del-proyecto-contra-la-tasa-exigida">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'La segunda línea de embotellado' : 'The second bottling line') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'La empresa simulada puede comprar una segunda línea que agrega botellas al mes durante varios años. La primera vista dibuja el valor del proyecto contra la tasa que la empresa exige a su dinero, y la curva baja siempre: cuanto más rinde la mejor alternativa, menos vale una promesa de flujos futuros. Donde la curva cruza el eje está la tasa interna de retorno, y la marca roja es la tasa que la empresa exige hoy. Todo lo que quede a la izquierda de ese cruce son condiciones en las que el proyecto conviene; lo que quede a la derecha son condiciones en las que no. La segunda vista responde otra pregunta con los mismos datos: cuánto lleva recuperado el proyecto año con año, ya descontado, contra la línea dorada de lo que costó. Donde la curva alcanza la línea, la máquina ya se pagó. Mueve la tasa y observa que el desembolso no se mueve, porque está fechado hoy, mientras todo lo demás se encoge.'
          : 'The simulated company can buy a second line that adds bottles every month for several years. The first view draws the value of the project against the rate the company demands of its money, and the curve always falls: the more the best alternative pays, the less a promise of future flows is worth. Where the curve crosses the axis is the internal rate of return, and the red marker is the rate the company demands today. Everything to the left of that crossing is conditions under which the project is worth doing; everything to the right is conditions under which it is not. The second view answers a different question with the same data: how much the project has recovered year by year, already discounted, against the gold line of what it cost. Where the curve reaches the line, the machine has paid for itself. Move the rate and notice that the outlay does not move, because it carries today as its date, while everything else shrinks.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Lo que cuesta la línea' : 'What the line costs') + ': <span class="cval" id="k4Il"></span></label>' +
          '<input type="range" min="600000" max="4000000" step="100000" id="k4I" value="' + state.I + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Efectivo extra de cada año' : 'Extra cash each year') + ': <span class="cval" id="k4Al"></span></label>' +
          '<input type="range" min="120000" max="1200000" step="20000" id="k4A" value="' + state.A + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Años de vida útil' : 'Years of useful life') + ': <span class="cval" id="k4nl"></span></label>' +
          '<input type="range" min="3" max="14" step="1" id="k4n" value="' + state.n + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Tasa que la empresa exige' : 'Rate the company demands') + ': <span class="cval" id="k4rl"></span></label>' +
          '<input type="range" min="4" max="30" step="1" id="k4r" value="' + Math.round(state.r * 100) + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="k4cv"></canvas>' +
        '<div class="dlist" id="k4steps"></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Valor que agrega el proyecto' : 'Value the project adds') + '</div><div class="mnum cs" id="k4npv"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Rendimiento del proyecto' : 'Return of the project') + '</div><div class="mnum ps" id="k4irr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Holgura antes del rechazo' : 'Headroom before rejection') + '</div><div class="mnum ts" id="k4hd"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Efectivo anual que necesitaría' : 'Annual cash it would need') + '</div><div class="mnum ts" id="k4nd"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Botellas al mes que lo justifican' : 'Bottles a month that justify it') + '</div><div class="mnum ps" id="k4bt"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Años en pagarse, ya descontado' : 'Years to pay for itself, discounted') + '</div><div class="mnum cs" id="k4pb"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="k4read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.view = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#k4I').addEventListener('input', function() { state.I = parseInt(this.value, 10); update(); });
    host.querySelector('#k4A').addEventListener('input', function() { state.A = parseInt(this.value, 10); update(); });
    host.querySelector('#k4n').addEventListener('input', function() { state.n = parseInt(this.value, 10); update(); });
    host.querySelector('#k4r').addEventListener('input', function() { state.r = parseInt(this.value, 10) / 100; update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var I = state.I, A = state.A, n = state.n, r = state.r;
    var npv  = npvLevel(I, A, r, n);
    var irr  = irrLevel(I, A, n);
    var need = flowForZero(I, r, n);
    var bott = (need / 12 + fExtra) / mUnit;
    var dp = null, acc = 0, i;
    for (i = 1; i <= n; i++) { acc += pvSingle(A, r, i); if (dp === null && acc >= I) dp = i; }
    host.querySelector('#k4Il').textContent = money(I);
    host.querySelector('#k4Al').textContent = money(A);
    host.querySelector('#k4nl').textContent = intN(n) + (es ? ' años' : ' years');
    host.querySelector('#k4rl').textContent = pctS(r) + (es ? ' por ciento' : ' percent');
    host.querySelector('#k4npv').textContent = npvTxt(npv, es);
    host.querySelector('#k4irr').textContent = irr === null ? (es ? 'no existe' : 'none') : pct2(irr);
    host.querySelector('#k4hd').textContent  = irr === null ? (es ? 'ninguna' : 'none') : (es ? ptsEs(irr - r) : ptsEn(irr - r));
    host.querySelector('#k4nd').textContent  = money(need);
    host.querySelector('#k4bt').textContent  = bott > 0 ? (es ? bottlesEs(bott) : bottlesEn(bott)) : (es ? 'ninguna alcanza' : 'no volume works');
    host.querySelector('#k4pb').textContent  = dp === null ? (es ? 'nunca' : 'never') : intN(dp) + (es ? ' años' : ' years');
    host.querySelector('#k4steps').textContent = es
      ? 'La línea cuesta ' + money(I) + ' y promete ' + money(A) + ' al año durante ' + intN(n) + ' años  ·  ' +
        'traídos al día de la decisión al ' + pctS(r) + ' por ciento valen ' + money(pvAnnuity(A, r, n)) + '  ·  ' +
        'contra el desembolso queda ' + npvTxt(npv, true) + '  ·  ' +
        'para quedar en tablas bastaría con ' + money(need) + ' al año'
      : 'The line costs ' + money(I) + ' and promises ' + money(A) + ' a year for ' + intN(n) + ' years  ·  ' +
        'carried to the day of the decision at ' + pctS(r) + ' percent they are worth ' + money(pvAnnuity(A, r, n)) + '  ·  ' +
        'against the outlay that leaves ' + npvTxt(npv, false) + '  ·  ' +
        'to come out exactly even ' + money(need) + ' a year would be enough';
    var gg = fitCanvas(host.querySelector('#k4cv'), 185);
    if (state.view === 'rate') {
      drawCurveChart(gg, 0.01, 0.45, [
        { f: function(x) { return npvLevel(I, A, x, n); }, kind: 'green', label: (es ? 'Valor del proyecto' : 'Value of the project') }
      ], {
        fmtY: function(y) { return moneyAx(y); }, fmtX: function(x) { return pctS(x) + '%'; },
        marks: irr === null ? [] : [{ x: irr, y: 0, label: pct2(irr), kind: 'gold' }],
        at: r,
        xLabel: (es ? 'tasa que la empresa exige' : 'rate the company demands')
      });
    } else {
      drawCurveChart(gg, 0, n, [
        { f: function(x) { return pvAnnuity(A, r, x); }, kind: 'green', label: (es ? 'Recuperado y descontado' : 'Recovered, discounted') },
        { f: function(x) { return A * x; },              kind: 'soft',  label: (es ? 'Sin descontar' : 'Undiscounted') }
      ], {
        yFloor: 0, fmtY: function(y) { return money(y); }, fmtX: function(x) { return intN(x); },
        hline: { y: I, label: (es ? 'Lo que costó' : 'What it cost') },
        marks: dp === null ? [] : [{ x: dp, y: I, label: intN(dp) + (es ? ' años' : ' years'), kind: 'bad' }],
        xLabel: (es ? 'años transcurridos' : 'years elapsed')
      });
    }
    host.querySelector('#k4read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> la línea pide ' + money(I) + ' hoy y devuelve ' + money(A) + ' de efectivo cada año durante ' + intN(n) + ' años. A la tasa exigida de ' + pctS(r) + ' por ciento esos flujos valen hoy ' + money(pvAnnuity(A, r, n)) + ' y el proyecto queda con ' + npvTxt(npv, true) + '. ' +
        (npv >= 0
          ? 'Conviene comprarla, y el argumento para los socios es que la empresa vale esa cantidad más el mismo día de la firma, ya pagado el rendimiento que le exigen a su dinero. La holgura hasta ' + (irr === null ? (es ? 'el cruce' : 'the crossing') : pct2(irr)) + ' dice cuánto pueden empeorar las condiciones antes de que la respuesta cambie.'
          : 'No conviene comprarla a esta tasa. Fíjate en que el proyecto puede seguir dando utilidad contable y aun así destruir valor: lo que falla no es que pierda dinero, es que la empresa tiene mejores usos para el mismo capital.') +
        ' Lo que amarra este tema con los anteriores es la última cifra del tablero. Para quedar en tablas la línea necesitaría ' + money(need) + ' de efectivo al año, lo que equivale a colocar ' + (bott > 0 ? bottlesEs(bott) : (es ? 'un volumen imposible' : 'an impossible volume')) + ' adicionales cada mes al margen actual. Así la decisión de inversión se vuelve una pregunta de ventas, que es una pregunta que el área comercial sí puede contestar.'
      : '<strong>Business reading:</strong> the line asks for ' + money(I) + ' today and returns ' + money(A) + ' of cash every year for ' + intN(n) + ' years. At the required rate of ' + pctS(r) + ' percent those flows are worth ' + money(pvAnnuity(A, r, n)) + ' today and the project ends up with ' + npvTxt(npv, false) + '. ' +
        (npv >= 0
          ? 'It is worth buying, and the argument for the partners is that the company is worth that much more on the very day the deal is signed, after paying the return they demand of their money. The headroom up to ' + (irr === null ? 'the crossing' : pct2(irr)) + ' says how far conditions can worsen before the answer changes.'
          : 'It is not worth buying at this rate. Notice that the project can still post an accounting profit and destroy value all the same: the fault is not that it loses money, it is that the company has better uses for the same capital.') +
        ' What ties this topic to the earlier ones is the last figure on the panel. To come out exactly even the line would need ' + money(need) + ' of cash a year, which amounts to placing ' + (bott > 0 ? bottlesEn(bott) : 'an impossible volume') + ' extra bottles every month at the current margin. That turns the investment decision into a sales question, and a sales question is one the commercial team can actually answer.';
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   LESSON CONTENT
   ════════════════════════════════════════════════════════════════════════ */
function mk(i18n, correctIdx, showWork) {
  return {
    i18n: i18n, correctIdx: correctIdx, showWork: showWork,
    title: i18n.title[LANG], questionText: i18n.q[LANG],
    hint: i18n.hint[LANG], explanation: i18n.exp[LANG],
    options: i18n.opts[LANG].slice()
  };
}
function frac(a, b) {
  return '<span class="mf-outer"><span class="mf-num">' + a + '</span><span class="mf-den">' + b + '</span></span>';
}
/* The market size and the current price are drawn separately, and for one
   pair of draws the price that pays best lands exactly on the price already
   being charged. That would leave a graded item with two identical options
   and nothing to decide, so the market size is nudged one step. */
function fixK(p0, v, k) { return (p0 === 2 * k + v) ? (k === 6 ? 4 : k + 1) : k; }

function buildLesson(rng) {
  problems = []; sectionDefs = []; widgets = [];
  document.getElementById('lessonBody').innerHTML = '';

  /* ── every number in the guide comes from the seeded rng ── */
  /* Concept 1 · what it costs to run the plant */
  var c1v = pick([9, 11, 13], rng);
  var c1p = pick([19, 21, 23], rng);
  var c1Q = pick([12000, 15000, 18000], rng);
  var c1F = (c1p - c1v) * c1Q;
  var c1q = c1Q + pick([6000, 9000, 12000], rng);
  var w1p = pick([19, 21, 23], rng);                    // widget 1 opening state
  var w1v = pick([9, 11, 13], rng);
  var w1F = pick([120000, 180000, 240000], rng);
  var w1q = pick([20000, 28000, 36000], rng);
  var p1v = pick([9, 11, 13], rng);                     // item 1
  var p1p = pick([19, 21, 23], rng);
  var p1Q = pick([9000, 12000, 14000], rng);
  var p1F = (p1p - p1v) * p1Q;
  var p2q  = pick([14000, 16000, 18000], rng);          // item 2
  var p2mA = pick([12, 14], rng);
  var p2mB = pick([7, 8], rng);
  var p2P  = pick([50000, 60000, 70000], rng);
  var p2FA = p2mA * p2q - p2P;
  var p2FB = p2mB * p2q - p2P;
  var p2d  = pick([0.15, 0.20, 0.25], rng);

  /* Concept 2 · what the market lets the plant charge */
  var c2v  = pick([9, 11, 13], rng);
  var c2p0 = pick([19, 21, 23], rng);
  var c2b  = pick([2400, 3000, 3600], rng);
  var c2k  = fixK(c2p0, c2v, pick([4, 5, 6], rng));
  var c2q0 = 2 * c2b * c2k;
  var c2F  = Math.round((c2p0 - c2v) * c2q0 * pick([0.40, 0.50, 0.60], rng) / 10000) * 10000;
  var w2p  = pick([19, 21, 23], rng);                   // widget 2 opening state
  var w2v  = pick([9, 11, 13], rng);
  var w2b  = pick([2400, 3000, 3600], rng);
  var w2k  = pick([4, 5, 6], rng);
  var w2F  = Math.round((w2p - w2v) * 2 * w2b * w2k * pick([0.40, 0.50, 0.60], rng) / 10000) * 10000;
  var p3v  = pick([9, 11, 13], rng);                    // item 3
  var p3p0 = pick([19, 21, 23], rng);
  var p3b  = pick([2400, 3000, 3600], rng);
  var p3k  = fixK(p3p0, p3v, pick([4, 5, 6], rng));
  var p3q0 = 2 * p3b * p3k;
  var p4v  = pick([9, 11, 13], rng);                    // item 4
  var p4p0 = pick([19, 21, 23], rng);
  var p4b  = pick([2400, 3000, 3600], rng);
  var p4k  = fixK(p4p0, p4v, pick([4, 5, 6], rng));
  var p4q0 = 2 * p4b * p4k;

  /* Concept 3 · when the money actually moves */
  var c3S = pick([420000, 480000, 540000], rng);
  var c3g = pick([1.06, 1.08, 1.10], rng);
  var c3c = pick([0.55, 0.65, 0.75], rng);
  var c3m = pick([0.36, 0.40, 0.44], rng);
  var c3F = pick([90000, 120000, 150000], rng);
  var w3S = pick([300000, 420000, 540000], rng);        // widget 3 opening state
  var w3g = pick([1.06, 1.09, 1.12], rng);
  var w3c = pick([0.45, 0.55, 0.65], rng);
  var w3m = pick([0.34, 0.40, 0.46], rng);
  var w3F = pick([90000, 120000, 150000], rng);
  var p5S1 = pick([420000, 480000, 540000], rng);       // item 5
  var p5gr = pick([1.15, 1.25, 1.35], rng);
  var p5S2 = Math.round(p5S1 * p5gr / 10000) * 10000;
  var p5c  = pick([0.55, 0.60, 0.70], rng);
  var p6P  = pick([180000, 240000, 300000], rng);       // item 6
  var p6AR = Math.round(p6P * pick([1.05, 1.15, 1.25], rng) / 10000) * 10000;
  var p6In = Math.round(p6P * pick([0.40, 0.50, 0.60], rng) / 10000) * 10000;
  var p6AP = Math.round(p6P * pick([0.15, 0.25, 0.35], rng) / 10000) * 10000;

  /* Concept 4 · whether the second line is worth buying */
  var c4q = pick([4000, 5000, 6000], rng);
  var c4m = pick([8, 10, 12], rng);
  var c4f = pick([12000, 16000, 20000], rng);
  var c4n = pick([5, 6, 7], rng);
  var c4r = pick([0.12, 0.14, 0.16], rng);
  var c4A = (c4m * c4q - c4f) * 12;
  var c4I = Math.round(pvAnnuity(c4A, c4r, c4n) * pick([0.72, 0.78, 0.84], rng) / 10000) * 10000;
  var w4I = pick([1200000, 1800000, 2400000], rng);     // widget 4 opening state
  var w4A = pick([320000, 460000, 600000], rng);
  var w4n = pick([6, 8, 10], rng);
  var w4r = pick([0.10, 0.13, 0.16], rng);
  var w4m = pick([8, 10, 12], rng);
  var w4f = pick([12000, 16000, 20000], rng);

  /* Final assessment */
  var p7q = pick([4000, 5000, 6000], rng);              // item 7
  var p7m = pick([8, 10, 12], rng);
  var p7f = pick([12000, 16000, 20000], rng);
  var p7n = pick([5, 6, 7], rng);
  var p7r = pick([0.12, 0.14, 0.16], rng);
  var p7A = (p7m * p7q - p7f) * 12;
  var p7I = Math.round(pvAnnuity(p7A, p7r, p7n) * pick([0.72, 0.78, 0.84], rng) / 10000) * 10000;
  var p8I = pick([1800000, 2400000, 3000000], rng);     // item 8
  var p8n = pick([5, 6, 7], rng);
  var p8r = pick([0.12, 0.14, 0.16], rng);
  var p8m = pick([8, 10, 12], rng);
  var p8f = pick([12000, 16000, 20000], rng);
  var p9I  = pick([1500000, 2000000, 2500000], rng);    // item 9
  var p9np = pick([240000, 320000, 400000], rng);
  var p9sh = pick([180000, 260000, 340000], rng);
  var p10v  = pick([9, 11, 13], rng);                   // item 10
  var p10p0 = pick([19, 21, 23], rng);
  var p10b  = pick([2400, 3000, 3600], rng);
  var p10k  = fixK(p10p0, p10v, pick([4, 5, 6], rng));
  var p10q0 = 2 * p10b * p10k;
  var p10F  = Math.round((p10p0 - p10v) * p10q0 * pick([0.40, 0.50, 0.60], rng) / 10000) * 10000;

  /* ═══════════════════════ CONCEPT 1 ═══════════════════════ */
  var c1cm  = contribUnit(c1p, c1v);
  var c1cr  = contribRatio(c1p, c1v);
  var c1pr  = profitAt(c1q, c1p, c1v, c1F);
  var c1ms  = safetyMargin(c1q, c1F, c1p, c1v);
  var c1lev = leverage(c1q, c1p, c1v, c1F);
  var c1ac  = c1F / c1q + c1v;
  var c1bp  = breakEvenPesos(c1F, c1p, c1v);

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 1</div>' +
      '<h2>La empresa simulada y su estructura de costos</h2>' +
      '<p>A lo largo de esta guía diriges una sola empresa. Es una embotelladora de agua de limón instalada en Colima que vende a tiendas de abarrotes y a cadenas regionales, y en cada bloque tendrás que tomar una decisión distinta sobre ella: cuánto producir, a qué precio venderla, cómo financiar el mes y si comprar o no una segunda línea. La gracia del caso integrador es que las cuatro decisiones son la misma empresa vista desde cuatro ángulos, y que una respuesta correcta en un bloque puede ser una mala decisión si se ignora lo que dicen los otros tres.</p>' +
      '<p>Todo empieza por separar los costos según se comporten, no según quién los firme. El <strong>costo variable</strong> aparece solo cuando se produce una botella más: el concentrado, el envase, la etiqueta, la energía de la línea. El <strong>costo fijo</strong> se paga aunque la línea esté detenida: la renta de la nave, los sueldos administrativos, el seguro, la depreciación. Esa división parece contable y es en realidad la herramienta de decisión más útil del curso, porque solo el costo variable cambia cuando cambia el volumen.</p>' +
      '<p>De ahí sale el <strong>margen de contribución</strong>, que es lo que deja cada botella después de pagarse a sí misma. Ese sobrante no es utilidad todavía: primero tiene que ir juntándose hasta cubrir el costo fijo completo del mes. El volumen en el que termina de cubrirlo es el <strong>punto de equilibrio</strong>, y a partir de esa botella exacta cada unidad adicional entrega su margen íntegro a la utilidad. Por eso las empresas con mucho costo fijo viven pendientes del volumen: no porque vender más las haga eficientes, sino porque su equilibrio está lejos.</p>' +
      '<p>Dos cifras terminan de leer la salud del mes. El <strong>margen de seguridad</strong> mide cuánto pueden caer las ventas antes de volver al equilibrio, y es la respuesta honesta a la pregunta de qué tan cómoda está la empresa. El <strong>apalancamiento operativo</strong> mide cuántas veces se amplifica en la utilidad cualquier cambio de ventas, y explica por qué dos empresas con la misma utilidad pueden reaccionar de forma opuesta a la misma caída del mercado. Conviene además desconfiar del costo unitario promedio: cambia cada vez que cambia el volumen, así que sirve para reportar y es pésimo para decidir.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Margen por botella</div><div class="rform">precio − costo variable</div><div class="rnote">Lo que queda para el costo fijo.</div></div>' +
        '<div class="rcard"><div class="rname">Punto de equilibrio</div><div class="rform">' + frac('costo fijo', 'margen') + '</div><div class="rnote">Volumen que no deja ni pierde.</div></div>' +
        '<div class="rcard"><div class="rname">Utilidad del mes</div><div class="rform">margen · q − costo fijo</div><div class="rnote">Solo el excedente del equilibrio.</div></div>' +
        '<div class="rcard"><div class="rname">Margen de seguridad</div><div class="rform">' + frac('q − equilibrio', 'q') + '</div><div class="rnote">Caída que aguanta sin perder.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> La embotelladora vende cada botella en ' + money(c1p) + ' y su costo variable es de ' + money(c1v) + '. Los costos fijos del mes suman ' + money(c1F) + ' y en el mes que acaba de cerrar colocó ' + bottlesEs(c1q) + '.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> Cada botella deja ' + money(c1cm) + ' después de pagar su propio material, es decir ' + pct1(c1cr) + ' de lo que paga el cliente.<br>' +
      '<strong>Paso 2.</strong> Ese margen tiene que juntar los ' + money(c1F) + ' de costo fijo, lo que ocurre en ' + bottlesEs(c1Q) + '. Medido en dinero, el equilibrio equivale a ' + money(c1bp) + ' de venta.<br>' +
      '<strong>Paso 3.</strong> Las ' + bottlesEs(c1q) + ' vendidas superan el equilibrio, y solo ese excedente genera utilidad: el mes cierra en ' + money(c1pr) + '.<br>' +
      '<strong>Paso 4.</strong> Las ventas pueden caer ' + pct1(c1ms) + ' antes de volver al equilibrio, y cualquier cambio porcentual en las ventas se amplifica ' + dec2(c1lev) + ' veces en la utilidad.<br>' +
      '<strong>Lectura de negocio.</strong> La planta gana dinero y todavía tiene holgura, pero conviene mirar el costo unitario promedio antes de cerrar el análisis. Con el volumen de este mes cada botella cuesta en realidad ' + money2(c1ac) + ', por encima del costo variable de ' + money(c1v) + '. Si el mes entrante se venden menos botellas, ese costo promedio subirá sin que ningún proveedor haya cambiado un precio, y quien decida con esa cifra concluirá que la planta se volvió ineficiente cuando lo único que pasó fue que el costo fijo se repartió entre menos unidades.</p></div>';
    return '' +
      '<div class="stag">Concept 1</div>' +
      '<h2>The simulated company and its cost structure</h2>' +
      '<p>Through this whole guide you run a single company. It is a lime water bottling plant in Colima selling to grocery shops and to regional chains, and in each block you will have to take a different decision about it: how much to produce, what price to charge, how to fund the month, and whether or not to buy a second line. The point of an integrative case is that the four decisions are the same company seen from four angles, and that a right answer in one block can still be a bad decision if it ignores what the other three are saying.</p>' +
      '<p>Everything starts by separating costs according to how they behave rather than according to who signs for them. <strong>Variable cost</strong> appears only when one more bottle is produced: the concentrate, the container, the label, the electricity the line draws. <strong>Fixed cost</strong> is paid whether the line runs or not: the rent on the plant, the administrative salaries, the insurance, the depreciation. That split looks like an accounting exercise and is in fact the most useful decision tool in the course, because only variable cost changes when volume changes.</p>' +
      '<p>Out of it comes the <strong>contribution margin</strong>, which is what each bottle leaves behind after paying for itself. That surplus is not profit yet: first it has to accumulate until it covers the whole fixed cost of the month. The volume at which it finishes covering it is the <strong>break-even point</strong>, and from that exact bottle onwards every additional unit hands its full margin to profit. That is why companies with heavy fixed cost live and die by volume: not because selling more makes them efficient, but because their break-even sits a long way out.</p>' +
      '<p>Two more figures finish reading the health of the month. The <strong>margin of safety</strong> measures how far sales can fall before returning to break-even, and it is the honest answer to the question of how comfortable the company really is. <strong>Operating leverage</strong> measures how many times over any change in sales is amplified in profit, and it explains why two companies with the same profit can react in opposite ways to the same fall in the market. It is also worth distrusting the average unit cost: it changes every time volume changes, so it is fine for reporting and poor for deciding.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Margin per bottle</div><div class="rform">price − variable cost</div><div class="rnote">What is left for the fixed cost.</div></div>' +
        '<div class="rcard"><div class="rname">Break-even point</div><div class="rform">' + frac('fixed cost', 'margin') + '</div><div class="rnote">Volume that neither gains nor loses.</div></div>' +
        '<div class="rcard"><div class="rname">Profit for the month</div><div class="rform">margin · q − fixed cost</div><div class="rnote">Only the excess over break-even.</div></div>' +
        '<div class="rcard"><div class="rname">Margin of safety</div><div class="rform">' + frac('q − break-even', 'q') + '</div><div class="rnote">Fall it absorbs without a loss.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> The bottling plant sells each bottle at ' + money(c1p) + ' and its variable cost is ' + money(c1v) + '. Fixed costs for the month add up to ' + money(c1F) + ' and in the month just closed it placed ' + bottlesEn(c1q) + '.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> Each bottle leaves ' + money(c1cm) + ' after paying for its own materials, which is ' + pct1(c1cr) + ' of what the customer pays.<br>' +
      '<strong>Step 2.</strong> That margin has to gather the ' + money(c1F) + ' of fixed cost, which happens at ' + bottlesEn(c1Q) + '. Measured in money, break-even is ' + money(c1bp) + ' of sales.<br>' +
      '<strong>Step 3.</strong> The ' + bottlesEn(c1q) + ' sold clear the break-even point, and only that excess produces profit: the month closes at ' + money(c1pr) + '.<br>' +
      '<strong>Step 4.</strong> Sales can fall ' + pct1(c1ms) + ' before returning to break-even, and any percentage change in sales is amplified ' + dec2(c1lev) + ' times over in profit.<br>' +
      '<strong>Business reading.</strong> The plant makes money and still has headroom, but it is worth looking at the average unit cost before closing the analysis. At this month’s volume each bottle really costs ' + money2(c1ac) + ', above the variable cost of ' + money(c1v) + '. If fewer bottles sell next month that average will rise without any supplier having changed a price, and whoever decides with that figure will conclude the plant became inefficient when all that happened is that the fixed cost was spread over fewer units.</p></div>';
  });

  widgetCVP(w1p, w1v, w1F, w1q);

  /* ── Item 1 ── */
  var o1 = valOpts2(p1Q, [p1F / p1p, p1F / p1v, p1F / (p1p + p1v)], bottlesEs, bottlesEn, rng);
  var q1i = {
    title: { es: 'El volumen que la planta necesita para no perder', en: 'The volume the plant needs in order not to lose' },
    q: { es: 'La embotelladora prepara el presupuesto del mes entrante. Cada botella se vende en ' + money(p1p) + ', el material y la mano de obra directa de cada botella cuestan ' + money(p1v) + ', y la renta de la nave, los sueldos administrativos y el seguro suman ' + money(p1F) + ' al mes se produzca lo que se produzca. La dirección quiere saber por dónde empieza a ganar antes de comprometer la producción. ¿Cuántas botellas tiene que colocar en el mes para no ganar ni perder?',
        en: 'The bottling plant is preparing next month’s budget. Each bottle sells for ' + money(p1p) + ', the materials and direct labour in each bottle cost ' + money(p1v) + ', and the plant rent, the administrative salaries and the insurance add up to ' + money(p1F) + ' a month whatever gets produced. Management wants to know where it starts to earn before committing the production run. How many bottles does it have to place in the month in order neither to gain nor to lose?' },
    opts: { es: o1.es, en: o1.en },
    hint: { es: 'Fíjate en que hay dos costos con comportamientos distintos y que solo uno de ellos crece cuando sale otra botella. Averigua primero cuánto deja cada botella una vez pagada ella misma, y después cuántas veces cabe esa cantidad dentro del costo que se paga pase lo que pase. El costo fijo no se reparte antes de hacer la división: se cubre con lo que las botellas van dejando.',
            en: 'Notice that there are two costs behaving in different ways and that only one of them grows when another bottle comes off the line. Work out first how much each bottle leaves once it has paid for itself, and then how many times that amount fits inside the cost that gets paid no matter what. The fixed cost is not spread out before the division: it is covered by what the bottles leave behind.' },
    exp: { es: 'Cada botella se vende en ' + money(p1p) + ' y cuesta ' + money(p1v) + ', así que deja ' + money(p1p - p1v) + ' para el costo fijo. Los ' + money(p1F) + ' de costo fijo quedan cubiertos con ' + bottlesEs(p1Q) + ', y esa es la respuesta. La opción de ' + bottlesEs(p1F / p1p) + ' divide el costo fijo entre el precio completo, como si la botella no tuviera costo propio: siempre queda corta y llevaría a la planta a producir por debajo del equilibrio creyendo que ya lo alcanzó. La de ' + bottlesEs(p1F / p1v) + ' divide entre el costo variable en lugar del margen, que es confundir lo que la botella cuesta con lo que la botella deja. Y la de ' + bottlesEs(p1F / (p1p + p1v)) + ' suma el precio y el costo cuando la operación es restarlos, un desliz de signo que infla el margen y hace parecer que el equilibrio está mucho más cerca de lo que está.',
           en: 'Each bottle sells for ' + money(p1p) + ' and costs ' + money(p1v) + ', so it leaves ' + money(p1p - p1v) + ' towards the fixed cost. The ' + money(p1F) + ' of fixed cost is covered at ' + bottlesEn(p1Q) + ', and that is the answer. The option of ' + bottlesEn(p1F / p1p) + ' divides the fixed cost by the full price, as though the bottle had no cost of its own: it always falls short and would have the plant producing below break-even believing it had already cleared it. The one of ' + bottlesEn(p1F / p1v) + ' divides by the variable cost instead of the margin, which confuses what a bottle costs with what a bottle leaves. And the one of ' + bottlesEn(p1F / (p1p + p1v)) + ' adds the price and the cost when the operation is to subtract them, a slip of sign that inflates the margin and makes break-even look far closer than it is.' }
  };
  var d1 = mk(q1i, o1.correctIdx, true);
  problems.push({ i18n: d1.i18n, title: d1.title, questionText: d1.questionText, options: d1.options, correctIdx: d1.correctIdx, explanation: d1.explanation, hint: d1.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 2 ── */
  var s2beA = breakEvenUnits(p2FA, p2mA, 0);
  var s2beB = breakEvenUnits(p2FB, p2mB, 0);
  var s2prA = p2mA * p2q * (1 - p2d) - p2FA;
  var s2prB = p2mB * p2q * (1 - p2d) - p2FB;
  var o2 = shuffleOpts(
    ['Que la línea de vidrio es la expuesta, porque su costo fijo de ' + money(p2FA) + ' obliga a vender ' + bottlesEs(s2beA) + ' antes de ganar un peso y una caída de ' + pct0(p2d) + ' le quita ' + money(p2mA * p2q * p2d) + ' de margen contra los ' + money(p2mB * p2q * p2d) + ' que pierde la otra.',
     'Que las dos líneas quedan igual de expuestas, porque hoy ganan lo mismo y una caída del mismo porcentaje sobre el mismo volumen tiene que producir por fuerza el mismo efecto en las dos.',
     'Que la línea de plástico es la expuesta, porque su margen por botella de ' + money(p2mB) + ' es el más flaco de las dos y una caída de ventas golpea siempre más fuerte donde el margen es menor.',
     'Que no puede saberse cuál está más expuesta mientras no se conozca el precio de venta de cada presentación, ya que sin el precio ninguna de las dos líneas puede compararse con la otra.'],
    ['That the glass line is the exposed one, because its fixed cost of ' + money(p2FA) + ' forces it to sell ' + bottlesEn(s2beA) + ' before it earns a peso, and a fall of ' + pct0(p2d) + ' strips ' + money(p2mA * p2q * p2d) + ' of margin from it against the ' + money(p2mB * p2q * p2d) + ' the other one loses.',
     'That the two lines are equally exposed, because they earn the same today and a fall of the same percentage on the same volume must necessarily produce the same effect on both.',
     'That the plastic line is the exposed one, because its margin per bottle of ' + money(p2mB) + ' is the thinner of the two and a fall in sales always hits hardest where the margin is smaller.',
     'That nothing can be said about which is more exposed until the selling price of each format is known, since without the price neither line can be compared with the other.'], rng);
  var q2i = {
    title: { es: 'Dos presentaciones con la misma utilidad', en: 'Two formats with the same profit' },
    q: { es: 'La embotelladora corre dos presentaciones que este mes vendieron ' + bottlesEs(p2q) + ' cada una y cerraron con la misma utilidad de ' + money(p2P) + '. La de vidrio retornable deja ' + money(p2mA) + ' de margen por botella y arrastra ' + money(p2FA) + ' de costo fijo mensual; la de plástico deja ' + money(p2mB) + ' por botella y arrastra ' + money(p2FB) + '. El área comercial anticipa que el mercado se contraerá ' + pct0(p2d) + ' el mes entrante. ¿Qué debe reportar el analista sobre cuál de las dos presentaciones está más expuesta?',
        en: 'The bottling plant runs two formats that each sold ' + bottlesEn(p2q) + ' this month and closed with the same profit of ' + money(p2P) + '. The returnable glass format leaves ' + money(p2mA) + ' of margin per bottle and carries ' + money(p2FA) + ' of monthly fixed cost; the plastic one leaves ' + money(p2mB) + ' per bottle and carries ' + money(p2FB) + '. The commercial team expects the market to contract ' + pct0(p2d) + ' next month. What should the analyst report about which of the two formats is more exposed?' },
    hint: { es: 'La utilidad de hoy es la misma, así que no dice nada sobre el riesgo. Pregúntate qué pierde cada presentación cuando deja de vender una botella, y recuerda que el costo fijo sigue ahí completo aunque el volumen baje. La presentación que vive de un margen ancho es también la que más margen pierde por cada botella que no sale.',
            en: 'Profit today is identical, so it says nothing about risk. Ask yourself what each format loses when it stops selling one bottle, and remember that the fixed cost stays there in full even when volume drops. The format that lives off a wide margin is also the one that loses the most margin for every bottle that does not leave.' },
    opts: { es: o2.es, en: o2.en },
    exp: { es: 'La utilidad idéntica de hoy esconde dos estructuras opuestas. La línea de vidrio necesita ' + bottlesEs(s2beA) + ' para cubrir su costo fijo y la de plástico solo ' + bottlesEs(s2beB) + ', de modo que la primera opera mucho más cerca de su punto de equilibrio en términos relativos y pierde ' + money(p2mA * p2q * p2d) + ' de margen ante la caída, contra ' + money(p2mB * p2q * p2d) + ' de la segunda. Tras la contracción el vidrio queda en ' + profitTxt(s2prA, true) + ' y el plástico en ' + profitTxt(s2prB, true) + '. La respuesta que las declara iguales confunde utilidad con riesgo: son iguales en el resultado de hoy y opuestas en cómo lo consiguen. La que señala al plástico invierte el razonamiento, porque un margen flaco significa que se pierde poco por cada botella que no se vende. Y la que exige el precio pide un dato que no hace falta: el margen por botella ya contiene el precio y el costo variable, que es todo lo que la comparación necesita.',
           en: 'The identical profit of today hides two opposite structures. The glass line needs ' + bottlesEn(s2beA) + ' to cover its fixed cost and the plastic one only ' + bottlesEn(s2beB) + ', so the first operates far closer to its break-even point in relative terms and loses ' + money(p2mA * p2q * p2d) + ' of margin in the downturn against ' + money(p2mB * p2q * p2d) + ' for the second. After the contraction glass lands at ' + profitTxt(s2prA, false) + ' and plastic at ' + profitTxt(s2prB, false) + '. The answer declaring them equal confuses profit with risk: they are equal in today’s result and opposite in how they reach it. The one pointing at plastic reverses the reasoning, because a thin margin means little is lost for every bottle that does not sell. And the one demanding the price asks for a figure that is not needed: the margin per bottle already contains the price and the variable cost, which is all the comparison requires.' }
  };
  var d2 = mk(q2i, o2.correctIdx, false);
  problems.push({ i18n: d2.i18n, title: d2.title, questionText: d2.questionText, options: d2.options, correctIdx: d2.correctIdx, explanation: d2.explanation, hint: d2.hint, showWork: false, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPT 2 ═══════════════════════ */
  var c2a    = c2q0 + c2b * c2p0;
  var c2bp   = bestPrice(c2a, c2b, c2v);
  var c2rp   = revPrice(c2a, c2b);
  var c2qb   = qAt(c2a, c2b, c2bp);
  var c2pr0  = profitAtPrice(c2a, c2b, c2v, c2F, c2p0);
  var c2prb  = profitAtPrice(c2a, c2b, c2v, c2F, c2bp);
  var c2prr  = profitAtPrice(c2a, c2b, c2v, c2F, c2rp);
  var c2gain = c2prb - c2pr0;

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 2</div>' +
      '<h2>El precio que el mercado permite y el que más deja</h2>' +
      '<p>El bloque anterior tomó el precio como un dato. Ahora es la decisión. La embotelladora no vende en un mercado donde pueda cobrar lo que quiera: cada peso que sube el precio le cuesta clientes, y el área comercial midió cuántos. Con esa medición la pregunta deja de ser de opinión y se vuelve aritmética, porque ya se sabe qué se gana y qué se pierde con cada movimiento.</p>' +
      '<p>La relación se escribe como una recta: al precio actual el mercado toma cierta cantidad, y por cada peso de aumento se pierde un número fijo de botellas. Prolongada hacia arriba, esa recta llega a un precio en el que ya nadie compra, y prolongada hacia abajo llega a la cantidad que se colocaría regalando el producto. Ninguno de esos dos extremos es una decisión, pero entre ellos está la que sí lo es.</p>' +
      '<p>Al subir el precio pasan dos cosas a la vez y en direcciones opuestas: se gana margen en cada botella que se sigue vendiendo y se pierden botellas. La utilidad sube mientras lo primero domine y baja en cuanto domina lo segundo, así que dibujada contra el precio forma una curva con una sola cima. Esa cima cae exactamente a la mitad entre el precio al que nadie compra y el costo variable de una botella, y no en el punto medio del rango de precios ni donde el gerente tenga la corazonada.</p>' +
      '<p>Falta la advertencia que da sentido a todo el bloque, y es la que más se equivoca en la práctica. El precio que maximiza el <strong>ingreso</strong> no es el que maximiza la <strong>utilidad</strong>. El ingreso ignora por completo lo que cuesta producir, así que su cima cae siempre más abajo, exactamente la mitad del costo variable más abajo. Vender al precio de máximo ingreso significa mover mucho producto con margen regalado, y es la forma más elegante de tener un año récord en ventas y un año mediocre en utilidad.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Demanda</div><div class="rform">q = a − b · p</div><div class="rnote">b es lo que cuesta cada peso de aumento.</div></div>' +
        '<div class="rcard"><div class="rname">Precio sin compradores</div><div class="rform">' + frac('a', 'b') + '</div><div class="rnote">Donde la recta toca cero.</div></div>' +
        '<div class="rcard"><div class="rname">Precio que más deja</div><div class="rform">' + frac('a/b + costo variable', '2') + '</div><div class="rnote">Punto medio entre los dos.</div></div>' +
        '<div class="rcard"><div class="rname">Precio de más ingreso</div><div class="rform">' + frac('a', '2b') + '</div><div class="rnote">Ignora el costo: siempre menor.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Hoy la embotelladora cobra ' + money(c2p0) + ' por botella y coloca ' + bottlesEs(c2q0) + ' al mes. El área comercial estima que cada peso de aumento le costaría ' + bottlesEs(c2b) + '. El costo variable es de ' + money(c2v) + ' y el costo fijo del mes es ' + money(c2F) + '.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> Con esa sensibilidad, el precio al que ya nadie compraría es ' + money2(chokePrice(c2a, c2b)) + '.<br>' +
      '<strong>Paso 2.</strong> El precio que maximiza la utilidad cae a la mitad entre ese extremo y el costo variable de ' + money(c2v) + ', es decir ' + money2(c2bp) + ', con ' + bottlesEs(c2qb) + ' colocadas.<br>' +
      '<strong>Paso 3.</strong> La utilidad pasa de ' + money(c2pr0) + ' al precio de hoy a ' + money(c2prb) + ' en ese precio, una mejora de ' + money(c2gain) + ' al mes sin tocar la estructura de costos.<br>' +
      '<strong>Paso 4.</strong> El precio que maximizaría el ingreso es ' + money2(c2rp) + ', y llevaría la utilidad a ' + profitTxt(c2prr, es) + '.<br>' +
      '<strong>Lectura de negocio.</strong> La empresa gana ' + money(c2gain) + ' al mes con una decisión que no cuesta nada, y esa es la razón por la que el precio es la palanca más rentable de una empresa pequeña. Vale la pena señalar el costo de equivocarse de objetivo: al precio de máximo ingreso la empresa vendería más botellas, reportaría una cifra de ventas mayor y ganaría menos dinero. Y una salvedad honesta sobre el modelo. La recta de demanda es una estimación local, confiable cerca del precio actual y cada vez menos confiable lejos de él, así que se usa para mover el precio un tramo y volver a medir, no para saltar de un extremo al otro de la tabla.</p></div>';
    return '' +
      '<div class="stag">Concept 2</div>' +
      '<h2>The price the market allows and the price that pays best</h2>' +
      '<p>The previous block took the price as given. Now it is the decision. The bottling plant does not sell in a market where it can charge whatever it likes: every peso added to the price costs it customers, and the commercial team measured how many. With that measurement the question stops being a matter of opinion and turns into arithmetic, because what is gained and what is lost with each move is now known.</p>' +
      '<p>The relationship is written as a straight line: at the current price the market takes a certain quantity, and for every peso of increase a fixed number of bottles is lost. Extended upwards, that line reaches a price at which nobody buys at all, and extended downwards it reaches the quantity that would move if the product were given away. Neither of those extremes is a decision, but the decision lies between them.</p>' +
      '<p>Raising the price does two things at once and in opposite directions: it gains margin on every bottle that still sells and it loses bottles. Profit rises while the first effect dominates and falls as soon as the second one does, so drawn against the price it forms a curve with a single peak. That peak falls exactly halfway between the price at which nobody buys and the variable cost of one bottle, not at the midpoint of the price range and not where the manager has a hunch.</p>' +
      '<p>What remains is the warning that gives the whole block its point, and it is the one most often got wrong in practice. The price that maximises <strong>revenue</strong> is not the price that maximises <strong>profit</strong>. Revenue ignores production cost entirely, so its peak always falls lower, by exactly half the variable cost. Selling at the revenue-maximising price means moving a great deal of product with the margin given away, and it is the most elegant way to have a record year in sales and a mediocre one in profit.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Demand</div><div class="rform">q = a − b · p</div><div class="rnote">b is what each peso of increase costs.</div></div>' +
        '<div class="rcard"><div class="rname">Price with no buyers</div><div class="rform">' + frac('a', 'b') + '</div><div class="rnote">Where the line reaches zero.</div></div>' +
        '<div class="rcard"><div class="rname">Price that pays best</div><div class="rform">' + frac('a/b + variable cost', '2') + '</div><div class="rnote">Midway between the two.</div></div>' +
        '<div class="rcard"><div class="rname">Price with most revenue</div><div class="rform">' + frac('a', '2b') + '</div><div class="rnote">Blind to cost: always lower.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> Today the bottling plant charges ' + money(c2p0) + ' a bottle and places ' + bottlesEn(c2q0) + ' a month. The commercial team estimates that every peso of increase would cost it ' + bottlesEn(c2b) + '. The variable cost is ' + money(c2v) + ' and the fixed cost for the month is ' + money(c2F) + '.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> With that sensitivity, the price at which nobody would buy any more is ' + money2(chokePrice(c2a, c2b)) + '.<br>' +
      '<strong>Step 2.</strong> The price that maximises profit falls halfway between that extreme and the variable cost of ' + money(c2v) + ', which is ' + money2(c2bp) + ', with ' + bottlesEn(c2qb) + ' placed.<br>' +
      '<strong>Step 3.</strong> Profit moves from ' + money(c2pr0) + ' at today’s price to ' + money(c2prb) + ' at that price, an improvement of ' + money(c2gain) + ' a month without touching the cost structure.<br>' +
      '<strong>Step 4.</strong> The price that would maximise revenue is ' + money2(c2rp) + ', and it would leave profit at ' + profitTxt(c2prr, es) + '.<br>' +
      '<strong>Business reading.</strong> The company gains ' + money(c2gain) + ' a month from a decision that costs nothing, and that is why price is the most profitable lever a small company has. The cost of aiming at the wrong target is worth spelling out: at the revenue-maximising price the company would sell more bottles, report a bigger sales figure and make less money. And an honest caveat about the model. The demand line is a local estimate, reliable near the current price and steadily less reliable far from it, so it is used to move the price one stretch and measure again, not to jump from one end of the table to the other.</p></div>';
  });

  widgetPrice(w2p, w2v, w2b, w2k, w2F);

  /* ── Item 3 ── */
  var s3a  = p3q0 + p3b * p3p0;
  var s3bp = bestPrice(s3a, p3b, p3v);
  var s3rp = revPrice(s3a, p3b);
  var o3 = valOpts(s3bp, [s3rp, p3p0, p3p0 + p3k], money2, rng);
  var q3i = {
    title: { es: 'La revisión de precio de la presentación familiar', en: 'The price review on the family format' },
    q: { es: 'La embotelladora cobra hoy ' + money(p3p0) + ' por la botella familiar y coloca ' + bottlesEs(p3q0) + ' al mes. El área comercial levantó datos en las tiendas y concluyó que por cada peso que suba el precio dejaría de vender ' + bottlesEs(p3b) + ', y que la relación se sostiene hacia arriba y hacia abajo en el tramo que interesa. El costo variable de cada botella es ' + money(p3v) + ' y el costo fijo del mes no cambia con la decisión. La dirección quiere fijar el precio que deje la mayor utilidad mensual posible. ¿En cuánto debe quedar el precio?',
        en: 'The bottling plant charges ' + money(p3p0) + ' today for the family bottle and places ' + bottlesEn(p3q0) + ' a month. The commercial team gathered data in the shops and concluded that for every peso it raises the price it would stop selling ' + bottlesEn(p3b) + ', and that the relationship holds upwards and downwards over the stretch that matters. The variable cost of each bottle is ' + money(p3v) + ' and the fixed cost of the month does not change with the decision. Management wants to set the price that leaves the largest possible monthly profit. Where should the price end up?' },
    opts: { es: o3.es, en: o3.en },
    hint: { es: 'Empieza por averiguar a qué precio el mercado dejaría de comprar por completo, partiendo de lo que se vende hoy y de lo que cuesta cada peso de aumento. Ese extremo y el costo variable de una botella son las dos referencias que importan, porque la utilidad crece mientras el margen ganado pese más que las botellas perdidas y cae en cuanto deja de pesar más. El costo fijo no interviene: es el mismo cualquiera que sea el precio.',
            en: 'Start by working out the price at which the market would stop buying altogether, from what sells today and what each peso of increase costs. That extreme and the variable cost of one bottle are the two references that matter, because profit grows while the margin gained outweighs the bottles lost and falls the moment it stops outweighing them. The fixed cost plays no part: it is the same whatever the price.' },
    exp: { es: 'Con ' + bottlesEs(p3q0) + ' vendidas a ' + money(p3p0) + ' y ' + bottlesEs(p3b) + ' perdidas por cada peso, el mercado se agota en ' + money2(chokePrice(s3a, p3b)) + '. La utilidad alcanza su máximo justo a la mitad entre ese extremo y el costo variable de ' + money(p3v) + ', o sea ' + money2(s3bp) + '. La opción de ' + money2(s3rp) + ' es el precio que maximiza el ingreso: cae a la mitad entre el extremo y cero porque no toma en cuenta el costo variable, y por eso siempre queda medio costo variable por debajo del precio que más deja. La de ' + money2(p3p0) + ' es simplemente el precio actual, que solo sería óptimo por casualidad. Y la de ' + money2(p3p0 + p3k) + ' toma el punto medio entre el precio de hoy y el extremo del mercado, un promedio que suena razonable pero que no tiene relación con el costo de producir y por lo tanto no maximiza nada.',
           en: 'With ' + bottlesEn(p3q0) + ' sold at ' + money(p3p0) + ' and ' + bottlesEn(p3b) + ' lost per peso, the market runs out at ' + money2(chokePrice(s3a, p3b)) + '. Profit reaches its maximum exactly halfway between that extreme and the variable cost of ' + money(p3v) + ', which is ' + money2(s3bp) + '. The option of ' + money2(s3rp) + ' is the revenue-maximising price: it falls halfway between the extreme and zero because it takes no account of the variable cost, which is why it always sits half a variable cost below the price that pays best. The one of ' + money2(p3p0) + ' is simply the current price, which would only be optimal by coincidence. And the one of ' + money2(p3p0 + p3k) + ' takes the midpoint between today’s price and the end of the market, an average that sounds reasonable but bears no relation to what production costs and therefore maximises nothing.' }
  };
  var d3 = mk(q3i, o3.correctIdx, true);
  problems.push({ i18n: d3.i18n, title: d3.title, questionText: d3.questionText, options: d3.options, correctIdx: d3.correctIdx, explanation: d3.explanation, hint: d3.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 4 ── */
  var s4a   = p4q0 + p4b * p4p0;
  var s4bp  = bestPrice(s4a, p4b, p4v);
  var s4rp  = revPrice(s4a, p4b);
  var s4qb  = qAt(s4a, p4b, s4bp);
  var s4qr  = qAt(s4a, p4b, s4rp);
  var s4prb = (s4bp - p4v) * s4qb;
  var s4prr = (s4rp - p4v) * s4qr;
  var o4 = shuffleOpts(
    ['Que la meta está mal elegida: a ' + money2(s4rp) + ' la empresa facturaría más pero el margen total caería a ' + money(s4prr) + ', contra ' + money(s4prb) + ' que dejaría el precio de ' + money2(s4bp) + ', porque el ingreso no descuenta lo que cuesta producir cada botella adicional.',
     'Que la meta es correcta y conviene cobrar ' + money2(s4rp) + ', porque el precio que maximiza el ingreso maximiza también la utilidad siempre que el costo fijo permanezca sin cambios durante el periodo.',
     'Que la meta es correcta pero por un motivo distinto: al vender ' + bottlesEs(s4qr) + ' la planta reparte su costo fijo entre más unidades, y ese ahorro por botella compensa cualquier margen que se haya cedido en el precio.',
     'Que la decisión no puede tomarse con esta información, porque para comparar dos precios hace falta conocer antes el costo fijo mensual y sin ese dato ninguna de las dos alternativas puede evaluarse.'],
    ['That the target is the wrong one: at ' + money2(s4rp) + ' the company would invoice more but total margin would fall to ' + money(s4prr) + ', against the ' + money(s4prb) + ' the price of ' + money2(s4bp) + ' would leave, because revenue does not deduct what each additional bottle costs to make.',
     'That the target is right and ' + money2(s4rp) + ' is the price to charge, because the price maximising revenue also maximises profit as long as the fixed cost stays unchanged over the period.',
     'That the target is right but for a different reason: selling ' + bottlesEn(s4qr) + ' spreads the plant’s fixed cost over more units, and that saving per bottle makes up for any margin given away in the price.',
     'That the decision cannot be taken with this information, because comparing two prices requires knowing the monthly fixed cost first and without that figure neither alternative can be evaluated.'], rng);
  var q4i = {
    title: { es: 'La meta de ventas del director comercial', en: 'The sales target set by the commercial director' },
    q: { es: 'El director comercial de la embotelladora propone fijar el precio de la botella familiar en el nivel que produzca la mayor facturación posible, porque su bono y el de su equipo se calculan sobre las ventas del año. Hoy el precio es ' + money(p4p0) + ' con ' + bottlesEs(p4q0) + ' colocadas al mes, cada peso de aumento cuesta ' + bottlesEs(p4b) + ' y el costo variable es ' + money(p4v) + '. El director financiero pide revisar la propuesta antes de llevarla al consejo. ¿Qué debe concluir la revisión?',
        en: 'The commercial director of the bottling plant proposes setting the price of the family bottle at the level that produces the largest possible turnover, because his bonus and that of his team are calculated on sales for the year. Today the price is ' + money(p4p0) + ' with ' + bottlesEn(p4q0) + ' placed a month, every peso of increase costs ' + bottlesEn(p4b) + ' and the variable cost is ' + money(p4v) + '. The finance director asks for the proposal to be reviewed before it goes to the board. What should the review conclude?' },
    opts: { es: o4.es, en: o4.en },
    hint: { es: 'Facturar y ganar no son la misma cosa, y la diferencia entre ambas es justamente lo que cuesta producir las botellas que se facturan. Pregúntate qué cifra deja fuera el ingreso y en qué dirección mueve eso al precio elegido. Fíjate también en que el costo fijo es el mismo con cualquiera de los dos precios, así que no puede ser lo que incline la comparación.',
            en: 'Invoicing and earning are not the same thing, and the difference between them is precisely what it costs to make the bottles being invoiced. Ask yourself which figure revenue leaves out and in which direction that moves the chosen price. Notice too that the fixed cost is identical under either price, so it cannot be what tips the comparison.' },
    exp: { es: 'El precio de máxima facturación es ' + money2(s4rp) + ' y el de máxima utilidad ' + money2(s4bp) + ', y la distancia entre ambos es exactamente la mitad del costo variable, porque el ingreso trata todas las botellas como si producirlas fuera gratis. Al precio del director la planta colocaría ' + bottlesEs(s4qr) + ' y dejaría ' + money(s4prr) + ' de margen total; al precio correcto colocaría ' + bottlesEs(s4qb) + ' y dejaría ' + money(s4prb) + '. La opción que respalda la meta ignora el costo variable, que es justo la variable que separa a las dos cimas. La que apela al reparto del costo fijo comete un error más fino pero igual de grave: el costo fijo total no cambia con el precio, así que repartirlo entre más botellas mejora un indicador contable sin agregar un peso de utilidad. Y la que pide el costo fijo pide un dato irrelevante para elegir entre dos precios, porque se resta igual en ambos casos y no altera cuál de los dos gana.',
           en: 'The turnover-maximising price is ' + money2(s4rp) + ' and the profit-maximising one ' + money2(s4bp) + ', and the distance between them is exactly half the variable cost, because revenue treats every bottle as though making it were free. At the director’s price the plant would place ' + bottlesEn(s4qr) + ' and leave ' + money(s4prr) + ' of total margin; at the right price it would place ' + bottlesEn(s4qb) + ' and leave ' + money(s4prb) + '. The option backing the target ignores the variable cost, which is exactly the quantity separating the two peaks. The one appealing to the spreading of fixed cost makes a subtler mistake that is just as serious: total fixed cost does not change with the price, so spreading it over more bottles improves an accounting indicator without adding a peso of profit. And the one asking for the fixed cost asks for a figure that is irrelevant to choosing between two prices, because it is subtracted equally in both cases and does not change which one wins.' }
  };
  var d4 = mk(q4i, o4.correctIdx, false);
  problems.push({ i18n: d4.i18n, title: d4.title, questionText: d4.questionText, options: d4.options, correctIdx: d4.correctIdx, explanation: d4.explanation, hint: d4.hint, showWork: false, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPT 3 ═══════════════════════ */
  var c3s1 = c3S, c3s12 = c3S * Math.pow(c3g, 11);
  var c3prof = 0, c3cash = 0, c3low = 0, c3run = 0, c3t;
  for (c3t = 1; c3t <= 12; c3t++) {
    var c3sN = c3S * Math.pow(c3g, c3t - 1);
    var c3sP = c3t === 1 ? 0 : c3S * Math.pow(c3g, c3t - 2);
    c3prof += c3m * c3sN - c3F;
    c3run  += collected(c3sP, c3sN, c3c) - (1 - c3m) * c3sN - c3F;
    c3cash  = c3run;
    if (c3run < c3low) c3low = c3run;
  }
  var c3ar = (1 - c3c) * c3s12;

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 3</div>' +
      '<h2>La utilidad del mes y el dinero que hay en el banco</h2>' +
      '<p>Los dos bloques anteriores dejaron a la embotelladora produciendo el volumen correcto al precio correcto. Con eso la empresa es rentable, y una empresa rentable todavía puede quebrar. La razón es que la contabilidad registra una venta el día que se factura y el banco la registra el día que se cobra, y entre esas dos fechas pueden pasar semanas durante las cuales hay que pagar concentrado, envase y nómina.</p>' +
      '<p>La distinción se llama <strong>utilidad contra flujo de efectivo</strong> y no es un tecnicismo. La utilidad responde si el negocio sirve; el flujo de efectivo responde si sobrevive hasta que se note. Son dos preguntas distintas, se contestan con dos estados distintos, y confundirlas es la causa más frecuente de que una empresa joven y sana cierre sus puertas.</p>' +
      '<p>Lo que separa a las dos cifras tiene nombre y se puede calcular. El dinero que los clientes deben y todavía no pagan son las <strong>cuentas por cobrar</strong>; el que está inmovilizado en envase y producto terminado es el <strong>inventario</strong>; y el que la empresa debe a sus proveedores y aún no paga son las <strong>cuentas por pagar</strong>. Los dos primeros consumen caja al crecer, porque son dinero de la empresa parado fuera de ella; el tercero la libera, porque es dinero ajeno financiando la operación. Partiendo de la utilidad y corrigiendo por esos tres movimientos se llega al efectivo que realmente generó el periodo.</p>' +
      '<p>De ahí sale el resultado más contraintuitivo del curso: <strong>crecer consume caja</strong>. Cuando las ventas suben, las cuentas por cobrar y el inventario suben con ellas, así que cada mes bueno inmoviliza un poco más de dinero que el anterior. Una empresa que crece rápido y cobra tarde puede reportar utilidad todos los meses y quedarse sin efectivo a la mitad del año. El remedio no es dejar de crecer sino planear el faltante: proyectar la caja mes a mes, ver dónde se hunde y negociar la línea de crédito antes de necesitarla, cuando el banco todavía ve a una empresa rentable y no a una empresa desesperada.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Cobranza del mes</div><div class="rform">parte de hoy + resto de ayer</div><div class="rnote">La venta llega en dos fechas.</div></div>' +
        '<div class="rcard"><div class="rname">Efectivo de la operación</div><div class="rform">utilidad − ΔCxC − ΔInv + ΔCxP</div><div class="rnote">Lo que se inmoviliza se resta.</div></div>' +
        '<div class="rcard"><div class="rname">Ciclo de efectivo</div><div class="rform">días cobro + días inv − días pago</div><div class="rnote">Días que hay que financiar.</div></div>' +
        '<div class="rcard"><div class="rname">Faltante a financiar</div><div class="rform">peor saldo del año</div><div class="rnote">Tamaño de la línea de crédito.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> La embotelladora arranca el año facturando ' + money(c3s1) + ' al mes y creciendo ' + pct0(c3g - 1) + ' cada mes. Cobra ' + pct0(c3c) + ' dentro del mismo mes y el resto al mes siguiente. Su margen sobre ventas es ' + pct0(c3m) + ' y paga ' + money(c3F) + ' de costo fijo cada mes.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> Con ese crecimiento las ventas llegan a ' + money(c3s12) + ' en el mes doce.<br>' +
      '<strong>Paso 2.</strong> Sumando los doce meses, contabilidad reporta ' + money(c3prof) + ' de utilidad en el año.<br>' +
      '<strong>Paso 3.</strong> El banco cuenta otra cosa: la caja del mismo año deja ' + cashTxt(c3cash, true) + ', y el peor momento del año dejó el saldo en ' + (c3low < 0 ? money(-c3low) + ' en rojo' : 'terreno positivo todo el tiempo') + '.<br>' +
      '<strong>Paso 4.</strong> La diferencia no se perdió: al cerrar el año ' + money(c3ar) + ' están en manos de los clientes, facturados y sin cobrar.<br>' +
      '<strong>Lectura de negocio.</strong> El año fue bueno y aun así hubo meses incómodos, y las dos cosas son ciertas a la vez. La utilidad de ' + money(c3prof) + ' es real y el faltante también lo fue. Conviene notar de dónde sale exactamente la diferencia de cada mes: es la parte no cobrada del aumento de ventas de ese mes, de modo que mientras la empresa crezca la brecha nunca se cierra, solo se estabiliza si el crecimiento se detiene. Por eso el tesorero de una empresa en crecimiento vigila la cobranza con más atención que el margen: mejorar la cobranza en unos cuantos puntos libera de golpe más efectivo que un mes entero de buenas ventas.</p></div>';
    return '' +
      '<div class="stag">Concept 3</div>' +
      '<h2>The profit of the month and the money in the bank</h2>' +
      '<p>The two previous blocks left the bottling plant producing the right volume at the right price. That makes the company profitable, and a profitable company can still go under. The reason is that accounting records a sale on the day it is invoiced and the bank records it on the day it is collected, and between those two dates weeks can pass during which concentrate, containers and payroll all have to be paid.</p>' +
      '<p>The distinction is called <strong>profit against cash flow</strong> and it is not a technicality. Profit answers whether the business works; cash flow answers whether it survives long enough for anyone to notice. They are two different questions, answered by two different statements, and confusing them is the single most frequent reason a young and healthy company closes its doors.</p>' +
      '<p>What separates the two figures has a name and can be calculated. The money customers owe and have not yet paid is <strong>accounts receivable</strong>; the money tied up in containers and finished product is <strong>inventory</strong>; and the money the company owes its suppliers and has not yet paid is <strong>accounts payable</strong>. The first two consume cash as they grow, because they are company money parked outside the company; the third releases it, because it is somebody else’s money funding the operation. Starting from profit and correcting for those three movements gives the cash the period actually generated.</p>' +
      '<p>From this comes the most counterintuitive result in the course: <strong>growth consumes cash</strong>. When sales rise, receivables and inventory rise with them, so every good month ties up a little more money than the one before. A company that grows fast and collects late can report a profit every month and run out of cash halfway through the year. The remedy is not to stop growing but to plan the shortfall: project the cash month by month, see where it sinks and negotiate the credit line before it is needed, while the bank still sees a profitable company rather than a desperate one.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Collections of the month</div><div class="rform">part of today + rest of yesterday</div><div class="rnote">A sale arrives on two dates.</div></div>' +
        '<div class="rcard"><div class="rname">Cash from operations</div><div class="rform">profit − ΔAR − ΔInv + ΔAP</div><div class="rnote">Whatever is tied up is subtracted.</div></div>' +
        '<div class="rcard"><div class="rname">Cash cycle</div><div class="rform">collect days + stock days − pay days</div><div class="rnote">Days that have to be funded.</div></div>' +
        '<div class="rcard"><div class="rname">Shortfall to fund</div><div class="rform">worst balance of the year</div><div class="rnote">Size of the credit line.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> The bottling plant starts the year invoicing ' + money(c3s1) + ' a month and growing ' + pct0(c3g - 1) + ' each month. It collects ' + pct0(c3c) + ' within the same month and the rest the following month. Its margin on sales is ' + pct0(c3m) + ' and it pays ' + money(c3F) + ' of fixed cost every month.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> At that rate of growth sales reach ' + money(c3s12) + ' in month twelve.<br>' +
      '<strong>Step 2.</strong> Adding the twelve months, accounting reports ' + money(c3prof) + ' of profit for the year.<br>' +
      '<strong>Step 3.</strong> The bank counts something else: cash for the same year comes to ' + cashTxt(c3cash, false) + ', and the worst moment of the year left the balance ' + (c3low < 0 ? money(-c3low) + ' overdrawn' : 'in positive territory throughout') + '.<br>' +
      '<strong>Step 4.</strong> The difference was not lost: as the year closes ' + money(c3ar) + ' sits in the hands of customers, invoiced and uncollected.<br>' +
      '<strong>Business reading.</strong> The year was a good one and there were still uncomfortable months, and both things are true at once. The profit of ' + money(c3prof) + ' is real and so was the shortfall. It is worth noting exactly where each month’s difference comes from: it is the uncollected part of that month’s increase in sales, so while the company grows the gap never closes, it only settles if growth stops. That is why the treasurer of a growing company watches collections more closely than margin: improving collections by a few points releases more cash at a stroke than a whole month of good sales.</p></div>';
  });

  widgetCash(w3S, w3g, w3c, w3m, w3F);

  /* ── Item 5 ── */
  var s5ok = collected(p5S1, p5S2, p5c);
  var o5 = valOpts(s5ok, [p5S2, p5c * p5S2, p5c * p5S1 + (1 - p5c) * p5S2], money, rng);
  var q5i = {
    title: { es: 'La cobranza del mes de temporada', en: 'Collections in the peak season month' },
    q: { es: 'La embotelladora factura a las tiendas y cobra en dos tiempos: ' + pct0(p5c) + ' dentro del mismo mes de la venta y el resto durante el mes siguiente, sin excepciones. En abril facturó ' + money(p5S1) + ' y en mayo, ya con el calor de la temporada, facturó ' + money(p5S2) + '. La tesorera necesita saber cuánto dinero entrará realmente a la cuenta durante mayo para programar los pagos a proveedores. ¿Cuánto efectivo recibirá la empresa en mayo?',
        en: 'The bottling plant invoices the shops and collects in two stages: ' + pct0(p5c) + ' within the same month as the sale and the rest during the following month, without exceptions. In April it invoiced ' + money(p5S1) + ' and in May, with the season heat already on, it invoiced ' + money(p5S2) + '. The treasurer needs to know how much money will actually reach the account during May in order to schedule supplier payments. How much cash will the company receive in May?' },
    opts: { es: o5.es, en: o5.en },
    hint: { es: 'En mayo llegan dos corrientes distintas y hay que armarlas por separado antes de sumarlas. Una viene de lo que se facturó en mayo y otra de lo que quedó pendiente de abril, y cada una entra con la parte que le corresponde según la política de cobro. Cuida cuál de los dos meses lleva la parte que se cobra pronto y cuál lleva la parte rezagada, porque invertirlos cambia el resultado.',
            en: 'Two separate streams arrive in May and they have to be assembled apart before being added. One comes from what was invoiced in May and the other from what was left over from April, and each enters with the share the collection policy gives it. Be careful which of the two months carries the part collected early and which carries the part left behind, because swapping them changes the result.' },
    exp: { es: 'De la facturación de mayo entra ' + pct0(p5c) + ', es decir ' + money(p5c * p5S2) + ', y de la de abril entra el resto pendiente, ' + money((1 - p5c) * p5S1) + ', lo que da ' + money(s5ok) + ' en la cuenta durante mayo. La opción de ' + money(p5S2) + ' toma la facturación del mes como si fuera efectivo, que es exactamente el error que este bloque combate: una factura no es dinero hasta que se cobra. La de ' + money(p5c * p5S2) + ' cobra bien la parte de mayo pero olvida la cola de abril, y quien presupueste así se quedará corto todos los meses. Y la de ' + money(p5c * p5S1 + (1 - p5c) * p5S2) + ' invierte los dos meses: aplica la parte pronta a abril y la rezagada a mayo, con lo que en un mes de ventas crecientes sobrestima la entrada.',
           en: 'From the May invoicing, ' + pct0(p5c) + ' comes in, that is ' + money(p5c * p5S2) + ', and from April the remaining tail arrives, ' + money((1 - p5c) * p5S1) + ', giving ' + money(s5ok) + ' in the account during May. The option of ' + money(p5S2) + ' takes the invoicing of the month as though it were cash, which is exactly the error this block sets out to correct: an invoice is not money until it is collected. The one of ' + money(p5c * p5S2) + ' collects the May share correctly but forgets the April tail, and anyone budgeting that way will fall short every month. And the one of ' + money(p5c * p5S1 + (1 - p5c) * p5S2) + ' swaps the two months: it applies the early share to April and the late share to May, which in a month of rising sales overstates what comes in.' }
  };
  var d5 = mk(q5i, o5.correctIdx, true);
  problems.push({ i18n: d5.i18n, title: d5.title, questionText: d5.questionText, options: d5.options, correctIdx: d5.correctIdx, explanation: d5.explanation, hint: d5.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 6 ── */
  var s6ok = cashFromOps(p6P, p6AR, p6In, p6AP);
  var o6 = valOpts2(s6ok, [p6P, p6P - p6AR, p6P - p6AR - p6In - p6AP],
    function(x) { return cashTxt(x, true); }, function(x) { return cashTxt(x, false); }, rng);
  var q6i = {
    title: { es: 'Un trimestre rentable con la cuenta más baja', en: 'A profitable quarter with a lower bank balance' },
    q: { es: 'El trimestre de la embotelladora cerró con ' + money(p6P) + ' de utilidad, y aun así la dueña notó que la cuenta bancaria terminó con menos dinero que al empezar. El contador revisó el balance y encontró los movimientos del periodo: lo que los clientes deben subió ' + money(p6AR) + ', el inventario de envase y producto terminado subió ' + money(p6In) + ' y lo que la empresa debe a sus proveedores subió ' + money(p6AP) + '. No hubo compras de maquinaria ni movimientos de préstamos en el trimestre. ¿Qué efectivo generó realmente la operación?',
        en: 'The quarter at the bottling plant closed with ' + money(p6P) + ' of profit, and even so the owner noticed the bank account ended with less money than it started with. The accountant went through the balance sheet and found the movements of the period: what customers owe rose ' + money(p6AR) + ', the inventory of containers and finished product rose ' + money(p6In) + ' and what the company owes its suppliers rose ' + money(p6AP) + '. There were no machinery purchases and no loan movements during the quarter. What cash did the operation really generate?' },
    opts: { es: o6.es, en: o6.en },
    hint: { es: 'Parte de la utilidad y pregúntate, movimiento por movimiento, si ese saldo dejó dinero parado fuera de la empresa o si más bien lo liberó. Lo que los clientes deben y lo que está guardado en la bodega es dinero de la empresa que no está en la cuenta. Lo que se le debe a un proveedor y todavía no se paga es lo contrario: es dinero ajeno que se quedó adentro este trimestre.',
            en: 'Start from the profit and ask yourself, movement by movement, whether that balance left money parked outside the company or in fact released it. What customers owe and what sits in the warehouse is company money that is not in the account. What is owed to a supplier and not yet paid is the opposite: it is somebody else’s money that stayed inside this quarter.' },
    exp: { es: 'A los ' + money(p6P) + ' de utilidad hay que quitarles los ' + money(p6AR) + ' que quedaron en manos de los clientes y los ' + money(p6In) + ' inmovilizados en bodega, y sumarles los ' + money(p6AP) + ' que los proveedores todavía no cobran, con lo que la operación arroja ' + cashTxt(s6ok, true) + '. Eso explica la cuenta bancaria sin contradecir al estado de resultados. La opción de ' + cashTxt(p6P, true) + ' supone que la utilidad se convierte en efectivo el mismo día, que es precisamente lo que el trimestre desmiente. La de ' + cashTxt(p6P - p6AR, true) + ' corrige solo la cobranza y deja fuera el inventario y a los proveedores, de modo que reconoce el problema a medias. Y la de ' + cashTxt(p6P - p6AR - p6In - p6AP, true) + ' resta las cuentas por pagar en lugar de sumarlas: deber más a un proveedor no saca dinero de la caja este trimestre, lo deja adentro, y ese signo es el que más se equivoca al armar el estado de flujos.',
           en: 'From the ' + money(p6P) + ' of profit the ' + money(p6AR) + ' left in the hands of customers and the ' + money(p6In) + ' tied up in the warehouse have to be taken away, and the ' + money(p6AP) + ' the suppliers have not yet collected has to be added, so the operation throws off ' + cashTxt(s6ok, false) + '. That explains the bank account without contradicting the income statement. The option of ' + cashTxt(p6P, false) + ' assumes profit turns into cash on the same day, which is precisely what the quarter disproves. The one of ' + cashTxt(p6P - p6AR, false) + ' corrects only for collections and leaves out inventory and suppliers, so it recognises the problem halfway. And the one of ' + cashTxt(p6P - p6AR - p6In - p6AP, false) + ' subtracts payables instead of adding them: owing a supplier more does not take money out of the till this quarter, it leaves it in, and that sign is the one most often got wrong in building a cash flow statement.' }
  };
  var d6 = mk(q6i, o6.correctIdx, true);
  problems.push({ i18n: d6.i18n, title: d6.title, questionText: d6.questionText, options: d6.options, correctIdx: d6.correctIdx, explanation: d6.explanation, hint: d6.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPT 4 ═══════════════════════ */
  var c4npv  = npvLevel(c4I, c4A, c4r, c4n);
  var c4irr  = irrLevel(c4I, c4A, c4n);
  var c4need = flowForZero(c4I, c4r, c4n);
  var c4bot  = (c4need / 12 + c4f) / c4m;
  var c4pv   = pvAnnuity(c4A, c4r, c4n);

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 4</div>' +
      '<h2>La decisión que cierra el caso: la segunda línea</h2>' +
      '<p>La empresa simulada llega al último bloque produciendo bien, cobrando a tiempo y con la caja bajo control. Ahora aparece la decisión que compromete el futuro: comprar una segunda línea de embotellado que permitiría atender la demanda que hoy se queda sin surtir. Es la decisión donde convergen los tres bloques anteriores, porque el proyecto se justifica con botellas del bloque uno, valuadas al precio del bloque dos, y solo sirve si la empresa puede pagarlo sin romper la caja del bloque tres.</p>' +
      '<p>Lo primero es acordar qué se pone en la cuenta. Se evalúan <strong>flujos de efectivo incrementales</strong>, es decir el dinero que entra o sale por el hecho de comprar la máquina y que no se movería sin ella. La depreciación no es una salida de efectivo y no se resta como si lo fuera, aunque importe por el impuesto que ahorra. Lo que ya se pagó al ingeniero por el estudio de capacidad no entra bajo ningún concepto: ese dinero está gastado se compre o no la línea, y arrastrarlo al análisis es la forma más común de justificar una mala compra.</p>' +
      '<p>Lo segundo es la <strong>tasa que la empresa exige</strong> a su dinero, que es el rendimiento al que renuncia por comprometerlo aquí en lugar de en su mejor alternativa. Es un costo de oportunidad y pertenece a la empresa, no al proyecto: la misma máquina puede convenirle a una embotelladora y no a otra sin que ninguna se haya equivocado. Con esas dos piezas la regla se escribe sola. Se traen al presente los flujos que la línea promete, se les resta el desembolso, que ya está fechado hoy y por eso no se descuenta, y lo que quede es el <strong>valor presente neto</strong>.</p>' +
      '<p>La cifra tiene además una lectura que cierra el caso. En lugar de preguntar cuánto vale el proyecto, se puede preguntar cuánto efectivo anual necesitaría para valer exactamente cero, y traducir esa cantidad a botellas usando el margen del bloque uno. Así la decisión de inversión se convierte en una meta de ventas que el área comercial puede aceptar o rechazar con conocimiento, en lugar de una cifra financiera que nadie fuera de la dirección sabe interpretar.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Un flujo del año n</div><div class="rform">' + frac('F', '(1 + i)<sup>n</sup>') + '</div><div class="rnote">Traer al presente es dividir.</div></div>' +
        '<div class="rcard"><div class="rname">Serie pareja</div><div class="rform">A · ' + frac('1 − (1 + i)<sup>−n</sup>', 'i') + '</div><div class="rnote">Los n flujos valuados hoy.</div></div>' +
        '<div class="rcard"><div class="rname">Valor presente neto</div><div class="rform">VPN = VP − I</div><div class="rnote">El desembolso ya está fechado hoy.</div></div>' +
        '<div class="rcard"><div class="rname">Flujo de equilibrio</div><div class="rform">' + frac('I', 'factor de anualidad') + '</div><div class="rnote">Lo mínimo que debe rendir al año.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> La segunda línea cuesta ' + money(c4I) + ' y permitiría colocar ' + bottlesEs(c4q) + ' adicionales al mes con un margen de ' + money(c4m) + ' cada una, a cambio de ' + money(c4f) + ' mensuales de costo fijo extra por mantenimiento y un operador. La máquina duraría ' + intN(c4n) + ' años y la empresa exige ' + pctS(c4r) + ' por ciento anual a su capital.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El margen extra del mes es lo que dejan las botellas adicionales menos el costo fijo que traen consigo, y al año suma ' + money(c4A) + ' de efectivo incremental.<br>' +
      '<strong>Paso 2.</strong> Traídos al día de la decisión al ' + pctS(c4r) + ' por ciento, los ' + intN(c4n) + ' flujos valen ' + money(c4pv) + '.<br>' +
      '<strong>Paso 3.</strong> Restando el desembolso de ' + money(c4I) + ', la línea deja ' + npvTxt(c4npv, true) + ', y el rendimiento implícito del proyecto es ' + pct2(c4irr) + '.<br>' +
      '<strong>Paso 4.</strong> Para quedar exactamente en tablas la línea necesitaría ' + money(c4need) + ' al año, equivalentes a ' + bottlesEs(c4bot) + ' adicionales al mes.<br>' +
      '<strong>Lectura de negocio.</strong> La compra conviene, y el argumento para los socios cabe en una frase: la empresa vale ' + money(c4npv) + ' más el mismo día de la firma, ya pagado el rendimiento que le exigen a su dinero. La cifra que conviene llevar a la junta, sin embargo, es la última: la línea se justifica con ' + bottlesEs(c4bot) + ' adicionales al mes, contra las ' + bottlesEs(c4q) + ' que el área comercial cree poder colocar. Esa comparación es la que cualquiera en la mesa puede juzgar. Y queda una advertencia que enlaza con el bloque anterior: un proyecto puede agregar valor y aun así hundir la caja los primeros meses, así que la aprobación no está completa hasta que el presupuesto de efectivo demuestre que la empresa aguanta el desembolso.</p></div>';
    return '' +
      '<div class="stag">Concept 4</div>' +
      '<h2>The decision that closes the case: the second line</h2>' +
      '<p>The simulated company reaches the last block producing well, collecting on time and with its cash under control. Now comes the decision that commits the future: buying a second bottling line that would let it serve the demand currently going unfilled. It is the decision where the three previous blocks converge, because the project is justified with bottles from block one, valued at the price from block two, and is only any use if the company can pay for it without breaking the cash position from block three.</p>' +
      '<p>The first thing to agree is what goes into the count. What gets evaluated is <strong>incremental cash flow</strong>, the money that enters or leaves because the machine is bought and that would not move without it. Depreciation is not a cash outflow and is not subtracted as though it were, although it matters through the tax it saves. What was already paid to the engineer for the capacity study does not belong in the count on any grounds: that money is gone whether the line is bought or not, and dragging it into the analysis is the most common way of justifying a bad purchase.</p>' +
      '<p>The second piece is the <strong>rate the company demands</strong> of its money, the return it gives up by committing it here instead of to its best alternative. It is an opportunity cost and it belongs to the company rather than to the project: the same machine can suit one bottling plant and not another without either being wrong. With those two pieces the rule writes itself. Bring the flows the line promises back to the present, subtract the outlay, which already carries today as its date and is therefore not discounted, and what is left is the <strong>net present value</strong>.</p>' +
      '<p>The figure also has a reading that closes the case. Instead of asking what the project is worth, you can ask how much annual cash it would need in order to be worth exactly zero, and translate that amount into bottles using the margin from block one. The investment decision then becomes a sales target the commercial team can accept or reject knowingly, rather than a financial figure nobody outside the boardroom knows how to read.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">One flow from year n</div><div class="rform">' + frac('F', '(1 + i)<sup>n</sup>') + '</div><div class="rnote">Coming back to today is dividing.</div></div>' +
        '<div class="rcard"><div class="rname">Level stream</div><div class="rform">A · ' + frac('1 − (1 + i)<sup>−n</sup>', 'i') + '</div><div class="rnote">The n flows valued today.</div></div>' +
        '<div class="rcard"><div class="rname">Net present value</div><div class="rform">NPV = PV − I</div><div class="rnote">The outlay already carries today.</div></div>' +
        '<div class="rcard"><div class="rname">Break-even flow</div><div class="rform">' + frac('I', 'annuity factor') + '</div><div class="rnote">The least it must return a year.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> The second line costs ' + money(c4I) + ' and would let the plant place ' + bottlesEn(c4q) + ' extra a month at a margin of ' + money(c4m) + ' each, in exchange for ' + money(c4f) + ' a month of extra fixed cost for maintenance and one operator. The machine would last ' + intN(c4n) + ' years and the company demands ' + pctS(c4r) + ' percent a year from its capital.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The extra margin of the month is what the additional bottles leave less the fixed cost they bring with them, and over a year it comes to ' + money(c4A) + ' of incremental cash.<br>' +
      '<strong>Step 2.</strong> Carried to the day of the decision at ' + pctS(c4r) + ' percent, the ' + intN(c4n) + ' flows are worth ' + money(c4pv) + '.<br>' +
      '<strong>Step 3.</strong> Subtracting the outlay of ' + money(c4I) + ', the line leaves ' + npvTxt(c4npv, false) + ', and the implied return of the project is ' + pct2(c4irr) + '.<br>' +
      '<strong>Step 4.</strong> To come out exactly even the line would need ' + money(c4need) + ' a year, equivalent to ' + bottlesEn(c4bot) + ' extra a month.<br>' +
      '<strong>Business reading.</strong> The purchase is worth making, and the argument for the partners fits in one sentence: the company is worth ' + money(c4npv) + ' more on the very day the deal is signed, after paying the return they demand of their money. The figure worth taking to the meeting, though, is the last one: the line is justified by ' + bottlesEn(c4bot) + ' extra a month, against the ' + bottlesEn(c4q) + ' the commercial team believes it can place. That is a comparison anyone at the table can judge. And one warning links back to the previous block: a project can add value and still sink the cash position in the first months, so the approval is not complete until the cash budget shows the company can absorb the outlay.</p></div>';
  });

  widgetProject(w4I, w4A, w4n, w4r, w4m, w4f);

  /* ═══════════════════════ FINAL ASSESSMENT ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Evaluación final</div>' +
      '<h2>El expediente completo de la empresa simulada</h2>' +
      '<p>Los cuatro reactivos que siguen cierran el caso. Ya no vienen anunciados por un concepto, y esa es la dificultad: cada uno describe una situación de la embotelladora sin decirte de cuál de los cuatro bloques proviene, igual que ocurre en una junta de dirección. Lee cada situación completa antes de decidir qué herramienta pide, porque un dato del bloque de costos puede ser justo lo que hace falta para cerrar una decisión de inversión.</p>' +
      '<p>Los dos primeros tratan la compra de la segunda línea desde ángulos opuestos: cuánto vale y cuánto tendría que venderse para que valiera la pena. El tercero pone a chocar la decisión de invertir con la de financiar, que es el conflicto más común en una empresa que crece. El último vuelve al precio para medir en pesos de todo un año lo que estaba en juego en el bloque dos.</p>';
    return '' +
      '<div class="stag">Final assessment</div>' +
      '<h2>The complete file on the simulated company</h2>' +
      '<p>The four items that follow close the case. They no longer come announced by a concept, and that is the difficulty: each one describes a situation at the bottling plant without telling you which of the four blocks it came from, exactly as happens in a management meeting. Read each situation through before deciding which tool it calls for, because a figure from the cost block can be precisely what is needed to close an investment decision.</p>' +
      '<p>The first two treat the purchase of the second line from opposite angles: what it is worth, and how much would have to be sold to make it worth having. The third sets the decision to invest against the decision to fund, which is the most common conflict in a growing company. The last returns to price to measure, in pesos across a full year, what was at stake in block two.</p>';
  });

  /* ── Item 7 ── */
  var s7pv  = pvAnnuity(p7A, p7r, p7n);
  var s7npv = s7pv - p7I;
  var s7nof = pvAnnuity(p7m * p7q * 12, p7r, p7n) - p7I;
  var o7 = valOpts(s7npv, [p7A * p7n - p7I, s7pv, s7nof], money, rng);
  var q7i = {
    title: { es: 'Lo que agrega la segunda línea', en: 'What the second line adds' },
    q: { es: 'La embotelladora tiene sobre la mesa la compra de la segunda línea por ' + money(p7I) + '. Con ella podría colocar ' + bottlesEs(p7q) + ' adicionales cada mes, y cada una de esas botellas deja ' + money(p7m) + ' después de su propio material y mano de obra. La línea trae consigo ' + money(p7f) + ' mensuales de costo fijo adicional entre mantenimiento y el operador que la atiende. La máquina serviría ' + intN(p7n) + ' años y quedaría sin valor de reventa, y la empresa exige ' + pctS(p7r) + ' por ciento anual a su capital. ¿Cuánto valor agregaría la compra a la empresa, medido en pesos de hoy?',
        en: 'The bottling plant has the purchase of the second line on the table at ' + money(p7I) + '. With it the plant could place ' + bottlesEn(p7q) + ' extra every month, and each of those bottles leaves ' + money(p7m) + ' after its own materials and labour. The line brings with it ' + money(p7f) + ' a month of additional fixed cost between maintenance and the operator who runs it. The machine would serve ' + intN(p7n) + ' years and be left with no resale value, and the company demands ' + pctS(p7r) + ' percent a year from its capital. How much value would the purchase add to the company, measured in pesos of today?' },
    opts: { es: o7.es, en: o7.en },
    hint: { es: 'Arma primero el efectivo que la línea deja en un año, cuidando que el costo fijo adicional se descuente del margen antes de anualizar. Después lleva cada uno de esos años al día de la decisión, porque un peso del último año no vale lo mismo que uno del primero. El desembolso ya está fechado hoy y entra tal cual, sin descontar.',
            en: 'Build first the cash the line leaves in one year, taking care that the additional fixed cost comes out of the margin before annualising. Then carry each of those years back to the day of the decision, because a peso from the last year is not worth the same as one from the first. The outlay already carries today as its date and enters as it stands, undiscounted.' },
    exp: { es: 'Las ' + bottlesEs(p7q) + ' adicionales dejan margen cada mes, y al restarles los ' + money(p7f) + ' de costo fijo que la línea trae consigo el efectivo incremental del año queda en ' + money(p7A) + '. Traídos al día de la decisión al ' + pctS(p7r) + ' por ciento, los ' + intN(p7n) + ' años valen ' + money(s7pv) + ', y contra el desembolso de ' + money(p7I) + ' la compra agrega ' + money(s7npv) + '. La opción de ' + money(p7A * p7n - p7I) + ' suma los años sin descontar ninguno, es decir trata el peso del último año como si llegara hoy, y por eso siempre resulta demasiado optimista. La de ' + money(s7pv) + ' descuenta correctamente pero olvida restar lo que cuesta la máquina, de modo que responde cuánto vale lo que se recibe y no cuánto valor se agrega. Y la de ' + money(s7nof) + ' descuenta el margen de las botellas sin restar el costo fijo adicional, lo que confunde el margen de contribución con el efectivo incremental: la línea no es gratis de operar.',
           en: 'The ' + bottlesEn(p7q) + ' extra leave margin every month, and once the ' + money(p7f) + ' of fixed cost the line brings with it is taken out, the incremental cash for the year comes to ' + money(p7A) + '. Carried to the day of the decision at ' + pctS(p7r) + ' percent, the ' + intN(p7n) + ' years are worth ' + money(s7pv) + ', and against the outlay of ' + money(p7I) + ' the purchase adds ' + money(s7npv) + '. The option of ' + money(p7A * p7n - p7I) + ' adds the years without discounting any of them, treating the peso of the last year as though it arrived today, which is why it always comes out too optimistic. The one of ' + money(s7pv) + ' discounts correctly but forgets to subtract what the machine costs, so it answers what the company receives rather than what the company gains. And the one of ' + money(s7nof) + ' discounts the bottle margin without taking out the additional fixed cost, which confuses contribution margin with incremental cash: the line is not free to run.' }
  };
  var d7 = mk(q7i, o7.correctIdx, true);
  problems.push({ i18n: d7.i18n, title: d7.title, questionText: d7.questionText, options: d7.options, correctIdx: d7.correctIdx, explanation: d7.explanation, hint: d7.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 8 ── */
  var s8need = flowForZero(p8I, p8r, p8n);
  var s8ok   = (s8need / 12 + p8f) / p8m;
  var s8flat = (p8I / p8n / 12 + p8f) / p8m;
  var s8nof  = (s8need / 12) / p8m;
  var s8pay  = p8I / (p8m * p8n * 12);
  var o8 = valOpts2(s8ok, [s8flat, s8nof, s8pay], bottlesEs, bottlesEn, rng);
  var q8i = {
    title: { es: 'La meta de venta que justifica la máquina', en: 'The sales target that justifies the machine' },
    q: { es: 'Antes de aprobar la segunda línea de ' + money(p8I) + ', la dirección de la embotelladora quiere convertir la decisión en una meta que el área comercial pueda juzgar. La máquina duraría ' + intN(p8n) + ' años, la empresa exige ' + pctS(p8r) + ' por ciento anual a su capital, cada botella adicional dejaría ' + money(p8m) + ' de margen y la línea costaría ' + money(p8f) + ' mensuales de costo fijo extra por mantenimiento y operador. ¿Cuántas botellas adicionales al mes tendría que colocar la línea para que la compra apenas se justifique?',
        en: 'Before approving the second line at ' + money(p8I) + ', management at the bottling plant wants to turn the decision into a target the commercial team can judge. The machine would last ' + intN(p8n) + ' years, the company demands ' + pctS(p8r) + ' percent a year from its capital, each additional bottle would leave ' + money(p8m) + ' of margin and the line would cost ' + money(p8f) + ' a month of extra fixed cost for maintenance and an operator. How many extra bottles a month would the line have to place for the purchase to be just barely justified?' },
    opts: { es: o8.es, en: o8.en },
    hint: { es: 'Piensa la pregunta al revés que en el reactivo anterior: en vez de valuar un flujo conocido, busca el flujo anual que dejaría la compra exactamente en tablas, tomando en cuenta que el dinero comprometido tiene un rendimiento exigido durante los años que dure la máquina. Una vez que tengas esa cifra anual, bájala al mes y recuerda que las botellas tienen que pagar también el costo fijo que la propia línea trae consigo.',
            en: 'Turn the previous item around: instead of valuing a known flow, look for the annual flow that would leave the purchase exactly even, bearing in mind that the money committed carries a required return over the years the machine lasts. Once you have that annual figure, bring it down to the month and remember that the bottles have to pay for the fixed cost the line brings with it as well.' },
    exp: { es: 'Para que la compra quede en tablas, la línea tiene que generar ' + money(s8need) + ' de efectivo al año durante los ' + intN(p8n) + ' años, cantidad que ya incluye el rendimiento exigido sobre el capital comprometido. Bajada al mes y sumándole los ' + money(p8f) + ' de costo fijo que la línea arrastra, la meta queda en ' + bottlesEs(s8ok) + ' adicionales cada mes. La opción de ' + bottlesEs(s8flat) + ' reparte el desembolso en partes iguales entre los años sin exigirle rendimiento alguno, con lo que subestima la meta y hace parecer aprobable un proyecto que apenas devuelve el dinero. La de ' + bottlesEs(s8nof) + ' calcula bien el flujo anual necesario pero olvida el costo fijo que la máquina trae consigo, de modo que la meta se queda corta justo en el monto que hay que pagar cada mes sin importar cuánto se venda. Y la de ' + bottlesEs(s8pay) + ' solo divide el precio de la máquina entre el margen y los meses de vida, que es razonar en plazo de recuperación: ignora a la vez el rendimiento exigido y el costo fijo adicional.',
           en: 'For the purchase to come out even, the line has to generate ' + money(s8need) + ' of cash a year over the ' + intN(p8n) + ' years, an amount that already includes the required return on the capital committed. Brought down to the month and with the ' + money(p8f) + ' of fixed cost the line carries added to it, the target lands at ' + bottlesEn(s8ok) + ' extra every month. The option of ' + bottlesEn(s8flat) + ' spreads the outlay evenly across the years without demanding any return on it, which understates the target and makes a project that barely returns the money look approvable. The one of ' + bottlesEn(s8nof) + ' gets the required annual flow right but forgets the fixed cost the machine brings with it, so the target falls short by exactly the amount that has to be paid every month however much is sold. And the one of ' + bottlesEn(s8pay) + ' simply divides the price of the machine by the margin and the months of life, which is payback reasoning: it ignores the required return and the additional fixed cost at the same time.' }
  };
  var d8 = mk(q8i, o8.correctIdx, true);
  problems.push({ i18n: d8.i18n, title: d8.title, questionText: d8.questionText, options: d8.options, correctIdx: d8.correctIdx, explanation: d8.explanation, hint: d8.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 9 ── */
  var o9 = shuffleOpts(
    ['Que la compra sigue conviniendo y lo que hay que resolver es cómo pagarla: el proyecto agrega ' + money(p9np) + ' de valor y el problema del tercer mes es de liquidez, así que corresponde negociar antes la línea de crédito por los ' + money(p9sh) + ' del faltante o escalonar el desembolso con el proveedor.',
     'Que la compra debe rechazarse, porque una empresa que no puede pagar una máquina de contado con su propio efectivo tampoco está en condiciones de operarla, y el faltante de ' + money(p9sh) + ' demuestra que el proyecto excede el tamaño de la empresa.',
     'Que la compra debe aprobarse y el presupuesto de efectivo puede archivarse, porque el valor presente neto de ' + money(p9np) + ' ya tomó en cuenta todos los flujos del proyecto e incluye por construcción cualquier faltante mensual.',
     'Que la compra debe reevaluarse restando los ' + money(p9sh) + ' del faltante al valor presente neto de ' + money(p9np) + ', y aprobarse solo si el resultado sigue siendo favorable después de esa corrección.'],
    ['That the purchase is still worth making and what has to be solved is how to pay for it: the project adds ' + money(p9np) + ' of value and the problem in the third month is one of liquidity, so the right move is to negotiate the credit line for the ' + money(p9sh) + ' shortfall in advance, or to stage the payment with the supplier.',
     'That the purchase should be rejected, because a company that cannot pay cash for a machine out of its own funds is in no position to run it either, and the ' + money(p9sh) + ' shortfall shows the project is larger than the company.',
     'That the purchase should be approved and the cash budget can be filed away, because the net present value of ' + money(p9np) + ' already took every flow of the project into account and by construction includes any monthly shortfall.',
     'That the purchase should be reassessed by subtracting the ' + money(p9sh) + ' shortfall from the net present value of ' + money(p9np) + ', and approved only if the result is still favourable after that correction.'], rng);
  var q9i = {
    title: { es: 'El proyecto conviene y la caja no alcanza', en: 'The project is worth it and the cash falls short' },
    q: { es: 'El consejo de la embotelladora tiene dos documentos sobre la mesa. La evaluación de la segunda línea, que cuesta ' + money(p9I) + ', concluye que agrega ' + money(p9np) + ' de valor a la empresa. El presupuesto de efectivo del año, elaborado por tesorería, muestra que si la máquina se paga de contado el tercer mes la cuenta bancaria quedaría ' + money(p9sh) + ' por debajo de cero, aunque a partir del quinto mes la caja se recupera y cierra el año en positivo. Los dos documentos están bien hechos. ¿Qué debe decidir el consejo?',
        en: 'The board of the bottling plant has two documents on the table. The appraisal of the second line, which costs ' + money(p9I) + ', concludes that it adds ' + money(p9np) + ' of value to the company. The cash budget for the year, prepared by the treasury, shows that if the machine is paid for in cash the third month would leave the bank account ' + money(p9sh) + ' below zero, although from the fifth month onwards the cash recovers and the year closes in positive territory. Both documents are correctly prepared. What should the board decide?' },
    opts: { es: o9.es, en: o9.en },
    hint: { es: 'Los dos documentos contestan preguntas distintas y ninguno de los dos está equivocado. Uno dice si el proyecto vale la pena a lo largo de su vida útil; el otro dice si la empresa tiene con qué pagar en una fecha concreta. Pregúntate si la respuesta a la segunda pregunta puede cambiar la respuesta a la primera, o si más bien indica qué hay que arreglar antes de firmar.',
            en: 'The two documents answer different questions and neither of them is wrong. One says whether the project is worth having over its useful life; the other says whether the company has the means to pay on a particular date. Ask yourself whether the answer to the second question can change the answer to the first, or whether it rather indicates what has to be arranged before signing.' },
    exp: { es: 'La decisión de invertir y la de financiar son dos decisiones separadas, y esa separación es la lección que cierra el caso. El valor presente neto de ' + money(p9np) + ' dice que la línea conviene a lo largo de su vida útil; el presupuesto de efectivo dice que el tercer mes falta dinero, y eso no cambia lo que la máquina vale, solo obliga a conseguir ' + money(p9sh) + ' de financiamiento temporal o a pactar el pago en parcialidades. La opción que rechaza la compra confunde no tener el efectivo hoy con que el proyecto no convenga: si eso fuera criterio, ninguna empresa financiaría jamás su crecimiento. La que archiva el presupuesto ignora que el valor presente neto trabaja con flujos anuales y no dice nada del calendario mensual, y una empresa que no puede pagar la nómina en el tercer mes no llega al quinto a cobrar el valor prometido. Y la que resta el faltante al valor presente neto cuenta dos veces el mismo desembolso, porque el precio de la máquina ya está restado en esa cifra, y además mezcla una cantidad de hoy con un saldo de dentro de tres meses.',
           en: 'The decision to invest and the decision to fund are two separate decisions, and that separation is the lesson that closes the case. The net present value of ' + money(p9np) + ' says the line is worth having over its useful life; the cash budget says money is short in the third month, and that does not change what the machine is worth, it only forces the company to raise ' + money(p9sh) + ' of temporary funding or to agree the payment in instalments. The option rejecting the purchase confuses not having the cash today with the project not being worth having: if that were the test, no company would ever fund its own growth. The one that files the budget away ignores that net present value works with annual flows and says nothing about the monthly calendar, and a company that cannot make payroll in the third month never reaches the fifth to collect the promised value. And the one that subtracts the shortfall from the net present value counts the same outlay twice, because the price of the machine is already deducted in that figure, and it also mixes an amount of today with a balance three months from now.' }
  };
  var d9 = mk(q9i, o9.correctIdx, false);
  problems.push({ i18n: d9.i18n, title: d9.title, questionText: d9.questionText, options: d9.options, correctIdx: d9.correctIdx, explanation: d9.explanation, hint: d9.hint, showWork: false, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 10 ── */
  var s10a   = p10q0 + p10b * p10p0;
  var s10bp  = bestPrice(s10a, p10b, p10v);
  var s10rp  = revPrice(s10a, p10b);
  var s10qb  = qAt(s10a, p10b, s10bp);
  var s10pr0 = profitAtPrice(s10a, p10b, p10v, p10F, p10p0);
  var s10prb = profitAtPrice(s10a, p10b, p10v, p10F, s10bp);
  var s10prr = profitAtPrice(s10a, p10b, p10v, p10F, s10rp);
  var s10ok  = 12 * (s10prb - s10pr0);
  var s10wr  = 12 * (s10prr - s10pr0);
  var s10rev = 12 * (revenueAtPrice(s10a, p10b, s10bp) - revenueAtPrice(s10a, p10b, p10p0));
  var s10mon = s10prb - s10pr0;
  var o10 = valOpts2(s10ok, [s10wr, s10rev, s10mon],
    function(x) { return gainTxt(x, true); }, function(x) { return gainTxt(x, false); }, rng);
  var q10i = {
    title: { es: 'Lo que costó un año de precio equivocado', en: 'What a year of the wrong price cost' },
    q: { es: 'Al cerrar el ejercicio, la dueña de la embotelladora quiere saber cuánto dejó de ganar la empresa por haber sostenido todo el año el precio de ' + money(p10p0) + ' en la botella familiar, con la que colocó ' + bottlesEs(p10q0) + ' al mes. El estudio comercial que se hizo entonces indicaba que cada peso de aumento costaría ' + bottlesEs(p10b) + ', el costo variable fue de ' + money(p10v) + ' por botella y el costo fijo de ' + money(p10F) + ' al mes se mantuvo sin cambios. ¿Cuánta utilidad adicional habría obtenido la empresa en el año con el precio que más deja?',
        en: 'As the financial year closes, the owner of the bottling plant wants to know how much the company gave up by holding the price of ' + money(p10p0) + ' on the family bottle all year, with which it placed ' + bottlesEn(p10q0) + ' a month. The commercial study done at the time indicated that every peso of increase would cost ' + bottlesEn(p10b) + ', the variable cost was ' + money(p10v) + ' a bottle and the fixed cost of ' + money(p10F) + ' a month stayed unchanged. How much additional profit would the company have made over the year at the price that pays best?' },
    opts: { es: o10.es, en: o10.en },
    hint: { es: 'Necesitas dos utilidades mensuales y una resta: la del precio que se sostuvo y la del precio que más deja, cada una con las botellas que le corresponden. Cuida que ambas se calculen con la misma estructura de costos, porque el costo fijo no cambia con el precio y por lo tanto se cancela en la comparación. Y fíjate en que la pregunta es por el año completo, no por un mes.',
            en: 'You need two monthly profits and a subtraction: the one at the price that was held and the one at the price that pays best, each with the bottles that go with it. Make sure both are worked out with the same cost structure, because the fixed cost does not change with the price and therefore cancels in the comparison. And note that the question asks about the whole year, not about one month.' },
    exp: { es: 'Al precio sostenido de ' + money(p10p0) + ' la utilidad mensual fue de ' + money(s10pr0) + '. El precio que más deja era ' + money2(s10bp) + ', con ' + bottlesEs(s10qb) + ' colocadas y ' + money(s10prb) + ' de utilidad al mes, de modo que el año completo dejó de ganar ' + gainTxt(s10ok, true) + '. La opción de ' + gainTxt(s10wr, true) + ' compara contra el precio que maximiza el ingreso y no el que maximiza la utilidad, que es la confusión del bloque de precio y siempre subestima la mejora posible. La de ' + gainTxt(s10rev, true) + ' mide el cambio en la facturación en lugar del cambio en la utilidad, y por eso puede incluso salir en contra aunque la empresa gane más. Y la de ' + gainTxt(s10mon, true) + ' es la mejora de un solo mes presentada como si fuera la del año, un descuido de periodo que en un reporte al consejo divide la cifra real entre doce.',
           en: 'At the price held of ' + money(p10p0) + ' monthly profit was ' + money(s10pr0) + '. The price that pays best was ' + money2(s10bp) + ', with ' + bottlesEn(s10qb) + ' placed and ' + money(s10prb) + ' of profit a month, so across the full year the company gave up ' + gainTxt(s10ok, false) + '. The option of ' + gainTxt(s10wr, false) + ' compares against the price that maximises revenue rather than the one that maximises profit, which is the confusion from the pricing block and always understates the improvement available. The one of ' + gainTxt(s10rev, false) + ' measures the change in turnover instead of the change in profit, which is why it can even come out against the company although the company earns more. And the one of ' + gainTxt(s10mon, false) + ' is the improvement of a single month presented as though it were the year, a slip of period that in a report to the board divides the real figure by twelve.' }
  };
  var d10 = mk(q10i, o10.correctIdx, true);
  problems.push({ i18n: d10.i18n, title: d10.title, questionText: d10.questionText, options: d10.options, correctIdx: d10.correctIdx, explanation: d10.explanation, hint: d10.hint, showWork: true, studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);
}

/* ════════════════════════════════════════════════════════════════════════
   LANGUAGE SWITCHING
   ════════════════════════════════════════════════════════════════════════ */
function applyUIStrings() {
  var set = function(id, txt) { var e = document.getElementById(id); if (e) e.textContent = txt; };
  var ph  = function(id, txt) { var e = document.getElementById(id); if (e) e.placeholder = txt; };
  set('wtitle-el',    SCHOOL.guideTitle[LANG]);
  set('wcourse-el',   SCHOOL.courseName[LANG]);
  set('htitle-el',    SCHOOL.guideTitle[LANG]);
  set('lbl-name-el',  t('lbl-name'));
  set('lbl-group-el', t('lbl-group'));
  set('startBtn',     t('btn-start'));
  set('restoreTitle', t('restore-title'));
  set('restoreMsg',   t('restore-msg'));
  set('restoreBtn',   t('btn-restore'));
  set('dismissBtn',   t('btn-dismiss'));
  set('dlBtn',        t('btn-pdf'));
  ph('sName',  t('ph-name'));
  ph('sGroup', t('ph-group'));
  var ll = document.getElementById('logo-left');   if (ll) ll.alt = SCHOOL.logoLeftAlt;
  var lr = document.getElementById('logo-right');  if (lr) lr.alt = SCHOOL.logoRightAlt;
}
/* Rebuilds the visible text of every card without touching the numbers. */
function applyProblemLang() {
  problems.forEach(function(p, i) {
    var card = document.getElementById('pc' + i);
    if (!card || !p.i18n) return;
    p.title        = p.i18n.title[LANG];
    p.questionText = p.i18n.q[LANG];
    p.hint         = p.i18n.hint[LANG];
    p.explanation  = p.i18n.exp[LANG];
    p.options      = p.i18n.opts[LANG].slice();
    var ti = card.querySelector('.ptitle'); if (ti) ti.textContent = p.title;
    var st = card.querySelector('.pstmt');  if (st) st.innerHTML = p.questionText;
    var hb = card.querySelector('.hintbox'); if (hb) hb.innerHTML = p.hint;
    var hbtn = card.querySelector('.hintbtn'); if (hbtn) hbtn.textContent = t('btn-hint');
    card.querySelectorAll('.mcopt').forEach(function(o, oi) {
      if (p.options[oi] !== undefined) o.innerHTML = p.options[oi];
    });
    var tabs = card.querySelectorAll('.wtab');
    if (tabs.length === 3) {
      tabs[0].textContent = t('tab-draw');
      tabs[1].textContent = t('tab-type');
      tabs[2].textContent = t('tab-photo');
    }
    var tools = card.querySelectorAll('.tbtn2');
    if (tools.length === 3) {
      tools[0].textContent = t('tool-pen');
      tools[1].textContent = t('tool-mark');
      tools[2].textContent = t('tool-erase');
    }
    var clr = card.querySelector('.clrbtn'); if (clr) clr.textContent = t('tool-clear');
    var ta  = card.querySelector('.wtextarea'); if (ta) ta.placeholder = t('ph-work');
    var pzt = card.querySelector('.pztxt'); if (pzt) pzt.textContent = t('ph-photo');
    var lab = card.querySelector('.pbody > div:last-child > div:first-child');
    if (lab) lab.textContent = t('lbl-answer');
    var fb = card.querySelector('.mcfb');
    if (fb && fb.classList.contains('show')) {
      var isOk = (p.studentChoice === p.correctIdx);
      fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + p.explanation;
    }
  });
}
function setLang(l) {
  LANG = l;
  try { localStorage.setItem(LANG_KEY, l); } catch(e) {}
  document.documentElement.setAttribute('lang', l);
  var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
  if (be) be.classList.toggle('active', l === 'es');
  if (bn) bn.classList.toggle('active', l === 'en');
  applyUIStrings();
  applySectionLang();
  applyProblemLang();
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
  document.querySelectorAll('#lessonBody .section').forEach(function(s) { s.classList.add('vis'); });
}
(function() {
  try { var stored = localStorage.getItem(LANG_KEY); if (stored === 'es' || stored === 'en') LANG = stored; } catch(e) {}
  document.addEventListener('DOMContentLoaded', function() {
    document.documentElement.setAttribute('lang', LANG);
    var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
    if (be) be.classList.toggle('active', LANG === 'es');
    if (bn) bn.classList.toggle('active', LANG === 'en');
    applyUIStrings();
  });
})();

/* LOGO INJECTION */
document.addEventListener('DOMContentLoaded', function() {
  var wl = document.getElementById('logo-left');
  if (wl && SCHOOL.logoLeftB64) { wl.src = SCHOOL.logoLeftB64; wl.style.display = 'inline-block'; }
  var hl = document.getElementById('hlogo-left');
  if (hl && SCHOOL.logoLeftB64) { hl.src = SCHOOL.logoLeftB64; hl.style.display = 'inline-block'; }
});

/* ════════════════════════════════════════════════════════════════════════
   PDF
   ════════════════════════════════════════════════════════════════════════ */
async function generatePDF() {
  var btn = document.getElementById('dlBtn');
  btn.textContent = t('pdf-busy');
  btn.disabled = true;

  var jspdf   = window.jspdf;
  var doc     = new jspdf.jsPDF({ orientation:'portrait', unit:'mm', format:'letter' });
  var PW      = 215.9;
  var M       = 18;
  var TW      = PW - M * 2;
  var PH      = doc.internal.pageSize.height;
  var name    = studentData.name;
  var group   = studentData.group;
  var total   = problems.length;
  var pct     = Math.round(correctCount / total * 100);
  var dateStr = new Date().toLocaleString(LANG === 'es' ? 'es-MX' : 'en-US', { dateStyle:'long', timeStyle:'short' });

  var raw = name + '|' + group + '|' + correctCount + '|' + total + '|' + new Date().toDateString();
  var h = 0;
  for (var ci = 0; ci < raw.length; ci++) h = (Math.imul(31, h) + raw.charCodeAt(ci)) | 0;
  var code = Math.abs(h).toString(36).toUpperCase().slice(0, 8);

  var pBR = SCHOOL.pBR, pBG = SCHOOL.pBG, pBB = SCHOOL.pBB;
  var pAR = SCHOOL.pAR, pAG = SCHOOL.pAG, pAB = SCHOOL.pAB;

  function pdfText(html) {
    if (!html) return '';
    return html
      .replace(/<[^>]+>/g,'').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&')
      .replace(/&nbsp;/g,' ').replace(/&#[0-9]+;/g,'')
      .replace(/\u2019/g, String.fromCharCode(39))
      .replace(/→/g,'->').replace(/−/g,'-').replace(/²/g,'^2')
      .replace(/³/g,'^3').replace(/×/g,'x').replace(/÷/g,'/')
      .replace(/≠/g,'!=').replace(/≤/g,'<=').replace(/≥/g,'>=')
      .replace(/√/g,'sqrt').replace(/π/g,'pi').replace(/…/g,'...')
      .replace(/μ/g,'mu').replace(/σ/g,'sigma').replace(/α/g,'alpha').replace(/β/g,'beta')
      .replace(/₀/g,'0').replace(/₁/g,'1').replace(/₂/g,'2').replace(/·/g,'*')
      .replace(/\s+/g,' ').trim();
  }

  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,2,'F');
  doc.setFillColor(255,255,255); doc.rect(0,2,PW,26,'F');
  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,28,PW,2,'F');
  doc.setFillColor(pBR,pBG,pBB); doc.rect(0,30,PW,34,'F');

  var fmtL = SCHOOL.logoLeftB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  var fmtR = SCHOOL.logoRightB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  try { doc.addImage(SCHOOL.logoLeftB64,  fmtL, M,  4.0, 22, 22); } catch(e) {}
  try { doc.addImage(SCHOOL.logoRightB64, fmtR, 48, 4.5, 48, 21); } catch(e) {}

  var lx = PW - M - 36;
  var ly = 10;
  doc.setDrawColor(pBR,pBG,pBB); doc.setLineWidth(0.7);
  doc.lines([[2.57-1.03,4.63-6.17],[4.11-2.57,5.14-4.63],[5.66-4.11,2.57-5.14]], lx+1.03, ly+6.17);
  doc.setFillColor(pAR,pAG,pAB); doc.circle(lx+5.66, ly+2.57, 0.9, 'F');
  doc.setDrawColor(pAR,pAG,pAB); doc.setLineWidth(0.7);
  doc.line(lx+8.23, ly+1.54, lx+8.23, ly+7.2);
  doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text('LIAXA', lx+10, ly+6.8);

  doc.setTextColor(240,244,238); doc.setFontSize(13); doc.setFont('helvetica','bold');
  doc.text(SCHOOL.guideTitle[LANG], M, 49);
  doc.setTextColor(198,214,192); doc.setFontSize(8); doc.setFont('helvetica','normal');
  doc.text(dateStr, M, 59);

  doc.setFillColor(237,240,245); doc.roundedRect(M,72,TW,20,3,3,'F');
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
  doc.text(t('pdf-student'), M+4, 79); doc.text(t('pdf-group'), 130, 79);
  doc.setTextColor(20,24,32); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text(name, M+4, 87); doc.text(group, 130, 87);

  var sc = pct>=70?[26,106,74]:pct>=50?[224,123,26]:[176,48,16];
  doc.setFillColor(255,255,255); doc.roundedRect(M,100,TW,34,4,4,'F');
  doc.setDrawColor(sc[0],sc[1],sc[2]); doc.setLineWidth(0.8);
  doc.roundedRect(M,100,TW,34,4,4,'S');
  doc.setTextColor(sc[0],sc[1],sc[2]); doc.setFontSize(40); doc.setFont('helvetica','bold');
  doc.text(pct+'%', PW/2, 124, {align:'center'});
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
  doc.text(correctCount+' '+t('pdf-score')+' '+total+' '+t('pdf-questions'), PW/2, 131, {align:'center'});

  doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
  doc.setFontSize(7); doc.setFont('helvetica','bold');
  doc.rect(M,142,TW,8,'F'); doc.text(t('pdf-summary'), M+4, 148);
  var sy = 154;
  problems.forEach(function(prob, i) {
    if (sy + 12 > PH - 15) {
      doc.addPage(); sy = 20;
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,sy,TW,8,'F'); doc.text(t('pdf-summary2'), M+4, sy+6);
      sy += 12;
    }
    var ok = document.getElementById('pc'+i).classList.contains('ok');
    doc.setFillColor(ok?232:255, ok?240:232, ok?232:228);
    doc.roundedRect(M,sy,TW,10,2,2,'F');
    doc.setFillColor(ok?26:176, ok?106:48, ok?74:16);
    doc.circle(M+6, sy+5, 2.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(7); doc.setFont('helvetica','bold');
    doc.text(ok?'v':'x', M+4.5, sy+6.5);
    doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('helvetica','normal');
    doc.text(t('pdf-item')+' '+(i+1)+': '+pdfText(prob.title), M+12, sy+6.5);
    doc.setTextColor(ok?26:176, ok?106:48, ok?74:16);
    doc.text(ok?t('pdf-ok'):t('pdf-bad'), PW-M-24, sy+6.5);
    sy += 12;
  });

  for (var i = 0; i < problems.length; i++) {
    var prob = problems[i];
    doc.addPage();
    var wy = 0;

    doc.setFillColor(pBR,pBG,pBB); doc.rect(0,0,PW,20,'F');
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,3,'F');
    doc.setTextColor(pAR,pAG,pAB); doc.setFontSize(7); doc.setFont('helvetica','normal');
    doc.text(SCHOOL.courseName[LANG]+'  ·  '+SCHOOL.guideTitle[LANG], M, 10);
    doc.setTextColor(240,244,238); doc.setFontSize(10.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-item')+' '+(i+1)+' '+t('pdf-of')+' '+total+'  ·  '+pdfText(prob.title), M, 17);
    wy = 25;

    var qRaw = pdfText(prob.questionText);
    doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qLines = doc.splitTextToSize(qRaw, TW-10);
    var qBoxH  = 8 + qLines.length*5 + 3;
    doc.setFillColor(237,240,245); doc.roundedRect(M,wy,TW,qBoxH,2,2,'F');
    doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(6.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-question'), M+4, wy+6);
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qy = wy+12;
    qLines.forEach(function(ln,li){ doc.text(ln, M+4, qy+li*5); });
    wy += qBoxH + 4;

    var isOk   = document.getElementById('pc'+i).classList.contains('ok');
    var chosen = prob.studentChoice != null ? pdfText(prob.options[prob.studentChoice]||'') : '';
    var corr   = pdfText(prob.options[prob.correctIdx]||'');
    var expRaw = pdfText(prob.explanation||'');
    doc.setFontSize(8.5); var chLines = doc.splitTextToSize(t('pdf-yours')+chosen, TW-18);
    doc.setFontSize(8);   var coLines = doc.splitTextToSize(t('pdf-key')+corr, TW-18);
    doc.setFontSize(7.5); var exLines = doc.splitTextToSize(t('pdf-sol')+expRaw, TW-18).slice(0,4);
    var ansBoxH = 8 + chLines.length*5.5 + coLines.length*5 + exLines.length*5 + 6;
    doc.setFillColor(isOk?232:255, isOk?240:232, isOk?232:228);
    doc.roundedRect(M,wy,TW,ansBoxH,2,2,'F');
    doc.setFillColor(isOk?26:176, isOk?106:48, isOk?74:16);
    doc.circle(M+7, wy+8, 3.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(9); doc.setFont('helvetica','bold');
    doc.text(isOk?'v':'x', M+5.2, wy+10.5);
    var ay = wy+7;
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
    chLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5.5); });
    ay += chLines.length*5.5 + 3;
    doc.setTextColor(26,106,74); doc.setFontSize(8); doc.setFont('helvetica','normal');
    coLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    ay += coLines.length*5 + 3;
    doc.setTextColor(90,85,80); doc.setFontSize(7.5);
    exLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    wy += ansBoxH + 5;

    var dc = document.getElementById('dc'+i);
    if (dc) {
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,wy,TW,8,'F'); doc.text(t('pdf-work'), M+4, wy+5.5);
      wy += 11;
      try {
        var imgD = dc.toDataURL('image/png');
        var ar   = dc.height / dc.width;
        var iw   = TW;
        var ih   = Math.min(iw * ar, 68);
        doc.addImage(imgD, 'PNG', M, wy, iw, ih);
        wy += ih + 4;
      } catch(e) {}
    }

    var ta = document.getElementById('ta'+i);
    if (ta && ta.value.trim()) {
      if (wy > PH-30) { doc.addPage(); wy = 20; }
      doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('courier','normal');
      var taLines = doc.splitTextToSize(ta.value, TW);
      taLines.slice(0,16).forEach(function(ln) {
        if (wy > PH-15) { doc.addPage(); wy = 20; }
        doc.text(ln, M, wy); wy += 5;
      });
      wy += 2;
    }

    var pp = document.getElementById('pp'+i);
    if (pp && pp.src && pp.src.indexOf('data:') === 0) {
      if (wy > PH-55) { doc.addPage(); wy = 20; }
      try { doc.addImage(pp.src, 'JPEG', M, wy, TW, 68); wy += 72; } catch(e) {}
    }
  }

  var pages = doc.internal.getNumberOfPages();
  for (var p = 1; p <= pages; p++) {
    doc.setPage(p);
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0, PH-3, PW, 3, 'F');
    doc.setTextColor(130,140,160); doc.setFontSize(6.5); doc.setFont('helvetica','normal');
    doc.text(name+'  ·  '+group+'  ·  '+t('pdf-code')+code+'  ·  '+t('pdf-page')+p+'/'+pages,
      PW/2, PH-5, {align:'center'});
  }

  var _fn = SCHOOL.filePrefix + '_' + name.replace(/\s+/g,'_') + '_' + group.replace(/\s+/g,'_') + '.pdf';
  var _pdfBlob = doc.output('blob');
  var _blobUrl = URL.createObjectURL(_pdfBlob);
  var _a = document.createElement('a');
  _a.href = _blobUrl;
  _a.download = _fn;
  document.body.appendChild(_a);
  _a.click();
  setTimeout(function(){ document.body.removeChild(_a); URL.revokeObjectURL(_blobUrl); }, 200);
  btn.textContent = t('btn-pdf');
  btn.disabled  = false;
}
</script>
</body>
</html>
