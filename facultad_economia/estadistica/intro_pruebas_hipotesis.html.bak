var LANG = 'es';
var LANG_KEY = 'fac_econ_est__lang';
function t(k) { return (TX[LANG] && TX[LANG][k]) || TX.es[k] || k; }

/* ════════════════════════════════════════════════════════════════════════
   STATE
   ════════════════════════════════════════════════════════════════════════ */
var studentData   = {};
var problems      = [];
var sectionDefs   = [];
var widgets       = [];
var answeredCount = 0;
var correctCount  = 0;

/* ════════════════════════════════════════════════════════════════════════
   THEME
   ════════════════════════════════════════════════════════════════════════ */
var THEME_KEY = 'fac_econ_est__theme';
function applyThemeVars(mode) {
  var r = document.documentElement.style;
  if (mode === 'dark') {
    r.setProperty('--green',      SCHOOL.darkPrimary);
    r.setProperty('--green-dark', SCHOOL.darkPrimaryDark);
    r.setProperty('--green-bg',   SCHOOL.darkPrimaryBg);
    r.setProperty('--gold',       SCHOOL.darkAccent);
    r.setProperty('--gold-bg',    SCHOOL.darkAccentBg);
  } else {
    r.setProperty('--green',      SCHOOL.primary);
    r.setProperty('--green-dark', SCHOOL.primaryDark);
    r.setProperty('--green-bg',   SCHOOL.primaryBg);
    r.setProperty('--gold',       SCHOOL.accent);
    r.setProperty('--gold-bg',    SCHOOL.accentBg);
  }
}
function toggleTheme() {
  var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  applyThemeVars(next);
  document.getElementById('themeBtn').textContent = next === 'dark' ? '☀️' : '🌙';
  try { localStorage.setItem(THEME_KEY, next); } catch(e) {}
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
}
(function() {
  document.documentElement.setAttribute('data-theme', 'light');
  applyThemeVars('light');
  try {
    var th = localStorage.getItem(THEME_KEY);
    if (th === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      applyThemeVars('dark');
      document.addEventListener('DOMContentLoaded', function() {
        var b = document.getElementById('themeBtn');
        if (b) b.textContent = '☀️';
      });
    }
  } catch(e) {}
})();

/* ════════════════════════════════════════════════════════════════════════
   ATTEMPT COUNTER + SEEDED RNG
   ════════════════════════════════════════════════════════════════════════ */
function getAttemptKey(name, group) {
  return 'fac_econ_est__est_hyp_intro__att__' + (name + '__' + group).replace(/\s+/g, '_');
}
function nextAttempt(name, group) {
  var k = getAttemptKey(name, group), n = 0;
  try { n = parseInt(localStorage.getItem(k) || '0', 10) || 0; } catch(e) {}
  n++;
  try { localStorage.setItem(k, String(n)); } catch(e) {}
  return n;
}
function currentAttempt(name, group) {
  var k = getAttemptKey(name, group);
  try { return parseInt(localStorage.getItem(k) || '1', 10) || 1; } catch(e) { return 1; }
}
function seededRng(seed) {
  var s = 0;
  for (var i = 0; i < seed.length; i++) s = (Math.imul(31, s) + seed.charCodeAt(i)) | 0;
  return function() {
    s = (s + 0x9e3779b9) | 0;
    var t2 = s ^ (s >>> 16);
    t2 = Math.imul(t2, 0x21f0aaad);
    t2 ^= (t2 >>> 15);
    t2 = Math.imul(t2, 0x735a2d97);
    return ((t2 ^ (t2 >>> 15)) >>> 0) / 4294967296;
  };
}
function pick(arr, rng) { return arr[Math.floor(rng() * arr.length)]; }
function shuffle(arr, rng) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(rng() * (i + 1));
    var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
  }
  return a;
}
/* Shuffles the four options once and keeps both language versions aligned. */
function shuffleOpts(rawEs, rawEn, rng) {
  var p = shuffle([0, 1, 2, 3], rng);
  return {
    es: p.map(function(j) { return rawEs[j]; }),
    en: p.map(function(j) { return rawEn[j]; }),
    correctIdx: p.indexOf(0)
  };
}

/* ════════════════════════════════════════════════════════════════════════
   NUMBER HELPERS
   ════════════════════════════════════════════════════════════════════════ */
function nf(x) {
  var neg = x < 0, v = Math.abs(x);
  var s = (Math.round(v * 10) / 10).toString().split('.');
  s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return (neg ? '−' : '') + s.join('.');
}
function money(v) { return '$' + nf(Math.round(v)); }
function pr(x)    { return x.toFixed(4); }
function dec1(x)  { return x.toFixed(1); }
function dec2(x)  { return x.toFixed(2); }
function dec3(x)  { return x.toFixed(3); }
/* Percentage with one decimal, identical in both languages. */
function pct1(x)  { return (Math.round(x * 1000) / 10).toFixed(1); }
function pctS(x)  { return pct1(x) + '%'; }
function intN(x)  { return nf(Math.round(x)); }

/* ── NORMAL MODEL · the sampling distribution rests on it ── */
function erfc(x) {
  var z = Math.abs(x), tt = 1 / (1 + 0.5 * z);
  var ans = tt * Math.exp(-z * z - 1.26551223 + tt * (1.00002368 + tt * (0.37409196 +
    tt * (0.09678418 + tt * (-0.18628806 + tt * (0.27886807 + tt * (-1.13520398 +
    tt * (1.48851587 + tt * (-0.82215223 + tt * 0.17087277)))))))));
  return x >= 0 ? ans : 2 - ans;
}
function nPdf(z)  { return Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI); }
function nCdf(z)  { return 0.5 * erfc(-z / Math.SQRT2); }
/* Inverse of the standard normal, rational approximation of Acklam. */
function nInv(p) {
  if (p <= 0) return -8; if (p >= 1) return 8;
  var a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02,
           1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00];
  var b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02,
           6.680131188771972e+01, -1.328068155288572e+01];
  var c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00,
           -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00];
  var d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00,
           3.754408661907416e+00];
  var pl = 0.02425, ph = 1 - pl, q, r;
  if (p < pl) {
    q = Math.sqrt(-2 * Math.log(p));
    return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /
           ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
  }
  if (p > ph) {
    q = Math.sqrt(-2 * Math.log(1 - p));
    return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /
            ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
  }
  q = p - 0.5; r = q * q;
  return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5]) * q /
         (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);
}

/* ── STUDENT t MODEL · used when the deviation comes from the sample ── */
function lgamma(x) {
  var g = [76.18009172947146, -86.50532032941677, 24.01409824083091,
           -1.231739572450155, 0.1208650973866179e-2, -0.5395239384953e-5];
  var y = x, tmp = x + 5.5, ser = 1.000000000190015;
  tmp -= (x + 0.5) * Math.log(tmp);
  for (var j = 0; j < 6; j++) { y += 1; ser += g[j] / y; }
  return -tmp + Math.log(2.5066282746310005 * ser / x);
}
function betacf(a, b, x) {
  var MAXIT = 220, EPS = 3e-12, FPMIN = 1e-300;
  var qab = a + b, qap = a + 1, qam = a - 1;
  var c = 1, d = 1 - qab * x / qap;
  if (Math.abs(d) < FPMIN) d = FPMIN;
  d = 1 / d;
  var h = d, m, m2, aa, del;
  for (m = 1; m <= MAXIT; m++) {
    m2 = 2 * m;
    aa = m * (b - m) * x / ((qam + m2) * (a + m2));
    d = 1 + aa * d; if (Math.abs(d) < FPMIN) d = FPMIN;
    c = 1 + aa / c; if (Math.abs(c) < FPMIN) c = FPMIN;
    d = 1 / d; h *= d * c;
    aa = -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2));
    d = 1 + aa * d; if (Math.abs(d) < FPMIN) d = FPMIN;
    c = 1 + aa / c; if (Math.abs(c) < FPMIN) c = FPMIN;
    d = 1 / d; del = d * c; h *= del;
    if (Math.abs(del - 1) < EPS) break;
  }
  return h;
}
function ibeta(a, b, x) {
  if (x <= 0) return 0;
  if (x >= 1) return 1;
  var bt = Math.exp(lgamma(a + b) - lgamma(a) - lgamma(b) +
                    a * Math.log(x) + b * Math.log(1 - x));
  if (x < (a + 1) / (a + b + 2)) return bt * betacf(a, b, x) / a;
  return 1 - bt * betacf(b, a, 1 - x) / b;
}
function tCdf(tv, df) {
  var x = df / (df + tv * tv);
  var p = 0.5 * ibeta(df / 2, 0.5, x);
  return tv > 0 ? 1 - p : p;
}
/* One sided critical value of the t model, found by bisection. */
function tCritOne(alpha, df) {
  var target = 1 - alpha, lo = 0, hi = 80, mid;
  for (var i = 0; i < 90; i++) {
    mid = (lo + hi) / 2;
    if (tCdf(mid, df) < target) lo = mid; else hi = mid;
  }
  return (lo + hi) / 2;
}

/* ── THE MACHINERY OF A TEST ── */
function seMean(sd, n) { return sd / Math.sqrt(n); }
/* Critical values. One tail leaves the whole risk on one side, two tails split it. */
function zOne(alpha) { return nInv(1 - alpha); }
function zTwo(alpha) { return nInv(1 - alpha / 2); }
/* Test statistic for a mean when the deviation of the population is known. */
function zStat(xbar, mu0, sd, n) { return (xbar - mu0) / seMean(sd, n); }
/* p values for each direction of the alternative. */
function pRight(z) { return 1 - nCdf(z); }
function pLeft(z)  { return nCdf(z); }
function pTwo(z)   { return 2 * (1 - nCdf(Math.abs(z))); }
/* Probability of the second kind of error and power, for a right sided test. */
function betaRight(mu0, mu1, sd, n, alpha) {
  var se = seMean(sd, n), crit = mu0 + zOne(alpha) * se;
  return nCdf((crit - mu1) / se);
}
function powerRight(mu0, mu1, sd, n, alpha) { return 1 - betaRight(mu0, mu1, sd, n, alpha); }
function cssv(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }

/* ════════════════════════════════════════════════════════════════════════
   OPTION BUILDERS · the key is always the first value handed in
   ════════════════════════════════════════════════════════════════════════ */
/* Four distinct numbers rendered by fmt, aligned across languages. */
function valOpts(correct, wrongs, fmt, rng) {
  var seen = {}, vals = [];
  function add(v) {
    if (typeof v !== 'number' || !isFinite(v)) return;
    var s = fmt(v);
    if (seen[s]) return;
    seen[s] = 1; vals.push(s);
  }
  add(correct);
  for (var i = 0; i < wrongs.length && vals.length < 4; i++) add(wrongs[i]);
  for (var j = 1; vals.length < 4 && j < 900; j++) {
    add(correct * (1 + j * 0.12 * (j % 2 ? 1 : -1)));
  }
  for (var k = 1; vals.length < 4 && k < 900; k++) add(correct + k * 0.37);
  return shuffleOpts(vals, vals, rng);
}
function intOpts(correct, wrongs, rng) {
  var seen = {}, vals = [];
  function add(v) {
    if (typeof v !== 'number' || !isFinite(v) || v < 1) return;
    var s = intN(v);
    if (seen[s]) return;
    seen[s] = 1; vals.push(s);
  }
  add(correct);
  for (var i = 0; i < wrongs.length && vals.length < 4; i++) add(wrongs[i]);
  for (var j = 1; vals.length < 4 && j < 900; j++) add(Math.round(correct * (1 + j * 0.13 * (j % 2 ? 1 : -1))));
  return shuffleOpts(vals, vals, rng);
}

/* ════════════════════════════════════════════════════════════════════════
   SESSION PERSISTENCE
   ════════════════════════════════════════════════════════════════════════ */
function lsKey() {
  var n = (studentData.name || '').trim(), g = (studentData.group || '').trim();
  return 'fac_econ_est__est_hyp_intro__' + (n + '__' + g).replace(/\s+/g, '_');
}
function saveSession() {
  if (!studentData.name) return;
  var drawings = [], texts = [], photos = [];
  problems.forEach(function(p, i) {
    var dc = document.getElementById('dc' + i);
    if (dc && dc.width) {
      var blank = document.createElement('canvas');
      blank.width = dc.width; blank.height = dc.height;
      drawings.push(dc.toDataURL() === blank.toDataURL() ? null : dc.toDataURL('image/png'));
    } else { drawings.push(null); }
    var ta = document.getElementById('ta' + i);
    texts.push(ta ? ta.value : '');
    var pp = document.getElementById('pp' + i);
    photos.push((pp && pp.src && pp.src.indexOf('data:') === 0) ? pp.src : null);
  });
  var state = {
    name: studentData.name, group: studentData.group,
    answeredCount: answeredCount, correctCount: correctCount,
    choices: problems.map(function(p) { return p.studentChoice; }),
    drawings: drawings, texts: texts, photos: photos
  };
  try { localStorage.setItem(lsKey(), JSON.stringify(state)); } catch(e) {}
}
function loadSession(name, group) {
  var key = 'fac_econ_est__est_hyp_intro__' + (name + '__' + group).replace(/\s+/g, '_');
  try { var r = localStorage.getItem(key); return r ? JSON.parse(r) : null; } catch(e) { return null; }
}
function dismissRestore() { document.getElementById('restoreBar').style.display = 'none'; }
function checkForSavedSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  if (!name || !group) { document.getElementById('restoreBar').style.display = 'none'; return; }
  var saved = loadSession(name, group);
  var bar = document.getElementById('restoreBar');
  bar.style.display = (saved && saved.choices && saved.choices.some(function(c) { return c !== null; })) ? 'block' : 'none';
}
function observeSections() {
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('vis'); });
  }, { threshold: 0.05 });
  document.querySelectorAll('.section').forEach(function(s) { obs.observe(s); });
}

/* ════════════════════════════════════════════════════════════════════════
   START / RESTORE
   ════════════════════════════════════════════════════════════════════════ */
function startLesson() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var err   = document.getElementById('startErr');
  if (!name || !group) { err.textContent = t('err-fields'); return; }
  err.textContent = '';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = nextAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
}
function restoreSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var saved = loadSession(name, group);
  if (!saved) return;
  document.getElementById('restoreBar').style.display = 'none';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = currentAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
  saved.choices.forEach(function(choice, idx) {
    if (choice !== null && choice !== undefined) confirmMC(idx, choice);
  });
  setTimeout(function() {
    if (saved.drawings) saved.drawings.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var dc = document.getElementById('dc' + i);
      if (!dc || !dc.width) return;
      var img = new Image();
      img.onload = function() {
        var dpr = window.devicePixelRatio || 1;
        dc.getContext('2d').drawImage(img, 0, 0, dc.width / dpr, dc.height / dpr);
      };
      img.src = dataUrl;
    });
    if (saved.texts) saved.texts.forEach(function(txt, i) {
      if (!txt) return;
      var ta = document.getElementById('ta' + i);
      if (ta) ta.value = txt;
    });
    if (saved.photos) saved.photos.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var pp = document.getElementById('pp' + i);
      if (!pp) return;
      pp.src = dataUrl; pp.style.display = 'block';
      var pz = document.getElementById('pz' + i);
      if (pz) pz.style.opacity = '0.4';
    });
  }, 300);
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS / TABS / PHOTO / HINT / RESULTS
   ════════════════════════════════════════════════════════════════════════ */
function initCanvas(canvas) {
  var dpr  = window.devicePixelRatio || 1;
  var rect = canvas.getBoundingClientRect();
  canvas.width  = rect.width  * dpr;
  canvas.height = rect.height * dpr;
  var ctx = canvas.getContext('2d');
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.scale(dpr, dpr);
  ctx.strokeStyle = '#2d5a27';
  ctx.lineWidth   = 2;
  ctx.lineCap     = 'round';
  ctx.lineJoin    = 'round';
  var drawing = false, lx = 0, ly = 0;
  var tb = canvas.closest('.cvwrap').querySelector('.ctoolbar');
  function getPos(e) {
    var r = canvas.getBoundingClientRect();
    var src = e.touches ? e.touches[0] : e;
    return [src.clientX - r.left, src.clientY - r.top];
  }
  function onDown(e) { e.preventDefault(); drawing = true; var p = getPos(e); lx = p[0]; ly = p[1]; }
  function onMove(e) { e.preventDefault(); if (!drawing) return; var p = getPos(e); ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p[0], p[1]); ctx.stroke(); lx = p[0]; ly = p[1]; }
  function onUp() { drawing = false; saveSession(); }
  canvas.addEventListener('mousedown',  onDown, { passive:false });
  canvas.addEventListener('mousemove',  onMove, { passive:false });
  canvas.addEventListener('mouseup',    onUp);
  canvas.addEventListener('mouseleave', onUp);
  canvas.addEventListener('touchstart', onDown, { passive:false });
  canvas.addEventListener('touchmove',  onMove, { passive:false });
  canvas.addEventListener('touchend',   onUp);
  tb.querySelectorAll('.tbtn2').forEach(function(btn) {
    btn.addEventListener('click', function() {
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      if (btn.classList.contains('bpen'))    { ctx.lineWidth = 2; }
      if (btn.classList.contains('bmarker')) { ctx.lineWidth = 10; ctx.globalAlpha = 0.45; }
      if (btn.classList.contains('beraser')) { ctx.globalCompositeOperation = 'destination-out'; ctx.lineWidth = 20; }
    });
  });
  tb.querySelectorAll('.cdot').forEach(function(dot) {
    dot.addEventListener('click', function() {
      tb.querySelectorAll('.cdot').forEach(function(d) { d.classList.remove('sel'); });
      dot.classList.add('sel');
      ctx.strokeStyle = dot.dataset.color;
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      tb.querySelector('.bpen').classList.add('on');
    });
  });
  tb.querySelector('.clrbtn').addEventListener('click', function() {
    ctx.clearRect(0, 0, canvas.width / dpr, canvas.height / dpr);
  });
}
function switchTab(idx, panel, btn) {
  var prefix = 'wp_' + idx + '_';
  document.querySelectorAll('[id^="' + prefix + '"]').forEach(function(p) { p.classList.remove('active'); });
  document.getElementById(prefix + panel).classList.add('active');
  btn.closest('.wtabs').querySelectorAll('.wtab').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
}
function handlePhoto(idx, input) {
  if (!input.files || !input.files[0]) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var img = document.getElementById('pp' + idx);
    img.src = e.target.result;
    img.style.display = 'block';
    document.getElementById('pz' + idx).style.opacity = '0.4';
    saveSession();
  };
  reader.readAsDataURL(input.files[0]);
}
function toggleHint(idx) { document.getElementById('hint' + idx).classList.toggle('show'); }
function showResults() {
  var rb = document.getElementById('s_results');
  if (!rb) return;
  rb.style.display = 'block';
  setTimeout(function() {
    rb.classList.add('vis');
    rb.scrollIntoView({ behavior:'smooth', block:'center' });
  }, 50);
}

/* ════════════════════════════════════════════════════════════════════════
   ANSWER HANDLER · two taps to confirm
   ════════════════════════════════════════════════════════════════════════ */
function handleMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  if (prob.pendingChoice === chosenIdx) {
    prob.studentChoice = chosenIdx;
    prob.pendingChoice = null;
    var isOk = (chosenIdx === prob.correctIdx);
    opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
    opts.forEach(function(o, i) {
      if (i === prob.correctIdx) o.classList.add('rc');
      if (i === chosenIdx && isOk)  o.classList.add('sc');
      if (i === chosenIdx && !isOk) o.classList.add('sw');
    });
    var fb = document.getElementById('fb' + probIdx);
    fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.explanation;
    fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
    document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
    if (isOk) correctCount++;
    answeredCount++;
    document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
    saveSession();
    if (answeredCount === problems.length) setTimeout(showResults, 700);
    return;
  }
  prob.pendingChoice = chosenIdx;
  opts.forEach(function(o) { o.classList.remove('pending'); });
  opts[chosenIdx].classList.add('pending');
}
function confirmMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (!prob || prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  prob.studentChoice = chosenIdx;
  prob.pendingChoice = null;
  var isOk = (chosenIdx === prob.correctIdx);
  opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
  opts.forEach(function(o, i) {
    if (i === prob.correctIdx) o.classList.add('rc');
    if (i === chosenIdx && isOk)  o.classList.add('sc');
    if (i === chosenIdx && !isOk) o.classList.add('sw');
  });
  var fb = document.getElementById('fb' + probIdx);
  fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.explanation;
  fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
  document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
  if (isOk) correctCount++;
  answeredCount++;
  document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
  saveSession();
  if (answeredCount === problems.length) setTimeout(showResults, 700);
}

/* ════════════════════════════════════════════════════════════════════════
   BUILD ONE CARD · appended inline, right after its concept
   ════════════════════════════════════════════════════════════════════════ */
function buildOneCard(prob, i) {
  var opts = prob.options.map(function(opt, oi) {
    return '<div class="mcopt" onclick="handleMC(' + i + ',' + oi + ')">' + opt + '</div>';
  }).join('');
  var work = '';
  if (prob.showWork) {
    work =
      '<div style="margin-bottom:.85rem">' +
        '<div class="wtabs">' +
          '<button class="wtab active" onclick="switchTab(' + i + ',\'draw\',this)">' + t('tab-draw') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'type\',this)">' + t('tab-type') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'photo\',this)">' + t('tab-photo') + '</button>' +
        '</div>' +
        '<div class="wpanel active" id="wp_' + i + '_draw">' +
          '<div class="cvwrap">' +
            '<canvas class="dcanvas" id="dc' + i + '"></canvas>' +
            '<div class="ctoolbar">' +
              '<button class="tbtn2 bpen on">' + t('tool-pen') + '</button>' +
              '<button class="tbtn2 bmarker">' + t('tool-mark') + '</button>' +
              '<button class="tbtn2 beraser">' + t('tool-erase') + '</button>' +
              '<div class="cdot sel" data-color="#2d5a27" style="background:#2d5a27"></div>' +
              '<div class="cdot"     data-color="#1a1a16" style="background:#1a1a16"></div>' +
              '<div class="cdot"     data-color="#8b2500" style="background:#8b2500"></div>' +
              '<div class="cdot"     data-color="#1d4e89" style="background:#1d4e89"></div>' +
              '<button class="clrbtn">' + t('tool-clear') + '</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_type">' +
          '<textarea class="wtextarea" id="ta' + i + '" placeholder="' + t('ph-work') + '" oninput="saveSession()"></textarea>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_photo">' +
          '<div class="pzone" id="pz' + i + '">' +
            '<input type="file" accept="image/*" onchange="handlePhoto(' + i + ',this)">' +
            '<div class="pzicon">📸</div>' +
            '<div class="pztxt">' + t('ph-photo') + '</div>' +
          '</div>' +
          '<img class="ppreview" id="pp' + i + '" alt="' + t('alt-work') + '">' +
        '</div>' +
      '</div>';
  }
  var card = document.createElement('div');
  card.className = 'pcrd section';
  card.id = 'pc' + i;
  card.innerHTML =
    '<div class="phdr"><div class="pnum">' + (i + 1) + '</div><div class="ptitle">' + prob.title + '</div></div>' +
    '<div class="pbody">' +
      '<div class="pstmt">' + prob.questionText + '<span class="pfn">' + (prob.fn || '') + '</span></div>' +
      work +
      '<button class="hintbtn" onclick="toggleHint(' + i + ')">' + t('btn-hint') + '</button>' +
      '<div class="hintbox" id="hint' + i + '">' + (prob.hint || '') + '</div>' +
      '<div style="margin-top:.7rem">' +
        '<div style="font-family:\'IBM Plex Mono\',monospace;font-size:.65rem;letter-spacing:.1em;color:var(--text3);text-transform:uppercase;margin-bottom:.5rem">' + t('lbl-answer') + '</div>' +
        '<div class="mcopts">' + opts + '</div>' +
        '<div class="mcfb" id="fb' + i + '"></div>' +
      '</div>' +
    '</div>';
  document.getElementById('lessonBody').appendChild(card);
  if (prob.showWork) setTimeout(function() { var c = document.getElementById('dc' + i); if (c) initCanvas(c); }, 80);
}

/* ════════════════════════════════════════════════════════════════════════
   SECTION REGISTRY  (concept text is re-rendered on language switch)
   ════════════════════════════════════════════════════════════════════════ */
function addSection(fn) {
  var d = document.createElement('div');
  d.className = 'section';
  d.innerHTML = fn(LANG);
  document.getElementById('lessonBody').appendChild(d);
  sectionDefs.push({ el: d, fn: fn });
}
function applySectionLang() {
  sectionDefs.forEach(function(s) { s.el.innerHTML = s.fn(LANG); });
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS PRIMITIVES FOR THE WIDGETS
   ════════════════════════════════════════════════════════════════════════ */
function fitCanvas(cv, h) {
  var dpr = window.devicePixelRatio || 1;
  var w = Math.max(240, cv.clientWidth || cv.parentNode.clientWidth || 300);
  cv.style.height = h + 'px';
  cv.width  = Math.round(w * dpr);
  cv.height = Math.round(h * dpr);
  var ctx = cv.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);
  return { ctx: ctx, w: w, h: h };
}
function palette() {
  return {
    green: cssv('--green'), dark: cssv('--green-dark'), tint: cssv('--green-bg'),
    gold: cssv('--gold'), bad: cssv('--bad'), border: cssv('--border'),
    text: cssv('--text'), text2: cssv('--text2'), text3: cssv('--text3')
  };
}
/* Draws one normal density over four standard deviations on each side. Bands
   carry a kind: 0 pale, 1 green for the region where the null survives, 2 gold
   for the rejection region. opts.obs marks the statistic the sample produced. */
function drawCurve(g, mu, sd, bands, opts) {
  var ctx = g.ctx, P = palette(), W = g.w, H = g.h;
  var padL = 12, padR = 12, padT = 16, padB = 22;
  var x0 = mu - 4 * sd, x1 = mu + 4 * sd, i;
  opts = opts || {};
  var fmt = opts.fmt || function(v) { return nf(v); };
  function X(v) { return padL + (v - x0) / (x1 - x0) * (W - padL - padR); }
  var peak = nPdf(0) / sd;
  function Y(d) { return H - padB - d / peak * (H - padT - padB); }
  function dens(v) { return nPdf((v - mu) / sd) / sd; }
  var step = (x1 - x0) / 260;
  (bands || []).forEach(function(b) {
    var a = Math.max(x0, b.a), c = Math.min(x1, b.b), v;
    if (c <= a) return;
    ctx.beginPath();
    ctx.moveTo(X(a), H - padB);
    for (v = a; v <= c; v += step) ctx.lineTo(X(v), Y(dens(v)));
    ctx.lineTo(X(c), Y(dens(c)));
    ctx.lineTo(X(c), H - padB);
    ctx.closePath();
    ctx.fillStyle = b.kind === 2 ? P.gold : b.kind === 1 ? P.green : P.tint;
    ctx.globalAlpha = b.kind === 0 ? 1 : 0.42;
    ctx.fill();
    ctx.globalAlpha = 1;
  });
  ctx.strokeStyle = P.border; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(padL, H - padB); ctx.lineTo(W - padR, H - padB); ctx.stroke();
  ctx.strokeStyle = P.dark; ctx.lineWidth = 2;
  ctx.beginPath();
  for (i = 0; i <= 260; i++) {
    var vv = x0 + i * step;
    if (i === 0) ctx.moveTo(X(vv), Y(dens(vv))); else ctx.lineTo(X(vv), Y(dens(vv)));
  }
  ctx.stroke();
  (opts.marks || []).forEach(function(m) {
    if (m < x0 || m > x1) return;
    ctx.save();
    ctx.strokeStyle = P.gold; ctx.lineWidth = 1.8;
    ctx.beginPath(); ctx.moveTo(X(m), H - padB); ctx.lineTo(X(m), Y(dens(m))); ctx.stroke();
    ctx.restore();
  });
  if (typeof opts.obs === 'number' && opts.obs >= x0 && opts.obs <= x1) {
    ctx.save();
    ctx.strokeStyle = P.bad; ctx.lineWidth = 2.4;
    ctx.beginPath(); ctx.moveTo(X(opts.obs), H - padB); ctx.lineTo(X(opts.obs), padT - 6); ctx.stroke();
    ctx.fillStyle = P.bad; ctx.font = '600 10px "IBM Plex Sans", sans-serif';
    if (opts.obsLabel) {
      var ow = ctx.measureText(opts.obsLabel).width;
      ctx.fillText(opts.obsLabel, Math.min(Math.max(2, X(opts.obs) - ow / 2), W - ow - 2), H - padB + 21);
    }
    ctx.restore();
  }
  ctx.save();
  ctx.strokeStyle = P.dark; ctx.lineWidth = 1.6; ctx.setLineDash([4, 3]);
  ctx.beginPath(); ctx.moveTo(X(mu), padT - 8); ctx.lineTo(X(mu), H - padB); ctx.stroke();
  ctx.restore();
  if (opts.muLabel) {
    ctx.fillStyle = P.dark; ctx.font = '600 10px "IBM Plex Sans", sans-serif';
    var lw = ctx.measureText(opts.muLabel).width;
    ctx.fillText(opts.muLabel, Math.min(Math.max(2, X(mu) - lw / 2), W - lw - 2), 11);
  }
  ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Mono", monospace';
  for (i = -2; i <= 2; i++) {
    var tv = mu + i * sd, lab = fmt(tv), tw = ctx.measureText(lab).width;
    ctx.fillText(lab, Math.min(Math.max(1, X(tv) - tw / 2), W - tw - 1), H - padB + 13);
  }
}
/* Draws the world the null describes and the world the alternative describes on
   the same axis. Gold is the risk of a false alarm, red is the risk of missing
   a real change, and green is the power that remains for the business. */
function drawTwoWorlds(g, mu0, mu1, se, crit, labels) {
  var ctx = g.ctx, P = palette(), W = g.w, H = g.h;
  var padL = 12, padR = 12, padT = 22, padB = 24;
  var x0 = Math.min(mu0, mu1) - 4 * se, x1 = Math.max(mu0, mu1) + 4 * se, i;
  function X(v) { return padL + (v - x0) / (x1 - x0) * (W - padL - padR); }
  var peak = nPdf(0) / se;
  function Y(d) { return H - padB - d / peak * (H - padT - padB); }
  function d0(v) { return nPdf((v - mu0) / se) / se; }
  function d1(v) { return nPdf((v - mu1) / se) / se; }
  var step = (x1 - x0) / 300;
  function band(a, b, dens, color) {
    var v;
    if (b <= a) return;
    ctx.beginPath();
    ctx.moveTo(X(a), H - padB);
    for (v = a; v <= b; v += step) ctx.lineTo(X(v), Y(dens(v)));
    ctx.lineTo(X(b), Y(dens(b)));
    ctx.lineTo(X(b), H - padB);
    ctx.closePath();
    ctx.fillStyle = color; ctx.globalAlpha = 0.45; ctx.fill(); ctx.globalAlpha = 1;
  }
  band(crit, x1, d0, P.gold);
  band(x0, crit, d1, P.bad);
  band(crit, x1, d1, P.green);
  ctx.strokeStyle = P.border; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(padL, H - padB); ctx.lineTo(W - padR, H - padB); ctx.stroke();
  ctx.strokeStyle = P.dark; ctx.lineWidth = 2;
  ctx.beginPath();
  for (i = 0; i <= 300; i++) {
    var va = x0 + i * step;
    if (i === 0) ctx.moveTo(X(va), Y(d0(va))); else ctx.lineTo(X(va), Y(d0(va)));
  }
  ctx.stroke();
  ctx.save();
  ctx.strokeStyle = P.green; ctx.lineWidth = 2; ctx.setLineDash([5, 3]);
  ctx.beginPath();
  for (i = 0; i <= 300; i++) {
    var vb = x0 + i * step;
    if (i === 0) ctx.moveTo(X(vb), Y(d1(vb))); else ctx.lineTo(X(vb), Y(d1(vb)));
  }
  ctx.stroke();
  ctx.restore();
  ctx.save();
  ctx.strokeStyle = P.bad; ctx.lineWidth = 2.2;
  ctx.beginPath(); ctx.moveTo(X(crit), H - padB); ctx.lineTo(X(crit), padT - 10); ctx.stroke();
  ctx.restore();
  ctx.fillStyle = P.dark; ctx.font = '600 10px "IBM Plex Sans", sans-serif';
  ctx.fillText(labels.h0, padL + 2, 12);
  ctx.fillStyle = P.green;
  ctx.fillText(labels.h1, W - padR - ctx.measureText(labels.h1).width - 2, 12);
  ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Mono", monospace';
  var critLab = labels.crit, cw = ctx.measureText(critLab).width;
  ctx.fillText(critLab, Math.min(Math.max(1, X(crit) - cw / 2), W - cw - 1), H - padB + 20);
  [mu0, mu1].forEach(function(m, k) {
    var lab = k === 0 ? labels.m0 : labels.m1, tw = ctx.measureText(lab).width;
    ctx.fillText(lab, Math.min(Math.max(1, X(m) - tw / 2), W - tw - 1), H - padB + 11);
  });
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 1 · where the doubt goes when the claim points one way
   ════════════════════════════════════════════════════════════════════════ */
function widgetTails(al0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { tail: 'right', al: al0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'right', es: 'La sospecha dice mayor', en: 'The suspicion says larger' },
      { id: 'left',  es: 'La sospecha dice menor', en: 'The suspicion says smaller' },
      { id: 'two',   es: 'Solo dice distinto',     en: 'It only says different' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.tail ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="planteamiento-y-cola-de-la-prueba">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Hacia dónde apunta la sospecha del negocio' : 'Where the suspicion of the business points') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Un proveedor promete un tiempo de entrega y la empresa quiere revisarlo. Lo que se decide primero no es un número sino una dirección: si la sospecha es que el proveedor tarda más, si es que tarda menos, o si solo interesa saber que el tiempo cambió. Cambia de pestaña y observa cómo se mueve la zona dorada, que es donde la evidencia sería tan rara que se abandona la promesa. Mueve después el riesgo que la empresa acepta y verás que la zona dorada se ensancha o se encoge.'
          : 'A supplier promises a delivery time and the company wants to check it. What gets decided first is not a number but a direction: whether the suspicion is that the supplier takes longer, that it takes less, or that only a change matters. Switch tabs and watch the gold zone move, the zone where the evidence would be so rare that the promise gets dropped. Then move the risk the company accepts and you will see the gold zone widen or shrink.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Riesgo aceptado de falsa alarma en por ciento' : 'Accepted risk of a false alarm in percent') + ': <span class="cval" id="t1al"></span></label>' +
          '<input type="range" min="1" max="15" step="1" id="t1a" value="' + state.al + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Zona verde' : 'Green zone') + '</label>' +
          '<div style="font-size:.74rem;color:var(--text3)">' + (es ? 'Es donde la promesa del proveedor sobrevive a la revisión' : 'It is where the promise of the supplier survives the review') + '</div>' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="t1cv"></canvas>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Hipótesis nula' : 'Null hypothesis') + '</div><div class="mnum ts" id="t1h0"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Hipótesis alternativa' : 'Alternative hypothesis') + '</div><div class="mnum cs" id="t1h1"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Colas de rechazo' : 'Rejection tails') + '</div><div class="mnum ts" id="t1nt"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Valor crítico' : 'Critical value') + '</div><div class="mnum ps" id="t1cv2"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Riesgo por cola' : 'Risk per tail') + '</div><div class="mnum ps" id="t1pt"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Zona donde la nula sobrevive' : 'Zone where the null survives') + '</div><div class="mnum cs" id="t1keep"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="t1read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.tail = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#t1a').addEventListener('input', function() { state.al = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var al = state.al / 100;
    var two = state.tail === 'two';
    var zc  = two ? zTwo(al) : zOne(al);
    var bands, marks, h0txt, h1txt;
    if (state.tail === 'right') {
      bands = [{ a: -4, b: zc, kind: 1 }, { a: zc, b: 4, kind: 2 }];
      marks = [zc];
      h0txt = 'μ ≤ μ₀'; h1txt = 'μ > μ₀';
    } else if (state.tail === 'left') {
      bands = [{ a: -4, b: -zc, kind: 2 }, { a: -zc, b: 4, kind: 1 }];
      marks = [-zc];
      h0txt = 'μ ≥ μ₀'; h1txt = 'μ < μ₀';
    } else {
      bands = [{ a: -4, b: -zc, kind: 2 }, { a: -zc, b: zc, kind: 1 }, { a: zc, b: 4, kind: 2 }];
      marks = [-zc, zc];
      h0txt = 'μ = μ₀'; h1txt = 'μ ≠ μ₀';
    }
    host.querySelector('#t1al').textContent   = dec1(state.al);
    host.querySelector('#t1h0').textContent   = h0txt;
    host.querySelector('#t1h1').textContent   = h1txt;
    host.querySelector('#t1nt').textContent   = two ? '2' : '1';
    host.querySelector('#t1cv2').textContent  = (state.tail === 'left' ? '−' : '') + dec3(zc);
    host.querySelector('#t1pt').textContent   = pctS(two ? al / 2 : al);
    host.querySelector('#t1keep').textContent = pctS(1 - al);
    var dirMsg = (state.tail === 'right')
      ? (es ? 'La empresa sospecha que el proveedor tarda más de lo prometido, así que solo un retraso grande cuenta como evidencia y toda la zona dorada se va a la derecha.'
            : 'The company suspects the supplier takes longer than promised, so only a large delay counts as evidence and the whole gold zone goes to the right.')
      : (state.tail === 'left')
      ? (es ? 'La sospecha apunta a que el tiempo real es menor que el prometido, así que la zona dorada se va a la izquierda y un retraso, por grande que sea, nunca sería evidencia a favor de esa sospecha.'
            : 'The suspicion points to a real time smaller than promised, so the gold zone goes to the left and a delay, however large, would never be evidence for that suspicion.')
      : (es ? 'Aquí la empresa no se compromete con una dirección: cualquier cambio importa, y por eso el riesgo se reparte entre las dos colas y cada una recibe la mitad.'
            : 'Here the company does not commit to a direction: any change matters, and that is why the risk is split between the two tails and each one gets half.');
    host.querySelector('#t1read').innerHTML = (es
      ? '<strong>Lectura de negocio:</strong> ' : '<strong>Business reading:</strong> ') + dirMsg + (es
      ? ' Con un riesgo aceptado de ' + dec1(state.al) + ' por ciento el valor crítico vale ' + dec3(zc) + ' y la promesa del proveedor sobrevive mientras el resultado caiga en el ' + pctS(1 - al) + ' central. Fíjate en algo que suele sorprender: con el mismo riesgo total, la prueba de dos colas exige más evidencia que la de una cola, porque cada lado recibe apenas ' + pctS(al / 2) + '. Elegir la dirección después de ver los datos es hacer trampa, y por eso la dirección se fija en el contrato o en la pregunta de negocio, nunca en la hoja de cálculo.'
      : ' With an accepted risk of ' + dec1(state.al) + ' percent the critical value is ' + dec3(zc) + ' and the promise of the supplier survives as long as the result lands in the central ' + pctS(1 - al) + '. Notice something that often surprises: at the same total risk, the two tailed test demands more evidence than the one tailed one, because each side gets only ' + pctS(al / 2) + '. Choosing the direction after seeing the data is cheating, and that is why the direction is fixed in the contract or in the business question, never in the spreadsheet.');
    var g = fitCanvas(host.querySelector('#t1cv'), 160);
    drawCurve(g, 0, 1, bands, {
      marks: marks, fmt: function(v) { return dec2(v); },
      muLabel: (es ? 'Mundo donde la promesa se cumple' : 'World where the promise holds')
    });
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 2 · the two ways a decision can go wrong
   ════════════════════════════════════════════════════════════════════════ */
function widgetErrors(mu0, sd0, n0, ef0, al0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { n: n0, ef: ef0, al: al0 };
  var sd = sd0;
  function mount() {
    var es = LANG === 'es';
    host.innerHTML =
      '<div class="gcrd" data-widget="errores-tipo-i-y-tipo-ii">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Falsa alarma contra cambio que se pasa por alto' : 'False alarm against a change that slips by') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Una financiera probó un guion nuevo de cobranza y quiere saber si sube la recuperación promedio por cuenta. La curva sólida es el mundo donde el guion no sirvió y la punteada es el mundo donde sí subió la recuperación. La línea roja es el punto a partir del cual la empresa declara que el guion funciona. Mueve el riesgo aceptado, el tamaño de la prueba piloto y la mejora real, y observa que reducir un error casi siempre agranda el otro, salvo cuando lo que crece es la muestra.'
          : 'A lender tested a new collections script and wants to know whether it raises average recovery per account. The solid curve is the world where the script did nothing and the dotted one is the world where recovery did rise. The red line is the point from which the company declares the script works. Move the accepted risk, the size of the pilot and the real improvement, and watch how cutting one error almost always grows the other, except when what grows is the sample.') + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Riesgo aceptado de falsa alarma en por ciento' : 'Accepted risk of a false alarm in percent') + ': <span class="cval" id="e2all"></span></label>' +
          '<input type="range" min="1" max="20" step="1" id="e2a" value="' + state.al + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Cuentas en la prueba piloto' : 'Accounts in the pilot') + ': <span class="cval" id="e2nl"></span></label>' +
          '<input type="range" min="16" max="400" step="4" id="e2n" value="' + state.n + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Mejora real que trae el guion en pesos' : 'Real improvement the script brings in pesos') + ': <span class="cval" id="e2el"></span></label>' +
          '<input type="range" min="20" max="400" step="10" id="e2e" value="' + state.ef + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Franja roja' : 'Red band') + '</label>' +
          '<div style="font-size:.74rem;color:var(--text3)">' + (es ? 'Es la parte del mundo bueno que la prueba no alcanza a detectar' : 'It is the part of the good world the test fails to detect') + '</div>' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="e2cv"></canvas>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Error estándar' : 'Standard error') + '</div><div class="mnum ts" id="e2se"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Punto de corte' : 'Cut off point') + '</div><div class="mnum ts" id="e2cr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Riesgo de falsa alarma' : 'Risk of a false alarm') + '</div><div class="mnum ps" id="e2a1"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Riesgo de no ver la mejora' : 'Risk of missing the gain') + '</div><div class="mnum ps" id="e2b"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Potencia de la prueba' : 'Power of the test') + '</div><div class="mnum cs" id="e2pw"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Potencia si se duplica el piloto' : 'Power if the pilot doubles') + '</div><div class="mnum cs" id="e2p2"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="e2read"></div>' +
      '</div>';
    host.querySelector('#e2a').addEventListener('input', function() { state.al = parseInt(this.value, 10); update(); });
    host.querySelector('#e2n').addEventListener('input', function() { state.n  = parseInt(this.value, 10); update(); });
    host.querySelector('#e2e').addEventListener('input', function() { state.ef = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var al = state.al / 100, n = state.n, mu1 = mu0 + state.ef;
    var se = seMean(sd, n), crit = mu0 + zOne(al) * se;
    var beta = betaRight(mu0, mu1, sd, n, al), pw = 1 - beta;
    var pw2 = powerRight(mu0, mu1, sd, n * 2, al);
    host.querySelector('#e2all').textContent = dec1(state.al);
    host.querySelector('#e2nl').textContent  = intN(n);
    host.querySelector('#e2el').textContent  = money(state.ef);
    host.querySelector('#e2se').textContent  = dec2(se);
    host.querySelector('#e2cr').textContent  = money(crit);
    host.querySelector('#e2a1').textContent  = pctS(al);
    host.querySelector('#e2b').textContent   = pctS(beta);
    host.querySelector('#e2pw').textContent  = pctS(pw);
    host.querySelector('#e2p2').textContent  = pctS(pw2);
    host.querySelector('#e2read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> con ' + intN(n) + ' cuentas y una dispersión de ' + money(sd) + ', el error estándar es ' + dec2(se) + ' pesos y la empresa declararía exitoso el guion solo si la recuperación promedio del piloto supera ' + money(crit) + '. Si el guion en realidad no sirve, eso pasaría ' + pctS(al) + ' de las veces por puro azar: esa es la falsa alarma, y su costo es desplegar a todo el call center una herramienta que no aporta. Si el guion sí mejora la recuperación en ' + money(state.ef) + ', la prueba lo detectaría ' + pctS(pw) + ' de las veces y lo dejaría pasar ' + pctS(beta) + ': ese segundo error no hace ruido, simplemente archiva una mejora que ya estaba pagada. Bajar el riesgo de falsa alarma sube el segundo riesgo, y la única palanca que mejora los dos a la vez es la muestra: con ' + intN(n * 2) + ' cuentas la potencia subiría a ' + pctS(pw2) + '.'
      : '<strong>Business reading:</strong> with ' + intN(n) + ' accounts and a spread of ' + money(sd) + ', the standard error is ' + dec2(se) + ' pesos and the company would call the script a success only if average recovery in the pilot clears ' + money(crit) + '. If the script really does nothing, that would happen ' + pctS(al) + ' of the time by pure chance: that is the false alarm, and its cost is rolling out a useless tool to the whole call centre. If the script does raise recovery by ' + money(state.ef) + ', the test would catch it ' + pctS(pw) + ' of the time and let it slip ' + pctS(beta) + ': that second error makes no noise, it simply shelves an improvement that was already paid for. Lowering the risk of a false alarm raises the second risk, and the only lever that improves both at once is the sample: with ' + intN(n * 2) + ' accounts the power would climb to ' + pctS(pw2) + '.';
    var g = fitCanvas(host.querySelector('#e2cv'), 170);
    drawTwoWorlds(g, mu0, mu1, se, crit, {
      h0: (es ? 'El guion no sirvió' : 'The script did nothing'),
      h1: (es ? 'El guion sí mejoró' : 'The script did improve'),
      crit: money(crit),
      m0: money(mu0),
      m1: money(mu1)
    });
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 3 · turning pesos into a distance and reading the verdict
   ════════════════════════════════════════════════════════════════════════ */
function widgetStat(mu0, sd0, n0, dif0, al0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { sd: sd0, n: n0, dif: dif0, al: al0 };
  function mount() {
    var es = LANG === 'es';
    host.innerHTML =
      '<div class="gcrd" data-widget="estadistico-de-prueba-y-region-de-rechazo">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'De pesos a distancias, y de distancias a una decisión' : 'From pesos to distances, and from distances to a decision') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Una cadena de tiendas afirma que su ticket promedio es de ' + money(mu0) + ' y un análisis independiente revisó una muestra para ver si en realidad es mayor. El estadístico de prueba convierte la diferencia en pesos en un número de errores estándar, que es la única escala en la que la campana sabe responder. Mueve la diferencia observada, el tamaño de muestra y la variabilidad, y observa que una misma diferencia en pesos puede quedar dentro o fuera de la zona de rechazo según cuánta información la respalde.'
          : 'A retail chain claims its average ticket is ' + money(mu0) + ' and an independent analysis reviewed a sample to see whether it is in fact larger. The test statistic turns the difference in pesos into a number of standard errors, which is the only scale the bell knows how to answer in. Move the observed difference, the sample size and the variability, and watch how the same difference in pesos can land inside or outside the rejection zone depending on how much information backs it.') + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Diferencia observada en pesos' : 'Observed difference in pesos') + ': <span class="cval" id="s3dl"></span></label>' +
          '<input type="range" min="5" max="200" step="5" id="s3d" value="' + state.dif + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Tickets revisados' : 'Tickets reviewed') + ': <span class="cval" id="s3nl"></span></label>' +
          '<input type="range" min="16" max="600" step="8" id="s3n" value="' + state.n + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Desviación estándar del gasto' : 'Standard deviation of spending') + ': <span class="cval" id="s3sl"></span></label>' +
          '<input type="range" min="100" max="900" step="25" id="s3s" value="' + state.sd + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Riesgo aceptado de falsa alarma en por ciento' : 'Accepted risk of a false alarm in percent') + ': <span class="cval" id="s3al"></span></label>' +
          '<input type="range" min="1" max="15" step="1" id="s3a" value="' + state.al + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="s3cv"></canvas>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Error estándar' : 'Standard error') + '</div><div class="mnum ts" id="s3se"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Estadístico de prueba' : 'Test statistic') + '</div><div class="mnum cs" id="s3z"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Valor crítico' : 'Critical value') + '</div><div class="mnum ps" id="s3zc"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Promedio observado' : 'Observed average') + '</div><div class="mnum ts" id="s3xb"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Frontera en pesos' : 'Boundary in pesos') + '</div><div class="mnum ps" id="s3cr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Decisión' : 'Decision') + '</div><div class="mnum cs" id="s3dec"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="s3read"></div>' +
      '</div>';
    host.querySelector('#s3d').addEventListener('input', function() { state.dif = parseInt(this.value, 10); update(); });
    host.querySelector('#s3n').addEventListener('input', function() { state.n   = parseInt(this.value, 10); update(); });
    host.querySelector('#s3s').addEventListener('input', function() { state.sd  = parseInt(this.value, 10); update(); });
    host.querySelector('#s3a').addEventListener('input', function() { state.al  = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var al = state.al / 100;
    var xbar = mu0 + state.dif;
    var se = seMean(state.sd, state.n);
    var z  = zStat(xbar, mu0, state.sd, state.n);
    var zc = zOne(al);
    var crit = mu0 + zc * se;
    var rejects = z > zc;
    var nNeeded = Math.ceil(Math.pow(zc * state.sd / state.dif, 2));
    host.querySelector('#s3dl').textContent  = money(state.dif);
    host.querySelector('#s3nl').textContent  = intN(state.n);
    host.querySelector('#s3sl').textContent  = money(state.sd);
    host.querySelector('#s3al').textContent  = dec1(state.al);
    host.querySelector('#s3se').textContent  = dec2(se);
    host.querySelector('#s3z').textContent   = dec3(z);
    host.querySelector('#s3zc').textContent  = dec3(zc);
    host.querySelector('#s3xb').textContent  = money(xbar);
    host.querySelector('#s3cr').textContent  = money(crit);
    host.querySelector('#s3dec').textContent = rejects
      ? (es ? 'Se rechaza' : 'Reject')
      : (es ? 'No se rechaza' : 'Do not reject');
    var verdict = rejects
      ? (es ? 'El estadístico ' + dec3(z) + ' rebasa el valor crítico ' + dec3(zc) + ', así que la diferencia es demasiado grande para atribuirla al azar del muestreo y la afirmación de la cadena queda desmentida por la evidencia.'
            : 'The statistic ' + dec3(z) + ' clears the critical value ' + dec3(zc) + ', so the difference is too large to blame on sampling chance and the claim of the chain is contradicted by the evidence.')
      : (es ? 'El estadístico ' + dec3(z) + ' no llega al valor crítico ' + dec3(zc) + ', de modo que una diferencia así de grande es perfectamente posible aunque la afirmación de la cadena sea cierta. No se rechaza, que no es lo mismo que darla por buena.'
            : 'The statistic ' + dec3(z) + ' does not reach the critical value ' + dec3(zc) + ', so a difference this large is perfectly possible even if the claim of the chain is true. The null is not rejected, which is not the same as taking it as proven.');
    host.querySelector('#s3read').innerHTML = (es
      ? '<strong>Lectura de negocio:</strong> ' : '<strong>Business reading:</strong> ') + verdict + (es
      ? ' La diferencia de ' + money(state.dif) + ' vale ' + dec3(z) + ' errores estándar porque cada error estándar mide ' + dec2(se) + ' pesos con esta muestra. En pesos, la frontera de la decisión está en ' + money(crit) + '. Observa lo que ocurre al mover solo el tamaño de muestra: la diferencia en pesos no cambia, pero el estadístico crece, porque más información hace que la misma brecha sea más difícil de explicar por azar. Con esta variabilidad harían falta ' + intN(nNeeded) + ' tickets para que una diferencia de ' + money(state.dif) + ' quedara justo en la frontera.'
      : ' The difference of ' + money(state.dif) + ' is worth ' + dec3(z) + ' standard errors because each standard error measures ' + dec2(se) + ' pesos with this sample. In pesos, the boundary of the decision sits at ' + money(crit) + '. Watch what happens when only the sample size moves: the difference in pesos does not change, but the statistic grows, because more information makes the same gap harder to explain by chance. With this variability it would take ' + intN(nNeeded) + ' tickets for a difference of ' + money(state.dif) + ' to land exactly on the boundary.');
    var g = fitCanvas(host.querySelector('#s3cv'), 165);
    drawCurve(g, 0, 1, [{ a: -4, b: zc, kind: 1 }, { a: zc, b: 4, kind: 2 }], {
      marks: [zc], fmt: function(v) { return dec2(v); },
      obs: Math.max(-3.9, Math.min(3.9, z)),
      obsLabel: (es ? 'Estadístico ' : 'Statistic ') + dec3(z),
      muLabel: (es ? 'Mundo donde la afirmación es cierta' : 'World where the claim is true')
    });
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 4 · a small p value is not the same as a difference that matters
   ════════════════════════════════════════════════════════════════════════ */
function widgetPvalue(mu0, sd0, n0, dif0, al0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { n: n0, dif: dif0, al: al0 };
  var sd = sd0;
  function mount() {
    var es = LANG === 'es';
    host.innerHTML =
      '<div class="gcrd" data-widget="valor-p-y-relevancia-practica">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'El valor p y el tamaño de lo que está en juego' : 'The p value and the size of what is at stake') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Una plataforma de comercio electrónico probó un cambio de diseño y mide si sube el ticket promedio, que hoy vale ' + money(mu0) + '. El área dorada es el valor p: la probabilidad de ver una diferencia como la observada, o mayor, si el cambio no hubiera servido de nada. Sube el número de sesiones sin tocar la diferencia y observa lo incómodo del asunto: el valor p se desploma aunque la mejora en pesos siga siendo la misma de siempre.'
          : 'An online marketplace tested a design change and measures whether it raises the average ticket, worth ' + money(mu0) + ' today. The gold area is the p value: the probability of seeing a difference like the observed one, or larger, if the change had done nothing at all. Raise the number of sessions without touching the difference and watch the uncomfortable part: the p value collapses even though the gain in pesos stays exactly the same.') + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Mejora observada en pesos' : 'Observed gain in pesos') + ': <span class="cval" id="p4dl"></span></label>' +
          '<input type="range" min="2" max="120" step="2" id="p4d" value="' + state.dif + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Sesiones medidas' : 'Sessions measured') + ': <span class="cval" id="p4nl"></span></label>' +
          '<input type="range" min="50" max="5000" step="50" id="p4n" value="' + state.n + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Nivel de significancia en por ciento' : 'Significance level in percent') + ': <span class="cval" id="p4al"></span></label>' +
          '<input type="range" min="1" max="15" step="1" id="p4a" value="' + state.al + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Área dorada' : 'Gold area') + '</label>' +
          '<div style="font-size:.74rem;color:var(--text3)">' + (es ? 'Es el valor p, la rareza del resultado si el cambio no sirviera' : 'It is the p value, how rare the result is if the change did nothing') + '</div>' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="p4cv"></canvas>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Estadístico de prueba' : 'Test statistic') + '</div><div class="mnum ts" id="p4z"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Valor p' : 'p value') + '</div><div class="mnum ps" id="p4p"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Nivel de significancia' : 'Significance level') + '</div><div class="mnum ts" id="p4a2"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Decisión' : 'Decision') + '</div><div class="mnum cs" id="p4dec"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Mejora como parte del ticket' : 'Gain as a share of the ticket') + '</div><div class="mnum ts" id="p4rel"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Sesiones para volverlo significativo' : 'Sessions to make it significant') + '</div><div class="mnum cs" id="p4nn"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="p4read"></div>' +
      '</div>';
    host.querySelector('#p4d').addEventListener('input', function() { state.dif = parseInt(this.value, 10); update(); });
    host.querySelector('#p4n').addEventListener('input', function() { state.n   = parseInt(this.value, 10); update(); });
    host.querySelector('#p4a').addEventListener('input', function() { state.al  = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var al = state.al / 100;
    var z = zStat(mu0 + state.dif, mu0, sd, state.n);
    var p = pRight(z), zc = zOne(al);
    var rel = state.dif / mu0;
    var nNeeded = Math.ceil(Math.pow(zc * sd / state.dif, 2));
    var rejects = p <= al;
    host.querySelector('#p4dl').textContent  = money(state.dif);
    host.querySelector('#p4nl').textContent  = intN(state.n);
    host.querySelector('#p4al').textContent  = dec1(state.al);
    host.querySelector('#p4z').textContent   = dec3(z);
    host.querySelector('#p4p').textContent   = pr(p);
    host.querySelector('#p4a2').textContent  = pr(al);
    host.querySelector('#p4dec').textContent = rejects
      ? (es ? 'Se rechaza' : 'Reject')
      : (es ? 'No se rechaza' : 'Do not reject');
    host.querySelector('#p4rel').textContent = pctS(rel);
    host.querySelector('#p4nn').textContent  = intN(nNeeded);
    var decMsg = rejects
      ? (es ? 'Como el valor p ' + pr(p) + ' no supera el nivel de significancia ' + pr(al) + ', el resultado se declara estadísticamente significativo.'
            : 'Since the p value ' + pr(p) + ' does not exceed the significance level ' + pr(al) + ', the result is declared statistically significant.')
      : (es ? 'Como el valor p ' + pr(p) + ' supera el nivel de significancia ' + pr(al) + ', el resultado no alcanza para descartar que la mejora observada sea puro ruido de muestreo.'
            : 'Since the p value ' + pr(p) + ' exceeds the significance level ' + pr(al) + ', the result is not enough to rule out that the observed gain is pure sampling noise.');
    host.querySelector('#p4read').innerHTML = (es
      ? '<strong>Lectura de negocio:</strong> ' : '<strong>Business reading:</strong> ') + decMsg + (es
      ? ' Ojo con lo que ese valor p dice y con lo que no dice: mide qué tan raro sería este resultado en un mundo donde el rediseño no sirve, no la probabilidad de que el rediseño no sirva. Y la mejora observada de ' + money(state.dif) + ' representa apenas ' + pctS(rel) + ' del ticket actual, un dato que ninguna prueba de hipótesis evalúa por ti. Con ' + intN(nNeeded) + ' sesiones esa misma mejora quedaría en la frontera de lo significativo, y con más sesiones cualquier diferencia, por diminuta que sea, termina cruzándola. La pregunta que decide la inversión no es si la mejora es significativa, sino si ' + money(state.dif) + ' por sesión paga el costo del rediseño.'
      : ' Watch what that p value says and what it does not: it measures how rare this result would be in a world where the redesign does nothing, not the probability that the redesign does nothing. And the observed gain of ' + money(state.dif) + ' amounts to just ' + pctS(rel) + ' of the current ticket, a fact no hypothesis test evaluates for you. With ' + intN(nNeeded) + ' sessions that same gain would sit right on the edge of significance, and with more sessions any difference, however tiny, ends up crossing it. The question that decides the investment is not whether the gain is significant, but whether ' + money(state.dif) + ' per session pays for the cost of the redesign.');
    var g = fitCanvas(host.querySelector('#p4cv'), 165);
    var zShown = Math.max(-3.9, Math.min(3.9, z));
    drawCurve(g, 0, 1, [{ a: -4, b: zShown, kind: 1 }, { a: zShown, b: 4, kind: 2 }], {
      marks: [zc], fmt: function(v) { return dec2(v); },
      obs: zShown,
      obsLabel: (es ? 'Valor p ' : 'p value ') + pr(p),
      muLabel: (es ? 'Mundo donde el rediseño no sirve' : 'World where the redesign does nothing')
    });
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   LESSON CONTENT
   ════════════════════════════════════════════════════════════════════════ */
function mk(i18n, correctIdx, showWork) {
  return {
    i18n: i18n, correctIdx: correctIdx, showWork: showWork,
    title: i18n.title[LANG], questionText: i18n.q[LANG],
    hint: i18n.hint[LANG], explanation: i18n.exp[LANG],
    options: i18n.opts[LANG].slice()
  };
}
function frac(a, b) {
  return '<span class="mf-outer"><span class="mf-num">' + a + '</span><span class="mf-den">' + b + '</span></span>';
}

function buildLesson(rng) {
  problems = []; sectionDefs = []; widgets = [];
  document.getElementById('lessonBody').innerHTML = '';

  /* ── every number in the guide comes from the seeded rng ── */
  var c1mu0 = pick([48, 60, 72], rng);              // concept 1 example, hours promised
  var c1dif = pick([2.4, 3.2, 4.0], rng);
  var c1sd  = pick([9, 12, 15], rng);
  var c1n   = pick([36, 49, 64], rng);
  var w1al  = pick([5, 10, 1], rng);                // widget 1 start
  var p1mu0 = pick([15, 18, 20], rng);              // item 1, minutes promised
  var p1dif = pick([1.5, 2.0, 2.5], rng);
  var p1n   = pick([40, 60, 80], rng);
  var p1al  = pick([0.05, 0.01], rng);

  var c2mu0 = pick([2400, 2600, 2800], rng);        // concept 2 example, recovery per account
  var c2sd  = pick([600, 700, 800], rng);
  var c2n   = pick([64, 100, 144], rng);
  var c2al  = pick([0.05, 0.10, 0.01], rng);
  var c2ef  = pick([150, 200, 250], rng);
  var w2mu0 = pick([2400, 2600, 2800], rng);        // widget 2 start
  var w2sd  = pick([600, 800, 1000], rng);
  var w2n   = pick([36, 64, 100], rng);
  var w2ef  = pick([100, 150, 200], rng);
  var w2al  = pick([5, 10, 1], rng);
  var p2mu0 = pick([92, 94, 96], rng);              // item 2, service level in percent points
  var p2n   = pick([120, 150, 180], rng);
  var p2al  = pick([0.05, 0.01], rng);
  var p3mu0 = pick([1800, 2000, 2200], rng);        // item 3, average order value
  var p3sd  = pick([400, 500, 600], rng);
  var p3n   = pick([49, 64, 81], rng);
  var p3al  = pick([0.05, 0.01], rng);
  var p3ef  = pick([120, 160, 200], rng);

  var c3mu0 = pick([320, 360, 400], rng);           // concept 3 example, average ticket
  var c3sd  = pick([90, 120, 150], rng);
  var c3n   = pick([64, 100, 144], rng);
  var c3dif = pick([25, 35, 45], rng);
  var c3al  = pick([0.05, 0.01], rng);
  var w3mu0 = pick([300, 350, 400], rng);           // widget 3 start
  var w3sd  = pick([200, 350, 500], rng);
  var w3n   = pick([64, 120, 200], rng);
  var w3dif = pick([30, 50, 80], rng);
  var w3al  = pick([5, 10, 1], rng);
  var p4mu0 = pick([540, 600, 660], rng);           // item 4, average invoice
  var p4sd  = pick([120, 150, 180], rng);
  var p4n   = pick([36, 64, 81], rng);
  var p4dif = pick([30, 40, 50], rng);
  var p5mu0 = pick([26, 30, 34], rng);              // item 5, minutes per repair
  var p5sd  = pick([6, 8, 10], rng);
  var p5n   = pick([49, 64, 100], rng);
  var p5dif = pick([1.2, 1.8, 2.4], rng);
  var p5al  = pick([0.05, 0.01], rng);

  var c4mu0 = pick([180, 200, 220], rng);           // concept 4 example, ticket of a marketplace
  var c4sd  = pick([60, 75, 90], rng);
  var c4n   = pick([400, 900, 1600], rng);
  var c4dif = pick([4, 6, 8], rng);
  var c4al  = pick([0.05, 0.01], rng);
  var w4mu0 = pick([180, 200, 220], rng);           // widget 4 start
  var w4sd  = pick([60, 90, 120], rng);
  var w4n   = pick([200, 800, 2000], rng);
  var w4dif = pick([4, 8, 12], rng);
  var w4al  = pick([5, 10, 1], rng);
  var p6mu0 = pick([1250, 1400, 1550], rng);        // item 6, monthly spending
  var p6sd  = pick([280, 350, 420], rng);
  var p6n   = pick([100, 144, 196], rng);
  var p6dif = pick([60, 80, 100], rng);

  var p7dif = pick([35, 45, 55], rng);              // item 7, p value reading
  var p7sd  = pick([160, 200, 240], rng);
  var p7n   = pick([144, 196, 256], rng);
  var p7al  = pick([0.05, 0.01], rng);
  var p8mu0 = pick([480, 520, 560], rng);           // item 8, two sided p value
  var p8sd  = pick([90, 110, 130], rng);
  var p8n   = pick([64, 100, 121], rng);
  var p8dif = pick([20, 28, 36], rng);
  var p9mu0 = pick([3200, 3600, 4000], rng);        // item 9, power of a pilot
  var p9sd  = pick([700, 850, 1000], rng);
  var p9n   = pick([36, 49, 64], rng);
  var p9ef  = pick([200, 250, 300], rng);
  var p9al  = pick([0.05, 0.01], rng);
  var p10mu = pick([240, 260, 280], rng);           // item 10, significance against relevance
  var p10sd = pick([70, 85, 100], rng);
  var p10n  = pick([2500, 3600, 4900], rng);
  var p10d  = pick([2, 3, 4], rng);
  var p10al = pick([0.05, 0.01], rng);

  /* ═══════════════════════ CONCEPTO 1 ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    var se1 = seMean(c1sd, c1n);
    var xb1 = c1mu0 + c1dif;
    var z1  = zStat(xb1, c1mu0, c1sd, c1n);
    if (es) return '' +
      '<div class="stag">Concepto 1</div>' +
      '<h2>Una afirmación que se pone a prueba</h2>' +
      '<p>Una prueba de hipótesis no nace de la curiosidad estadística sino de una afirmación que alguien hizo y que cuesta dinero creer o desmentir. Un proveedor firma que entrega en cierto plazo. Una agencia asegura que su campaña sube la conversión. Un socio sostiene que el ticket promedio de su sucursal es más alto que el de la red. En todos esos casos hay una frase que se puede escribir como un número, hay una muestra que se puede levantar, y hay una decisión que depende de cuál de las dos versiones se sostiene.</p>' +
      '<p>El método empieza traduciendo la discusión a dos afirmaciones que no pueden ser ciertas al mismo tiempo. La <strong>hipótesis nula</strong> es la posición de arranque, la que se da por buena mientras no haya evidencia suficiente en contra: el proveedor cumple, la campaña no cambió nada, la sucursal es como las demás. La <strong>hipótesis alternativa</strong> es lo que alguien quiere demostrar y solo se adopta si los datos lo obligan. La asimetría es deliberada y viene del mundo real: cambiar de proveedor, cancelar una campaña o reasignar un presupuesto cuesta caro, así que el estado actual conserva el beneficio de la duda hasta que la evidencia lo vuelva insostenible.</p>' +
      '<p>De esa asimetría salen dos reglas prácticas. La primera es que la nula siempre contiene la igualdad, porque es la única versión que fija un número concreto con el cual se pueden calcular probabilidades. La segunda es que <strong>la alternativa recoge la sospecha</strong>, y por eso hereda su dirección: mayor que, menor que, o simplemente distinto. Si la pregunta de negocio es si el proveedor tarda más de lo prometido, la alternativa apunta a la derecha y un adelanto en las entregas, por notable que sea, nunca contará como evidencia a favor.</p>' +
      '<p>Queda un punto que conviene fijar desde ahora porque es fuente de discusiones eternas: la dirección de la prueba se decide <strong>antes</strong> de ver los datos, a partir del contrato, de la queja o de la decisión que está en juego. Elegirla después, mirando hacia dónde se inclinó la muestra, convierte el procedimiento en un adorno y le quita todo su valor como argumento frente a un tercero.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Hipótesis nula</div><div class="rform">H₀ contiene la igualdad</div><div class="rnote">Es el estado actual y arranca con el beneficio de la duda.</div></div>' +
        '<div class="rcard"><div class="rname">Hipótesis alternativa</div><div class="rform">H₁ es la sospecha</div><div class="rnote">Solo se adopta si la evidencia obliga.</div></div>' +
        '<div class="rcard"><div class="rname">Dirección</div><div class="rform">mayor · menor · distinto</div><div class="rnote">Sale de la pregunta de negocio.</div></div>' +
        '<div class="rcard"><div class="rname">Orden correcto</div><div class="rform">primero plantear, luego medir</div><div class="rnote">Nunca al revés.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Un proveedor de logística tiene firmado en contrato un tiempo de entrega promedio de ' + dec1(c1mu0) + ' horas. El área de operaciones ha recibido quejas y sospecha que en realidad tarda más. Se revisó una muestra aleatoria de ' + intN(c1n) + ' entregas del último trimestre y el tiempo promedio resultó de ' + dec1(xb1) + ' horas. Por el histórico del sector se acepta que la desviación estándar es de ' + dec1(c1sd) + ' horas.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> La afirmación que se defiende es el contrato, así que la nula dice que el tiempo promedio real es de ' + dec1(c1mu0) + ' horas o menos.<br>' +
      '<strong>Paso 2.</strong> La queja sostiene que el proveedor tarda más, de modo que la alternativa apunta hacia arriba: el tiempo promedio real es mayor que ' + dec1(c1mu0) + ' horas. La prueba es de una cola, del lado derecho.<br>' +
      '<strong>Paso 3.</strong> La muestra quedó ' + dec1(c1dif) + ' horas por arriba del compromiso, y el error estándar de un promedio de ' + intN(c1n) + ' entregas vale ' + dec2(se1) + ' horas.<br>' +
      '<strong>Paso 4.</strong> Esa diferencia equivale a ' + dec3(z1) + ' errores estándar, que es la escala en la que se decidirá si el retraso es creíble o si cabe dentro del ruido normal del muestreo.<br>' +
      '<strong>Lectura de negocio.</strong> Todavía no hay veredicto y eso es correcto: lo que se acaba de hacer es fijar las reglas del juego antes de jugarlo. Si el área de operaciones hubiera mirado primero el promedio de la muestra y después hubiera escrito la hipótesis, cualquier proveedor podría objetar el resultado con razón.</p></div>';
    return '' +
      '<div class="stag">Concept 1</div>' +
      '<h2>A claim that gets put to the test</h2>' +
      '<p>A hypothesis test is not born out of statistical curiosity but out of a claim somebody made that costs money to believe or to deny. A supplier signs a delivery deadline. An agency insists its campaign raises conversion. A partner argues the average ticket of their branch beats the rest of the network. In every one of those cases there is a sentence that can be written as a number, a sample that can be collected, and a decision that depends on which of the two versions holds.</p>' +
      '<p>The method starts by translating the argument into two claims that cannot both be true. The <strong>null hypothesis</strong> is the starting position, the one taken as good until there is enough evidence against it: the supplier complies, the campaign changed nothing, the branch is like the others. The <strong>alternative hypothesis</strong> is what somebody wants to demonstrate and it is adopted only if the data force it. The asymmetry is deliberate and it comes from the real world: switching suppliers, cancelling a campaign or reassigning a budget is expensive, so the current state keeps the benefit of the doubt until the evidence makes it untenable.</p>' +
      '<p>Two practical rules follow from that asymmetry. The first is that the null always contains the equality, because it is the only version that pins down a concrete number with which probabilities can be computed. The second is that <strong>the alternative carries the suspicion</strong>, and therefore inherits its direction: larger than, smaller than, or simply different. If the business question is whether the supplier takes longer than promised, the alternative points to the right and an early delivery, however remarkable, will never count as evidence in its favour.</p>' +
      '<p>One point is worth settling right now because it feeds endless arguments: the direction of the test is decided <strong>before</strong> seeing the data, from the contract, the complaint or the decision at stake. Choosing it afterwards, by looking at which way the sample leaned, turns the procedure into decoration and strips it of any value as an argument in front of a third party.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Null hypothesis</div><div class="rform">H₀ contains the equality</div><div class="rnote">It is the current state and starts with the benefit of the doubt.</div></div>' +
        '<div class="rcard"><div class="rname">Alternative hypothesis</div><div class="rform">H₁ is the suspicion</div><div class="rnote">Adopted only if the evidence forces it.</div></div>' +
        '<div class="rcard"><div class="rname">Direction</div><div class="rform">larger · smaller · different</div><div class="rnote">It comes from the business question.</div></div>' +
        '<div class="rcard"><div class="rname">Right order</div><div class="rform">state first, measure second</div><div class="rnote">Never the other way round.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> A logistics supplier has an average delivery time of ' + dec1(c1mu0) + ' hours written into the contract. Operations has been getting complaints and suspects it actually takes longer. A random sample of ' + intN(c1n) + ' deliveries from the last quarter was reviewed and the average time came out at ' + dec1(xb1) + ' hours. From industry history the standard deviation is taken to be ' + dec1(c1sd) + ' hours.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The claim being defended is the contract, so the null says the true average time is ' + dec1(c1mu0) + ' hours or less.<br>' +
      '<strong>Step 2.</strong> The complaint holds that the supplier takes longer, so the alternative points upward: the true average time is larger than ' + dec1(c1mu0) + ' hours. The test is one tailed, on the right side.<br>' +
      '<strong>Step 3.</strong> The sample landed ' + dec1(c1dif) + ' hours above the commitment, and the standard error of an average of ' + intN(c1n) + ' deliveries is worth ' + dec2(se1) + ' hours.<br>' +
      '<strong>Step 4.</strong> That difference amounts to ' + dec3(z1) + ' standard errors, which is the scale on which it will be decided whether the delay is credible or whether it fits inside the normal noise of sampling.<br>' +
      '<strong>Business reading.</strong> There is no verdict yet and that is as it should be: what has just been done is to set the rules of the game before playing it. Had operations looked at the sample average first and written the hypothesis afterwards, any supplier could object to the result and would be right.</p></div>';
  });

  widgetTails(w1al);

  /* ── Item 1 ── */
  var p1xb = p1mu0 + p1dif;
  var o1 = shuffleOpts(
    ['H₀ dice que el tiempo promedio real de espera es de ' + dec1(p1mu0) + ' minutos o menos, y H₁ dice que es mayor que ' + dec1(p1mu0) + ' minutos, con una prueba de una cola del lado derecho.',
     'H₀ dice que el tiempo promedio real de espera es mayor que ' + dec1(p1mu0) + ' minutos, y H₁ dice que es de ' + dec1(p1mu0) + ' minutos o menos, porque la sospecha siempre va en la nula.',
     'H₀ dice que el promedio de la muestra es de ' + dec1(p1xb) + ' minutos, y H₁ dice que el promedio de la muestra es distinto de ' + dec1(p1xb) + ' minutos.',
     'H₀ dice que el tiempo promedio real es de ' + dec1(p1mu0) + ' minutos, y H₁ dice que es distinto de ' + dec1(p1mu0) + ' minutos, con una prueba de dos colas.'],
    ['H₀ says the true average waiting time is ' + dec1(p1mu0) + ' minutes or less, and H₁ says it is larger than ' + dec1(p1mu0) + ' minutes, with a one tailed test on the right side.',
     'H₀ says the true average waiting time is larger than ' + dec1(p1mu0) + ' minutes, and H₁ says it is ' + dec1(p1mu0) + ' minutes or less, because the suspicion always goes into the null.',
     'H₀ says the average of the sample is ' + dec1(p1xb) + ' minutes, and H₁ says the average of the sample is different from ' + dec1(p1xb) + ' minutes.',
     'H₀ says the true average time is ' + dec1(p1mu0) + ' minutes, and H₁ says it is different from ' + dec1(p1mu0) + ' minutes, with a two tailed test.'], rng);
  var q1i = {
    title: { es: 'Cómo se plantea el reclamo a un centro de contacto', en: 'How to state the complaint to a contact centre' },
    q: { es: 'Un banco contrató un centro de contacto que se comprometió a un tiempo promedio de espera de ' + dec1(p1mu0) + ' minutos por llamada. El área de calidad recibió quejas de clientes y sospecha que la espera real es mayor. Se midieron ' + intN(p1n) + ' llamadas al azar y el promedio fue de ' + dec1(p1xb) + ' minutos. El análisis se hará con un nivel de significancia de ' + pct1(p1al) + ' por ciento. ¿Cómo deben plantearse las hipótesis?',
        en: 'A bank hired a contact centre that committed to an average waiting time of ' + dec1(p1mu0) + ' minutes per call. Quality assurance received customer complaints and suspects the real wait is longer. A random set of ' + intN(p1n) + ' calls was measured and the average came to ' + dec1(p1xb) + ' minutes. The analysis will run at a significance level of ' + pct1(p1al) + ' percent. How should the hypotheses be stated?' },
    opts: { es: o1.es, en: o1.en },
    hint: { es: 'La nula defiende el compromiso contratado y siempre lleva la igualdad. La alternativa recoge la sospecha del banco, y esa sospecha tiene una dirección clara. Fíjate además en que las hipótesis hablan del parámetro de la población, no del promedio que arrojó la muestra.',
            en: 'The null defends the committed level and always carries the equality. The alternative carries the suspicion of the bank, and that suspicion has a clear direction. Notice too that hypotheses speak about the parameter of the population, not about the average the sample produced.' },
    exp: { es: 'El compromiso contratado es lo que se defiende, así que la nula sostiene que la espera promedio real no pasa de ' + dec1(p1mu0) + ' minutos. La queja apunta en una sola dirección, hacia esperas más largas, de modo que la alternativa es que el promedio real supera ' + dec1(p1mu0) + ' minutos y la prueba es de una cola por la derecha. Intercambiar las hipótesis pone la sospecha en la nula y le regala el beneficio de la duda a la acusación, que es justo lo contrario del método. Plantearlas sobre el promedio de la muestra, ' + dec1(p1xb) + ' minutos, no tiene sentido porque ese número ya se conoce con certeza y no hay nada que probar sobre él. Y usar dos colas desperdicia la mitad del riesgo en un escenario que al banco no le preocupa, que sería una espera notablemente más corta que la contratada.',
           en: 'The committed level is what gets defended, so the null holds that the true average wait does not exceed ' + dec1(p1mu0) + ' minutes. The complaint points in a single direction, towards longer waits, so the alternative is that the true average clears ' + dec1(p1mu0) + ' minutes and the test is one tailed on the right. Swapping the hypotheses puts the suspicion into the null and hands the benefit of the doubt to the accusation, which is exactly the reverse of the method. Stating them about the sample average, ' + dec1(p1xb) + ' minutes, makes no sense because that number is already known with certainty and there is nothing to test about it. And using two tails wastes half the risk on a scenario the bank does not care about, namely a wait noticeably shorter than the one contracted.' }
  };
  var d1 = mk(q1i, o1.correctIdx, false);
  problems.push({ i18n: d1.i18n, title: d1.title, questionText: d1.questionText, options: d1.options, correctIdx: d1.correctIdx, explanation: d1.explanation, hint: d1.hint, showWork: false, fn: 'H₀: μ ≤ μ₀   ·   H₁: μ > μ₀', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPTO 2 ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    var se2   = seMean(c2sd, c2n);
    var crit2 = c2mu0 + zOne(c2al) * se2;
    var mu12  = c2mu0 + c2ef;
    var beta2 = betaRight(c2mu0, mu12, c2sd, c2n, c2al);
    var pw2   = 1 - beta2;
    var pw2b  = powerRight(c2mu0, mu12, c2sd, c2n * 4, c2al);
    if (es) return '' +
      '<div class="stag">Concepto 2</div>' +
      '<h2>Los dos errores que una decisión puede cometer</h2>' +
      '<p>Como la decisión se toma con una muestra y no con toda la población, equivocarse es una posibilidad permanente. Lo valioso del método no es que elimine el error, cosa imposible, sino que obliga a ponerle precio antes de decidir. Hay exactamente dos formas de fallar y conviene nombrarlas con el costo que tienen en la operación.</p>' +
      '<p>El <strong>error de tipo uno</strong> consiste en rechazar la nula cuando en realidad era cierta: una falsa alarma. Se cancela un contrato con un proveedor que sí cumplía, se despliega a toda la red una campaña que en realidad no movió nada, se sanciona a una sucursal que trabajaba bien. Su probabilidad se llama <strong>nivel de significancia</strong>, se denota alfa, y tiene una propiedad que la vuelve el eje del método: la empresa la elige. Fijar alfa en cinco por ciento es aceptar que uno de cada veinte estudios levantará una falsa alarma cuando la nula sea cierta.</p>' +
      '<p>El <strong>error de tipo dos</strong> es el contrario: no rechazar la nula cuando la alternativa era la verdadera. Aquí no hay escándalo, hay silencio. El proveedor que sí incumple sigue cobrando, la mejora que sí funcionaba se archiva, el fraude que sí ocurría pasa la auditoría. Su probabilidad se denota beta y no se elige: sale de la combinación entre el alfa fijado, el tamaño de muestra, la variabilidad y qué tan grande sea el cambio real. Su complemento tiene nombre propio, la <strong>potencia</strong> de la prueba, y responde a la pregunta que le importa a quien paga el estudio: si el cambio existe, qué probabilidad hay de que este estudio lo detecte.</p>' +
      '<p>La relación entre los dos errores es la parte incómoda. Con la misma muestra, bajar alfa mueve el punto de corte hacia afuera y vuelve más difícil rechazar, de modo que baja la falsa alarma y sube el riesgo de no ver el cambio. Subir alfa hace lo opuesto. Solo hay una manera de mejorar los dos al mismo tiempo y es aumentar la información: más muestra angosta la campana, y con una campana más angosta el mismo punto de corte deja menos margen para ambos errores. Por eso la pregunta correcta al diseñar un estudio no es qué alfa usar sino cuánta muestra hace falta para que la prueba tenga potencia suficiente frente al cambio que sí importaría en el negocio.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Error de tipo uno</div><div class="rform">rechazar una nula cierta</div><div class="rnote">Falsa alarma. Su riesgo es alfa y se elige.</div></div>' +
        '<div class="rcard"><div class="rname">Error de tipo dos</div><div class="rform">no rechazar una nula falsa</div><div class="rnote">Cambio que se pasa por alto. Su riesgo es beta.</div></div>' +
        '<div class="rcard"><div class="rname">Potencia</div><div class="rform">potencia = 1 − beta</div><div class="rnote">Probabilidad de detectar un cambio real.</div></div>' +
        '<div class="rcard"><div class="rname">Única salida</div><div class="rform">más muestra</div><div class="rnote">Baja los dos riesgos a la vez.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Una financiera recupera en promedio ' + money(c2mu0) + ' por cuenta en cobranza, con una desviación estándar de ' + money(c2sd) + '. Se probará un guion nuevo con ' + intN(c2n) + ' cuentas y se declarará exitoso si la recuperación promedio del piloto queda por arriba del punto de corte que corresponde a un nivel de significancia de ' + pct1(c2al) + ' por ciento. La dirección quiere saber qué pasaría si el guion en verdad mejorara la recuperación en ' + money(c2ef) + ' por cuenta.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El error estándar del promedio del piloto es ' + money(c2sd) + ' entre la raíz de ' + intN(c2n) + ', o sea ' + dec2(se2) + ' pesos.<br>' +
      '<strong>Paso 2.</strong> Con un nivel de significancia de ' + pct1(c2al) + ' por ciento el punto de corte queda en ' + money(crit2) + ': por arriba de esa cifra se declara exitoso el guion.<br>' +
      '<strong>Paso 3.</strong> Si el guion no sirviera, la probabilidad de superar ese corte por puro azar sería ' + pr(c2al) + ', que es exactamente el riesgo de falsa alarma que la empresa aceptó.<br>' +
      '<strong>Paso 4.</strong> Si el guion sí mejorara la recuperación en ' + money(c2ef) + ', la probabilidad de no alcanzar el corte sería ' + pr(beta2) + ', así que la potencia de la prueba es ' + pctS(pw2) + '.<br>' +
      '<strong>Lectura de negocio.</strong> Con esa potencia, el piloto tiene ' + pctS(beta2) + ' de probabilidad de archivar un guion que en realidad funcionaba. Si la dirección considera inaceptable ese riesgo, la respuesta no es bajar la exigencia sino ampliar el piloto: con ' + intN(c2n * 4) + ' cuentas la potencia subiría a ' + pctS(pw2b) + ' sin tocar el nivel de significancia.</p></div>';
    return '' +
      '<div class="stag">Concept 2</div>' +
      '<h2>The two errors a decision can make</h2>' +
      '<p>Because the decision is taken from a sample and not from the whole population, being wrong is a permanent possibility. The value of the method is not that it removes error, which is impossible, but that it forces a price to be put on it before deciding. There are exactly two ways to fail and it pays to name them by the cost they carry in the operation.</p>' +
      '<p>The <strong>type one error</strong> is rejecting the null when it was in fact true: a false alarm. A contract is cancelled with a supplier that was complying, a campaign that moved nothing is rolled out across the network, a branch that was working well gets sanctioned. Its probability is called the <strong>significance level</strong>, denoted alpha, and it has a property that makes it the axis of the method: the company chooses it. Setting alpha at five percent means accepting that one study out of twenty will raise a false alarm when the null is true.</p>' +
      '<p>The <strong>type two error</strong> is the opposite: failing to reject the null when the alternative was the true one. There is no scandal here, there is silence. The supplier that really is in breach keeps invoicing, the improvement that really worked gets shelved, the fraud that really happened passes the audit. Its probability is denoted beta and it is not chosen: it comes out of the combination of the alpha that was set, the sample size, the variability and how large the real change is. Its complement has a name of its own, the <strong>power</strong> of the test, and it answers the question that matters to whoever pays for the study: if the change exists, what is the probability that this study detects it.</p>' +
      '<p>The relationship between the two errors is the uncomfortable part. With the same sample, lowering alpha pushes the cut off point further out and makes rejection harder, so the false alarm falls and the risk of missing the change rises. Raising alpha does the opposite. There is only one way to improve both at once and that is to add information: more sample narrows the bell, and with a narrower bell the same cut off leaves less room for either error. That is why the right question when designing a study is not which alpha to use but how much sample it takes for the test to have enough power against the change that would actually matter to the business.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Type one error</div><div class="rform">reject a true null</div><div class="rnote">False alarm. Its risk is alpha and it is chosen.</div></div>' +
        '<div class="rcard"><div class="rname">Type two error</div><div class="rform">keep a false null</div><div class="rnote">A change that slips by. Its risk is beta.</div></div>' +
        '<div class="rcard"><div class="rname">Power</div><div class="rform">power = 1 − beta</div><div class="rnote">Probability of detecting a real change.</div></div>' +
        '<div class="rcard"><div class="rname">Only way out</div><div class="rform">more sample</div><div class="rnote">It lowers both risks at once.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> A lender recovers an average of ' + money(c2mu0) + ' per account in collections, with a standard deviation of ' + money(c2sd) + '. A new script will be tested on ' + intN(c2n) + ' accounts and it will be declared a success if average recovery in the pilot lands above the cut off point matching a significance level of ' + pct1(c2al) + ' percent. Management wants to know what would happen if the script genuinely improved recovery by ' + money(c2ef) + ' per account.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The standard error of the pilot average is ' + money(c2sd) + ' over the square root of ' + intN(c2n) + ', that is ' + dec2(se2) + ' pesos.<br>' +
      '<strong>Step 2.</strong> At a significance level of ' + pct1(c2al) + ' percent the cut off point sits at ' + money(crit2) + ': above that figure the script is declared a success.<br>' +
      '<strong>Step 3.</strong> If the script did nothing, the probability of clearing that cut off by pure chance would be ' + pr(c2al) + ', which is exactly the false alarm risk the company accepted.<br>' +
      '<strong>Step 4.</strong> If the script did improve recovery by ' + money(c2ef) + ', the probability of falling short of the cut off would be ' + pr(beta2) + ', so the power of the test is ' + pctS(pw2) + '.<br>' +
      '<strong>Business reading.</strong> With that power, the pilot carries a ' + pctS(beta2) + ' probability of shelving a script that really worked. If management finds that risk unacceptable, the answer is not to lower the bar but to widen the pilot: with ' + intN(c2n * 4) + ' accounts the power would climb to ' + pctS(pw2b) + ' without touching the significance level.</p></div>';
  });

  widgetErrors(w2mu0, w2sd, w2n, w2ef, w2al);

  /* ── Item 2 ── */
  var o2 = shuffleOpts(
    ['Cometió un error de tipo uno: rechazó una hipótesis nula que era cierta, y el costo es haber roto la relación con un proveedor que sí cumplía el contrato.',
     'Cometió un error de tipo dos: no rechazó una hipótesis nula que era falsa, y el costo es haber conservado a un proveedor que incumplía.',
     'No cometió ningún error, porque la muestra de ' + intN(p2n) + ' pedidos mostró un incumplimiento y la decisión siguió la evidencia disponible.',
     'Cometió un error de tipo uno, y su probabilidad de ocurrir es ' + pr(1 - p2al) + ', que es el complemento del nivel de significancia usado en el estudio.'],
    ['It made a type one error: it rejected a null hypothesis that was true, and the cost is having broken off with a supplier that was in fact complying with the contract.',
     'It made a type two error: it failed to reject a null hypothesis that was false, and the cost is having kept a supplier that was in breach.',
     'It made no error at all, because the sample of ' + intN(p2n) + ' orders showed a breach and the decision followed the available evidence.',
     'It made a type one error, and its probability of occurring is ' + pr(1 - p2al) + ', which is the complement of the significance level used in the study.'], rng);
  var q2i = {
    title: { es: 'Qué error se cometió al cancelar un contrato', en: 'Which error was made when a contract was cancelled' },
    q: { es: 'Un contrato de abasto exige un nivel de servicio promedio de ' + dec1(p2mu0) + ' puntos. La empresa planteó como nula que el proveedor cumple ese nivel y como alternativa que queda por debajo. Con una muestra de ' + intN(p2n) + ' pedidos y un nivel de significancia de ' + pct1(p2al) + ' por ciento se rechazó la nula y se canceló el contrato. Un año después, el sistema del proveedor permitió revisar la totalidad de los pedidos de aquel periodo y el nivel de servicio real resultó ser exactamente el comprometido. ¿Qué ocurrió?',
        en: 'A supply contract requires an average service level of ' + dec1(p2mu0) + ' points. The company stated as the null that the supplier meets that level and as the alternative that it falls below. With a sample of ' + intN(p2n) + ' orders and a significance level of ' + pct1(p2al) + ' percent the null was rejected and the contract was cancelled. A year later the system of the supplier allowed a review of every order from that period and the real service level turned out to be exactly the one committed. What happened?' },
    opts: { es: o2.es, en: o2.en },
    hint: { es: 'Ubica dos cosas por separado: qué decidió la empresa con la muestra y cuál era la verdad que después se conoció. El nombre del error depende de la combinación de esas dos cosas, no de si la decisión parecía razonable en su momento.',
            en: 'Pin down two things separately: what the company decided from the sample and what the truth turned out to be afterwards. The name of the error depends on the combination of those two, not on whether the decision looked reasonable at the time.' },
    exp: { es: 'La empresa rechazó la nula y la nula era cierta, que es la definición exacta del error de tipo uno. Su probabilidad es el nivel de significancia que se fijó, ' + pr(p2al) + ', no su complemento ' + pr(1 - p2al) + ', que es la probabilidad de no cometerlo cuando la nula es cierta. El error de tipo dos habría sido el escenario opuesto: conservar a un proveedor que en realidad incumplía. Y decir que no hubo error confunde una decisión razonable con una decisión acertada: el procedimiento se siguió bien y aun así el resultado fue equivocado, que es precisamente el riesgo que la empresa aceptó al elegir ' + pct1(p2al) + ' por ciento. La lección de negocio es que el nivel de significancia debe fijarse mirando lo que cuesta cancelar un contrato en falso, no por costumbre.',
           en: 'The company rejected the null and the null was true, which is the exact definition of a type one error. Its probability is the significance level that was set, ' + pr(p2al) + ', not its complement ' + pr(1 - p2al) + ', which is the probability of avoiding it when the null is true. A type two error would have been the opposite scenario: keeping a supplier that really was in breach. And saying there was no error confuses a reasonable decision with a correct one: the procedure was followed properly and the outcome was still wrong, which is precisely the risk the company accepted when it chose ' + pct1(p2al) + ' percent. The business lesson is that the significance level should be set by looking at what it costs to cancel a contract in error, not out of habit.' }
  };
  var d2 = mk(q2i, o2.correctIdx, true);
  problems.push({ i18n: d2.i18n, title: d2.title, questionText: d2.questionText, options: d2.options, correctIdx: d2.correctIdx, explanation: d2.explanation, hint: d2.hint, showWork: true, fn: 'P(error de tipo uno) = α', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 3 ── */
  var se3   = seMean(p3sd, p3n);
  var mu13  = p3mu0 + p3ef;
  var crit3 = p3mu0 + zOne(p3al) * se3;
  var beta3 = betaRight(p3mu0, mu13, p3sd, p3n, p3al);
  var o3 = valOpts(beta3, [1 - beta3, p3al, nCdf((crit3 - mu13) / p3sd)], pr, rng);
  var q3i = {
    title: { es: 'Riesgo de archivar una mejora que sí existe', en: 'Risk of shelving an improvement that is real' },
    q: { es: 'Una tienda en línea vende hoy ' + money(p3mu0) + ' en promedio por pedido, con una desviación estándar de ' + money(p3sd) + '. Va a probar un nuevo motor de recomendaciones con ' + intN(p3n) + ' pedidos y declarará exitoso el cambio solo si el promedio del piloto supera el punto de corte que corresponde a un nivel de significancia de ' + pct1(p3al) + ' por ciento, en una prueba de una cola por la derecha. Si el motor en verdad aumentara el pedido promedio en ' + money(p3ef) + ', ¿cuál es la probabilidad de que la prueba no lo detecte?',
        en: 'An online store sells ' + money(p3mu0) + ' on average per order today, with a standard deviation of ' + money(p3sd) + '. It will test a new recommendation engine on ' + intN(p3n) + ' orders and will declare the change a success only if the pilot average clears the cut off point matching a significance level of ' + pct1(p3al) + ' percent, in a one tailed test on the right. If the engine genuinely raised the average order by ' + money(p3ef) + ', what is the probability that the test fails to detect it?' },
    opts: { es: o3.es, en: o3.en },
    hint: { es: 'Localiza primero el punto de corte en pesos, que sale del mundo donde la nula es cierta. Después colócate en el mundo donde la mejora existe y pregúntate qué parte de esa segunda campana queda por debajo del corte.',
            en: 'Locate the cut off point in pesos first, which comes from the world where the null is true. Then move to the world where the improvement exists and ask what share of that second bell falls below the cut off.' },
    exp: { es: 'El error estándar es ' + dec2(se3) + ' pesos, así que el punto de corte queda en ' + money(crit3) + '. Si la mejora real fuera de ' + money(p3ef) + ', el pedido promedio verdadero sería ' + money(mu13) + ' y la probabilidad de que el piloto quede por debajo del corte, es decir de no detectar la mejora, es ' + pr(beta3) + '. Su complemento, ' + pr(1 - beta3) + ', es la potencia de la prueba y responde a la pregunta contraria. El nivel de significancia ' + pr(p3al) + ' es el otro error, el de declarar exitoso un motor que no sirve, y no depende de la mejora real. Usar la desviación de un pedido suelto en lugar del error estándar del promedio da ' + pr(nCdf((crit3 - mu13) / p3sd)) + ' y describe a un cliente individual, no al resultado del piloto.',
           en: 'The standard error is ' + dec2(se3) + ' pesos, so the cut off point sits at ' + money(crit3) + '. If the real improvement were ' + money(p3ef) + ', the true average order would be ' + money(mu13) + ' and the probability that the pilot lands below the cut off, meaning the improvement goes undetected, is ' + pr(beta3) + '. Its complement, ' + pr(1 - beta3) + ', is the power of the test and answers the opposite question. The significance level ' + pr(p3al) + ' is the other error, declaring a useless engine successful, and it does not depend on the real improvement. Using the deviation of a single order instead of the standard error of the average gives ' + pr(nCdf((crit3 - mu13) / p3sd)) + ' and describes an individual customer, not the outcome of the pilot.' }
  };
  var d3 = mk(q3i, o3.correctIdx, true);
  problems.push({ i18n: d3.i18n, title: d3.title, questionText: d3.questionText, options: d3.options, correctIdx: d3.correctIdx, explanation: d3.explanation, hint: d3.hint, showWork: true, fn: 'β = P( x̄ < punto de corte | μ = μ₁ )', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPTO 3 ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    var xb3   = c3mu0 + c3dif;
    var se3c  = seMean(c3sd, c3n);
    var z3    = zStat(xb3, c3mu0, c3sd, c3n);
    var zc3   = zOne(c3al);
    var crit3c = c3mu0 + zc3 * se3c;
    var rej3  = z3 > zc3;
    if (es) return '' +
      '<div class="stag">Concepto 3</div>' +
      '<h2>El estadístico de prueba y la zona de rechazo</h2>' +
      '<p>Ya están planteadas las hipótesis y ya está fijado el riesgo que la empresa acepta. Falta la maquinaria que convierte una muestra en un veredicto, y consta de dos piezas. La primera es el <strong>estadístico de prueba</strong>, que traduce la diferencia observada a una escala universal. La segunda es la <strong>zona de rechazo</strong>, que marca a partir de qué punto esa diferencia deja de ser creíble bajo la nula.</p>' +
      '<p>La traducción es sencilla y hace todo el trabajo pesado. Una diferencia en pesos, en horas o en piezas no dice por sí sola si es grande: cuarenta pesos son una enormidad en un ticket de café y una nimiedad en la venta de maquinaria. Lo que la vuelve interpretable es dividirla entre el error estándar del promedio, con lo cual queda expresada en <strong>cuántos errores estándar se alejó la muestra</strong> del valor que la nula afirma. Ese cociente es el estadístico, y cuando la desviación de la población se conoce sigue la campana normal estándar, de modo que sus probabilidades ya son conocidas.</p>' +
      '<p>La zona de rechazo se construye antes de mirar el estadístico. Se toma el nivel de significancia, se coloca en la cola o en las colas que marca la alternativa, y el punto donde empieza esa área se llama <strong>valor crítico</strong>. Si el estadístico cae en la zona de rechazo, la muestra es tan poco compatible con la nula que se abandona; si cae fuera, la nula sobrevive. Y como la escala es reversible, el valor crítico también se puede traducir de vuelta a pesos u horas, que es la forma en que conviene presentarlo en una junta: no digas que el estadístico rebasó uno punto seis cuatro cinco, di que el retraso superó la frontera de las horas que el contrato tolera.</p>' +
      '<p>Queda la parte que más se maltrata en los reportes: <strong>cómo se enuncia la conclusión</strong>. Cuando el estadístico cae en la zona de rechazo se dice que se rechaza la nula y que la evidencia respalda la alternativa. Cuando no cae, se dice que no se rechaza la nula, jamás que se acepta ni que quedó demostrada. La diferencia no es un tecnicismo. No rechazar significa que los datos son compatibles con la nula, y también son compatibles con muchas alternativas cercanas que esta muestra no tenía potencia para distinguir. Un estudio que no rechaza no absuelve al proveedor: solo dice que con esta muestra no se le pudo probar nada.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Estadístico</div><div class="rform">z = ' + frac('x̄ − μ₀', 'σ/√n') + '</div><div class="rnote">La distancia medida en errores estándar.</div></div>' +
        '<div class="rcard"><div class="rname">Valor crítico</div><div class="rform">frontera de la zona</div><div class="rnote">Sale de alfa y de la dirección.</div></div>' +
        '<div class="rcard"><div class="rname">Regla</div><div class="rform">cae dentro, se rechaza</div><div class="rnote">Cae fuera, la nula sobrevive.</div></div>' +
        '<div class="rcard"><div class="rname">Redacción</div><div class="rform">no rechazar no es aceptar</div><div class="rnote">Falta de prueba no es prueba de ausencia.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Una cadena de cafeterías afirma que su ticket promedio es de ' + money(c3mu0) + '. Un inversionista sospecha que en realidad es mayor y revisa una muestra aleatoria de ' + intN(c3n) + ' cuentas, que arroja un promedio de ' + money(xb3) + '. La desviación estándar del gasto en la población es ' + money(c3sd) + ' y la prueba se hará con un nivel de significancia de ' + pct1(c3al) + ' por ciento.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> La nula sostiene que el ticket promedio real no pasa de ' + money(c3mu0) + ' y la alternativa que lo supera, así que la prueba es de una cola por la derecha.<br>' +
      '<strong>Paso 2.</strong> El error estándar es ' + money(c3sd) + ' entre la raíz de ' + intN(c3n) + ', o sea ' + dec2(se3c) + ' pesos.<br>' +
      '<strong>Paso 3.</strong> El estadístico vale la diferencia de ' + money(c3dif) + ' entre ese error estándar, es decir ' + dec3(z3) + ' errores estándar.<br>' +
      '<strong>Paso 4.</strong> El valor crítico al ' + pct1(c3al) + ' por ciento es ' + dec3(zc3) + ', que traducido a pesos coloca la frontera en ' + money(crit3c) + '.<br>' +
      '<strong>Paso 5.</strong> ' + (rej3
        ? 'El estadístico ' + dec3(z3) + ' cae en la zona de rechazo, así que se rechaza la nula: la evidencia respalda que el ticket promedio real supera lo que la cadena afirma.'
        : 'El estadístico ' + dec3(z3) + ' queda fuera de la zona de rechazo, así que no se rechaza la nula: con esta muestra no se puede sostener que el ticket real sea mayor.') + '<br>' +
      '<strong>Lectura de negocio.</strong> Presentar la frontera en pesos, ' + money(crit3c) + ', vuelve la conclusión discutible por gente que no hace estadística, y esa es justo la conversación que hay que poder sostener con la dirección.</p></div>';
    return '' +
      '<div class="stag">Concept 3</div>' +
      '<h2>The test statistic and the rejection zone</h2>' +
      '<p>The hypotheses are stated and the risk the company accepts is set. What is missing is the machinery that turns a sample into a verdict, and it has two pieces. The first is the <strong>test statistic</strong>, which translates the observed difference into a universal scale. The second is the <strong>rejection zone</strong>, which marks the point from which that difference stops being credible under the null.</p>' +
      '<p>The translation is simple and does all the heavy lifting. A difference in pesos, hours or units does not say on its own whether it is large: forty pesos is enormous on a coffee ticket and trivial on a machinery sale. What makes it interpretable is dividing it by the standard error of the average, which leaves it expressed as <strong>how many standard errors the sample moved away</strong> from the value the null claims. That ratio is the statistic, and when the deviation of the population is known it follows the standard normal bell, so its probabilities are already known.</p>' +
      '<p>The rejection zone is built before looking at the statistic. Take the significance level, place it in the tail or tails the alternative points to, and the point where that area begins is called the <strong>critical value</strong>. If the statistic lands in the rejection zone, the sample is so incompatible with the null that the null is dropped; if it lands outside, the null survives. And since the scale is reversible, the critical value can also be translated back into pesos or hours, which is how it should be presented in a meeting: do not say the statistic cleared one point six four five, say the delay crossed the boundary of hours the contract tolerates.</p>' +
      '<p>That leaves the part most abused in reports: <strong>how the conclusion is worded</strong>. When the statistic lands in the rejection zone you say the null is rejected and the evidence supports the alternative. When it does not, you say the null is not rejected, never that it is accepted or that it has been proven. The difference is not a technicality. Not rejecting means the data are compatible with the null, and they are also compatible with many nearby alternatives this sample had no power to tell apart. A study that does not reject does not clear the supplier: it only says nothing could be proven against it with this sample.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Statistic</div><div class="rform">z = ' + frac('x̄ − μ₀', 'σ/√n') + '</div><div class="rnote">The distance measured in standard errors.</div></div>' +
        '<div class="rcard"><div class="rname">Critical value</div><div class="rform">boundary of the zone</div><div class="rnote">It comes from alpha and the direction.</div></div>' +
        '<div class="rcard"><div class="rname">Rule</div><div class="rform">inside means reject</div><div class="rnote">Outside and the null survives.</div></div>' +
        '<div class="rcard"><div class="rname">Wording</div><div class="rform">not rejecting is not accepting</div><div class="rnote">Lack of proof is not proof of absence.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> A coffee shop chain claims its average ticket is ' + money(c3mu0) + '. An investor suspects it is in fact larger and reviews a random sample of ' + intN(c3n) + ' bills, which yields an average of ' + money(xb3) + '. The standard deviation of spending in the population is ' + money(c3sd) + ' and the test will run at a significance level of ' + pct1(c3al) + ' percent.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The null holds that the true average ticket does not exceed ' + money(c3mu0) + ' and the alternative that it clears it, so the test is one tailed on the right.<br>' +
      '<strong>Step 2.</strong> The standard error is ' + money(c3sd) + ' over the square root of ' + intN(c3n) + ', that is ' + dec2(se3c) + ' pesos.<br>' +
      '<strong>Step 3.</strong> The statistic is the difference of ' + money(c3dif) + ' over that standard error, meaning ' + dec3(z3) + ' standard errors.<br>' +
      '<strong>Step 4.</strong> The critical value at ' + pct1(c3al) + ' percent is ' + dec3(zc3) + ', which translated into pesos puts the boundary at ' + money(crit3c) + '.<br>' +
      '<strong>Step 5.</strong> ' + (rej3
        ? 'The statistic ' + dec3(z3) + ' lands in the rejection zone, so the null is rejected: the evidence supports a true average ticket above what the chain claims.'
        : 'The statistic ' + dec3(z3) + ' stays outside the rejection zone, so the null is not rejected: with this sample it cannot be held that the true ticket is larger.') + '<br>' +
      '<strong>Business reading.</strong> Presenting the boundary in pesos, ' + money(crit3c) + ', makes the conclusion arguable by people who do no statistics, and that is exactly the conversation you need to be able to hold with management.</p></div>';
  });

  widgetStat(w3mu0, w3sd, w3n, w3dif, w3al);

  /* ── Item 4 ── */
  var xb4  = p4mu0 + p4dif;
  var se4  = seMean(p4sd, p4n);
  var z4   = zStat(xb4, p4mu0, p4sd, p4n);
  var o4 = valOpts(z4, [p4dif / p4sd, p4dif / (p4sd / p4n), -z4], dec3, rng);
  var q4i = {
    title: { es: 'Convertir una diferencia en pesos a un estadístico', en: 'Turning a difference in pesos into a statistic' },
    q: { es: 'Una constructora tiene registrado que sus proveedores facturan en promedio ' + money(p4mu0) + ' por orden de compra, con una desviación estándar de ' + money(p4sd) + '. El área de auditoría sospecha que un proveedor en particular está facturando por arriba de ese promedio y revisó ' + intN(p4n) + ' de sus órdenes, que arrojaron un promedio de ' + money(xb4) + '. ¿Cuánto vale el estadístico de prueba?',
        en: 'A construction company has on record that its suppliers invoice an average of ' + money(p4mu0) + ' per purchase order, with a standard deviation of ' + money(p4sd) + '. The audit team suspects one particular supplier is invoicing above that average and reviewed ' + intN(p4n) + ' of its orders, which produced an average of ' + money(xb4) + '. How much is the test statistic worth?' },
    opts: { es: o4.es, en: o4.en },
    hint: { es: 'El estadístico mide cuántos errores estándar separan al promedio observado del valor que afirma la nula. Revisa que en el denominador esté el error estándar del promedio y no la desviación de una orden suelta.',
            en: 'The statistic measures how many standard errors separate the observed average from the value the null claims. Check that the denominator holds the standard error of the average and not the deviation of a single order.' },
    exp: { es: 'La diferencia observada es ' + money(p4dif) + ' y el error estándar vale ' + money(p4sd) + ' entre la raíz de ' + intN(p4n) + ', o sea ' + dec2(se4) + ' pesos. El cociente da ' + dec3(z4) + ' errores estándar. Dividir entre la desviación de la población sin la raíz de la muestra da ' + dec3(p4dif / p4sd) + ' y mide la diferencia en unidades de una orden individual, no del promedio. Dividir entre la desviación sobre el tamaño de muestra completo da ' + dec3(p4dif / (p4sd / p4n)) + ' y exagera muchísimo la evidencia. Invertir el orden de la resta da ' + dec3(-z4) + ' y manda al estadístico a la cola equivocada, con lo cual una sospecha de sobrefacturación se leería como si el proveedor cobrara de menos.',
           en: 'The observed difference is ' + money(p4dif) + ' and the standard error is ' + money(p4sd) + ' over the square root of ' + intN(p4n) + ', that is ' + dec2(se4) + ' pesos. The ratio gives ' + dec3(z4) + ' standard errors. Dividing by the deviation of the population without the square root of the sample gives ' + dec3(p4dif / p4sd) + ' and measures the difference in units of a single order, not of the average. Dividing by the deviation over the full sample size gives ' + dec3(p4dif / (p4sd / p4n)) + ' and wildly exaggerates the evidence. Reversing the order of the subtraction gives ' + dec3(-z4) + ' and sends the statistic to the wrong tail, so a suspicion of overbilling would read as if the supplier were undercharging.' }
  };
  var d4 = mk(q4i, o4.correctIdx, true);
  problems.push({ i18n: d4.i18n, title: d4.title, questionText: d4.questionText, options: d4.options, correctIdx: d4.correctIdx, explanation: d4.explanation, hint: d4.hint, showWork: true, fn: 'z = ' + frac('x̄ − μ₀', 'σ/√n'), studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 5 ── */
  var xb5   = p5mu0 + p5dif;
  var se5   = seMean(p5sd, p5n);
  var z5    = zStat(xb5, p5mu0, p5sd, p5n);
  var zc5   = zOne(p5al);
  var crit5 = p5mu0 + zc5 * se5;
  var rej5  = z5 > zc5;
  var corr5 = rej5
    ? { es: 'El estadístico vale ' + dec3(z5) + ' y rebasa el valor crítico ' + dec3(zc5) + ', así que se rechaza la nula y la evidencia respalda que el tiempo promedio real de reparación supera lo comprometido.',
        en: 'The statistic is ' + dec3(z5) + ' and clears the critical value ' + dec3(zc5) + ', so the null is rejected and the evidence supports a true average repair time above the committed one.' }
    : { es: 'El estadístico vale ' + dec3(z5) + ' y no alcanza el valor crítico ' + dec3(zc5) + ', así que no se rechaza la nula y con esta muestra no se puede sostener que el tiempo promedio real supere lo comprometido.',
        en: 'The statistic is ' + dec3(z5) + ' and does not reach the critical value ' + dec3(zc5) + ', so the null is not rejected and with this sample it cannot be held that the true average time exceeds the committed one.' };
  var o5 = shuffleOpts(
    [corr5.es,
     'Como el promedio observado de ' + dec1(xb5) + ' minutos es mayor que los ' + dec1(p5mu0) + ' minutos comprometidos, la nula se rechaza sin necesidad de calcular ningún estadístico.',
     'El estadístico vale ' + dec3(z5) + ', y como no cae en la zona de rechazo queda demostrado que el taller cumple el tiempo comprometido de ' + dec1(p5mu0) + ' minutos.',
     'El estadístico vale ' + dec3(z5 * Math.sqrt(p5n)) + ', porque la diferencia se divide entre la desviación y después se multiplica por el tamaño de muestra completo.'],
    [corr5.en,
     'Since the observed average of ' + dec1(xb5) + ' minutes is larger than the ' + dec1(p5mu0) + ' committed minutes, the null is rejected with no need to compute any statistic.',
     'The statistic is ' + dec3(z5) + ', and since it does not land in the rejection zone it is proven that the workshop meets the committed time of ' + dec1(p5mu0) + ' minutes.',
     'The statistic is ' + dec3(z5 * Math.sqrt(p5n)) + ', because the difference is divided by the deviation and then multiplied by the full sample size.'], rng);
  var q5i = {
    title: { es: 'Veredicto sobre el tiempo de reparación de un taller', en: 'Verdict on the repair time of a workshop' },
    q: { es: 'Una aseguradora tiene convenido con un taller un tiempo promedio de reparación de ' + dec1(p5mu0) + ' minutos por unidad. Sospecha que el taller se está tardando más y midió ' + intN(p5n) + ' reparaciones al azar, con un promedio de ' + dec1(xb5) + ' minutos. La desviación estándar de la población es ' + dec1(p5sd) + ' minutos y la prueba se hace con un nivel de significancia de ' + pct1(p5al) + ' por ciento. ¿Cuál es la conclusión correcta y cómo debe enunciarse?',
        en: 'An insurer has agreed with a workshop an average repair time of ' + dec1(p5mu0) + ' minutes per unit. It suspects the workshop is taking longer and measured ' + intN(p5n) + ' random repairs, with an average of ' + dec1(xb5) + ' minutes. The standard deviation of the population is ' + dec1(p5sd) + ' minutes and the test runs at a significance level of ' + pct1(p5al) + ' percent. What is the correct conclusion and how should it be worded?' },
    opts: { es: o5.es, en: o5.en },
    hint: { es: 'Calcula el estadístico y compáralo contra el valor crítico de una cola. Cuida además la redacción: hay una opción cuyo número es correcto pero cuya conclusión afirma más de lo que una prueba puede afirmar.',
            en: 'Compute the statistic and compare it with the one tailed critical value. Watch the wording too: one option gets the number right but states a conclusion stronger than any test can support.' },
    exp: { es: 'El error estándar es ' + dec2(se5) + ' minutos, así que el estadístico vale ' + dec3(z5) + ' y el valor crítico al ' + pct1(p5al) + ' por ciento es ' + dec3(zc5) + ', que en minutos coloca la frontera en ' + dec2(crit5) + '. ' + (rej5
        ? 'El estadístico cae en la zona de rechazo, de modo que la aseguradora sí tiene evidencia para reclamar el incumplimiento. '
        : 'El estadístico queda fuera de la zona de rechazo, de modo que la aseguradora no tiene evidencia suficiente para reclamar el incumplimiento. ') + 'Comparar a ojo el promedio observado contra el comprometido ignora que otra muestra habría dado otro promedio, que es justo el problema que la prueba resuelve. Y la opción que habla de quedar demostrado el cumplimiento es la trampa clásica: no rechazar la nula nunca la demuestra, solo indica que la muestra no alcanzó para desmentirla.',
           en: 'The standard error is ' + dec2(se5) + ' minutes, so the statistic is ' + dec3(z5) + ' and the critical value at ' + pct1(p5al) + ' percent is ' + dec3(zc5) + ', which in minutes puts the boundary at ' + dec2(crit5) + '. ' + (rej5
        ? 'The statistic lands in the rejection zone, so the insurer does have evidence to claim a breach. '
        : 'The statistic stays outside the rejection zone, so the insurer does not have enough evidence to claim a breach. ') + 'Eyeballing the observed average against the committed one ignores that another sample would have given another average, which is exactly the problem the test solves. And the option claiming compliance is proven is the classic trap: failing to reject the null never proves it, it only says the sample fell short of disproving it.' }
  };
  var d5 = mk(q5i, o5.correctIdx, true);
  problems.push({ i18n: d5.i18n, title: d5.title, questionText: d5.questionText, options: d5.options, correctIdx: d5.correctIdx, explanation: d5.explanation, hint: d5.hint, showWork: true, fn: 'z > z crítico  →  se rechaza H₀', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPTO 4 ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    var xb4c = c4mu0 + c4dif;
    var se4c = seMean(c4sd, c4n);
    var z4c  = zStat(xb4c, c4mu0, c4sd, c4n);
    var p4c  = pRight(z4c);
    var rej4 = p4c <= c4al;
    var rel4 = c4dif / c4mu0;
    var nSmall = Math.ceil(Math.pow(zOne(c4al) * c4sd / c4dif, 2));
    if (es) return '' +
      '<div class="stag">Concepto 4</div>' +
      '<h2>El valor p y lo que una prueba no puede decidir</h2>' +
      '<p>El método del valor crítico entrega un veredicto pero esconde una información útil: qué tan cerca o qué tan lejos quedó la muestra de la frontera. Un estadístico que apenas la rozó y otro que la rebasó por mucho llevan a la misma frase, y sin embargo no valen lo mismo para quien decide. El <strong>valor p</strong> recupera esa información.</p>' +
      '<p>Su definición hay que leerla despacio porque cada palabra carga peso. El valor p es la probabilidad de obtener un resultado como el observado, o todavía más extremo en la dirección de la alternativa, <strong>suponiendo que la nula fuera cierta</strong>. Es decir, mide la rareza de la evidencia en el mundo donde no pasa nada. La regla de decisión es de una sola línea: si el valor p no supera el nivel de significancia, se rechaza la nula; si lo supera, la nula sobrevive. Y esa regla da exactamente el mismo veredicto que comparar el estadístico contra el valor crítico, porque son la misma comparación vista desde dos ángulos.</p>' +
      '<p>Lo que hace valioso al valor p es que reporta una <strong>gradación</strong> en lugar de un sí o un no, y por eso conviene publicarlo en lugar de esconderlo detrás de la palabra significativo. Pero es también la cifra peor interpretada de toda la estadística aplicada. No es la probabilidad de que la nula sea cierta. No es la probabilidad de haberse equivocado. No es la probabilidad de que el resultado se repita. Todas esas lecturas invierten el condicional: el valor p supone que la nula es cierta y calcula qué tan rara sería la evidencia; no toma la evidencia y calcula qué tan probable es la nula.</p>' +
      '<p>Y queda la advertencia que más dinero ahorra en la práctica. La <strong>significancia estadística no es relevancia práctica</strong>. El estadístico crece con la raíz del tamaño de muestra, así que con suficientes datos cualquier diferencia distinta de cero, por microscópica que sea, termina saliendo significativa. Una plataforma con millones de sesiones puede demostrar con enorme solidez que un rediseño sube el ticket promedio en unos cuantos centavos, y esa demostración impecable no responde la única pregunta que importa: si esos centavos pagan el costo del rediseño. La prueba dice si la diferencia es real; el tamaño de la diferencia y su valor para el negocio los tiene que juzgar quien decide.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Valor p</div><div class="rform">rareza bajo la nula</div><div class="rnote">Probabilidad de esta evidencia o peor si nada pasa.</div></div>' +
        '<div class="rcard"><div class="rname">Regla</div><div class="rform">p ≤ α  →  se rechaza</div><div class="rnote">Mismo veredicto que el valor crítico.</div></div>' +
        '<div class="rcard"><div class="rname">Lo que no es</div><div class="rform">no es P(H₀ cierta)</div><div class="rnote">El condicional va al revés.</div></div>' +
        '<div class="rcard"><div class="rname">Advertencia</div><div class="rform">significativo ≠ relevante</div><div class="rnote">Con mucha muestra todo se vuelve significativo.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Un mercado en línea tiene un ticket promedio de ' + money(c4mu0) + ' con una desviación estándar de ' + money(c4sd) + '. Probó un rediseño del carrito en ' + intN(c4n) + ' sesiones y el ticket promedio subió a ' + money(xb4c) + '. La prueba es de una cola por la derecha con un nivel de significancia de ' + pct1(c4al) + ' por ciento.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El error estándar es ' + dec2(se4c) + ' pesos y el estadístico vale ' + dec3(z4c) + '.<br>' +
      '<strong>Paso 2.</strong> El valor p es la probabilidad de ver una mejora igual o mayor si el rediseño no sirviera, y vale ' + pr(p4c) + '.<br>' +
      '<strong>Paso 3.</strong> Como ' + pr(p4c) + (rej4 ? ' no supera ' : ' supera ') + pr(c4al) + ', ' + (rej4 ? 'se rechaza la nula y el resultado se declara estadísticamente significativo.' : 'no se rechaza la nula y el resultado no alcanza la significancia pedida.') + '<br>' +
      '<strong>Paso 4.</strong> La mejora observada de ' + money(c4dif) + ' representa ' + pctS(rel4) + ' del ticket actual.<br>' +
      '<strong>Lectura de negocio.</strong> Aquí conviene separar dos preguntas que se confunden todo el tiempo. La estadística ya respondió si la diferencia es distinguible del ruido. Lo que falta es la decisión: si ' + money(c4dif) + ' por sesión, multiplicados por el volumen del mercado, superan el costo de mantener el rediseño. Nota además que bastaban ' + intN(nSmall) + ' sesiones para que una mejora de ese tamaño llegara a la frontera de lo significativo, y que con muchas más sesiones incluso una mejora de un peso la cruzaría.</p></div>';
    return '' +
      '<div class="stag">Concept 4</div>' +
      '<h2>The p value and what a test cannot decide</h2>' +
      '<p>The critical value method delivers a verdict but hides a useful piece of information: how close or how far the sample landed from the boundary. A statistic that barely grazed it and one that cleared it by a mile lead to the same sentence, and yet they are not worth the same to whoever decides. The <strong>p value</strong> recovers that information.</p>' +
      '<p>Its definition has to be read slowly because every word carries weight. The p value is the probability of obtaining a result like the observed one, or even more extreme in the direction of the alternative, <strong>assuming the null were true</strong>. That is, it measures how rare the evidence is in the world where nothing is happening. The decision rule is one line long: if the p value does not exceed the significance level, the null is rejected; if it does, the null survives. And that rule gives exactly the same verdict as comparing the statistic against the critical value, because they are the same comparison seen from two angles.</p>' +
      '<p>What makes the p value valuable is that it reports a <strong>gradation</strong> instead of a yes or a no, and that is why it should be published rather than hidden behind the word significant. But it is also the most misread figure in all of applied statistics. It is not the probability that the null is true. It is not the probability of having made a mistake. It is not the probability that the result will repeat. All those readings flip the conditional: the p value assumes the null is true and computes how rare the evidence would be; it does not take the evidence and compute how likely the null is.</p>' +
      '<p>And there remains the warning that saves the most money in practice. <strong>Statistical significance is not practical relevance</strong>. The statistic grows with the square root of the sample size, so with enough data any difference other than zero, however microscopic, ends up coming out significant. A platform with millions of sessions can demonstrate with enormous solidity that a redesign raises the average ticket by a few cents, and that impeccable demonstration does not answer the only question that matters: whether those cents pay for the cost of the redesign. The test says whether the difference is real; the size of the difference and its worth to the business have to be judged by whoever decides.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">p value</div><div class="rform">rarity under the null</div><div class="rnote">Probability of this evidence or worse if nothing happens.</div></div>' +
        '<div class="rcard"><div class="rname">Rule</div><div class="rform">p ≤ α  →  reject</div><div class="rnote">Same verdict as the critical value.</div></div>' +
        '<div class="rcard"><div class="rname">What it is not</div><div class="rform">not P(H₀ true)</div><div class="rnote">The conditional runs the other way.</div></div>' +
        '<div class="rcard"><div class="rname">Warning</div><div class="rform">significant ≠ relevant</div><div class="rnote">With enough sample everything turns significant.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> An online marketplace has an average ticket of ' + money(c4mu0) + ' with a standard deviation of ' + money(c4sd) + '. It tested a cart redesign on ' + intN(c4n) + ' sessions and the average ticket rose to ' + money(xb4c) + '. The test is one tailed on the right at a significance level of ' + pct1(c4al) + ' percent.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The standard error is ' + dec2(se4c) + ' pesos and the statistic is ' + dec3(z4c) + '.<br>' +
      '<strong>Step 2.</strong> The p value is the probability of seeing a gain equal or larger if the redesign did nothing, and it is worth ' + pr(p4c) + '.<br>' +
      '<strong>Step 3.</strong> Since ' + pr(p4c) + (rej4 ? ' does not exceed ' : ' exceeds ') + pr(c4al) + ', ' + (rej4 ? 'the null is rejected and the result is declared statistically significant.' : 'the null is not rejected and the result falls short of the requested significance.') + '<br>' +
      '<strong>Step 4.</strong> The observed gain of ' + money(c4dif) + ' amounts to ' + pctS(rel4) + ' of the current ticket.<br>' +
      '<strong>Business reading.</strong> Two questions that get mixed up all the time should be kept apart here. Statistics has already answered whether the difference is distinguishable from noise. What remains is the decision: whether ' + money(c4dif) + ' per session, multiplied by the volume of the marketplace, beats the cost of maintaining the redesign. Note as well that ' + intN(nSmall) + ' sessions were enough for a gain of that size to reach the edge of significance, and that with many more sessions even a one peso gain would cross it.</p></div>';
  });

  widgetPvalue(w4mu0, w4sd, w4n, w4dif, w4al);

  /* ── Item 6 ── */
  var xb6 = p6mu0 + p6dif;
  var se6 = seMean(p6sd, p6n);
  var z6  = zStat(xb6, p6mu0, p6sd, p6n);
  var pv6 = pRight(z6);
  var o6 = valOpts(pv6, [pLeft(z6), pTwo(z6), pRight(p6dif / p6sd)], pr, rng);
  var q6i = {
    title: { es: 'Rareza de una mejora en el gasto mensual', en: 'Rarity of a gain in monthly spending' },
    q: { es: 'Una tienda departamental sabe que sus tarjetahabientes gastan en promedio ' + money(p6mu0) + ' al mes, con una desviación estándar de ' + money(p6sd) + '. Lanzó un programa de puntos y midió el gasto de ' + intN(p6n) + ' tarjetahabientes inscritos, que promediaron ' + money(xb6) + '. La nula dice que el programa no cambió el gasto y la alternativa que lo aumentó. ¿Cuánto vale el valor p de esta prueba?',
        en: 'A department store knows its cardholders spend an average of ' + money(p6mu0) + ' per month, with a standard deviation of ' + money(p6sd) + '. It launched a points programme and measured spending for ' + intN(p6n) + ' enrolled cardholders, who averaged ' + money(xb6) + '. The null says the programme changed nothing and the alternative that it raised spending. How much is the p value of this test worth?' },
    opts: { es: o6.es, en: o6.en },
    hint: { es: 'Calcula primero el estadístico y después el área que queda más allá de él, en la cola que señala la alternativa. La alternativa apunta hacia arriba, así que el área que interesa es la de la derecha.',
            en: 'Compute the statistic first and then the area beyond it, in the tail the alternative points to. The alternative points upward, so the area of interest is the one on the right.' },
    exp: { es: 'El error estándar es ' + dec2(se6) + ' pesos y el estadístico vale ' + dec3(z6) + '. Como la alternativa apunta hacia arriba, el valor p es el área de la cola derecha más allá de ese estadístico: ' + pr(pv6) + '. Tomar la cola izquierda da ' + pr(pLeft(z6)) + ' y responde a la sospecha contraria, la de que el programa redujo el gasto. Duplicar el área da ' + pr(pTwo(z6)) + ', que sería el valor p de una prueba de dos colas y castiga de más a una hipótesis con dirección declarada. Y usar la desviación de un tarjetahabiente en lugar del error estándar del promedio da ' + pr(pRight(p6dif / p6sd)) + ', un valor tan alto que haría parecer irrelevante cualquier programa.',
           en: 'The standard error is ' + dec2(se6) + ' pesos and the statistic is ' + dec3(z6) + '. Since the alternative points upward, the p value is the right tail area beyond that statistic: ' + pr(pv6) + '. Taking the left tail gives ' + pr(pLeft(z6)) + ' and answers the opposite suspicion, that the programme reduced spending. Doubling the area gives ' + pr(pTwo(z6)) + ', which would be the p value of a two tailed test and overpenalises a hypothesis with a declared direction. And using the deviation of a single cardholder instead of the standard error of the average gives ' + pr(pRight(p6dif / p6sd)) + ', a value so high it would make any programme look irrelevant.' }
  };
  var d6 = mk(q6i, o6.correctIdx, true);
  problems.push({ i18n: d6.i18n, title: d6.title, questionText: d6.questionText, options: d6.options, correctIdx: d6.correctIdx, explanation: d6.explanation, hint: d6.hint, showWork: true, fn: 'valor p = P( z ≥ z observado | H₀ )', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ EVALUACIÓN FINAL ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Evaluación final</div>' +
      '<h2>Cuatro decisiones de negocio</h2>' +
      '<p>Los siguientes cuatro reactivos ya no vienen precedidos de una explicación. Cada uno describe una decisión real de una empresa y te toca identificar qué se afirma, hacia dónde apunta la sospecha y qué es exactamente lo que se está preguntando. Dos de ellos piden un número y dos ponen a prueba lo más delicado del tema, que es decir en voz alta lo que una prueba de hipótesis permite concluir y detenerse justo ahí.</p>' +
      '<div class="callout"><p><strong>Antes de responder.</strong> Pregúntate en este orden: qué afirma la nula y qué dirección tiene la alternativa; qué nivel de significancia se fijó; si lo que se pide es el estadístico, el valor p, un riesgo de error o una interpretación; y por último, si la diferencia de la que se habla tendría alguna consecuencia para el negocio en caso de ser real.</p></div>';
    return '' +
      '<div class="stag">Final assessment</div>' +
      '<h2>Four business decisions</h2>' +
      '<p>The next four items are no longer preceded by an explanation. Each one describes a real company decision and it is up to you to identify what is being claimed, where the suspicion points and what exactly is being asked. Two of them ask for a number and two test the most delicate part of the topic, which is saying out loud what a hypothesis test allows you to conclude and stopping right there.</p>' +
      '<div class="callout"><p><strong>Before answering.</strong> Ask yourself in this order: what the null claims and which direction the alternative takes; which significance level was set; whether what is wanted is the statistic, the p value, a risk of error or an interpretation; and finally, whether the difference being discussed would have any consequence for the business if it were real.</p></div>';
  });

  /* ── Item 7 ── */
  var se7 = seMean(p7sd, p7n);
  var z7  = p7dif / se7;
  var pv7 = pRight(z7);
  var o7 = shuffleOpts(
    ['Si la campaña no hubiera cambiado nada, la probabilidad de observar un aumento de ' + money(p7dif) + ' o mayor sería ' + pr(pv7) + '.',
     'La probabilidad de que la hipótesis nula sea cierta es ' + pr(pv7) + ', por lo que casi seguramente la campaña sí funcionó.',
     'La probabilidad de que la campaña haya funcionado es ' + pr(1 - pv7) + ', que es el complemento del valor p obtenido.',
     'El valor ' + pr(pv7) + ' es la probabilidad de haber cometido un error de tipo uno en esta decisión en particular.'],
    ['If the campaign had changed nothing, the probability of observing an increase of ' + money(p7dif) + ' or larger would be ' + pr(pv7) + '.',
     'The probability that the null hypothesis is true is ' + pr(pv7) + ', so the campaign almost certainly did work.',
     'The probability that the campaign worked is ' + pr(1 - pv7) + ', which is the complement of the p value obtained.',
     'The value ' + pr(pv7) + ' is the probability of having made a type one error in this particular decision.'], rng);
  var q7i = {
    title: { es: 'Cómo se explica un valor p en un reporte', en: 'How to explain a p value in a report' },
    q: { es: 'Una cadena de restaurantes lanzó una campaña y midió el consumo promedio por mesa en ' + intN(p7n) + ' visitas posteriores. El consumo quedó ' + money(p7dif) + ' por arriba del nivel histórico y la desviación estándar de la población es ' + money(p7sd) + '. La prueba de una cola por la derecha, con un nivel de significancia de ' + pct1(p7al) + ' por ciento, arrojó un valor p de ' + pr(pv7) + '. La dirección pide una frase que explique qué significa ese número. ¿Cuál es correcta?',
        en: 'A restaurant chain launched a campaign and measured average spending per table across ' + intN(p7n) + ' later visits. Spending landed ' + money(p7dif) + ' above the historical level and the standard deviation of the population is ' + money(p7sd) + '. The one tailed test on the right, at a significance level of ' + pct1(p7al) + ' percent, returned a p value of ' + pr(pv7) + '. Management asks for one sentence explaining what that number means. Which one is correct?' },
    opts: { es: o7.es, en: o7.en },
    hint: { es: 'Fíjate en qué se supone y qué se calcula. El valor p parte de suponer que la nula es cierta y calcula la rareza de la evidencia. Las lecturas que empiezan por la evidencia y terminan hablando de la probabilidad de una hipótesis invierten esa dirección.',
            en: 'Watch what is assumed and what is computed. The p value starts by assuming the null is true and computes the rarity of the evidence. Readings that start from the evidence and end up speaking of the probability of a hypothesis flip that direction.' },
    exp: { es: 'El valor p ' + pr(pv7) + ' se calcula en el mundo donde la campaña no sirvió: mide qué tan raro sería ver un aumento de ' + money(p7dif) + ' o mayor en ese mundo, con un estadístico de ' + dec3(z7) + '. Decir que es la probabilidad de que la nula sea cierta invierte el condicional y le asigna probabilidad a una hipótesis, cosa que este método no hace. Su complemento ' + pr(1 - pv7) + ' tampoco es la probabilidad de que la campaña haya funcionado, por la misma razón. Y confundirlo con la probabilidad de haber cometido un error de tipo uno en esta decisión concreta mezcla dos ideas: ese riesgo es el nivel de significancia ' + pr(p7al) + ' fijado de antemano, y describe el comportamiento del procedimiento a la larga, no este caso particular.',
           en: 'The p value ' + pr(pv7) + ' is computed in the world where the campaign did nothing: it measures how rare it would be to see an increase of ' + money(p7dif) + ' or larger in that world, with a statistic of ' + dec3(z7) + '. Saying it is the probability that the null is true flips the conditional and assigns probability to a hypothesis, which this method does not do. Its complement ' + pr(1 - pv7) + ' is not the probability that the campaign worked either, for the same reason. And confusing it with the probability of having made a type one error in this concrete decision mixes two ideas: that risk is the significance level ' + pr(p7al) + ' fixed in advance, and it describes the long run behaviour of the procedure, not this particular case.' }
  };
  var d7 = mk(q7i, o7.correctIdx, true);
  problems.push({ i18n: d7.i18n, title: d7.title, questionText: d7.questionText, options: d7.options, correctIdx: d7.correctIdx, explanation: d7.explanation, hint: d7.hint, showWork: true, fn: 'valor p = P( evidencia | H₀ )', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 8 ── */
  var xb8 = p8mu0 + p8dif;
  var se8 = seMean(p8sd, p8n);
  var z8  = zStat(xb8, p8mu0, p8sd, p8n);
  var pv8 = pTwo(z8);
  var o8 = valOpts(pv8, [pRight(z8), 1 - pv8, pTwo(p8dif / p8sd)], pr, rng);
  var q8i = {
    title: { es: 'Control de peso en una línea de envasado', en: 'Weight control on a packaging line' },
    q: { es: 'Una planta envasa costales cuyo contenido debe pesar en promedio ' + dec1(p8mu0) + ' gramos. A control de calidad no le preocupa solo que se llenen de menos, porque llenarlos de más también cuesta dinero: cualquier desviación del objetivo obliga a recalibrar. Se pesaron ' + intN(p8n) + ' costales al azar y el promedio fue de ' + dec1(xb8) + ' gramos, con una desviación estándar poblacional de ' + dec1(p8sd) + ' gramos. ¿Cuánto vale el valor p de esta prueba?',
        en: 'A plant fills sacks whose contents must weigh an average of ' + dec1(p8mu0) + ' grams. Quality control does not only worry about underfilling, because overfilling costs money too: any deviation from the target forces a recalibration. A random set of ' + intN(p8n) + ' sacks was weighed and the average was ' + dec1(xb8) + ' grams, with a population standard deviation of ' + dec1(p8sd) + ' grams. How much is the p value of this test worth?' },
    opts: { es: o8.es, en: o8.en },
    hint: { es: 'Lee con cuidado qué le preocupa a la planta antes de decidir cuántas colas lleva la prueba. Si una desviación en cualquier sentido obliga a actuar, la rareza del resultado se mide en los dos extremos.',
            en: 'Read carefully what worries the plant before deciding how many tails the test has. If a deviation in either direction forces action, the rarity of the result is measured at both ends.' },
    exp: { es: 'Como cualquier desviación del objetivo importa, la alternativa no tiene dirección y la prueba es de dos colas. El error estándar es ' + dec2(se8) + ' gramos, el estadístico vale ' + dec3(z8) + ' y el valor p suma las dos colas: ' + pr(pv8) + '. Usar una sola cola da ' + pr(pRight(z8) ) + ' y responde a una pregunta que la planta no hizo, porque ignora por completo el costo de sobrellenar. El complemento ' + pr(1 - pv8) + ' es el área central y no mide rareza alguna. Y sustituir el error estándar por la desviación de un costal individual da ' + pr(pTwo(p8dif / p8sd)) + ', que describe la variación de una pieza suelta en lugar de la del promedio de ' + intN(p8n) + ' costales.',
           en: 'Since any deviation from the target matters, the alternative has no direction and the test is two tailed. The standard error is ' + dec2(se8) + ' grams, the statistic is ' + dec3(z8) + ' and the p value adds both tails: ' + pr(pv8) + '. Using a single tail gives ' + pr(pRight(z8)) + ' and answers a question the plant did not ask, because it ignores the cost of overfilling entirely. The complement ' + pr(1 - pv8) + ' is the central area and measures no rarity at all. And replacing the standard error with the deviation of a single sack gives ' + pr(pTwo(p8dif / p8sd)) + ', which describes the variation of one loose unit instead of that of the average of ' + intN(p8n) + ' sacks.' }
  };
  var d8 = mk(q8i, o8.correctIdx, true);
  problems.push({ i18n: d8.i18n, title: d8.title, questionText: d8.questionText, options: d8.options, correctIdx: d8.correctIdx, explanation: d8.explanation, hint: d8.hint, showWork: true, fn: 'valor p de dos colas = 2 · P( z ≥ |z observado| )', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 9 ── */
  var mu19  = p9mu0 + p9ef;
  var pw9   = powerRight(p9mu0, mu19, p9sd, p9n, p9al);
  var pw9n  = powerRight(p9mu0, mu19, p9sd, p9n * 4, p9al);
  var pw9a  = powerRight(p9mu0, mu19, p9sd, p9n, p9al / 5);
  var o9 = shuffleOpts(
    ['Cuadruplicar la prueba piloto hasta ' + intN(p9n * 4) + ' sucursales, con lo cual la potencia sube a ' + pctS(pw9n) + ' sin tocar el riesgo de falsa alarma.',
     'Bajar el nivel de significancia a ' + pct1(p9al / 5) + ' por ciento, con lo cual la potencia sube a ' + pctS(pw9a) + ' porque una prueba más exigente detecta mejor los cambios reales.',
     'Subir el nivel de significancia hasta que la potencia alcance la meta, porque así se detectan más cambios reales sin costo adicional de muestreo.',
     'Repetir la misma prueba piloto varias veces y quedarse con el resultado que rechace la nula, porque basta con que una de las corridas lo logre.'],
    ['Quadrupling the pilot to ' + intN(p9n * 4) + ' branches, which raises the power to ' + pctS(pw9n) + ' without touching the false alarm risk.',
     'Lowering the significance level to ' + pct1(p9al / 5) + ' percent, which raises the power to ' + pctS(pw9a) + ' because a stricter test detects real changes better.',
     'Raising the significance level until the power reaches the target, since that detects more real changes at no extra sampling cost.',
     'Running the same pilot several times and keeping the result that rejects the null, since one of the runs succeeding is enough.'], rng);
  var q9i = {
    title: { es: 'Cómo mejorar un piloto sin subir el riesgo de falsa alarma', en: 'How to improve a pilot without raising the false alarm risk' },
    q: { es: 'Una cadena de tiendas vende hoy ' + money(p9mu0) + ' diarios por sucursal, con una desviación estándar de ' + money(p9sd) + '. Un piloto en ' + intN(p9n) + ' sucursales pondrá a prueba un nuevo acomodo de la mercancía, con un nivel de significancia de ' + pct1(p9al) + ' por ciento y una cola por la derecha. Si el acomodo en verdad subiera la venta diaria en ' + money(p9ef) + ', la potencia de la prueba sería apenas ' + pctS(pw9) + '. La dirección quiere más potencia sin aumentar el riesgo de declarar exitoso un acomodo que no sirve. ¿Qué debe hacer?',
        en: 'A retail chain sells ' + money(p9mu0) + ' per day per branch today, with a standard deviation of ' + money(p9sd) + '. A pilot in ' + intN(p9n) + ' branches will test a new merchandise layout, at a significance level of ' + pct1(p9al) + ' percent and one tail on the right. If the layout genuinely raised daily sales by ' + money(p9ef) + ', the power of the test would be only ' + pctS(pw9) + '. Management wants more power without raising the risk of declaring a useless layout successful. What should it do?' },
    opts: { es: o9.es, en: o9.en },
    hint: { es: 'Solo hay una palanca que mejora los dos riesgos a la vez, y no es gratuita. Revisa qué le pasa a la potencia cuando se mueve el nivel de significancia en cada dirección, y recuerda que el enunciado prohíbe expresamente subir el riesgo de falsa alarma.',
            en: 'Only one lever improves both risks at once, and it is not free. Check what happens to the power when the significance level moves each way, and remember the statement expressly forbids raising the false alarm risk.' },
    exp: { es: 'Aumentar la muestra angosta la distribución del promedio y separa los dos mundos, así que sube la potencia sin tocar el nivel de significancia: con ' + intN(p9n * 4) + ' sucursales pasaría de ' + pctS(pw9) + ' a ' + pctS(pw9n) + '. Bajar el nivel de significancia hace lo contrario de lo que dice esa opción: al volver más exigente el corte, la potencia cae a ' + pctS(pw9a) + '. Subir el nivel de significancia sí aumentaría la potencia, pero al precio de más falsas alarmas, que es exactamente lo que la dirección prohibió. Y repetir el piloto hasta que alguna corrida rechace es la peor de todas: multiplica en silencio el riesgo real de falsa alarma muy por encima del ' + pct1(p9al) + ' por ciento declarado.',
           en: 'Increasing the sample narrows the distribution of the average and pulls the two worlds apart, so power rises without touching the significance level: with ' + intN(p9n * 4) + ' branches it would go from ' + pctS(pw9) + ' to ' + pctS(pw9n) + '. Lowering the significance level does the opposite of what that option claims: by making the cut off stricter, power falls to ' + pctS(pw9a) + '. Raising the significance level would indeed increase power, but at the price of more false alarms, which is exactly what management forbade. And repeating the pilot until some run rejects is the worst of all: it silently multiplies the real false alarm risk far above the declared ' + pct1(p9al) + ' percent.' }
  };
  var d9 = mk(q9i, o9.correctIdx, true);
  problems.push({ i18n: d9.i18n, title: d9.title, questionText: d9.questionText, options: d9.options, correctIdx: d9.correctIdx, explanation: d9.explanation, hint: d9.hint, showWork: true, fn: 'potencia = 1 − β', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 10 ── */
  var se10 = seMean(p10sd, p10n);
  var z10  = p10d / se10;
  var pv10 = pRight(z10);
  var rel10 = p10d / p10mu;
  var o10 = shuffleOpts(
    ['El resultado es estadísticamente significativo porque el valor p ' + pr(pv10) + ' es menor que ' + pr(p10al) + ', pero la mejora de ' + money(p10d) + ' equivale a ' + pctS(rel10) + ' del ticket y solo conviene adoptar el rediseño si ese monto supera su costo.',
     'El resultado es estadísticamente significativo, y como el valor p ' + pr(pv10) + ' es muy pequeño, la mejora observada de ' + money(p10d) + ' es también muy grande en términos de negocio.',
     'El resultado no sirve para decidir porque la mejora de ' + money(p10d) + ' es demasiado pequeña, y con diferencias así de chicas la prueba de hipótesis no es aplicable.',
     'El valor p ' + pr(pv10) + ' indica que hay esa probabilidad de que el rediseño no sirva, y como es muy baja conviene adoptarlo de inmediato.'],
    ['The result is statistically significant because the p value ' + pr(pv10) + ' is smaller than ' + pr(p10al) + ', but the gain of ' + money(p10d) + ' amounts to ' + pctS(rel10) + ' of the ticket and the redesign is worth adopting only if that amount beats its cost.',
     'The result is statistically significant, and since the p value ' + pr(pv10) + ' is very small, the observed gain of ' + money(p10d) + ' is also very large in business terms.',
     'The result is of no use for deciding because the gain of ' + money(p10d) + ' is far too small, and with differences this tiny a hypothesis test does not apply.',
     'The p value ' + pr(pv10) + ' says that is the probability that the redesign does nothing, and since it is very low the redesign should be adopted at once.'], rng);
  var q10i = {
    title: { es: 'Una diferencia significativa que quizá no valga la pena', en: 'A significant difference that may not be worth it' },
    q: { es: 'Una tienda en línea con mucho tráfico probó un rediseño de su ficha de producto. El ticket promedio histórico es de ' + money(p10mu) + ' con una desviación estándar de ' + money(p10sd) + '. Midió ' + intN(p10n) + ' sesiones con el nuevo diseño y el ticket promedio quedó ' + money(p10d) + ' por arriba, lo que da un valor p de ' + pr(pv10) + ' frente a un nivel de significancia de ' + pct1(p10al) + ' por ciento. ¿Cuál es la lectura correcta de este resultado?',
        en: 'A high traffic online store tested a redesign of its product page. The historical average ticket is ' + money(p10mu) + ' with a standard deviation of ' + money(p10sd) + '. It measured ' + intN(p10n) + ' sessions with the new design and the average ticket landed ' + money(p10d) + ' above, giving a p value of ' + pr(pv10) + ' against a significance level of ' + pct1(p10al) + ' percent. What is the correct reading of this result?' },
    opts: { es: o10.es, en: o10.en },
    hint: { es: 'Separa dos preguntas distintas: si la diferencia es distinguible del ruido y si la diferencia tiene un tamaño que importe. El valor p responde la primera y guarda silencio absoluto sobre la segunda.',
            en: 'Keep two different questions apart: whether the difference is distinguishable from noise and whether the difference is large enough to matter. The p value answers the first and stays completely silent about the second.' },
    exp: { es: 'Con ' + intN(p10n) + ' sesiones el error estándar baja a ' + dec2(se10) + ' pesos, así que una mejora de apenas ' + money(p10d) + ' produce un estadístico de ' + dec3(z10) + ' y un valor p de ' + pr(pv10) + ': la diferencia es real y distinguible del ruido. Lo que la prueba no dice es si conviene. Esa mejora representa ' + pctS(rel10) + ' del ticket, y la decisión depende de multiplicarla por el volumen esperado y compararla contra el costo de desarrollar y mantener el rediseño. Sostener que un valor p chico implica una mejora grande confunde precisión con magnitud. Decir que la prueba no aplica es falso: aplica perfectamente y por eso detectó la diferencia. Y leer el valor p como la probabilidad de que el rediseño no sirva vuelve a invertir el condicional.',
           en: 'With ' + intN(p10n) + ' sessions the standard error drops to ' + dec2(se10) + ' pesos, so a gain of just ' + money(p10d) + ' produces a statistic of ' + dec3(z10) + ' and a p value of ' + pr(pv10) + ': the difference is real and distinguishable from noise. What the test does not say is whether it is worth it. That gain amounts to ' + pctS(rel10) + ' of the ticket, and the decision depends on multiplying it by the expected volume and comparing it against the cost of building and maintaining the redesign. Holding that a small p value implies a large gain confuses precision with magnitude. Saying the test does not apply is false: it applies perfectly and that is why it caught the difference. And reading the p value as the probability that the redesign does nothing flips the conditional once again.' }
  };
  var d10 = mk(q10i, o10.correctIdx, false);
  problems.push({ i18n: d10.i18n, title: d10.title, questionText: d10.questionText, options: d10.options, correctIdx: d10.correctIdx, explanation: d10.explanation, hint: d10.hint, showWork: false, fn: 'significancia estadística ≠ relevancia práctica', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);
}

/* ════════════════════════════════════════════════════════════════════════
   LANGUAGE SWITCHING
   ════════════════════════════════════════════════════════════════════════ */
function applyUIStrings() {
  var set = function(id, txt) { var e = document.getElementById(id); if (e) e.textContent = txt; };
  var ph  = function(id, txt) { var e = document.getElementById(id); if (e) e.placeholder = txt; };
  set('wtitle-el',    SCHOOL.guideTitle[LANG]);
  set('wcourse-el',   SCHOOL.courseName[LANG]);
  set('htitle-el',    SCHOOL.guideTitle[LANG]);
  set('lbl-name-el',  t('lbl-name'));
  set('lbl-group-el', t('lbl-group'));
  set('startBtn',     t('btn-start'));
  set('restoreTitle', t('restore-title'));
  set('restoreMsg',   t('restore-msg'));
  set('restoreBtn',   t('btn-restore'));
  set('dismissBtn',   t('btn-dismiss'));
  set('dlBtn',        t('btn-pdf'));
  ph('sName',  t('ph-name'));
  ph('sGroup', t('ph-group'));
  var ll = document.getElementById('logo-left');   if (ll) ll.alt = SCHOOL.logoLeftAlt;
  var lr = document.getElementById('logo-right');  if (lr) lr.alt = SCHOOL.logoRightAlt;
}
/* Rebuilds the visible text of every card without touching the numbers. */
function applyProblemLang() {
  problems.forEach(function(p, i) {
    var card = document.getElementById('pc' + i);
    if (!card || !p.i18n) return;
    p.title        = p.i18n.title[LANG];
    p.questionText = p.i18n.q[LANG];
    p.hint         = p.i18n.hint[LANG];
    p.explanation  = p.i18n.exp[LANG];
    p.options      = p.i18n.opts[LANG].slice();
    var ti = card.querySelector('.ptitle'); if (ti) ti.textContent = p.title;
    var st = card.querySelector('.pstmt');
    if (st) st.innerHTML = p.questionText + '<span class="pfn">' + (p.fn || '') + '</span>';
    var hb = card.querySelector('.hintbox'); if (hb) hb.innerHTML = p.hint;
    var hbtn = card.querySelector('.hintbtn'); if (hbtn) hbtn.textContent = t('btn-hint');
    card.querySelectorAll('.mcopt').forEach(function(o, oi) {
      if (p.options[oi] !== undefined) o.innerHTML = p.options[oi];
    });
    var tabs = card.querySelectorAll('.wtab');
    if (tabs.length === 3) {
      tabs[0].textContent = t('tab-draw');
      tabs[1].textContent = t('tab-type');
      tabs[2].textContent = t('tab-photo');
    }
    var tools = card.querySelectorAll('.tbtn2');
    if (tools.length === 3) {
      tools[0].textContent = t('tool-pen');
      tools[1].textContent = t('tool-mark');
      tools[2].textContent = t('tool-erase');
    }
    var clr = card.querySelector('.clrbtn'); if (clr) clr.textContent = t('tool-clear');
    var ta  = card.querySelector('.wtextarea'); if (ta) ta.placeholder = t('ph-work');
    var pzt = card.querySelector('.pztxt'); if (pzt) pzt.textContent = t('ph-photo');
    var lab = card.querySelector('.pbody > div:last-child > div:first-child');
    if (lab) lab.textContent = t('lbl-answer');
    var fb = card.querySelector('.mcfb');
    if (fb && fb.classList.contains('show')) {
      var isOk = (p.studentChoice === p.correctIdx);
      fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + p.explanation;
    }
  });
}
function setLang(l) {
  LANG = l;
  try { localStorage.setItem(LANG_KEY, l); } catch(e) {}
  document.documentElement.setAttribute('lang', l);
  var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
  if (be) be.classList.toggle('active', l === 'es');
  if (bn) bn.classList.toggle('active', l === 'en');
  applyUIStrings();
  applySectionLang();
  applyProblemLang();
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
  document.querySelectorAll('#lessonBody .section').forEach(function(s) { s.classList.add('vis'); });
}
(function() {
  try { var stored = localStorage.getItem(LANG_KEY); if (stored === 'es' || stored === 'en') LANG = stored; } catch(e) {}
  document.addEventListener('DOMContentLoaded', function() {
    document.documentElement.setAttribute('lang', LANG);
    var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
    if (be) be.classList.toggle('active', LANG === 'es');
    if (bn) bn.classList.toggle('active', LANG === 'en');
    applyUIStrings();
  });
})();

/* LOGO INJECTION */
document.addEventListener('DOMContentLoaded', function() {
  var wl = document.getElementById('logo-left');
  if (wl && SCHOOL.logoLeftB64) { wl.src = SCHOOL.logoLeftB64; wl.style.display = 'inline-block'; }
  var hl = document.getElementById('hlogo-left');
  if (hl && SCHOOL.logoLeftB64) { hl.src = SCHOOL.logoLeftB64; hl.style.display = 'inline-block'; }
});
/* ════════════════════════════════════════════════════════════════════════
   PDF
   ════════════════════════════════════════════════════════════════════════ */
async function generatePDF() {
  var btn = document.getElementById('dlBtn');
  btn.textContent = t('pdf-busy');
  btn.disabled = true;

  var jspdf   = window.jspdf;
  var doc     = new jspdf.jsPDF({ orientation:'portrait', unit:'mm', format:'letter' });
  var PW      = 215.9;
  var M       = 18;
  var TW      = PW - M * 2;
  var PH      = doc.internal.pageSize.height;
  var name    = studentData.name;
  var group   = studentData.group;
  var total   = problems.length;
  var pct     = Math.round(correctCount / total * 100);
  var dateStr = new Date().toLocaleString(LANG === 'es' ? 'es-MX' : 'en-US', { dateStyle:'long', timeStyle:'short' });

  var raw = name + '|' + group + '|' + correctCount + '|' + total + '|' + new Date().toDateString();
  var h = 0;
  for (var ci = 0; ci < raw.length; ci++) h = (Math.imul(31, h) + raw.charCodeAt(ci)) | 0;
  var code = Math.abs(h).toString(36).toUpperCase().slice(0, 8);

  var pBR = SCHOOL.pBR, pBG = SCHOOL.pBG, pBB = SCHOOL.pBB;
  var pAR = SCHOOL.pAR, pAG = SCHOOL.pAG, pAB = SCHOOL.pAB;

  function pdfText(html) {
    if (!html) return '';
    return html
      .replace(/<[^>]+>/g,'').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&')
      .replace(/&nbsp;/g,' ').replace(/&#[0-9]+;/g,'')
      .replace(/→/g,'->').replace(/−/g,'-').replace(/²/g,'^2')
      .replace(/³/g,'^3').replace(/×/g,'x').replace(/÷/g,'/')
      .replace(/≠/g,'!=').replace(/≤/g,'<=').replace(/≥/g,'>=')
      .replace(/√/g,'sqrt').replace(/π/g,'pi').replace(/…/g,'...')
      .replace(/μ/g,'mu').replace(/σ/g,'sigma').replace(/α/g,'alpha').replace(/β/g,'beta')
      .replace(/₀/g,'0').replace(/₁/g,'1').replace(/x̄/g,'xbar')
      .replace(/\s+/g,' ').trim();
  }

  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,2,'F');
  doc.setFillColor(255,255,255); doc.rect(0,2,PW,26,'F');
  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,28,PW,2,'F');
  doc.setFillColor(pBR,pBG,pBB); doc.rect(0,30,PW,34,'F');

  var fmtL = SCHOOL.logoLeftB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  var fmtR = SCHOOL.logoRightB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  try { doc.addImage(SCHOOL.logoLeftB64,  fmtL, M,  4.0, 22, 22); } catch(e) {}
  try { doc.addImage(SCHOOL.logoRightB64, fmtR, 48, 4.5, 48, 21); } catch(e) {}

  var lx = PW - M - 36;
  var ly = 10;
  doc.setDrawColor(pBR,pBG,pBB); doc.setLineWidth(0.7);
  doc.lines([[2.57-1.03,4.63-6.17],[4.11-2.57,5.14-4.63],[5.66-4.11,2.57-5.14]], lx+1.03, ly+6.17);
  doc.setFillColor(pAR,pAG,pAB); doc.circle(lx+5.66, ly+2.57, 0.9, 'F');
  doc.setDrawColor(pAR,pAG,pAB); doc.setLineWidth(0.7);
  doc.line(lx+8.23, ly+1.54, lx+8.23, ly+7.2);
  doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text('LIAXA', lx+10, ly+6.8);

  doc.setTextColor(240,244,238); doc.setFontSize(13); doc.setFont('helvetica','bold');
  doc.text(SCHOOL.guideTitle[LANG], M, 49);
  doc.setTextColor(198,214,192); doc.setFontSize(8); doc.setFont('helvetica','normal');
  doc.text(dateStr, M, 59);

  doc.setFillColor(237,240,245); doc.roundedRect(M,72,TW,20,3,3,'F');
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
  doc.text(t('pdf-student'), M+4, 79); doc.text(t('pdf-group'), 130, 79);
  doc.setTextColor(20,24,32); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text(name, M+4, 87); doc.text(group, 130, 87);

  var sc = pct>=70?[26,106,74]:pct>=50?[224,123,26]:[176,48,16];
  doc.setFillColor(255,255,255); doc.roundedRect(M,100,TW,34,4,4,'F');
  doc.setDrawColor(sc[0],sc[1],sc[2]); doc.setLineWidth(0.8);
  doc.roundedRect(M,100,TW,34,4,4,'S');
  doc.setTextColor(sc[0],sc[1],sc[2]); doc.setFontSize(40); doc.setFont('helvetica','bold');
  doc.text(pct+'%', PW/2, 124, {align:'center'});
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
  doc.text(correctCount+' '+t('pdf-score')+' '+total+' '+t('pdf-questions'), PW/2, 131, {align:'center'});

  doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
  doc.setFontSize(7); doc.setFont('helvetica','bold');
  doc.rect(M,142,TW,8,'F'); doc.text(t('pdf-summary'), M+4, 148);
  var sy = 154;
  problems.forEach(function(prob, i) {
    if (sy + 12 > PH - 15) {
      doc.addPage(); sy = 20;
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,sy,TW,8,'F'); doc.text(t('pdf-summary2'), M+4, sy+6);
      sy += 12;
    }
    var ok = document.getElementById('pc'+i).classList.contains('ok');
    doc.setFillColor(ok?232:255, ok?240:232, ok?232:228);
    doc.roundedRect(M,sy,TW,10,2,2,'F');
    doc.setFillColor(ok?26:176, ok?106:48, ok?74:16);
    doc.circle(M+6, sy+5, 2.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(7); doc.setFont('helvetica','bold');
    doc.text(ok?'v':'x', M+4.5, sy+6.5);
    doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('helvetica','normal');
    doc.text(t('pdf-item')+' '+(i+1)+': '+pdfText(prob.title), M+12, sy+6.5);
    doc.setTextColor(ok?26:176, ok?106:48, ok?74:16);
    doc.text(ok?t('pdf-ok'):t('pdf-bad'), PW-M-24, sy+6.5);
    sy += 12;
  });

  for (var i = 0; i < problems.length; i++) {
    var prob = problems[i];
    doc.addPage();
    var wy = 0;

    doc.setFillColor(pBR,pBG,pBB); doc.rect(0,0,PW,20,'F');
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,3,'F');
    doc.setTextColor(pAR,pAG,pAB); doc.setFontSize(7); doc.setFont('helvetica','normal');
    doc.text(SCHOOL.courseName[LANG]+'  ·  '+SCHOOL.guideTitle[LANG], M, 10);
    doc.setTextColor(240,244,238); doc.setFontSize(10.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-item')+' '+(i+1)+' '+t('pdf-of')+' '+total+'  ·  '+pdfText(prob.title), M, 17);
    wy = 25;

    var qRaw = pdfText(prob.questionText);
    doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qLines = doc.splitTextToSize(qRaw, TW-10);
    var qBoxH  = 8 + qLines.length*5 + 3;
    doc.setFillColor(237,240,245); doc.roundedRect(M,wy,TW,qBoxH,2,2,'F');
    doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(6.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-question'), M+4, wy+6);
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qy = wy+12;
    qLines.forEach(function(ln,li){ doc.text(ln, M+4, qy+li*5); });
    wy += qBoxH + 4;

    var isOk   = document.getElementById('pc'+i).classList.contains('ok');
    var chosen = prob.studentChoice != null ? pdfText(prob.options[prob.studentChoice]||'') : '';
    var corr   = pdfText(prob.options[prob.correctIdx]||'');
    var expRaw = pdfText(prob.explanation||'');
    doc.setFontSize(8.5); var chLines = doc.splitTextToSize(t('pdf-yours')+chosen, TW-18);
    doc.setFontSize(8);   var coLines = doc.splitTextToSize(t('pdf-key')+corr, TW-18);
    doc.setFontSize(7.5); var exLines = doc.splitTextToSize(t('pdf-sol')+expRaw, TW-18).slice(0,4);
    var ansBoxH = 8 + chLines.length*5.5 + coLines.length*5 + exLines.length*5 + 6;
    doc.setFillColor(isOk?232:255, isOk?240:232, isOk?232:228);
    doc.roundedRect(M,wy,TW,ansBoxH,2,2,'F');
    doc.setFillColor(isOk?26:176, isOk?106:48, isOk?74:16);
    doc.circle(M+7, wy+8, 3.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(9); doc.setFont('helvetica','bold');
    doc.text(isOk?'v':'x', M+5.2, wy+10.5);
    var ay = wy+7;
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
    chLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5.5); });
    ay += chLines.length*5.5 + 3;
    doc.setTextColor(26,106,74); doc.setFontSize(8); doc.setFont('helvetica','normal');
    coLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    ay += coLines.length*5 + 3;
    doc.setTextColor(90,85,80); doc.setFontSize(7.5);
    exLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    wy += ansBoxH + 5;

    var dc = document.getElementById('dc'+i);
    if (dc) {
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,wy,TW,8,'F'); doc.text(t('pdf-work'), M+4, wy+5.5);
      wy += 11;
      try {
        var imgD = dc.toDataURL('image/png');
        var ar   = dc.height / dc.width;
        var iw   = TW;
        var ih   = Math.min(iw * ar, 68);
        doc.addImage(imgD, 'PNG', M, wy, iw, ih);
        wy += ih + 4;
      } catch(e) {}
    }

    var ta = document.getElementById('ta'+i);
    if (ta && ta.value.trim()) {
      if (wy > PH-30) { doc.addPage(); wy = 20; }
      doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('courier','normal');
      var taLines = doc.splitTextToSize(ta.value, TW);
      taLines.slice(0,16).forEach(function(ln) {
        if (wy > PH-15) { doc.addPage(); wy = 20; }
        doc.text(ln, M, wy); wy += 5;
      });
      wy += 2;
    }

    var pp = document.getElementById('pp'+i);
    if (pp && pp.src && pp.src.indexOf('data:') === 0) {
      if (wy > PH-55) { doc.addPage(); wy = 20; }
      try { doc.addImage(pp.src, 'JPEG', M, wy, TW, 68); wy += 72; } catch(e) {}
    }
  }

  var pages = doc.internal.getNumberOfPages();
  for (var p = 1; p <= pages; p++) {
    doc.setPage(p);
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0, PH-3, PW, 3, 'F');
    doc.setTextColor(130,140,160); doc.setFontSize(6.5); doc.setFont('helvetica','normal');
    doc.text(name+'  ·  '+group+'  ·  '+t('pdf-code')+code+'  ·  '+t('pdf-page')+p+'/'+pages,
      PW/2, PH-5, {align:'center'});
  }

  var _fn = SCHOOL.filePrefix + '_' + name.replace(/\s+/g,'_') + '_' + group.replace(/\s+/g,'_') + '.pdf';
  var _pdfBlob = doc.output('blob');
  var _blobUrl = URL.createObjectURL(_pdfBlob);
  var _a = document.createElement('a');
  _a.href = _blobUrl;
  _a.download = _fn;
  document.body.appendChild(_a);
  _a.click();
  setTimeout(function(){ document.body.removeChild(_a); URL.revokeObjectURL(_blobUrl); }, 200);
  btn.textContent = t('btn-pdf');
  btn.disabled  = false;
}
</script>
</body>
</html>









