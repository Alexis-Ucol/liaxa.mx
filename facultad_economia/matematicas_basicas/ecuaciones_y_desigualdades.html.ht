<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ecuaciones y Desigualdades · Matemáticas Básicas · Facultad de Economía, Universidad de Colima</title>
<link rel="canonical" href="https://liaxa.mx/facultad_economia/matematicas_basicas/mat_ecuaciones.html">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ── DESIGN TOKENS ── fallback only; applyBranding() re-injects from SCHOOL ── */
:root {
  --green:      #4a7c3f;
  --green-dark: #2d5a27;
  --green-bg:   #eaf0e7;
  --gold:       #c9a84c;
  --gold-bg:    #faf3e0;
  --bg:         #f8f6f1;
  --surface:    #ffffff;
  --surface2:   #f0ede6;
  --border:     #ddd8cc;
  --text:       #1a1a16;
  --text2:      #4a4640;
  --text3:      #7a7468;
  --ok:         #2d6a4f;
  --ok-bg:      rgba(45,106,79,.10);
  --bad:        #8b2500;
  --bad-bg:     rgba(139,37,0,.08);
  --shadow:     0 4px 20px rgba(0,0,0,.09);
}
[data-theme="dark"] {
  --bg:         #18181a;
  --surface:    #242420;
  --surface2:   #2e2e28;
  --border:     #3a3830;
  --text:       #e8e4da;
  --text2:      #b0aa9e;
  --text3:      #7a7468;
  --shadow:     0 4px 20px rgba(0,0,0,.35);
  --green:      #6aaa5f;
  --green-dark: #8ecf82;
  --green-bg:   #1a281a;
  --gold:       #d4b86a;
  --gold-bg:    #241e0e;
  --ok:         #4a9a6f;
  --ok-bg:      rgba(74,154,111,.12);
  --bad:        #c05030;
  --bad-bg:     rgba(192,80,48,.10);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'IBM Plex Sans', sans-serif; background: var(--bg); color: var(--text); line-height: 1.65; }

/* ── WELCOME ── */
#welcomeScreen { display:flex; align-items:center; justify-content:center; min-height:100vh; padding:1.5rem; }
.wcard { background:var(--surface); border-radius:16px; box-shadow:var(--shadow); padding:2.4rem 2rem; width:100%; max-width:460px; text-align:center; border-top:4px solid var(--gold); }
.wlogos { display:flex; justify-content:center; align-items:center; gap:1.4rem; margin-bottom:1.6rem; padding-bottom:1.6rem; border-bottom:1px solid var(--border); }
.wlogos img { height:50px; width:auto; object-fit:contain; }
.wlogsep { width:1px; height:40px; background:var(--border); flex-shrink:0; }
.wtitle { font-family:'Crimson Pro',serif; font-size:1.65rem; font-weight:700; margin-bottom:.25rem; }
.wcourse { font-size:.78rem; color:var(--text3); letter-spacing:.07em; text-transform:uppercase; margin-bottom:1.6rem; }
.flabel { display:block; font-size:.75rem; color:var(--text3); text-transform:uppercase; letter-spacing:.06em; margin-bottom:.3rem; text-align:left; }
.finput { width:100%; padding:.7rem .9rem; border:1.5px solid var(--border); border-radius:8px; background:var(--surface2); color:var(--text); font-size:.95rem; font-family:inherit; margin-bottom:.9rem; transition:border-color .18s; }
.finput:focus { outline:none; border-color:var(--green); }
.sbtn { width:100%; padding:.85rem; background:var(--green); color:#fff; border:none; border-radius:10px; font-size:1rem; font-weight:600; cursor:pointer; transition:background .18s; }
.sbtn:hover { background:var(--green-dark); }
.serr { min-height:1.2rem; font-size:.82rem; color:var(--bad); margin-top:.4rem; }
.wfoot { margin-top:1rem; font-size:.75rem; color:var(--text3); }

/* ── RESTORE BAR ── */
#restoreBar { display:none; background:var(--green-bg); color:var(--green-dark); border:1.5px solid var(--green); border-radius:10px; padding:.85rem 1.1rem; margin-top:.9rem; font-size:.88rem; }
#restoreBar strong { color:var(--green-dark); }
.rbar-btns { display:flex; gap:.6rem; margin-top:.6rem; }
.rbtn { padding:.45rem 1rem; border-radius:8px; border:none; font-size:.82rem; font-weight:600; cursor:pointer; }
.rbtn-yes { background:var(--green); color:#fff; }
.rbtn-yes:hover { background:var(--green-dark); }
.rbtn-no  { background:var(--surface2); color:var(--text2); border:1px solid var(--border); }

/* ── LESSON ── */
#lessonScreen { display:none; }
.stickybar { position:sticky; top:0; z-index:100; background:var(--surface); border-bottom:1px solid var(--border); padding:.55rem 1.2rem; display:flex; align-items:center; gap:.7rem; box-shadow:0 2px 8px rgba(0,0,0,.06); }
.hlogos { display:flex; gap:.5rem; align-items:center; }
.hlogos img { height:26px; width:auto; object-fit:contain; }
.hsep { width:1px; height:22px; background:var(--border); flex-shrink:0; }
.htitle { font-family:'Crimson Pro',serif; font-size:1rem; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.halexis { flex:1; display:flex; justify-content:center; align-items:center; min-width:0; }
.hchip { font-size:.7rem; background:var(--green-bg); color:var(--green-dark); padding:.2rem .65rem; border-radius:20px; white-space:nowrap; flex-shrink:0; }
.tbtn { background:none; border:1px solid var(--border); border-radius:7px; padding:.28rem .55rem; cursor:pointer; font-size:.82rem; color:var(--text2); flex-shrink:0; }
.progbar { height:3px; background:var(--border); position:sticky; top:47px; z-index:99; }
.progfill { height:100%; background:var(--green); width:0%; transition:width .4s; }

/* ── LANGUAGE TOGGLE ── */
.lang-toggle { display:flex; border:1.5px solid var(--border); border-radius:8px; overflow:hidden; flex-shrink:0; }
.lang-btn { padding:.28rem .7rem; font-size:.72rem; font-weight:600; letter-spacing:.06em; cursor:pointer; border:none; background:none; color:var(--text3); font-family:inherit; transition:all .15s; }
.lang-btn.active { background:var(--green); color:#fff; }
[data-theme="dark"] .lang-btn.active { background:var(--green-dark); }

/* ── CONTENT ── */
.lbody { max-width:760px; margin:0 auto; padding:2rem 1.2rem 4rem; }
.section { opacity:0; transform:translateY(16px); transition:opacity .48s, transform .48s; margin-bottom:2.8rem; }
.section.vis { opacity:1; transform:none; }
.stag { font-size:.68rem; letter-spacing:.12em; text-transform:uppercase; color:var(--gold); font-weight:600; margin-bottom:.45rem; }
.section h2 { font-family:'Crimson Pro',serif; font-size:1.65rem; font-weight:700; margin-bottom:.7rem; }
.section p { color:var(--text2); margin-bottom:.8rem; }
.callout { background:var(--green-bg); border-left:4px solid var(--green); border-radius:0 10px 10px 0; padding:1rem 1.2rem; margin:1rem 0; }
.callout strong { color:var(--green-dark); }
.callout p { margin-bottom:0; }
.dlist { font-family:'IBM Plex Mono',monospace; font-size:.78rem; color:var(--green-dark); background:var(--surface2); border-radius:8px; padding:.6rem .7rem; margin:.6rem 0; word-break:break-word; }

/* ── RULE CARDS ── */
.rules-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:.75rem; margin:1.1rem 0; }
.rcard { background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:.9rem; border-top:3px solid var(--green); overflow-x:auto; }
.rname { font-size:.7rem; text-transform:uppercase; letter-spacing:.06em; color:var(--text3); margin-bottom:.35rem; }
.rform { font-family:'IBM Plex Mono',monospace; font-size:.85rem; color:var(--green-dark); font-weight:500; margin-bottom:.3rem; }
.rnote { font-size:.76rem; color:var(--text3); }

/* ── INTERACTIVE WIDGETS ── */
.gcrd { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:1.3rem; margin:.9rem 0; }
.iw-head { display:flex; align-items:baseline; gap:.6rem; margin-bottom:.3rem; flex-wrap:wrap; }
.iw-tag { font-size:.62rem; letter-spacing:.12em; text-transform:uppercase; color:var(--gold); font-weight:600; }
.iw-title { font-family:'Crimson Pro',serif; font-size:1.08rem; font-weight:700; }
.iw-sub { font-size:.8rem; color:var(--text2); margin-bottom:.85rem; }
.iw-read { margin-top:.85rem; background:var(--green-bg); border-left:4px solid var(--green); border-radius:0 8px 8px 0; padding:.7rem .85rem; font-size:.82rem; color:var(--text2); }
.iw-read strong { color:var(--green-dark); }
.iw-expr { font-family:'IBM Plex Mono',monospace; font-size:1rem; text-align:center; padding:.75rem .6rem; background:var(--surface2); border-radius:8px; margin:.5rem 0; color:var(--text); word-break:break-word; }
.iw-expr .ec { color:var(--green-dark); font-weight:600; }
.iw-expr .ev { color:var(--gold); font-weight:600; }
.iw-note { font-size:.74rem; color:var(--text3); text-align:center; margin-top:-.2rem; margin-bottom:.5rem; }

/* ── BALANCE BARS ── */
.sidebar-row { margin:.5rem 0; }
.sidebar-lbl { display:flex; justify-content:space-between; font-size:.72rem; color:var(--text3); margin-bottom:.18rem; }
.sidebar-track { height:20px; border-radius:6px; background:var(--surface2); border:1px solid var(--border); overflow:hidden; }
.sidebar-fill { display:block; height:100%; }
.fill-in { background:var(--green); }
.fill-out { background:var(--gold); }
.verdict { text-align:center; font-size:.84rem; font-weight:600; margin-top:.5rem; }
.v-ok  { color:var(--ok); }
.v-bad { color:var(--bad); }

/* ── NUMBER LINE ── */
.nline { position:relative; height:28px; border-radius:6px; background:var(--surface2); border:1px solid var(--border); margin:.6rem 0 .25rem; overflow:hidden; }
.nfill { position:absolute; top:0; bottom:0; background:var(--green-bg); border-left:2px solid var(--green); border-right:2px solid var(--green); }
.nmark { position:absolute; top:0; bottom:0; width:3px; background:var(--gold); }
.nscale { display:flex; justify-content:space-between; font-size:.68rem; color:var(--text3); }

/* ── CHIPS AND TABS ── */
.chips { display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.6rem; }
.chip { border:1.5px solid var(--border); border-radius:8px; padding:.34rem .6rem; font-size:.76rem; cursor:pointer; background:var(--surface2); color:var(--text2); font-family:inherit; text-align:left; line-height:1.25; }
.chip.on { border-color:var(--green); background:var(--green-bg); color:var(--green-dark); }
.cgrid { display:grid; grid-template-columns:1fr 1fr; gap:.7rem; margin-bottom:.9rem; }
@media(max-width:500px){ .cgrid { grid-template-columns:1fr; } }
.cg label { display:block; font-size:.73rem; color:var(--text3); margin-bottom:.25rem; }
.cg input[type=range] { width:100%; accent-color:var(--green); }
.cval { font-weight:600; color:var(--green); }
.metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:.55rem; margin-top:.9rem; }
.metric { background:var(--surface2); border-radius:8px; padding:.65rem; text-align:center; }
.mlbl { font-size:.66rem; text-transform:uppercase; letter-spacing:.06em; color:var(--text3); margin-bottom:.15rem; }
.mnum { font-family:'IBM Plex Mono',monospace; font-size:.95rem; font-weight:600; }
.mnum.cs { color:var(--green); }
.mnum.ps { color:var(--gold); }
.mnum.ts { color:var(--text); }
.mtabs { display:flex; gap:.4rem; margin-bottom:.8rem; flex-wrap:wrap; }
.mtab { background:var(--surface2); border:1px solid var(--border); border-radius:6px; padding:.3rem .7rem; font-size:.76rem; cursor:pointer; color:var(--text2); transition:all .14s; font-family:inherit; }
.mtab.active, .mtab:hover { background:var(--green); color:#fff; border-color:var(--green); }

/* ── PROBLEM CARDS ── */
.pcrd { background:var(--surface); border:1.5px solid var(--border); border-radius:12px; margin-bottom:1.3rem; overflow:hidden; transition:border-color .25s; }
.pcrd.ok  { border-color:var(--ok); }
.pcrd.bad { border-color:var(--bad); }
.phdr { display:flex; align-items:center; gap:.75rem; padding:.8rem 1rem; background:var(--surface2); border-bottom:1px solid var(--border); }
.pnum { background:var(--green); color:#fff; width:25px; height:25px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:.76rem; font-weight:700; flex-shrink:0; }
.ptitle { font-weight:600; font-size:.88rem; }
.pbody { padding:1rem; }
.pstmt { background:var(--surface2); border-radius:8px; padding:.85rem .95rem; margin-bottom:.9rem; font-size:.88rem; }

/* ── WORK AREA TABS ── */
.wtabs { display:flex; gap:.35rem; margin-bottom:.5rem; flex-wrap:wrap; }
.wtab { background:var(--surface2); border:1px solid var(--border); border-radius:6px; padding:.26rem .68rem; font-size:.78rem; cursor:pointer; color:var(--text2); transition:all .14s; }
.wtab.active, .wtab:hover { background:var(--green); color:#fff; border-color:var(--green); }
.wpanel { display:none; }
.wpanel.active { display:block; }

/* ── CANVAS ── */
.cvwrap { border:1px solid var(--border); border-radius:8px; overflow:hidden; background:var(--surface); }

/* ── MATH FRACTIONS ── */
.mf-outer { display:inline-flex; flex-direction:column; align-items:center; vertical-align:middle; margin:0 .15em; line-height:1.1; }
.mf-num   { border-bottom:1.5px solid var(--text); padding:0 .2em .1em; font-size:.92em; text-align:center; }
.mf-den   { padding:.1em .2em 0; font-size:.92em; text-align:center; }
.dcanvas { display:block; touch-action:none; cursor:crosshair; width:100%; height:190px; }
.ctoolbar { display:flex; align-items:center; gap:.35rem; padding:.35rem .55rem; background:var(--surface2); border-top:1px solid var(--border); flex-wrap:wrap; }
.tbtn2 { background:none; border:1px solid var(--border); border-radius:5px; padding:.22rem .45rem; font-size:.72rem; cursor:pointer; color:var(--text2); }
.tbtn2.on { background:var(--green); color:#fff; border-color:var(--green); }
.cdot { width:17px; height:17px; border-radius:50%; cursor:pointer; border:2px solid transparent; flex-shrink:0; }
.cdot.sel { border-color:var(--gold); }
.clrbtn { background:none; border:1px solid var(--border); border-radius:5px; padding:.22rem .45rem; font-size:.72rem; cursor:pointer; color:var(--bad); margin-left:auto; }

/* ── TEXTAREA ── */
.wtextarea { width:100%; min-height:120px; padding:.65rem; border:1px solid var(--border); border-radius:8px; background:var(--surface); color:var(--text); font-family:'IBM Plex Mono',monospace; font-size:.8rem; resize:vertical; }
.wtextarea:focus { outline:none; border-color:var(--green); }

/* ── PHOTO ── */
.pzone { border:2px dashed var(--border); border-radius:8px; padding:1.4rem; text-align:center; cursor:pointer; position:relative; transition:border-color .18s; }
.pzone:hover { border-color:var(--green); }
.pzone input { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
.pzicon { font-size:1.7rem; margin-bottom:.35rem; }
.pztxt { font-size:.8rem; color:var(--text3); }
.ppreview { display:none; width:100%; border-radius:8px; margin-top:.5rem; max-height:280px; object-fit:contain; }

/* ── HINT ── */
.hintbtn { background:none; border:1px solid var(--gold); color:var(--gold); border-radius:6px; padding:.28rem .65rem; font-size:.78rem; cursor:pointer; margin-bottom:.45rem; }
.hintbox { display:none; background:var(--gold-bg); border-left:3px solid var(--gold); border-radius:0 8px 8px 0; padding:.65rem .85rem; font-size:.83rem; color:var(--text2); }
.hintbox.show { display:block; }

/* ── MC ── */
.mcopt.pending { border-color:var(--gold); background:var(--gold-bg); }
.mcopts { display:flex; flex-direction:column; gap:.45rem; margin-bottom:.6rem; }
.mcopt { display:flex; align-items:center; gap:.65rem; padding:.65rem .85rem; border:1.5px solid var(--border); border-radius:8px; cursor:pointer; font-size:.86rem; transition:all .13s; user-select:none; }
.mcopt:hover:not(.dis) { border-color:var(--green); background:var(--green-bg); }
.mcopt.dis   { cursor:default; pointer-events:none; }
.mcopt.sc    { border-color:var(--ok);  background:var(--ok-bg);  color:var(--ok); }
.mcopt.sw    { border-color:var(--bad); background:var(--bad-bg); color:var(--bad); }
.mcopt.rc    { border-color:var(--ok);  background:var(--ok-bg); }
.mcfb { display:none; padding:.65rem .85rem; border-radius:8px; font-size:.83rem; margin-top:.25rem; }
.mcfb.show  { display:block; }
.mcfb.fbok  { background:var(--ok-bg);  color:var(--ok); }
.mcfb.fbbad { background:var(--bad-bg); color:var(--bad); }

/* ── RESULT ── */
.rpanel { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:1.8rem; text-align:center; }
.dlbtn { background:var(--green); color:#fff; border:none; border-radius:10px; padding:.8rem 1.8rem; font-size:.95rem; font-weight:600; cursor:pointer; transition:background .18s; }
.dlbtn:hover { background:var(--green-dark); }
.dlbtn:disabled { opacity:.6; cursor:wait; }

/* ── MOBILE ── */
@media (max-width: 600px) {
  .wcard { padding: 1.6rem 1.1rem; border-radius: 12px; }
  .wlogos { gap: .9rem; }
  .wlogos img { height: 38px; max-width: 42%; }
  .wtitle { font-size: 1.35rem; }
  .stickybar { padding: .5rem .55rem; gap: .38rem; }
  .htitle { display: none; }
  .halexis { display: none; }
  .hsep { display: none; }
  .hlogos { gap: .3rem; }
  .hlogos img { height: 18px; max-width: 60px; }
  .hchip { font-size: .63rem; padding: .15rem .45rem; max-width: 78px; overflow: hidden; text-overflow: ellipsis; }
  .lang-btn { padding: .26rem .48rem; font-size: .68rem; }
  .lbody { padding: 1.2rem .7rem 3rem; max-width: 100%; }
  .section h2 { font-size: 1.3rem; }
  .rules-grid { grid-template-columns: 1fr; }
  .metrics { grid-template-columns: repeat(2, 1fr); }
  .gcrd { padding: .9rem .75rem; }
  .iw-expr { font-size: .86rem; }
  .pbody { padding: .75rem; }
  .pstmt { font-size: .84rem; }
  .mcopt { font-size: .83rem; padding: .58rem .7rem; }
  .dcanvas { height: 220px; }
  .ctoolbar { gap: .25rem; }
  .callout { padding: .8rem .9rem; }
  .rcard { overflow-x: auto; }
}
</style>
</head>
<body>

<!-- ════════════════════ WELCOME ════════════════════ -->
<div id="welcomeScreen">
  <div class="wcard">
    <div class="wlogos" id="wlogos">
      <img id="logo-left"  src="" alt="Facultad de Economía" style="display:none">
      <div class="wlogsep" id="wlogsep"></div>
      <img id="logo-right" src="" alt="Universidad de Colima" style="display:none">
    </div>
    <div class="wtitle" id="wtitle-el">Ecuaciones y Desigualdades</div>
    <div class="wcourse" id="wcourse-el">Matemáticas Básicas</div>
    <label class="flabel" for="sName" id="lbl-name-el">Nombre completo</label>
    <input class="finput" id="sName" type="text" placeholder="Tu nombre completo" autocomplete="name" oninput="checkForSavedSession()">
    <label class="flabel" for="sGroup" id="lbl-group-el">Grupo</label>
    <input class="finput" id="sGroup" type="text" placeholder="ej. 3A" autocomplete="off" oninput="checkForSavedSession()">
    <button class="sbtn" id="startBtn" onclick="startLesson()">Comenzar</button>
    <div class="serr" id="startErr"></div>
    <div id="restoreBar" style="background:var(--green-bg); color:var(--green-dark);">
      <strong id="restoreTitle">Sesión guardada encontrada</strong><br>
      <span id="restoreMsg">¿Deseas continuar donde la dejaste?</span>
      <div class="rbar-btns">
        <button class="rbtn rbtn-yes" id="restoreBtn" onclick="restoreSession()">Retomar sesión</button>
        <button class="rbtn rbtn-no"  id="dismissBtn" onclick="dismissRestore()">Empezar de nuevo</button>
      </div>
    </div>
    <div class="wfoot" style="display:flex;justify-content:center;align-items:center;padding-top:.9rem">
      <svg width="160" height="52" viewBox="0 0 180 52" xmlns="http://www.w3.org/2000/svg">
        <style>
          .lbt { font-family:'Crimson Pro',serif; font-weight:700; letter-spacing:.1em; fill:var(--green); font-size:28px; }
          .lbl { stroke:var(--gold); stroke-width:2.5; }
          .lba { fill:var(--gold); }
        </style>
        <polyline points="5,40 14,28 24,33 36,14" fill="none" stroke="var(--green)" stroke-width="3"/>
        <circle cx="36" cy="14" r="4.5" class="lba"/>
        <line x1="52" y1="6" x2="52" y2="46" class="lbl"/>
        <text x="64" y="38" class="lbt">LIAXA</text>
      </svg>
    </div>
  </div>
</div>

<!-- ════════════════════ LESSON ════════════════════ -->
<div id="lessonScreen">
  <div class="stickybar">
    <div class="hlogos">
      <img id="hlogo-left"  src="" alt="Facultad de Economía" style="display:none">
      <img id="hlogo-right" src="" alt="Universidad de Colima" style="display:none">
    </div>
    <div class="hsep"></div>
    <div class="htitle" id="htitle-el">Ecuaciones y Desigualdades</div>
    <div class="hsep"></div>
    <div class="halexis">
      <svg width="120" height="30" viewBox="0 0 100 34" xmlns="http://www.w3.org/2000/svg">
        <style>
          .lht { font-family:'Crimson Pro',serif; font-weight:700; letter-spacing:.08em; fill:var(--green); font-size:16px; }
          .lhl { stroke:var(--gold); stroke-width:2; }
          .lha { fill:var(--gold); }
        </style>
        <polyline points="4,24 10,18 16,20 22,10" fill="none" stroke="var(--green)" stroke-width="2"/>
        <circle cx="22" cy="10" r="2.5" class="lha"/>
        <line x1="32" y1="6" x2="32" y2="28" class="lhl"/>
        <text x="42" y="22" class="lht">LIAXA</text>
      </svg>
    </div>
    <div class="hchip" id="studentChip"></div>
    <div class="lang-toggle">
      <button class="lang-btn active" id="btn-es" onclick="setLang('es')">ES</button>
      <button class="lang-btn"        id="btn-en" onclick="setLang('en')">EN</button>
    </div>
    <button class="tbtn" onclick="toggleTheme()" id="themeBtn">🌙</button>
  </div>
  <div class="progbar"><div class="progfill" id="progFill"></div></div>
  <div class="lbody" id="lessonBody"></div>

  <div class="section" id="s_results" style="display:none;">
    <div class="sbody" style="text-align:center;padding:2rem 1rem;">
      <button class="dlbtn" id="dlBtn" onclick="generatePDF()">Descargar resultados en PDF</button>
    </div>
  </div>
</div>

<script>
/* ════════════════════════════════════════════════════════════════════════
   SCHOOL CONFIG · edit ONLY this block to rebrand for a different school
   ════════════════════════════════════════════════════════════════════════ */
var SCHOOL = {
  primary:      '#4a7c3f',
  primaryDark:  '#2d5a27',
  primaryBg:    '#eaf0e7',
  accent:       '#c9a84c',
  accentBg:     '#faf3e0',
  pBR: 74,  pBG: 124, pBB: 63,
  pAR: 201, pAG: 168, pAB: 76,
  darkPrimary:     '#6aaa5f',
  darkPrimaryDark: '#8ecf82',
  darkPrimaryBg:   '#1a281a',
  darkAccent:      '#d4b86a',
  darkAccentBg:    '#241e0e',
  logoLeftB64:  'data:image/jpeg;base64,',
  logoRightB64: 'data:image/jpeg;base64,',
  logoLeftAlt:  'Facultad de Economía',
  logoRightAlt: 'Universidad de Colima',
  guideTitle:  { 'es': 'Ecuaciones y Desigualdades', 'en': 'Equations and Inequalities' },
  courseName:  { 'es': 'Matemáticas Básicas', 'en': 'Basic Math' },
  institution: { 'es': 'Facultad de Economía, Universidad de Colima', 'en': 'School of Economics, Universidad de Colima' },
  filePrefix:  'mat_ecuaciones',
  baseUrl:     'https://liaxa.mx/facultad_economia/matematicas_basicas/'
};
/* ════════════════════════════════════════════════════════════════════════ */

(function applyBranding() {
  var r = document.documentElement.style;
  r.setProperty('--green',      SCHOOL.primary);
  r.setProperty('--green-dark', SCHOOL.primaryDark);
  r.setProperty('--green-bg',   SCHOOL.primaryBg);
  r.setProperty('--gold',       SCHOOL.accent);
  r.setProperty('--gold-bg',    SCHOOL.accentBg);
})();

/* ════════════════════════════════════════════════════════════════════════
   BILINGUAL UI STRINGS
   ════════════════════════════════════════════════════════════════════════ */
var TX = {
  'es': {
    'lbl-name': 'Nombre completo', 'lbl-group': 'Grupo',
    'ph-name': 'Tu nombre completo', 'ph-group': 'ej. 3A',
    'btn-start': 'Comenzar', 'err-fields': 'Por favor llena ambos campos.',
    'btn-pdf': 'Descargar resultados en PDF', 'pdf-busy': 'Generando PDF...',
    'restore-title': 'Sesión guardada encontrada',
    'restore-msg': '¿Deseas continuar donde la dejaste?',
    'btn-restore': 'Retomar sesión', 'btn-dismiss': 'Empezar de nuevo',
    'lbl-answer': 'Selecciona tu respuesta:',
    'btn-hint': 'Mostrar pista',
    'tab-draw': 'Dibujar', 'tab-type': 'Teclear', 'tab-photo': 'Imagen',
    'tool-pen': 'Lápiz', 'tool-mark': 'Marcador', 'tool-erase': 'Borrador', 'tool-clear': 'Limpiar',
    'ph-work': 'Muestra tu procedimiento aquí...', 'ph-photo': 'Toca para elegir imagen o tomar foto',
    'alt-work': 'trabajo del alumno',
    'fb-correct': 'Correcto.', 'fb-wrong': 'Incorrecto.',
    'pdf-student': 'ALUMNO', 'pdf-group': 'GRUPO',
    'pdf-score': 'correcta(s) de', 'pdf-questions': 'preguntas',
    'pdf-summary': 'RESUMEN DE REACTIVOS', 'pdf-summary2': 'RESUMEN DE REACTIVOS (continuación)',
    'pdf-item': 'Reactivo', 'pdf-of': 'de', 'pdf-ok': 'Correcto', 'pdf-bad': 'Incorrecto',
    'pdf-question': 'PREGUNTA', 'pdf-work': 'TRABAJO DEL ALUMNO',
    'pdf-yours': 'Alumno: ', 'pdf-key': 'Correcto: ', 'pdf-sol': 'Solución: ',
    'pdf-code': 'Código: ', 'pdf-page': 'Página '
  },
  'en': {
    'lbl-name': 'Full name', 'lbl-group': 'Group',
    'ph-name': 'Your full name', 'ph-group': 'e.g. 3A',
    'btn-start': 'Start', 'err-fields': 'Please fill in both fields.',
    'btn-pdf': 'Download results as PDF', 'pdf-busy': 'Generating PDF...',
    'restore-title': 'Saved session found',
    'restore-msg': 'Do you want to continue where you left off?',
    'btn-restore': 'Resume session', 'btn-dismiss': 'Start over',
    'lbl-answer': 'Select your answer:',
    'btn-hint': 'Show hint',
    'tab-draw': 'Draw', 'tab-type': 'Type', 'tab-photo': 'Photo',
    'tool-pen': 'Pen', 'tool-mark': 'Marker', 'tool-erase': 'Eraser', 'tool-clear': 'Clear',
    'ph-work': 'Show your steps here...', 'ph-photo': 'Tap to choose an image or take a photo',
    'alt-work': 'student work',
    'fb-correct': 'Correct.', 'fb-wrong': 'Incorrect.',
    'pdf-student': 'STUDENT', 'pdf-group': 'GROUP',
    'pdf-score': 'correct out of', 'pdf-questions': 'questions',
    'pdf-summary': 'ITEM SUMMARY', 'pdf-summary2': 'ITEM SUMMARY (continued)',
    'pdf-item': 'Item', 'pdf-of': 'of', 'pdf-ok': 'Correct', 'pdf-bad': 'Incorrect',
    'pdf-question': 'QUESTION', 'pdf-work': 'STUDENT WORK',
    'pdf-yours': 'Student: ', 'pdf-key': 'Correct: ', 'pdf-sol': 'Solution: ',
    'pdf-code': 'Code: ', 'pdf-page': 'Page '
  }
};
var LANG = 'es';
var LANG_KEY = 'fac_econ_mat__mat_ecuaciones__lang';
function t(k) { return (TX[LANG] && TX[LANG][k]) || TX.es[k] || k; }

/* ════════════════════════════════════════════════════════════════════════
   STATE
   ════════════════════════════════════════════════════════════════════════ */
var studentData   = {};
var problems      = [];
var sectionDefs   = [];
var widgets       = [];
var answeredCount = 0;
var correctCount  = 0;

/* ════════════════════════════════════════════════════════════════════════
   THEME
   ════════════════════════════════════════════════════════════════════════ */
var THEME_KEY = 'fac_econ_mat__mat_ecuaciones__theme';
function applyThemeVars(mode) {
  var r = document.documentElement.style;
  if (mode === 'dark') {
    r.setProperty('--green',      SCHOOL.darkPrimary);
    r.setProperty('--green-dark', SCHOOL.darkPrimaryDark);
    r.setProperty('--green-bg',   SCHOOL.darkPrimaryBg);
    r.setProperty('--gold',       SCHOOL.darkAccent);
    r.setProperty('--gold-bg',    SCHOOL.darkAccentBg);
  } else {
    r.setProperty('--green',      SCHOOL.primary);
    r.setProperty('--green-dark', SCHOOL.primaryDark);
    r.setProperty('--green-bg',   SCHOOL.primaryBg);
    r.setProperty('--gold',       SCHOOL.accent);
    r.setProperty('--gold-bg',    SCHOOL.accentBg);
  }
}
function toggleTheme() {
  var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  applyThemeVars(next);
  document.getElementById('themeBtn').textContent = next === 'dark' ? '☀️' : '🌙';
  try { localStorage.setItem(THEME_KEY, next); } catch(e) {}
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
}
(function() {
  document.documentElement.setAttribute('data-theme', 'light');
  applyThemeVars('light');
  try {
    var th = localStorage.getItem(THEME_KEY);
    if (th === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      applyThemeVars('dark');
      document.addEventListener('DOMContentLoaded', function() {
        var b = document.getElementById('themeBtn');
        if (b) b.textContent = '☀️';
      });
    }
  } catch(e) {}
})();

/* ════════════════════════════════════════════════════════════════════════
   ATTEMPT COUNTER + SEEDED RNG
   Fresh numbers on every fresh start; a restored session reuses the seed.
   ════════════════════════════════════════════════════════════════════════ */
function getAttemptKey(name, group) {
  return 'fac_econ_mat__mat_ecuaciones__att__' + (name + '__' + group).replace(/\s+/g, '_');
}
function nextAttempt(name, group) {
  var k = getAttemptKey(name, group), n = 0;
  try { n = parseInt(localStorage.getItem(k) || '0', 10) || 0; } catch(e) {}
  n++;
  try { localStorage.setItem(k, String(n)); } catch(e) {}
  return n;
}
function currentAttempt(name, group) {
  var k = getAttemptKey(name, group);
  try { return parseInt(localStorage.getItem(k) || '1', 10) || 1; } catch(e) { return 1; }
}
function seededRng(seed) {
  var s = 0;
  for (var i = 0; i < seed.length; i++) s = (Math.imul(31, s) + seed.charCodeAt(i)) | 0;
  return function() {
    s = (s + 0x9e3779b9) | 0;
    var t2 = s ^ (s >>> 16);
    t2 = Math.imul(t2, 0x21f0aaad);
    t2 ^= (t2 >>> 15);
    t2 = Math.imul(t2, 0x735a2d97);
    return ((t2 ^ (t2 >>> 15)) >>> 0) / 4294967296;
  };
}
function pick(arr, rng) { return arr[Math.floor(rng() * arr.length)]; }
function shuffle(arr, rng) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(rng() * (i + 1));
    var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
  }
  return a;
}
/* Shuffles the four options once and keeps both language versions aligned.
   The key is always the value handed in first. */
function shuffleOpts(rawEs, rawEn, rng) {
  var p = shuffle([0, 1, 2, 3], rng);
  return {
    es: p.map(function(j) { return rawEs[j]; }),
    en: p.map(function(j) { return rawEn[j]; }),
    correctIdx: p.indexOf(0)
  };
}

/* ════════════════════════════════════════════════════════════════════════
   NUMBER AND EXPRESSION HELPERS
   ════════════════════════════════════════════════════════════════════════ */
function nf(x) {
  var neg = x < 0, v = Math.abs(x);
  var s = (Math.round(v * 100) / 100).toString().split('.');
  s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return (neg ? '−' : '') + s.join('.');
}
function nfD(x, d) {
  var neg = x < 0, v = Math.abs(x);
  var s = v.toFixed(d).split('.');
  s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return (neg ? '−' : '') + s.join('.');
}
function money(v)  { return '$' + nf(Math.round(v)); }
function money2(v) { return '$' + nfD(v, 2); }
function intN(x)   { return nf(Math.round(x)); }
function frac(a, b) {
  return '<span class="mf-outer"><span class="mf-num">' + a + '</span><span class="mf-den">' + b + '</span></span>';
}
/* Writes a term with its sign, so a negative term is always a subtraction. */
function term(coef, varName) {
  if (coef === 0) return '';
  var sign = coef > 0 ? ' + ' : ' − ';
  var abs  = Math.abs(coef);
  return sign + ((abs === 1 && varName) ? '' : intN(abs)) + (varName || '');
}
function pctW(x) { return Math.max(0, Math.min(100, x)) + '%'; }

/* ════════════════════════════════════════════════════════════════════════
   SESSION PERSISTENCE
   ════════════════════════════════════════════════════════════════════════ */
function lsKey() {
  var n = (studentData.name || '').trim(), g = (studentData.group || '').trim();
  return 'fac_econ_mat__mat_ecuaciones__' + (n + '__' + g).replace(/\s+/g, '_');
}
function saveSession() {
  if (!studentData.name) return;
  var drawings = [], texts = [], photos = [];
  problems.forEach(function(p, i) {
    var dc = document.getElementById('dc' + i);
    if (dc && dc.width) {
      var blank = document.createElement('canvas');
      blank.width = dc.width; blank.height = dc.height;
      drawings.push(dc.toDataURL() === blank.toDataURL() ? null : dc.toDataURL('image/png'));
    } else { drawings.push(null); }
    var ta = document.getElementById('ta' + i);
    texts.push(ta ? ta.value : '');
    var pp = document.getElementById('pp' + i);
    photos.push((pp && pp.src && pp.src.indexOf('data:') === 0) ? pp.src : null);
  });
  var state = {
    name: studentData.name, group: studentData.group,
    answeredCount: answeredCount, correctCount: correctCount,
    choices: problems.map(function(p) { return p.studentChoice; }),
    drawings: drawings, texts: texts, photos: photos
  };
  try { localStorage.setItem(lsKey(), JSON.stringify(state)); } catch(e) {}
}
function loadSession(name, group) {
  var key = 'fac_econ_mat__mat_ecuaciones__' + (name + '__' + group).replace(/\s+/g, '_');
  try { var r = localStorage.getItem(key); return r ? JSON.parse(r) : null; } catch(e) { return null; }
}
function dismissRestore() { document.getElementById('restoreBar').style.display = 'none'; }
function checkForSavedSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  if (!name || !group) { document.getElementById('restoreBar').style.display = 'none'; return; }
  var saved = loadSession(name, group);
  var bar = document.getElementById('restoreBar');
  bar.style.display = (saved && saved.choices && saved.choices.some(function(c) { return c !== null; })) ? 'block' : 'none';
}
function observeSections() {
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('vis'); });
  }, { threshold: 0.05 });
  document.querySelectorAll('.section').forEach(function(s) { obs.observe(s); });
}

/* ════════════════════════════════════════════════════════════════════════
   START / RESTORE
   ════════════════════════════════════════════════════════════════════════ */
function startLesson() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var err   = document.getElementById('startErr');
  if (!name || !group) { err.textContent = t('err-fields'); return; }
  err.textContent = '';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = nextAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
}
function restoreSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var saved = loadSession(name, group);
  if (!saved) return;
  document.getElementById('restoreBar').style.display = 'none';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = currentAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
  saved.choices.forEach(function(choice, idx) {
    if (choice !== null && choice !== undefined) confirmMC(idx, choice);
  });
  setTimeout(function() {
    if (saved.drawings) saved.drawings.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var dc = document.getElementById('dc' + i);
      if (!dc || !dc.width) return;
      var img = new Image();
      img.onload = function() {
        var dpr = window.devicePixelRatio || 1;
        dc.getContext('2d').drawImage(img, 0, 0, dc.width / dpr, dc.height / dpr);
      };
      img.src = dataUrl;
    });
    if (saved.texts) saved.texts.forEach(function(txt, i) {
      if (!txt) return;
      var ta = document.getElementById('ta' + i);
      if (ta) ta.value = txt;
    });
    if (saved.photos) saved.photos.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var pp = document.getElementById('pp' + i);
      if (!pp) return;
      pp.src = dataUrl; pp.style.display = 'block';
      var pz = document.getElementById('pz' + i);
      if (pz) pz.style.opacity = '0.4';
    });
  }, 300);
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS / TABS / PHOTO / HINT / RESULTS
   ════════════════════════════════════════════════════════════════════════ */
function initCanvas(canvas) {
  var dpr  = window.devicePixelRatio || 1;
  var rect = canvas.getBoundingClientRect();
  canvas.width  = rect.width  * dpr;
  canvas.height = rect.height * dpr;
  var ctx = canvas.getContext('2d');
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.scale(dpr, dpr);
  ctx.strokeStyle = '#2d5a27';
  ctx.lineWidth   = 2;
  ctx.lineCap     = 'round';
  ctx.lineJoin    = 'round';
  var drawing = false, lx = 0, ly = 0;
  var tb = canvas.closest('.cvwrap').querySelector('.ctoolbar');
  function getPos(e) {
    var r = canvas.getBoundingClientRect();
    var src = e.touches ? e.touches[0] : e;
    return [src.clientX - r.left, src.clientY - r.top];
  }
  function onDown(e) { e.preventDefault(); drawing = true; var p = getPos(e); lx = p[0]; ly = p[1]; }
  function onMove(e) { e.preventDefault(); if (!drawing) return; var p = getPos(e); ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p[0], p[1]); ctx.stroke(); lx = p[0]; ly = p[1]; }
  function onUp() { drawing = false; saveSession(); }
  canvas.addEventListener('mousedown',  onDown, { passive:false });
  canvas.addEventListener('mousemove',  onMove, { passive:false });
  canvas.addEventListener('mouseup',    onUp);
  canvas.addEventListener('mouseleave', onUp);
  canvas.addEventListener('touchstart', onDown, { passive:false });
  canvas.addEventListener('touchmove',  onMove, { passive:false });
  canvas.addEventListener('touchend',   onUp);
  tb.querySelectorAll('.tbtn2').forEach(function(btn) {
    btn.addEventListener('click', function() {
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      if (btn.classList.contains('bpen'))    { ctx.lineWidth = 2; }
      if (btn.classList.contains('bmarker')) { ctx.lineWidth = 10; ctx.globalAlpha = 0.45; }
      if (btn.classList.contains('beraser')) { ctx.globalCompositeOperation = 'destination-out'; ctx.lineWidth = 20; }
    });
  });
  tb.querySelectorAll('.cdot').forEach(function(dot) {
    dot.addEventListener('click', function() {
      tb.querySelectorAll('.cdot').forEach(function(d) { d.classList.remove('sel'); });
      dot.classList.add('sel');
      ctx.strokeStyle = dot.dataset.color;
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      tb.querySelector('.bpen').classList.add('on');
    });
  });
  tb.querySelector('.clrbtn').addEventListener('click', function() {
    ctx.clearRect(0, 0, canvas.width / dpr, canvas.height / dpr);
  });
}
function switchTab(idx, panel, btn) {
  var prefix = 'wp_' + idx + '_';
  document.querySelectorAll('[id^="' + prefix + '"]').forEach(function(p) { p.classList.remove('active'); });
  document.getElementById(prefix + panel).classList.add('active');
  btn.closest('.wtabs').querySelectorAll('.wtab').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
}
function handlePhoto(idx, input) {
  if (!input.files || !input.files[0]) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var img = document.getElementById('pp' + idx);
    img.src = e.target.result;
    img.style.display = 'block';
    document.getElementById('pz' + idx).style.opacity = '0.4';
    saveSession();
  };
  reader.readAsDataURL(input.files[0]);
}
function toggleHint(idx) { document.getElementById('hint' + idx).classList.toggle('show'); }
function showResults() {
  var rb = document.getElementById('s_results');
  if (!rb) return;
  rb.style.display = 'block';
  setTimeout(function() {
    rb.classList.add('vis');
    rb.scrollIntoView({ behavior:'smooth', block:'center' });
  }, 50);
}

/* ════════════════════════════════════════════════════════════════════════
   ANSWER HANDLER · two taps to confirm
   ════════════════════════════════════════════════════════════════════════ */
function handleMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  if (prob.pendingChoice === chosenIdx) {
    prob.studentChoice = chosenIdx;
    prob.pendingChoice = null;
    var isOk = (chosenIdx === prob.correctIdx);
    opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
    opts.forEach(function(o, i) {
      if (i === prob.correctIdx) o.classList.add('rc');
      if (i === chosenIdx && isOk)  o.classList.add('sc');
      if (i === chosenIdx && !isOk) o.classList.add('sw');
    });
    var fb = document.getElementById('fb' + probIdx);
    fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.exp;
    fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
    document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
    if (isOk) correctCount++;
    answeredCount++;
    document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
    saveSession();
    if (answeredCount === problems.length) setTimeout(showResults, 700);
    return;
  }
  prob.pendingChoice = chosenIdx;
  opts.forEach(function(o) { o.classList.remove('pending'); });
  opts[chosenIdx].classList.add('pending');
}
function confirmMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (!prob || prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  prob.studentChoice = chosenIdx;
  prob.pendingChoice = null;
  var isOk = (chosenIdx === prob.correctIdx);
  opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
  opts.forEach(function(o, i) {
    if (i === prob.correctIdx) o.classList.add('rc');
    if (i === chosenIdx && isOk)  o.classList.add('sc');
    if (i === chosenIdx && !isOk) o.classList.add('sw');
  });
  var fb = document.getElementById('fb' + probIdx);
  fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.exp;
  fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
  document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
  if (isOk) correctCount++;
  answeredCount++;
  document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
  saveSession();
  if (answeredCount === problems.length) setTimeout(showResults, 700);
}

/* ════════════════════════════════════════════════════════════════════════
   BUILD ONE CARD · appended inline, right after its concept
   The statement ends with a question and never prints the operation that
   answers it. Procedural scaffolding lives in the hint only.
   ════════════════════════════════════════════════════════════════════════ */
function buildOneCard(prob, i) {
  var opts = prob.opts.map(function(opt, oi) {
    return '<div class="mcopt" onclick="handleMC(' + i + ',' + oi + ')">' + opt + '</div>';
  }).join('');
  var work = '';
  if (prob.showWork) {
    work =
      '<div style="margin-bottom:.85rem">' +
        '<div class="wtabs">' +
          '<button class="wtab active" onclick="switchTab(' + i + ',\'draw\',this)">' + t('tab-draw') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'type\',this)">' + t('tab-type') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'photo\',this)">' + t('tab-photo') + '</button>' +
        '</div>' +
        '<div class="wpanel active" id="wp_' + i + '_draw">' +
          '<div class="cvwrap">' +
            '<canvas class="dcanvas" id="dc' + i + '"></canvas>' +
            '<div class="ctoolbar">' +
              '<button class="tbtn2 bpen on">' + t('tool-pen') + '</button>' +
              '<button class="tbtn2 bmarker">' + t('tool-mark') + '</button>' +
              '<button class="tbtn2 beraser">' + t('tool-erase') + '</button>' +
              '<div class="cdot sel" data-color="#2d5a27" style="background:#2d5a27"></div>' +
              '<div class="cdot"     data-color="#1a1a16" style="background:#1a1a16"></div>' +
              '<div class="cdot"     data-color="#8b2500" style="background:#8b2500"></div>' +
              '<div class="cdot"     data-color="#1d4e89" style="background:#1d4e89"></div>' +
              '<button class="clrbtn">' + t('tool-clear') + '</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_type">' +
          '<textarea class="wtextarea" id="ta' + i + '" placeholder="' + t('ph-work') + '" oninput="saveSession()"></textarea>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_photo">' +
          '<div class="pzone" id="pz' + i + '">' +
            '<input type="file" accept="image/*" onchange="handlePhoto(' + i + ',this)">' +
            '<div class="pzicon">📸</div>' +
            '<div class="pztxt">' + t('ph-photo') + '</div>' +
          '</div>' +
          '<img class="ppreview" id="pp' + i + '" alt="' + t('alt-work') + '">' +
        '</div>' +
      '</div>';
  }
  var card = document.createElement('div');
  card.className = 'pcrd section';
  card.id = 'pc' + i;
  card.innerHTML =
    '<div class="phdr"><div class="pnum">' + (i + 1) + '</div><div class="ptitle">' + prob.title + '</div></div>' +
    '<div class="pbody">' +
      '<div class="pstmt">' + prob.q + '</div>' +
      work +
      '<button class="hintbtn" onclick="toggleHint(' + i + ')">' + t('btn-hint') + '</button>' +
      '<div class="hintbox" id="hint' + i + '">' + (prob.hint || '') + '</div>' +
      '<div style="margin-top:.7rem">' +
        '<div style="font-family:\'IBM Plex Mono\',monospace;font-size:.65rem;letter-spacing:.1em;color:var(--text3);text-transform:uppercase;margin-bottom:.5rem">' + t('lbl-answer') + '</div>' +
        '<div class="mcopts">' + opts + '</div>' +
        '<div class="mcfb" id="fb' + i + '"></div>' +
      '</div>' +
    '</div>';
  document.getElementById('lessonBody').appendChild(card);
  if (prob.showWork) setTimeout(function() { var c = document.getElementById('dc' + i); if (c) initCanvas(c); }, 80);
}

/* ════════════════════════════════════════════════════════════════════════
   SECTION REGISTRY  (concept text is re-rendered on language switch)
   ════════════════════════════════════════════════════════════════════════ */
function addSection(fn) {
  var d = document.createElement('div');
  d.className = 'section';
  d.innerHTML = fn(LANG);
  document.getElementById('lessonBody').appendChild(d);
  sectionDefs.push({ el: d, fn: fn });
}
function applySectionLang() {
  sectionDefs.forEach(function(s) { s.el.innerHTML = s.fn(LANG); });
}

/* ════════════════════════════════════════════════════════════════════════
   ITEM ASSEMBLY
   Each item keeps both languages in i18n. The student always reads one of
   them: q, opts, hint and exp hold the active language and are the only
   fields the cards and the PDF ever touch.
   The runtime gate dumps questionText, options and explanation for external
   review, so those three carry both versions tagged [ES] and [EN]. They are
   an audit surface, never rendered anywhere in the guide.
   ════════════════════════════════════════════════════════════════════════ */
function bothTxt(o) {
  return (o.es === o.en) ? o.es : ('[ES] ' + o.es + '\n[EN] ' + o.en);
}
function bothOpts(o) {
  return o.es.map(function(s, i) {
    return (s === o.en[i]) ? s : ('[ES] ' + s + '   [EN] ' + o.en[i]);
  });
}
function mk(i18n, correctIdx, showWork) {
  return {
    i18n: i18n, correctIdx: correctIdx, showWork: showWork,
    title: i18n.title[LANG],
    q:     i18n.q[LANG],
    hint:  i18n.hint[LANG],
    exp:   i18n.exp[LANG],
    opts:  i18n.opts[LANG].slice(),
    questionText: bothTxt(i18n.q),
    explanation:  bothTxt(i18n.exp),
    options:      bothOpts(i18n.opts)
  };
}
function addItem(i18n, correctIdx, showWork) {
  var d = mk(i18n, correctIdx, showWork);
  problems.push({
    i18n: d.i18n, title: d.title, q: d.q, hint: d.hint, exp: d.exp, opts: d.opts,
    questionText: d.questionText, options: d.options, explanation: d.explanation,
    correctIdx: d.correctIdx, showWork: d.showWork,
    studentChoice: null, pendingChoice: null
  });
  buildOneCard(problems[problems.length - 1], problems.length - 1);
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 1 · la balanza de la ecuacion
   Dos platos: lo que entra por las ventas y lo que sale por los costos.
   El alumno mueve el volumen de prueba y ve la diferencia entre los dos
   lados encogerse hasta cero. Ese cero es la solucion de la ecuacion.
   ════════════════════════════════════════════════════════════════════════ */
function widgetBalanza(p0, v0, F0, q0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { p: p0, v: v0, F: F0, q: q0 };

  function render() {
    var es  = LANG === 'es';
    var ing = state.p * state.q;
    var cos = state.F + state.v * state.q;
    var dif = ing - cos;
    var mg  = state.p - state.v;
    var sol = mg > 0 ? state.F / mg : null;
    var top = Math.max(ing, cos, 1);
    var set = function(id, html) { var e = host.querySelector(id); if (e) e.innerHTML = html; };
    set('#w1pl', money(state.p));
    set('#w1vl', money(state.v));
    set('#w1Fl', money(state.F));
    set('#w1ql', intN(state.q));
    set('#w1ing', money(ing));
    set('#w1cos', money(cos));
    var bi = host.querySelector('#w1bi'), bc = host.querySelector('#w1bc');
    if (bi) bi.style.width = pctW(ing / top * 100);
    if (bc) bc.style.width = pctW(cos / top * 100);
    set('#w1mg', money(mg));
    set('#w1dif', money(Math.abs(dif)));
    set('#w1sol', sol === null ? (es ? 'no existe' : 'none') : intN(Math.ceil(sol)));
    var vd = host.querySelector('#w1verd');
    if (vd) {
      if (dif === 0) {
        vd.className = 'verdict v-ok';
        vd.textContent = es ? 'Los dos lados valen lo mismo: este volumen resuelve la ecuación.'
                            : 'Both sides are worth the same: this volume solves the equation.';
      } else if (dif < 0) {
        vd.className = 'verdict v-bad';
        vd.textContent = es ? 'El plato de los costos pesa más: a este volumen el taller pierde dinero.'
                            : 'The cost side weighs more: at this volume the workshop loses money.';
      } else {
        vd.className = 'verdict v-ok';
        vd.textContent = es ? 'El plato de las ventas pesa más: a este volumen el taller gana dinero.'
                            : 'The sales side weighs more: at this volume the workshop makes money.';
      }
    }
    set('#w1read', mg <= 0
      ? (es
        ? '<strong>Lectura de negocio:</strong> con el precio en ' + money(state.p) + ' y el material en ' + money(state.v) + ', cada pieza vendida aporta ' + money(mg) + ' para cubrir el gasto fijo, es decir que no aporta nada. La ecuación no tiene solución con sentido: ningún volumen empata los dos lados, porque el plato de los costos crece más rápido que el de las ventas. Sube el precio por encima del costo de material y observa cómo aparece de golpe un volumen que sí resuelve la igualdad.'
        : '<strong>Business reading:</strong> with the price at ' + money(state.p) + ' and material at ' + money(state.v) + ', every piece sold contributes ' + money(mg) + ' towards the fixed expense, which is to say it contributes nothing. The equation has no meaningful solution: no volume evens out the two sides, because the cost side grows faster than the sales side. Raise the price above the material cost and watch a volume that does solve the equality appear all at once.')
      : (es
        ? '<strong>Lectura de negocio:</strong> cada pieza vendida deja ' + money(mg) + ' libres después de pagar su propio barro, y ese sobrante es lo único que puede ir cubriendo los ' + money(state.F) + ' de gasto fijo. Por eso la solución de la ecuación es ' + intN(Math.ceil(sol)) + ' piezas y no otra cosa: es el número de aportaciones que hacen falta para llenar ese hueco. Deja el volumen de prueba justo en ese valor y verás la diferencia entre los dos platos caer a cero o casi. Mueve luego el precio un solo peso hacia arriba y observa que la solución baja: subir el precio no cambia el gasto fijo, cambia la rapidez con la que se cubre.'
        : '<strong>Business reading:</strong> every piece sold leaves ' + money(mg) + ' free after paying for its own clay, and that surplus is the only thing that can cover the ' + money(state.F) + ' of fixed expense. That is why the solution of the equation is ' + intN(Math.ceil(sol)) + ' pieces and nothing else: it is the number of contributions needed to fill that hole. Leave the test volume exactly at that value and the gap between the two sides falls to zero or close to it. Then move the price up by a single peso and notice the solution drops: raising the price does not change the fixed expense, it changes how fast it is covered.'));
  }

  function mount() {
    var es = LANG === 'es';
    host.innerHTML =
      '<div class="gcrd" data-widget="balanza-de-la-ecuacion">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'La balanza: dos lados que deben pesar lo mismo' : 'The balance: two sides that must weigh the same') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Cerámica Suchitlán vende piezas de barro y quiere saber cuántas necesita colocar en el mes para que el dinero que entra iguale exactamente al que sale. La barra verde es lo que entra por las ventas y la dorada lo que sale por los costos. Mueve el volumen de prueba hasta que las dos barras queden parejas: ese valor es la solución de la ecuación. Después cambia el precio o el gasto fijo y busca de nuevo el equilibrio, prestando atención a en qué dirección se mueve la solución cada vez.'
          : 'Cerámica Suchitlán sells clay pieces and wants to know how many it needs to place in the month for the money coming in to match exactly the money going out. The green bar is what comes in from sales and the golden one is what goes out in costs. Move the test volume until the two bars are level: that value is the solution of the equation. Then change the price or the fixed expense and look for the balance again, paying attention to which way the solution moves each time.') + '</div>' +
        '<div class="sidebar-row">' +
          '<div class="sidebar-lbl"><span>' + (es ? 'Entra por ventas' : 'In from sales') + '</span><span id="w1ing"></span></div>' +
          '<div class="sidebar-track"><span class="sidebar-fill fill-in" id="w1bi"></span></div>' +
        '</div>' +
        '<div class="sidebar-row">' +
          '<div class="sidebar-lbl"><span>' + (es ? 'Sale por costos' : 'Out in costs') + '</span><span id="w1cos"></span></div>' +
          '<div class="sidebar-track"><span class="sidebar-fill fill-out" id="w1bc"></span></div>' +
        '</div>' +
        '<div class="verdict" id="w1verd"></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Volumen de prueba, piezas del mes' : 'Test volume, pieces in the month') + ': <span class="cval" id="w1ql"></span></label>' +
          '<input type="range" min="0" max="700" step="5" id="w1q" value="' + state.q + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Precio de venta por pieza' : 'Selling price per piece') + ': <span class="cval" id="w1pl"></span></label>' +
          '<input type="range" min="100" max="260" step="2" id="w1p" value="' + state.p + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Costo de material por pieza' : 'Material cost per piece') + ': <span class="cval" id="w1vl"></span></label>' +
          '<input type="range" min="60" max="140" step="1" id="w1v" value="' + state.v + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Gasto fijo del mes' : 'Fixed expense of the month') + ': <span class="cval" id="w1Fl"></span></label>' +
          '<input type="range" min="9000" max="36000" step="500" id="w1F" value="' + state.F + '">' +
        '</div></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Aporte de cada pieza' : 'Contribution of each piece') + '</div><div class="mnum cs" id="w1mg"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Distancia entre los dos lados' : 'Gap between the two sides') + '</div><div class="mnum ps" id="w1dif"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Solución de la ecuación' : 'Solution of the equation') + '</div><div class="mnum ts" id="w1sol"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="w1read"></div>' +
      '</div>';
    var q = host.querySelector('#w1q'), p = host.querySelector('#w1p');
    var v = host.querySelector('#w1v'), F = host.querySelector('#w1F');
    q.addEventListener('input', function() { state.q = parseInt(q.value, 10); render(); });
    p.addEventListener('input', function() { state.p = parseInt(p.value, 10); render(); });
    v.addEventListener('input', function() { state.v = parseInt(v.value, 10); render(); });
    F.addEventListener('input', function() { state.F = parseInt(F.value, 10); render(); });
    render();
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 2 · el volumen en el que dos opciones cuestan lo mismo
   Taller propio contra maquila. Las dos rectas de costo se cruzan en un
   solo punto y ese punto es la solucion de una ecuacion con la incognita
   en los dos lados. El alumno lo persigue moviendo tarifas y cuotas.
   ════════════════════════════════════════════════════════════════════════ */
function widgetComparador(FA0, a0, FB0, b0, q0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { FA: FA0, a: a0, FB: FB0, b: b0, q: q0 };

  function render() {
    var es = LANG === 'es';
    var ca = state.FA + state.a * state.q;
    var cb = state.FB + state.b * state.q;
    var d  = state.b - state.a;
    var dF = state.FA - state.FB;
    var cruce = (d > 0 && dF > 0) ? dF / d : null;
    var top = Math.max(ca, cb, 1);
    var set = function(id, html) { var e = host.querySelector(id); if (e) e.innerHTML = html; };
    set('#w2FAl', money(state.FA));
    set('#w2al', money(state.a));
    set('#w2bl', money(state.b));
    set('#w2ql', intN(state.q));
    set('#w2ca', money(ca));
    set('#w2cb', money(cb));
    var ba = host.querySelector('#w2ba'), bb = host.querySelector('#w2bb');
    if (ba) ba.style.width = pctW(ca / top * 100);
    if (bb) bb.style.width = pctW(cb / top * 100);
    set('#w2dif', money(Math.abs(ca - cb)));
    set('#w2d', money(d));
    set('#w2cruce', cruce === null ? (es ? 'no hay' : 'none') : intN(Math.round(cruce)));
    set('#w2eq',
      '<span class="ec">' + intN(state.FA) + '</span> + ' + intN(state.a) + 'q' +
      '  <span style="color:var(--text3)">' + (es ? 'contra' : 'against') + '</span>  ' +
      '<span class="ev">' + intN(state.FB) + '</span> + ' + intN(state.b) + 'q');
    var vd = host.querySelector('#w2verd');
    if (vd) {
      if (ca === cb) {
        vd.className = 'verdict v-ok';
        vd.textContent = es ? 'A este volumen las dos opciones cuestan exactamente lo mismo.'
                            : 'At this volume the two options cost exactly the same.';
      } else if (ca < cb) {
        vd.className = 'verdict v-ok';
        vd.textContent = es ? 'A este volumen conviene el taller propio.'
                            : 'At this volume the workshop of their own is the better buy.';
      } else {
        vd.className = 'verdict v-bad';
        vd.textContent = es ? 'A este volumen conviene el maquilador.'
                            : 'At this volume the contract workshop is the better buy.';
      }
    }
    set('#w2read', cruce === null
      ? (es
        ? '<strong>Lectura de negocio:</strong> con estas tarifas una de las dos opciones gana en todos los volúmenes y no hay nada que decidir. Eso ocurre cuando la opción de cuota fija más alta también cobra más por pieza, o cuando cobra menos por pieza y además menos de cuota. La ecuación existe, pero su solución cae fuera de lo que tiene sentido en el negocio. Ajusta las tarifas para que la opción cara de instalar sea la barata de operar y el cruce reaparecerá.'
        : '<strong>Business reading:</strong> with these rates one of the two options wins at every volume and there is nothing to decide. That happens when the option with the higher fixed fee also charges more per piece, or when it charges less per piece and less in fees as well. The equation exists, but its solution falls outside what makes sense in the business. Adjust the rates so that the option that is expensive to set up is the cheap one to run, and the crossing point will come back.')
      : (es
        ? '<strong>Lectura de negocio:</strong> el taller propio pide ' + money(dF) + ' más de gasto fijo al mes, pero ahorra ' + money(d) + ' en cada pieza. La pregunta del dueño no es cuál opción es más barata, sino a partir de cuántas piezas ese ahorro por pieza alcanza a pagar el gasto fijo extra. La respuesta es ' + intN(Math.round(cruce)) + ' piezas, y es la solución de una ecuación con la incógnita en los dos lados: por debajo de ese volumen conviene maquilar, por encima conviene producir en casa. Mueve la tarifa del maquilador y observa que el punto de cruce se recorre sin que cambie ninguna de las dos cuotas fijas.'
        : '<strong>Business reading:</strong> the workshop of their own asks for ' + money(dF) + ' more in fixed expense every month, but saves ' + money(d) + ' on every piece. The question the owner faces is not which option is cheaper, but from how many pieces onwards that saving per piece manages to pay the extra fixed expense. The answer is ' + intN(Math.round(cruce)) + ' pieces, and it is the solution of an equation with the unknown on both sides: below that volume contracting out wins, above it producing at home wins. Move the contract rate and notice the crossing point travels without either fixed fee changing.'));
  }

  function mount() {
    var es = LANG === 'es';
    host.innerHTML =
      '<div class="gcrd" data-widget="comparador-de-dos-opciones">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Dos opciones, un solo volumen donde empatan' : 'Two options, a single volume where they tie') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'El taller puede hornear en casa, con más gasto fijo y menos costo por pieza, o mandar a maquilar, con poca cuota fija y más costo por pieza. Mueve el volumen del mes y observa cuál de las dos barras es más corta. Hay un punto exacto en el que las dos miden lo mismo: búscalo primero a ojo con la barra y después compáralo con la cifra que aparece abajo. Cambia luego el costo por pieza del maquilador y repite la búsqueda; conviene fijarse en si el cruce se recorre hacia la izquierda o hacia la derecha y en por qué tiene sentido que lo haga.'
          : 'The workshop can fire the kiln at home, with more fixed expense and less cost per piece, or send the work out, with a small fixed fee and more cost per piece. Move the volume of the month and watch which of the two bars is shorter. There is an exact point where both measure the same: find it by eye with the bars first and then compare it with the figure shown below. Then change the contract cost per piece and search again; it pays to notice whether the crossing point travels left or right and why that makes sense.') + '</div>' +
        '<div class="iw-note">' + (es ? 'Costo del taller propio contra costo del maquilador' : 'Cost of their own workshop against cost of the contract workshop') + '</div>' +
        '<div class="iw-expr" id="w2eq"></div>' +
        '<div class="sidebar-row">' +
          '<div class="sidebar-lbl"><span>' + (es ? 'Taller propio' : 'Their own workshop') + '</span><span id="w2ca"></span></div>' +
          '<div class="sidebar-track"><span class="sidebar-fill fill-in" id="w2ba"></span></div>' +
        '</div>' +
        '<div class="sidebar-row">' +
          '<div class="sidebar-lbl"><span>' + (es ? 'Maquilador' : 'Contract workshop') + '</span><span id="w2cb"></span></div>' +
          '<div class="sidebar-track"><span class="sidebar-fill fill-out" id="w2bb"></span></div>' +
        '</div>' +
        '<div class="verdict" id="w2verd"></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Piezas del mes' : 'Pieces in the month') + ': <span class="cval" id="w2ql"></span></label>' +
          '<input type="range" min="0" max="600" step="10" id="w2q" value="' + state.q + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Gasto fijo del taller propio' : 'Fixed expense of their own workshop') + ': <span class="cval" id="w2FAl"></span></label>' +
          '<input type="range" min="10000" max="30000" step="500" id="w2FA" value="' + state.FA + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Costo por pieza en casa' : 'Cost per piece at home') + ': <span class="cval" id="w2al"></span></label>' +
          '<input type="range" min="50" max="130" step="1" id="w2a" value="' + state.a + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Costo por pieza con el maquilador' : 'Cost per piece with the contract workshop') + ': <span class="cval" id="w2bl"></span></label>' +
          '<input type="range" min="60" max="170" step="1" id="w2b" value="' + state.b + '">' +
        '</div></div>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Ahorro por pieza en casa' : 'Saving per piece at home') + '</div><div class="mnum cs" id="w2d"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Diferencia a este volumen' : 'Gap at this volume') + '</div><div class="mnum ps" id="w2dif"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Volumen donde empatan' : 'Volume where they tie') + '</div><div class="mnum ts" id="w2cruce"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="w2read"></div>' +
      '</div>';
    var q  = host.querySelector('#w2q'),  FA = host.querySelector('#w2FA');
    var a  = host.querySelector('#w2a'),  b  = host.querySelector('#w2b');
    q.addEventListener('input',  function() { state.q  = parseInt(q.value, 10);  render(); });
    FA.addEventListener('input', function() { state.FA = parseInt(FA.value, 10); render(); });
    a.addEventListener('input',  function() { state.a  = parseInt(a.value, 10);  render(); });
    b.addEventListener('input',  function() { state.b  = parseInt(b.value, 10);  render(); });
    render();
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 3 · la recta de la desigualdad
   Dos condiciones reales del taller. En una la region admisible queda a la
   derecha del umbral y en la otra a la izquierda, y la razon no es una
   regla memorizada sino de que lado de la resta esta la incognita.
   ════════════════════════════════════════════════════════════════════════ */
function widgetRecta(m0, F0, U0, k0, M0, R0, test0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { mode: 'meta', m: m0, F: F0, U: U0, k: k0, M: M0, R: R0, test: test0 };
  var TOP = 800;

  function render() {
    var es   = LANG === 'es';
    var meta = state.mode === 'meta';
    var thr  = meta ? (state.F + state.U) / state.m : (state.M - state.R) / state.k;
    var lim  = meta ? Math.ceil(thr) : Math.floor(thr);
    if (!isFinite(lim)) lim = 0;
    if (lim < 0) lim = 0;
    var ok   = meta ? (state.test >= lim) : (state.test <= lim);
    var set  = function(id, html) { var e = host.querySelector(id); if (e) e.innerHTML = html; };
    var fill = host.querySelector('#w3fill');
    var mark = host.querySelector('#w3mark');
    var pos  = Math.max(0, Math.min(100, lim / TOP * 100));
    if (fill) {
      if (meta) { fill.style.left = pos + '%'; fill.style.width = (100 - pos) + '%'; }
      else      { fill.style.left = '0%';      fill.style.width = pos + '%'; }
    }
    if (mark) mark.style.left = Math.max(0, Math.min(100, state.test / TOP * 100)) + '%';
    set('#w3testl', intN(state.test));
    set('#w3lim', intN(lim));
    set('#w3thr', nfD(thr, 1));
    if (meta) {
      set('#w3ml', money(state.m));
      set('#w3Fl', money(state.F));
      set('#w3Ul', money(state.U));
      set('#w3res', money(state.m * state.test - state.F));
      set('#w3cond', (es ? 'Utilidad del mes con el volumen de prueba' : 'Profit of the month at the test volume'));
    } else {
      set('#w3kl', intN(state.k) + (es ? ' kg' : ' kg'));
      set('#w3Ml', intN(state.M) + (es ? ' kg' : ' kg'));
      set('#w3Rl', intN(state.R) + (es ? ' kg' : ' kg'));
      set('#w3res', intN(state.M - state.k * state.test) + (es ? ' kg' : ' kg'));
      set('#w3cond', (es ? 'Barro que quedaría con el volumen de prueba' : 'Clay left over at the test volume'));
    }
    var vd = host.querySelector('#w3verd');
    if (vd) {
      vd.className = 'verdict ' + (ok ? 'v-ok' : 'v-bad');
      if (meta) {
        vd.textContent = ok
          ? (es ? 'El volumen de prueba está dentro de la región: la meta se alcanza.'
                : 'The test volume sits inside the region: the target is reached.')
          : (es ? 'El volumen de prueba está fuera de la región: la meta no se alcanza.'
                : 'The test volume sits outside the region: the target is not reached.');
      } else {
        vd.textContent = ok
          ? (es ? 'El volumen de prueba está dentro de la región: la reserva de barro se respeta.'
                : 'The test volume sits inside the region: the clay reserve is respected.')
          : (es ? 'El volumen de prueba está fuera de la región: la reserva de barro se agota.'
                : 'The test volume sits outside the region: the clay reserve runs out.');
      }
    }
    set('#w3read', meta
      ? (es
        ? '<strong>Lectura de negocio:</strong> cada pieza aporta ' + money(state.m) + ', hay que cubrir ' + money(state.F) + ' de gasto fijo y encima llegar a ' + money(state.U) + ' de utilidad. El umbral cae en ' + nfD(thr, 1) + ' piezas, y como las piezas se cuentan enteras la respuesta del negocio es ' + intN(lim) + '. Fíjate en que la región admisible se extiende hacia la derecha: producir de más nunca incumple una meta de utilidad, por eso la desigualdad apunta hacia arriba. Aquí redondear hacia abajo sería tramposo, porque con una pieza menos la meta se queda corta.'
        : '<strong>Business reading:</strong> every piece contributes ' + money(state.m) + ', there is ' + money(state.F) + ' of fixed expense to cover and on top of that ' + money(state.U) + ' of profit to reach. The threshold falls at ' + nfD(thr, 1) + ' pieces, and since pieces are counted whole the business answer is ' + intN(lim) + '. Notice that the admissible region stretches to the right: producing more never breaks a profit target, which is why the inequality points upwards. Rounding down here would be cheating, because one piece less leaves the target short.')
      : (es
        ? '<strong>Lectura de negocio:</strong> el taller tiene ' + intN(state.M) + ' kg de barro, gasta ' + intN(state.k) + ' kg en cada pieza y quiere terminar el mes con al menos ' + intN(state.R) + ' kg guardados. Aquí la incógnita entra restando, porque cada pieza descuenta barro del almacén, y al despejarla hay que dividir entre un número negativo: ese es el momento exacto en el que el sentido de la desigualdad se voltea. El umbral cae en ' + nfD(thr, 1) + ' piezas y la respuesta del negocio es ' + intN(lim) + ', con la región admisible hacia la izquierda. Redondear hacia arriba aquí sí sería tramposo, porque esa pieza de más se come la reserva.'
        : '<strong>Business reading:</strong> the workshop holds ' + intN(state.M) + ' kg of clay, spends ' + intN(state.k) + ' kg on every piece and wants to end the month with at least ' + intN(state.R) + ' kg in store. Here the unknown comes in subtracting, because every piece takes clay out of the store, and isolating it means dividing by a negative number: that is the exact moment when the direction of the inequality flips. The threshold falls at ' + nfD(thr, 1) + ' pieces and the business answer is ' + intN(lim) + ', with the admissible region to the left. Rounding up here would be the cheat, because that extra piece eats into the reserve.'));
  }

  function mount() {
    var es   = LANG === 'es';
    var meta = state.mode === 'meta';
    var ctrl = meta
      ? '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Aporte de cada pieza' : 'Contribution of each piece') + ': <span class="cval" id="w3ml"></span></label>' +
          '<input type="range" min="30" max="130" step="1" id="w3m" value="' + state.m + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Gasto fijo del mes' : 'Fixed expense of the month') + ': <span class="cval" id="w3Fl"></span></label>' +
          '<input type="range" min="9000" max="30000" step="500" id="w3F" value="' + state.F + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Meta de utilidad del mes' : 'Profit target for the month') + ': <span class="cval" id="w3Ul"></span></label>' +
          '<input type="range" min="0" max="24000" step="500" id="w3U" value="' + state.U + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Volumen de prueba' : 'Test volume') + ': <span class="cval" id="w3testl"></span></label>' +
          '<input type="range" min="0" max="800" step="10" id="w3test" value="' + state.test + '">' +
        '</div></div>'
      : '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Barro por pieza' : 'Clay per piece') + ': <span class="cval" id="w3kl"></span></label>' +
          '<input type="range" min="2" max="12" step="1" id="w3k" value="' + state.k + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Barro en almacén' : 'Clay in store') + ': <span class="cval" id="w3Ml"></span></label>' +
          '<input type="range" min="800" max="3200" step="50" id="w3M" value="' + state.M + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Reserva que no se toca' : 'Reserve that is not touched') + ': <span class="cval" id="w3Rl"></span></label>' +
          '<input type="range" min="0" max="800" step="25" id="w3R" value="' + state.R + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Volumen de prueba' : 'Test volume') + ': <span class="cval" id="w3testl"></span></label>' +
          '<input type="range" min="0" max="800" step="10" id="w3test" value="' + state.test + '">' +
        '</div></div>';
    host.innerHTML =
      '<div class="gcrd" data-widget="recta-de-la-desigualdad">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'La región que sí sirve, dibujada sobre la recta' : 'The region that works, drawn on the line') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Una desigualdad no se contesta con un número sino con un tramo entero de la recta. Cambia entre las dos condiciones del taller: en la primera hay una meta de utilidad que hay que alcanzar, en la segunda hay una reserva de barro que no se puede tocar. Mueve el volumen de prueba y observa si la marca dorada cae dentro o fuera de la zona verde. Lo importante no es el umbral sino hacia qué lado se pinta la zona, y merece la pena preguntarse por qué en una condición apunta a la derecha y en la otra a la izquierda aunque las dos se resuelvan con los mismos pasos.'
          : 'An inequality is not answered with a number but with a whole stretch of the line. Switch between the two conditions of the workshop: the first one has a profit target to reach, the second a clay reserve that cannot be touched. Move the test volume and watch whether the golden mark falls inside or outside the green zone. What matters is not the threshold but which way the zone is painted, and it is worth asking why in one condition it points right and in the other left, even though both are solved with the same steps.') + '</div>' +
        '<div class="mtabs">' +
          '<button class="mtab' + (meta ? ' active' : '') + '" data-m="meta">' + (es ? 'Meta de utilidad' : 'Profit target') + '</button>' +
          '<button class="mtab' + (meta ? '' : ' active') + '" data-m="barro">' + (es ? 'Reserva de barro' : 'Clay reserve') + '</button>' +
        '</div>' +
        '<div class="nline"><span class="nfill" id="w3fill"></span><span class="nmark" id="w3mark"></span></div>' +
        '<div class="nscale"><span>0</span><span>200</span><span>400</span><span>600</span><span>800</span></div>' +
        '<div class="verdict" id="w3verd"></div>' +
        ctrl +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Umbral exacto' : 'Exact threshold') + '</div><div class="mnum ps" id="w3thr"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Umbral en piezas enteras' : 'Threshold in whole pieces') + '</div><div class="mnum cs" id="w3lim"></div></div>' +
          '<div class="metric"><div class="mlbl" id="w3cond"></div><div class="mnum ts" id="w3res"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="w3read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() { state.mode = b.getAttribute('data-m'); mount(); });
    });
    var bind = function(id, key) {
      var el = host.querySelector(id);
      if (el) el.addEventListener('input', function() { state[key] = parseInt(el.value, 10); render(); });
    };
    bind('#w3test', 'test');
    if (meta) { bind('#w3m', 'm'); bind('#w3F', 'F'); bind('#w3U', 'U'); }
    else      { bind('#w3k', 'k'); bind('#w3M', 'M'); bind('#w3R', 'R'); }
    render();
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   BUILD LESSON · concepto, herramienta, reactivos, y otra vez
   Todos los numeros salen del rng sembrado, de modo que dos alumnos nunca
   comparten una sola cifra y un mismo alumno nunca repite un intento.
   La guia entera sigue a un negocio: Ceramica Suchitlan, un taller de
   Colima que produce y vende piezas de barro.
   ════════════════════════════════════════════════════════════════════════ */
function buildLesson(rng) {
  problems = []; sectionDefs = []; widgets = [];
  document.getElementById('lessonBody').innerHTML = '';

  /* ── Concepto 1 · la ecuacion y el punto de equilibrio ── */
  var c1m = pick([60, 75, 90], rng);
  var c1v = pick([85, 95, 110], rng);
  var c1p = c1v + c1m;
  var c1q = pick([260, 320, 400], rng);
  var c1F = c1m * c1q;
  var w1p = pick([150, 175, 200], rng);
  var w1v = pick([80, 95, 110], rng);
  var w1F = pick([15000, 18000, 21000], rng);
  var w1q = pick([200, 300, 400], rng);
  var p1F = pick([16200, 19500, 22800], rng);
  var p1v = pick([88, 96, 105], rng);
  var p1p = pick([148, 165, 182], rng);
  var p2m = pick([65, 80, 95], rng);
  var p2q = pick([240, 300, 380], rng);
  var p2F = p2m * p2q;
  var p2v = pick([90, 105, 120], rng);
  var p2p = p2v + p2m;

  /* ── Concepto 2 · la incognita en los dos lados y el parentesis ── */
  var c2q  = pick([180, 240, 300], rng);
  var c2d  = pick([25, 30, 40], rng);
  var c2a  = pick([70, 80, 95], rng);
  var c2b  = c2a + c2d;
  var c2FB = pick([6000, 9000, 12000], rng);
  var c2FA = c2FB + c2d * c2q;
  var w2FA = pick([16000, 20000, 24000], rng);
  var w2a  = pick([70, 85, 100], rng);
  var w2FB = pick([6000, 9000, 12000], rng);
  var w2b  = w2a + pick([20, 30, 45], rng);
  var w2q  = pick([150, 250, 350], rng);
  var p3q  = pick([200, 260, 340], rng);
  var p3d  = pick([22, 28, 35], rng);
  var p3a  = pick([68, 78, 92], rng);
  var p3b  = p3a + p3d;
  var p3FB = pick([5000, 8000, 11000], rng);
  var p3FA = p3FB + p3d * p3q;
  var p4c  = pick([38, 45, 52], rng);
  var p4s  = pick([40, 60, 75], rng);
  var p4K  = pick([1800, 2400, 3000], rng);
  var p4q  = pick([320, 380, 450], rng);
  var p4T  = p4c * (p4q + p4s) + p4K;

  /* ── Concepto 3 · desigualdades y el sentido que se voltea ── */
  var c3m    = pick([58, 72, 88], rng);
  var c3qbe  = pick([250, 320, 400], rng);
  var c3F    = c3m * c3qbe;
  var c3x    = pick([100, 150, 200], rng);
  var c3U    = c3m * c3x;
  var c3k    = pick([4, 5, 8], rng);
  var c3R    = pick([200, 300, 400], rng);
  var c3qmax = pick([300, 360, 420], rng);
  var c3M    = c3R + c3k * c3qmax;
  var w3m    = pick([55, 70, 85], rng);
  var w3F    = pick([15000, 18000, 21000], rng);
  var w3U    = pick([6000, 9000, 12000], rng);
  var w3k    = pick([4, 5, 8], rng);
  var w3M    = pick([1600, 2000, 2400], rng);
  var w3R    = pick([200, 300, 400], rng);
  var w3test = pick([250, 350, 450], rng);
  var p5m    = pick([62, 78, 94], rng);
  var p5qbe  = pick([240, 300, 360], rng);
  var p5F    = p5m * p5qbe;
  var p5x    = pick([90, 130, 170], rng);
  var p5U    = p5m * p5x;
  var p5v    = pick([95, 110, 125], rng);
  var p5p    = p5v + p5m;
  var p6k    = pick([4, 5, 8], rng);
  var p6R    = pick([200, 300, 400], rng);
  var p6q    = pick([300, 360, 420], rng);
  var p6M    = p6R + p6k * p6q;

  /* ── Evaluacion final ── */
  var p7fq = pick([50, 60, 80], rng);
  var p7q  = pick([250, 320, 400], rng);
  var p7F  = p7fq * p7q;
  var p7v  = pick([88, 96, 105], rng);
  var p8q  = pick([260, 330, 420], rng);
  var p8v  = pick([92, 104, 118], rng);
  var p8F  = pick([12000, 15000, 18000], rng);
  var p8B  = p8F + p8v * p8q;
  var p9v  = pick([64, 72, 86], rng);
  var p9F  = pick([9000, 12000, 15000], rng);
  var p9q  = pick([280, 350, 420], rng);
  var p9T  = p9v * p9q + p9F;
  var p10v = pick([57, 69, 83], rng);
  var p10F = pick([12000, 15000, 18000], rng);
  var p10B = pick([36000, 42000, 48000], rng);

  /* ═══════════════════════ CONCEPTO 1 ═══════════════════════ */
  var c1ing = c1p * c1q;

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 1</div>' +
      '<h2>La ecuación: una igualdad que solo se sostiene en un punto</h2>' +
      '<p>Una expresión algebraica es una máquina de calcular: se le da un volumen y devuelve un costo. Una <strong>ecuación</strong> es otra cosa. Es una <em>pregunta</em> escrita con símbolos: de todos los valores posibles de la variable, ¿cuál hace que estas dos cantidades valgan exactamente lo mismo? La expresión sirve para cualquier valor; la ecuación casi siempre se sostiene en uno solo, y encontrarlo es lo que llamamos <strong>resolverla</strong>. Ese valor único recibe el nombre de <strong>solución</strong>, y en un negocio nunca es un número suelto: es una decisión, un umbral, una cantidad que hay que colocar.</p>' +
      '<p>El método descansa en una idea muy simple, casi física. Los dos lados de una ecuación son los dos platos de una balanza que está equilibrada. Cualquier cosa que se le haga a un plato hay que hacérsela también al otro para que el equilibrio se conserve: sumar la misma cantidad de los dos lados, restarla de los dos, multiplicar los dos por el mismo número, dividir los dos entre el mismo número distinto de cero. Ese es el <strong>principio de equivalencia</strong>, y todas las reglas prácticas que se enseñan como atajos, incluida la de que un término cambia de signo al pasar al otro lado, no son más que consecuencias suyas.</p>' +
      '<p>Para despejar la incógnita se aplican <strong>operaciones inversas</strong> y se aplican en el orden contrario al que armaron la expresión. Si a la variable primero se le multiplicó por una tasa y después se le sumó una cantidad fija, para deshacer el camino se resta primero la cantidad fija y se divide al final. Invertir ese orden es el error más frecuente del tema y produce resultados que ni siquiera se parecen al correcto. Conviene además terminar siempre con la <strong>comprobación</strong>: sustituir la solución en la ecuación original y verificar que los dos lados dan el mismo número. En un examen cuesta veinte segundos, en un presupuesto real evita una decisión cara.</p>' +
      '<p>La ecuación que más se usa en un negocio pequeño es la del <strong>punto de equilibrio</strong>: el volumen en el que el ingreso iguala al costo total. Debajo de ese volumen se pierde dinero, encima se gana. Su solución se apoya en una cantidad con nombre propio, el <strong>margen de contribución</strong>, que es lo que queda de cada pieza vendida después de pagar el material que se fue en ella. Ese sobrante es lo único que puede ir cubriendo el gasto fijo del mes, y por eso el punto de equilibrio se lee como una división entre el hueco que hay que llenar y lo que aporta cada pieza.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Ecuación</div><div class="rform">ingreso = costo</div><div class="rnote">Una pregunta, no una fórmula.</div></div>' +
        '<div class="rcard"><div class="rname">Solución</div><div class="rform">q = ' + intN(c1q) + '</div><div class="rnote">El valor que equilibra la balanza.</div></div>' +
        '<div class="rcard"><div class="rname">Margen por pieza</div><div class="rform">' + intN(c1p) + ' − ' + intN(c1v) + '</div><div class="rnote">Lo que sobra tras pagar su material.</div></div>' +
        '<div class="rcard"><div class="rname">Comprobar</div><div class="rform">sustituir</div><div class="rnote">Los dos lados deben coincidir.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Cerámica Suchitlán paga ' + money(c1F) + ' al mes de renta, luz del horno y sueldos base. Cada pieza consume ' + money(c1v) + ' de barro, esmalte y gas, y se vende en ' + money(c1p) + '. El dueño quiere saber cuántas piezas tiene que colocar en el mes para no perder ni ganar.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> Se nombra la incógnita. Las piezas vendidas en el mes son q, y la pregunta pide el valor de q que iguala el ingreso con el costo total.<br>' +
      '<strong>Paso 2.</strong> Se escribe cada lado. El ingreso es el precio repetido en cada pieza vendida. El costo total es el gasto fijo del mes más el material de esas mismas piezas.<br>' +
      '<strong>Paso 3.</strong> Se reúnen los términos con q de un solo lado restando el material de los dos lados. Del lado izquierdo queda el margen de ' + money(c1m) + ' multiplicando a q, y del derecho quedan los ' + money(c1F) + ' fijos.<br>' +
      '<strong>Paso 4.</strong> Se divide entre el margen, que es la última operación pendiente sobre la incógnita, y resulta q = ' + intN(c1q) + ' piezas.<br>' +
      '<strong>Comprobación.</strong> Con ' + intN(c1q) + ' piezas el ingreso es ' + money(c1ing) + ' y el costo total también es ' + money(c1ing) + '. Los dos platos pesan lo mismo, así que la solución es correcta.<br>' +
      '<strong>Lectura de negocio.</strong> Cada pieza deja ' + money(c1m) + ' libres y hay ' + money(c1F) + ' que cubrir, de modo que el taller necesita ' + intN(c1q) + ' aportaciones para llegar a cero. La pieza número ' + intN(c1q + 1) + ' es la primera que deja utilidad.</p></div>';
    return '' +
      '<div class="stag">Concept 1</div>' +
      '<h2>The equation: an equality that holds at one point only</h2>' +
      '<p>An algebraic expression is a calculating machine: give it a volume and it returns a cost. An <strong>equation</strong> is something else. It is a <em>question</em> written in symbols: out of all the possible values of the variable, which one makes these two quantities worth exactly the same? The expression works at any value; the equation almost always holds at a single one, and finding it is what we call <strong>solving</strong> it. That single value is called the <strong>solution</strong>, and in a business it is never a loose number: it is a decision, a threshold, a quantity that has to be placed.</p>' +
      '<p>The method rests on a very simple, almost physical idea. The two sides of an equation are the two pans of a balance that is level. Whatever is done to one pan must be done to the other for the balance to hold: add the same amount to both, subtract it from both, multiply both by the same number, divide both by the same number other than zero. That is the <strong>principle of equivalence</strong>, and every practical rule taught as a shortcut, including the one about a term changing sign when it moves to the other side, is no more than a consequence of it.</p>' +
      '<p>To isolate the unknown, <strong>inverse operations</strong> are applied, and they are applied in the reverse order to the one that built the expression. If the variable was first multiplied by a rate and then had a fixed amount added, undoing the path means subtracting the fixed amount first and dividing last. Reversing that order is the most frequent mistake in the topic and produces results that do not even resemble the right one. It is also worth always ending with the <strong>check</strong>: substitute the solution back into the original equation and verify that both sides give the same number. In an exam it costs twenty seconds; in a real budget it prevents an expensive decision.</p>' +
      '<p>The equation most used in a small business is the one for the <strong>break even point</strong>: the volume at which revenue matches total cost. Below that volume money is lost, above it money is made. Its solution rests on a quantity with a name of its own, the <strong>contribution margin</strong>, which is what is left of every piece sold after paying for the material that went into it. That surplus is the only thing that can cover the fixed expense of the month, and that is why the break even point reads as a division between the hole that has to be filled and what each piece contributes.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Equation</div><div class="rform">revenue = cost</div><div class="rnote">A question, not a formula.</div></div>' +
        '<div class="rcard"><div class="rname">Solution</div><div class="rform">q = ' + intN(c1q) + '</div><div class="rnote">The value that levels the balance.</div></div>' +
        '<div class="rcard"><div class="rname">Margin per piece</div><div class="rform">' + intN(c1p) + ' − ' + intN(c1v) + '</div><div class="rnote">What is left after its material.</div></div>' +
        '<div class="rcard"><div class="rname">Check</div><div class="rform">substitute</div><div class="rnote">Both sides must agree.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> Cerámica Suchitlán pays ' + money(c1F) + ' a month in rent, kiln power and base salaries. Every piece takes ' + money(c1v) + ' in clay, glaze and gas, and sells for ' + money(c1p) + '. The owner wants to know how many pieces have to be placed in the month to neither lose nor make money.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> Name the unknown. The pieces sold in the month are q, and the question asks for the value of q that makes revenue equal to total cost.<br>' +
      '<strong>Step 2.</strong> Write each side. Revenue is the price repeated on every piece sold. Total cost is the fixed expense of the month plus the material of those same pieces.<br>' +
      '<strong>Step 3.</strong> Gather the terms carrying q on one side by subtracting the material from both sides. On the left the margin of ' + money(c1m) + ' is left multiplying q, and on the right the ' + money(c1F) + ' of fixed expense.<br>' +
      '<strong>Step 4.</strong> Divide by the margin, which is the last operation still sitting on the unknown, and q = ' + intN(c1q) + ' pieces comes out.<br>' +
      '<strong>Check.</strong> At ' + intN(c1q) + ' pieces revenue is ' + money(c1ing) + ' and total cost is also ' + money(c1ing) + '. Both pans weigh the same, so the solution is right.<br>' +
      '<strong>Business reading.</strong> Every piece leaves ' + money(c1m) + ' free and there is ' + money(c1F) + ' to cover, so the workshop needs ' + intN(c1q) + ' contributions to reach zero. Piece number ' + intN(c1q + 1) + ' is the first one that leaves a profit.</p></div>';
  });

  widgetBalanza(w1p, w1v, w1F, w1q);

  /* ── Reactivo 1 · que igualdad describe la situacion ── */
  var o1es = [
    'El precio multiplicado por las piezas vendidas debe dar lo mismo que el gasto fijo del mes más el material de esas piezas.',
    'El precio multiplicado por las piezas vendidas debe dar lo mismo que el gasto fijo del mes.',
    'El precio de una pieza debe dar lo mismo que el gasto fijo del mes más el material de una pieza.',
    'El precio menos el material de una pieza debe dar lo mismo que el gasto fijo del mes.'
  ];
  var o1en = [
    'The price multiplied by the pieces sold must come to the same as the fixed expense of the month plus the material of those pieces.',
    'The price multiplied by the pieces sold must come to the same as the fixed expense of the month.',
    'The price of one piece must come to the same as the fixed expense of the month plus the material of one piece.',
    'The price minus the material of one piece must come to the same as the fixed expense of the month.'
  ];
  var o1 = shuffleOpts(o1es, o1en, rng);
  addItem({
    title: { es: 'La igualdad que hay que plantear', en: 'The equality that has to be set up' },
    q: { es: 'Cerámica Suchitlán tiene un gasto fijo de ' + money(p1F) + ' al mes entre renta, luz del horno y sueldos base. Cada pieza consume ' + money(p1v) + ' de barro, esmalte y gas, y se vende en ' + money(p1p) + '. El dueño quiere plantear la condición que cumple el mes en el que no pierde ni gana. ¿Cuál de estas condiciones es la correcta?',
        en: 'Cerámica Suchitlán has a fixed expense of ' + money(p1F) + ' a month in rent, kiln power and base salaries. Every piece takes ' + money(p1v) + ' in clay, glaze and gas, and sells for ' + money(p1p) + '. The owner wants to state the condition met by the month in which nothing is lost and nothing is made. Which of these conditions is the right one?' },
    opts: { es: o1.es, en: o1.en },
    hint: { es: 'Pregúntate qué partidas crecen cuando crece el número de piezas y cuáles se pagan una sola vez al mes. Una condición que solo habla de una pieza no puede describir el mes completo, porque el gasto fijo no se paga pieza por pieza.',
            en: 'Ask which lines grow when the number of pieces grows and which are paid once a month. A condition that speaks only of one piece cannot describe the whole month, because the fixed expense is not paid piece by piece.' },
    exp: { es: 'El punto de equilibrio es el mes en el que todo lo que entra iguala a todo lo que sale. Lo que entra es el precio de ' + money(p1p) + ' repetido en cada pieza vendida. Lo que sale son los ' + money(p1F) + ' fijos más el material de ' + money(p1v) + ' repetido en esas mismas piezas, así que la condición correcta iguala esas dos cantidades completas. La opción que deja fuera el material supone que las piezas se producen solas y adelanta el equilibrio a un volumen imposible. Las dos opciones que hablan de una sola pieza confunden un dato mensual con uno unitario: el gasto fijo no se paga en cada pieza, se paga una vez al mes, y por eso ninguna igualdad planteada pieza por pieza describe la situación.',
           en: 'The break even point is the month in which everything coming in matches everything going out. What comes in is the price of ' + money(p1p) + ' repeated on every piece sold. What goes out is the ' + money(p1F) + ' of fixed expense plus the material of ' + money(p1v) + ' repeated on those same pieces, so the right condition equates those two full amounts. The option that leaves the material out assumes pieces make themselves and brings the balance forward to an impossible volume. The two options speaking of a single piece confuse a monthly figure with a unit one: the fixed expense is not paid on every piece, it is paid once a month, and that is why no equality stated piece by piece describes the situation.' }
  }, o1.correctIdx, false);

  /* ── Reactivo 2 · resolver la ecuacion del punto de equilibrio ── */
  var o2es = [
    intN(p2q) + ' piezas',
    intN(Math.ceil(p2F / p2p)) + ' piezas',
    intN(Math.ceil(p2F / p2v)) + ' piezas',
    intN(Math.ceil(p2F / (p2p + p2v))) + ' piezas'
  ];
  var o2en = [
    intN(p2q) + ' pieces',
    intN(Math.ceil(p2F / p2p)) + ' pieces',
    intN(Math.ceil(p2F / p2v)) + ' pieces',
    intN(Math.ceil(p2F / (p2p + p2v))) + ' pieces'
  ];
  var o2 = shuffleOpts(o2es, o2en, rng);
  addItem({
    title: { es: 'El volumen que empata los dos lados', en: 'The volume that ties the two sides' },
    q: { es: 'Este mes el taller tiene comprometidos ' + money(p2F) + ' de gastos que no dependen de la producción. Cada pieza consume ' + money(p2v) + ' de material y se vende en ' + money(p2p) + '. ¿Cuántas piezas tiene que vender en el mes para que el dinero que entra alcance justo a cubrir todo el que sale?',
        en: 'This month the workshop is committed to ' + money(p2F) + ' of expenses that do not depend on production. Every piece takes ' + money(p2v) + ' of material and sells for ' + money(p2p) + '. How many pieces does it have to sell in the month for the money coming in to just cover all the money going out?' },
    hint: { es: 'El material también crece con las piezas, así que no todo el precio queda disponible para cubrir el gasto fijo. Averigua primero cuánto sobra de cada pieza después de pagar su propio material y solo entonces piensa cuántas de esas sobras hacen falta.',
            en: 'The material grows with the pieces too, so not all of the price is available to cover the fixed expense. Work out first how much is left over from each piece after paying for its own material, and only then think how many of those leftovers are needed.' },
    opts: { es: o2.es, en: o2.en },
    exp: { es: 'Cada pieza entra con ' + money(p2p) + ' pero se lleva ' + money(p2v) + ' de material, así que solo deja ' + money(p2m) + ' libres para cubrir el gasto fijo. Con ' + money(p2F) + ' que cubrir hacen falta ' + intN(p2q) + ' piezas, y la comprobación cierra: a ese volumen el ingreso y el costo total coinciden en ' + money(p2p * p2q) + '. La opción de ' + intN(Math.ceil(p2F / p2p)) + ' divide el gasto fijo entre el precio completo y olvida que parte de ese precio ya está comprometida con el barro. La de ' + intN(Math.ceil(p2F / p2v)) + ' divide entre el costo unitario, que no es lo que aporta la pieza sino lo que consume. Y la de ' + intN(Math.ceil(p2F / (p2p + p2v))) + ' suma precio y costo en lugar de restarlos, con lo cual el aporte por pieza sale inflado y el volumen necesario, muy corto.',
           en: 'Every piece brings in ' + money(p2p) + ' but takes ' + money(p2v) + ' of material with it, so it leaves only ' + money(p2m) + ' free to cover the fixed expense. With ' + money(p2F) + ' to cover, ' + intN(p2q) + ' pieces are needed, and the check closes: at that volume revenue and total cost meet at ' + money(p2p * p2q) + '. The option of ' + intN(Math.ceil(p2F / p2p)) + ' divides the fixed expense by the full price and forgets that part of that price is already committed to the clay. The one of ' + intN(Math.ceil(p2F / p2v)) + ' divides by the unit cost, which is not what the piece contributes but what it consumes. And the one of ' + intN(Math.ceil(p2F / (p2p + p2v))) + ' adds price and cost instead of subtracting them, so the contribution per piece comes out inflated and the volume needed far too short.' }
  }, o2.correctIdx, true);

  /* ═══════════════════════ CONCEPTO 2 ═══════════════════════ */
  var c2cost = c2FA + c2a * c2q;

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 2</div>' +
      '<h2>La incógnita en los dos lados y el paréntesis que hay que repartir</h2>' +
      '<p>Hasta aquí la incógnita vivía de un solo lado. En cuanto un negocio compara dos alternativas aparece de los dos, porque las dos dependen del mismo volumen. Es el caso de siempre: producir en casa o mandar a maquilar, comprar el equipo o rentarlo, contratar de planta o pagar por evento. Cada alternativa tiene una parte que se paga pase lo que pase y una tasa por unidad, y la pregunta que importa nunca es cuál es más barata sino <em>desde qué volumen</em> deja de serlo.</p>' +
      '<p>El procedimiento agrega un paso a lo que ya sabemos. Primero se juntan de un lado los términos que llevan la incógnita y del otro los que no, usando el principio de equivalencia: se resta de los dos lados el término con la variable que sea menor, y con eso desaparece de un lado sin desaparecer de la ecuación. Después se despeja como siempre. El número que termina dividiendo no es ninguna de las dos tasas por separado, sino su <strong>diferencia</strong>, y esa diferencia tiene una lectura de negocio muy clara: es el ahorro por unidad que consigue la alternativa cara de instalar. Del otro lado queda la diferencia entre las partes fijas, es decir el sobreprecio que hay que amortizar.</p>' +
      '<p>El segundo ingrediente del tema es la <strong>propiedad distributiva</strong>. Cuando una tarifa se cobra sobre una suma encerrada en un paréntesis, alcanza a todos los términos de adentro sin excepción. Si el maquilador cobra por cada pieza que pasa por sus manos, y por sus manos pasan las piezas de tienda más las de muestra, esa tarifa se cobra por unas y por otras. Repartir mal el paréntesis es equivalente a suponer que alguien trabajó gratis. Y cuando lo que hay delante del paréntesis es un signo menos, restar el paréntesis significa restar todo lo que hay dentro, así que cada término cambia de signo al salir.</p>' +
      '<p>Conviene desconfiar de la solución en dos momentos. Uno es aritmético: sustituirla en los dos lados originales y ver que dan el mismo número. El otro es de sentido común: preguntarse si el resultado cabe en la realidad del negocio. Un volumen de equilibrio negativo, o de cien mil piezas en un taller que produce cuatrocientas, no es un error de cuentas sino una señal de que la comparación estaba mal planteada desde el principio, casi siempre porque la alternativa cara de instalar también resultó cara de operar.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Incógnita en dos lados</div><div class="rform">restar de ambos</div><div class="rnote">Se agrupa sin perder el equilibrio.</div></div>' +
        '<div class="rcard"><div class="rname">Lo que divide</div><div class="rform">' + intN(c2b) + ' − ' + intN(c2a) + '</div><div class="rnote">La diferencia de tasas, no una tasa.</div></div>' +
        '<div class="rcard"><div class="rname">Distributiva</div><div class="rform">m(q + s)</div><div class="rnote">El factor alcanza a todo lo de dentro.</div></div>' +
        '<div class="rcard"><div class="rname">Signo menos</div><div class="rform">restar el paréntesis</div><div class="rnote">Cada término cambia de signo.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> El taller puede hornear en casa, lo que le cuesta ' + money(c2FA) + ' al mes de gasto fijo y ' + money(c2a) + ' por pieza, o mandar todo a un maquilador que cobra ' + money(c2FB) + ' fijos al mes y ' + money(c2b) + ' por pieza. El dueño quiere saber a partir de qué volumen le conviene hornear en casa.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> Se plantea la igualdad entre los dos costos mensuales, cada uno con su parte fija y su tasa por pieza, y la incógnita q aparece en los dos lados.<br>' +
      '<strong>Paso 2.</strong> Se resta de los dos lados el término con la tasa menor, la de ' + money(c2a) + ' por pieza. Del lado del maquilador queda un solo término con q cuyo coeficiente es la diferencia de tasas, ' + money(c2d) + '.<br>' +
      '<strong>Paso 3.</strong> Se resta de los dos lados la cuota fija menor, ' + money(c2FB) + ', y del otro lado queda la diferencia entre las partes fijas, ' + money(c2FA - c2FB) + '.<br>' +
      '<strong>Paso 4.</strong> Se divide entre ' + money(c2d) + ' y resulta q = ' + intN(c2q) + ' piezas.<br>' +
      '<strong>Comprobación.</strong> Con ' + intN(c2q) + ' piezas las dos opciones cuestan ' + money(c2cost) + '. Los dos lados coinciden, así que el volumen es el correcto.<br>' +
      '<strong>Lectura de negocio.</strong> Hornear en casa cuesta ' + money(c2FA - c2FB) + ' más al mes, pero ahorra ' + money(c2d) + ' en cada pieza. Hacen falta ' + intN(c2q) + ' piezas para que esos ahorros paguen el sobreprecio: por debajo conviene maquilar, por encima conviene el horno propio.</p></div>';
    return '' +
      '<div class="stag">Concept 2</div>' +
      '<h2>The unknown on both sides and the bracket that must be shared out</h2>' +
      '<p>So far the unknown lived on one side only. The moment a business compares two alternatives it turns up on both, because both depend on the same volume. It is the usual case: produce at home or send the work out, buy the equipment or rent it, hire staff or pay per event. Each alternative has a part that is paid whatever happens and a rate per unit, and the question that matters is never which one is cheaper but <em>from what volume onwards</em> it stops being so.</p>' +
      '<p>The procedure adds one step to what we already know. First the terms carrying the unknown are gathered on one side and those that do not on the other, using the principle of equivalence: subtract from both sides whichever variable term is smaller, and with that it disappears from one side without disappearing from the equation. Then it is isolated as always. The number that ends up dividing is neither of the two rates on its own but their <strong>difference</strong>, and that difference has a very clear business reading: it is the saving per unit achieved by the alternative that is expensive to set up. On the other side sits the difference between the fixed parts, which is the extra outlay that has to be paid off.</p>' +
      '<p>The second ingredient of the topic is the <strong>distributive property</strong>. When a rate is charged on a sum enclosed in a bracket, it reaches every term inside without exception. If the contract workshop charges for every piece that passes through its hands, and through its hands pass the shop pieces plus the samples, that rate is charged on both. Sharing out the bracket badly is the same as assuming somebody worked for free. And when what sits in front of the bracket is a minus sign, subtracting the bracket means subtracting everything inside it, so every term changes sign on the way out.</p>' +
      '<p>It pays to distrust the solution at two moments. One is arithmetic: substitute it into both original sides and see that they give the same number. The other is common sense: ask whether the result fits the reality of the business. A negative break even volume, or one of a hundred thousand pieces in a workshop that makes four hundred, is not an arithmetic slip but a sign that the comparison was badly set up from the start, almost always because the alternative that was expensive to set up turned out to be expensive to run as well.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Unknown on both sides</div><div class="rform">subtract from both</div><div class="rnote">Gathered without losing balance.</div></div>' +
        '<div class="rcard"><div class="rname">What divides</div><div class="rform">' + intN(c2b) + ' − ' + intN(c2a) + '</div><div class="rnote">The difference of rates, not a rate.</div></div>' +
        '<div class="rcard"><div class="rname">Distributive</div><div class="rform">m(q + s)</div><div class="rnote">The factor reaches everything inside.</div></div>' +
        '<div class="rcard"><div class="rname">Minus sign</div><div class="rform">subtract the bracket</div><div class="rnote">Every term changes sign.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> The workshop can fire the kiln at home, which costs ' + money(c2FA) + ' a month in fixed expense and ' + money(c2a) + ' per piece, or send everything to a contract workshop that charges ' + money(c2FB) + ' a month in fees and ' + money(c2b) + ' per piece. The owner wants to know from what volume onwards firing at home is the better buy.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> Set up the equality between the two monthly costs, each with its fixed part and its rate per piece, and the unknown q turns up on both sides.<br>' +
      '<strong>Step 2.</strong> Subtract from both sides the term with the smaller rate, the one of ' + money(c2a) + ' per piece. On the contract side a single term with q is left, and its coefficient is the difference of rates, ' + money(c2d) + '.<br>' +
      '<strong>Step 3.</strong> Subtract from both sides the smaller fixed fee, ' + money(c2FB) + ', and on the other side the difference between the fixed parts is left, ' + money(c2FA - c2FB) + '.<br>' +
      '<strong>Step 4.</strong> Divide by ' + money(c2d) + ' and q = ' + intN(c2q) + ' pieces comes out.<br>' +
      '<strong>Check.</strong> At ' + intN(c2q) + ' pieces both options cost ' + money(c2cost) + '. The two sides agree, so the volume is right.<br>' +
      '<strong>Business reading.</strong> Firing at home costs ' + money(c2FA - c2FB) + ' more a month, but saves ' + money(c2d) + ' on every piece. It takes ' + intN(c2q) + ' pieces for those savings to pay off the extra outlay: below that, contracting out wins; above it, the kiln of their own does.</p></div>';
  });

  widgetComparador(w2FA, w2a, w2FB, w2b, w2q);

  /* ── Reactivo 3 · el volumen en el que las dos opciones empatan ── */
  var o3es = [
    intN(p3q) + ' piezas',
    intN(Math.ceil((p3FA - p3FB) / p3b)) + ' piezas',
    intN(Math.ceil((p3FA - p3FB) / p3a)) + ' piezas',
    intN(Math.ceil(p3FA / p3d)) + ' piezas'
  ];
  var o3en = [
    intN(p3q) + ' pieces',
    intN(Math.ceil((p3FA - p3FB) / p3b)) + ' pieces',
    intN(Math.ceil((p3FA - p3FB) / p3a)) + ' pieces',
    intN(Math.ceil(p3FA / p3d)) + ' pieces'
  ];
  var o3 = shuffleOpts(o3es, o3en, rng);
  addItem({
    title: { es: 'Horno propio o maquila', en: 'Own kiln or contract work' },
    q: { es: 'Cerámica Suchitlán estudia dos maneras de hornear la producción del mes. Con horno propio paga ' + money(p3FA) + ' al mes de gasto fijo y ' + money(p3a) + ' por pieza. Con el maquilador paga ' + money(p3FB) + ' al mes y ' + money(p3b) + ' por pieza. ¿Con cuántas piezas al mes las dos opciones le cuestan exactamente lo mismo?',
        en: 'Cerámica Suchitlán is looking at two ways of firing the production of the month. With a kiln of their own they pay ' + money(p3FA) + ' a month in fixed expense and ' + money(p3a) + ' per piece. With the contract workshop they pay ' + money(p3FB) + ' a month and ' + money(p3b) + ' per piece. At how many pieces a month do the two options cost exactly the same?' },
    hint: { es: 'La incógnita aparece en los dos lados, así que primero hay que juntarla en uno solo. Cuando lo hagas, fíjate en qué número queda multiplicando a las piezas: no es ninguna de las dos tarifas, sino lo que se ahorra por pieza al cambiar de opción.',
            en: 'The unknown turns up on both sides, so it has to be gathered on one of them first. When you do it, look at which number is left multiplying the pieces: it is neither of the two rates, but what is saved per piece by switching option.' },
    opts: { es: o3.es, en: o3.en },
    exp: { es: 'El horno propio cuesta ' + money(p3FA - p3FB) + ' más al mes, pero cada pieza sale ' + money(p3d) + ' más barata que con el maquilador. Ese ahorro por pieza es el número que divide, y por eso las dos opciones empatan en ' + intN(p3q) + ' piezas: a ese volumen las dos cuestan ' + money(p3FA + p3a * p3q) + '. La opción de ' + intN(Math.ceil((p3FA - p3FB) / p3b)) + ' divide la diferencia de gastos fijos entre la tarifa del maquilador, y la de ' + intN(Math.ceil((p3FA - p3FB) / p3a)) + ' la divide entre la tarifa del horno propio; ninguna de las dos tarifas mide el ahorro, que es lo que realmente va pagando el sobreprecio. La opción de ' + intN(Math.ceil(p3FA / p3d)) + ' usa todo el gasto fijo del horno propio en lugar de la diferencia, y con eso amortiza un sobreprecio que el taller no está pagando, porque con el maquilador también hay una cuota mensual.',
           en: 'The kiln of their own costs ' + money(p3FA - p3FB) + ' more a month, but every piece comes out ' + money(p3d) + ' cheaper than with the contract workshop. That saving per piece is the number that divides, and that is why the two options tie at ' + intN(p3q) + ' pieces: at that volume both cost ' + money(p3FA + p3a * p3q) + '. The option of ' + intN(Math.ceil((p3FA - p3FB) / p3b)) + ' divides the gap between fixed expenses by the contract rate, and the one of ' + intN(Math.ceil((p3FA - p3FB) / p3a)) + ' divides it by the own kiln rate; neither rate measures the saving, which is what actually pays off the extra outlay. The option of ' + intN(Math.ceil(p3FA / p3d)) + ' uses the whole fixed expense of the own kiln instead of the difference, and with that pays off an extra outlay the workshop is not carrying, because there is a monthly fee with the contract workshop too.' }
  }, o3.correctIdx, true);

  /* ── Reactivo 4 · la tarifa que se cobra sobre un parentesis ── */
  var p4r = Math.round(p4K / p4c);
  var o4es = [
    intN(p4q) + ' piezas',
    intN(p4q + p4s) + ' piezas',
    intN(p4q + p4s + p4r) + ' piezas',
    intN(p4q - p4s) + ' piezas'
  ];
  var o4en = [
    intN(p4q) + ' pieces',
    intN(p4q + p4s) + ' pieces',
    intN(p4q + p4s + p4r) + ' pieces',
    intN(p4q - p4s) + ' pieces'
  ];
  var o4 = shuffleOpts(o4es, o4en, rng);
  addItem({
    title: { es: 'La factura del maquilador', en: 'The invoice from the contract workshop' },
    q: { es: 'El maquilador cobra una cuota fija de ' + money(p4K) + ' al mes más ' + money(p4c) + ' por cada pieza que pasa por su horno. El mes pasado, además de las piezas que iban a la tienda, el taller le mandó ' + intN(p4s) + ' piezas de muestra para una feria artesanal, y todas se hornearon igual. La factura del mes fue de ' + money(p4T) + '. ¿Cuántas piezas de las que iban a la tienda se hornearon ese mes?',
        en: 'The contract workshop charges a fixed fee of ' + money(p4K) + ' a month plus ' + money(p4c) + ' for every piece that goes through its kiln. Last month, besides the pieces headed for the shop, the workshop also sent ' + intN(p4s) + ' sample pieces for a crafts fair, and all of them were fired the same way. The invoice for the month came to ' + money(p4T) + '. How many of the pieces headed for the shop were fired that month?' },
    hint: { es: 'La tarifa por pieza se cobró sobre todo lo que entró al horno, no solo sobre lo que iba a la tienda. Deshaz la factura en el orden inverso al que se armó: primero lo que no depende del número de piezas, después lo que sí, y al final separa las muestras.',
            en: 'The rate per piece was charged on everything that went into the kiln, not only on what was headed for the shop. Undo the invoice in the reverse order to the one that built it: first what does not depend on the number of pieces, then what does, and separate the samples at the end.' },
    opts: { es: o4.es, en: o4.en },
    exp: { es: 'La cuota de ' + money(p4K) + ' no depende del volumen, así que se quita primero y deja ' + money(p4T - p4K) + ' cobrados por horneado. Como la tarifa de ' + money(p4c) + ' se aplicó a todas las piezas que entraron al horno, esa cantidad corresponde a ' + intN(p4q + p4s) + ' piezas en total, de las cuales ' + intN(p4s) + ' eran muestras, así que a la tienda iban ' + intN(p4q) + '. La opción de ' + intN(p4q + p4s) + ' se queda a un paso y reporta todo lo horneado como si fuera producto de tienda. La de ' + intN(p4q + p4s + p4r) + ' además olvida quitar la cuota fija y le atribuye piezas a un cargo que se paga una sola vez al mes. Y la de ' + intN(p4q - p4s) + ' suma las muestras en lugar de restarlas, con lo cual descuenta dos veces un envío que solo ocurrió una.',
           en: 'The fee of ' + money(p4K) + ' does not depend on volume, so it comes off first and leaves ' + money(p4T - p4K) + ' charged for firing. Since the rate of ' + money(p4c) + ' was applied to every piece that went into the kiln, that amount covers ' + intN(p4q + p4s) + ' pieces in total, of which ' + intN(p4s) + ' were samples, so ' + intN(p4q) + ' were headed for the shop. The option of ' + intN(p4q + p4s) + ' stops one step short and reports everything fired as if it were shop product. The one of ' + intN(p4q + p4s + p4r) + ' also forgets to take off the fixed fee and attributes pieces to a charge that is paid once a month. And the one of ' + intN(p4q - p4s) + ' adds the samples instead of subtracting them, discounting twice a shipment that happened only once.' }
  }, o4.correctIdx, true);

  /* ═══════════════════════ CONCEPTO 3 ═══════════════════════ */
  var c3qU = c3qbe + c3x;

  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Concepto 3</div>' +
      '<h2>Desigualdades: cuando la respuesta no es un número sino un rango</h2>' +
      '<p>Muchas decisiones de un negocio no piden un valor exacto sino un límite. No se pregunta cuántas piezas dejan exactamente cero de utilidad, sino cuántas hacen falta <em>como mínimo</em> para llegar a la meta del mes; no se pregunta qué volumen agota justo el presupuesto, sino cuánto se puede producir <em>sin pasarse</em>. Esas condiciones se escriben con los signos de <strong>desigualdad</strong>, y su solución ya no es un punto sino un tramo entero de la recta numérica, lo que se llama el <strong>conjunto solución</strong>. Leerlo bien es lo que convierte un despeje en una regla de decisión.</p>' +
      '<p>La buena noticia es que se resuelven casi igual que las ecuaciones: se puede sumar o restar la misma cantidad de los dos lados sin que nada cambie, y se puede multiplicar o dividir los dos lados por un número <strong>positivo</strong> sin que nada cambie. La excepción es una sola y hay que grabarla: al multiplicar o dividir los dos lados por un número <strong>negativo</strong>, el sentido de la desigualdad se invierte. No es un capricho. Si un taller produce más que otro, quien más produce agota antes su barro, de modo que la comparación entre lo producido y la comparación entre lo que queda en el almacén apuntan en direcciones contrarias. El signo se voltea porque la realidad se voltea.</p>' +
      '<p>En la práctica ese caso aparece siempre que la incógnita entra restando: existencias que se consumen, presupuestos que se gastan, plazos que se agotan. Hay dos maneras de resolverlo y las dos son válidas. Una es despejar dejando el término negativo y voltear el sentido al dividir. La otra, más segura para quien empieza, es mover la incógnita al lado donde quede positiva desde el principio, con lo cual nunca hace falta voltear nada. Elegir la segunda no es hacer trampa: es organizar el trabajo para no depender de una regla que se olvida bajo presión.</p>' +
      '<p>Queda un último paso que es puramente de negocio y que las calculadoras no hacen: <strong>redondear en el sentido correcto</strong>. Las piezas se cuentan enteras. Si la condición dice que hacen falta al menos ' + nfD(c3F / c3m + 0.4, 1) + ' piezas, la respuesta útil es el entero de arriba, porque con el de abajo la meta se queda corta. Si la condición dice que se pueden producir cuando mucho ese mismo número, la respuesta útil es el entero de abajo, porque el de arriba ya se pasa del límite. El mismo decimal se redondea en direcciones opuestas según el signo de la desigualdad, y equivocarse ahí es tan caro como equivocarse en el despeje.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Al menos</div><div class="rform">q ≥ ' + intN(c3qU) + '</div><div class="rnote">La región se abre hacia arriba.</div></div>' +
        '<div class="rcard"><div class="rname">Cuando mucho</div><div class="rform">q ≤ ' + intN(c3qmax) + '</div><div class="rnote">La región se abre hacia abajo.</div></div>' +
        '<div class="rcard"><div class="rname">Dividir entre negativo</div><div class="rform">voltear el signo</div><div class="rnote">Única regla que cambia.</div></div>' +
        '<div class="rcard"><div class="rname">Redondeo</div><div class="rform">según el sentido</div><div class="rnote">Arriba si es mínimo, abajo si es tope.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto 1.</strong> El gasto fijo del mes es ' + money(c3F) + ', cada pieza aporta ' + money(c3m) + ' después de pagar su material y el dueño quiere cerrar el mes con una utilidad de al menos ' + money(c3U) + '. ¿Cuántas piezas necesita colocar como mínimo?</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> La condición dice que lo que aportan las piezas, después de descontar el gasto fijo, debe ser mayor o igual que la meta.<br>' +
      '<strong>Paso 2.</strong> Se suma el gasto fijo a los dos lados, y del lado derecho queda todo lo que hay que cubrir: ' + money(c3F + c3U) + '.<br>' +
      '<strong>Paso 3.</strong> Se divide entre el aporte por pieza, que es positivo, de modo que el sentido de la desigualdad se conserva y queda q ≥ ' + intN(c3qU) + '.<br>' +
      '<strong>Lectura de negocio.</strong> Con ' + intN(c3qbe) + ' piezas el taller apenas empata; a partir de ' + intN(c3qU) + ' alcanza la meta, y cualquier volumen mayor también la cumple. Por eso la respuesta es un rango y no un número.</p></div>' +
      '<p><strong>Ejemplo resuelto 2.</strong> En el almacén hay ' + intN(c3M) + ' kg de barro, cada pieza consume ' + intN(c3k) + ' kg y el dueño quiere terminar el mes con al menos ' + intN(c3R) + ' kg guardados para atender pedidos urgentes. ¿Cuántas piezas puede producir como máximo?</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> La condición compara lo que queda en el almacén, que es la existencia menos lo consumido, con la reserva que no se toca.<br>' +
      '<strong>Paso 2.</strong> Se resta la existencia de los dos lados y del lado izquierdo queda el consumo con signo negativo, porque cada pieza descuenta barro en lugar de agregarlo.<br>' +
      '<strong>Paso 3.</strong> Se divide entre ese número negativo y aquí sí se voltea el sentido: la condición pasa a ser q ≤ ' + intN(c3qmax) + '.<br>' +
      '<strong>Comprobación.</strong> Con ' + intN(c3qmax) + ' piezas quedan exactamente ' + intN(c3R) + ' kg, y con una pieza más quedarían ' + intN(c3R - c3k) + ' kg, por debajo de la reserva.<br>' +
      '<strong>Lectura de negocio.</strong> Aquí el rango se abre hacia abajo: producir menos nunca incumple la reserva, producir de más sí. Si el resultado hubiera salido con decimales, la respuesta útil sería el entero de abajo.</p></div>';
    return '' +
      '<div class="stag">Concept 3</div>' +
      '<h2>Inequalities: when the answer is not a number but a range</h2>' +
      '<p>Many business decisions do not ask for an exact value but for a limit. The question is not how many pieces leave exactly zero profit, but how many are needed <em>at least</em> to reach the target of the month; not what volume uses up the budget exactly, but how much can be produced <em>without going over</em>. Those conditions are written with <strong>inequality</strong> signs, and their solution is no longer a point but a whole stretch of the number line, what is called the <strong>solution set</strong>. Reading it properly is what turns an algebraic step into a decision rule.</p>' +
      '<p>The good news is that they are solved almost exactly like equations: the same amount can be added to or subtracted from both sides with nothing changing, and both sides can be multiplied or divided by a <strong>positive</strong> number with nothing changing. There is a single exception and it is worth engraving: multiplying or dividing both sides by a <strong>negative</strong> number reverses the direction of the inequality. It is not a whim. If one workshop produces more than another, the one producing more runs out of clay sooner, so the comparison between what is produced and the comparison between what is left in store point in opposite directions. The sign flips because reality flips.</p>' +
      '<p>In practice that case shows up whenever the unknown comes in subtracting: stock being used up, budgets being spent, deadlines running out. There are two ways of handling it and both are valid. One is to isolate the unknown leaving the negative term and flip the direction when dividing. The other, safer for a beginner, is to move the unknown to the side where it is positive from the start, so nothing ever needs flipping. Choosing the second is not cheating: it is organising the work so as not to depend on a rule that gets forgotten under pressure.</p>' +
      '<p>One last step is left, purely a business one, and calculators do not do it: <strong>rounding in the right direction</strong>. Pieces are counted whole. If the condition says at least ' + nfD(c3F / c3m + 0.4, 1) + ' pieces are needed, the useful answer is the integer above, because with the one below the target falls short. If the condition says at most that same number can be produced, the useful answer is the integer below, because the one above already breaks the limit. The same decimal is rounded in opposite directions depending on the sign of the inequality, and getting that wrong is as expensive as getting the algebra wrong.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">At least</div><div class="rform">q ≥ ' + intN(c3qU) + '</div><div class="rnote">The region opens upwards.</div></div>' +
        '<div class="rcard"><div class="rname">At most</div><div class="rform">q ≤ ' + intN(c3qmax) + '</div><div class="rnote">The region opens downwards.</div></div>' +
        '<div class="rcard"><div class="rname">Divide by a negative</div><div class="rform">flip the sign</div><div class="rnote">The only rule that changes.</div></div>' +
        '<div class="rcard"><div class="rname">Rounding</div><div class="rform">follow the direction</div><div class="rnote">Up for a minimum, down for a cap.</div></div>' +
      '</div>' +
      '<p><strong>Worked example 1.</strong> The fixed expense of the month is ' + money(c3F) + ', every piece contributes ' + money(c3m) + ' after paying for its material, and the owner wants to close the month with a profit of at least ' + money(c3U) + '. How many pieces need to be placed as a minimum?</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The condition says that what the pieces contribute, once the fixed expense is taken off, must be greater than or equal to the target.<br>' +
      '<strong>Step 2.</strong> Add the fixed expense to both sides, and on the right everything that has to be covered is left: ' + money(c3F + c3U) + '.<br>' +
      '<strong>Step 3.</strong> Divide by the contribution per piece, which is positive, so the direction of the inequality is preserved and q ≥ ' + intN(c3qU) + ' is left.<br>' +
      '<strong>Business reading.</strong> At ' + intN(c3qbe) + ' pieces the workshop merely breaks even; from ' + intN(c3qU) + ' onwards it reaches the target, and any larger volume meets it too. That is why the answer is a range and not a number.</p></div>' +
      '<p><strong>Worked example 2.</strong> There are ' + intN(c3M) + ' kg of clay in store, every piece uses ' + intN(c3k) + ' kg and the owner wants to end the month with at least ' + intN(c3R) + ' kg kept back for urgent orders. How many pieces can be produced at most?</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The condition compares what is left in store, which is the stock minus what is used, with the reserve that is not to be touched.<br>' +
      '<strong>Step 2.</strong> Subtract the stock from both sides and on the left the consumption is left with a negative sign, because every piece takes clay away instead of adding it.<br>' +
      '<strong>Step 3.</strong> Divide by that negative number, and here the direction does flip: the condition becomes q ≤ ' + intN(c3qmax) + '.<br>' +
      '<strong>Check.</strong> At ' + intN(c3qmax) + ' pieces exactly ' + intN(c3R) + ' kg are left, and with one more piece there would be ' + intN(c3R - c3k) + ' kg, below the reserve.<br>' +
      '<strong>Business reading.</strong> Here the range opens downwards: producing less never breaks the reserve, producing more does. Had the result come out with decimals, the useful answer would be the integer below.</p></div>';
  });

  widgetRecta(w3m, w3F, w3U, w3k, w3M, w3R, w3test);

  /* ── Reactivo 5 · el minimo que exige una meta de utilidad ── */
  var p5t1 = p5qbe + p5x;
  var p5t2 = Math.ceil((p5F + p5U) / p5p);
  var o5es = [
    'Al menos ' + intN(p5t1) + ' piezas',
    'Cuando mucho ' + intN(p5t1) + ' piezas',
    'Al menos ' + intN(p5t2) + ' piezas',
    'Cuando mucho ' + intN(p5t2) + ' piezas'
  ];
  var o5en = [
    'At least ' + intN(p5t1) + ' pieces',
    'At most ' + intN(p5t1) + ' pieces',
    'At least ' + intN(p5t2) + ' pieces',
    'At most ' + intN(p5t2) + ' pieces'
  ];
  var o5 = shuffleOpts(o5es, o5en, rng);
  addItem({
    title: { es: 'La meta de utilidad del mes', en: 'The profit target for the month' },
    q: { es: 'El taller cerró el año pasado sin utilidad y este mes el dueño quiere terminar con al menos ' + money(p5U) + ' en la mano. Los gastos que no dependen de la producción suman ' + money(p5F) + ', cada pieza consume ' + money(p5v) + ' de material y se vende en ' + money(p5p) + '. ¿Qué condición debe cumplir el número de piezas vendidas en el mes?',
        en: 'The workshop closed last year with no profit and this month the owner wants to end up with at least ' + money(p5U) + ' in hand. The expenses that do not depend on production add up to ' + money(p5F) + ', every piece takes ' + money(p5v) + ' of material and sells for ' + money(p5p) + '. What condition must the number of pieces sold in the month satisfy?' },
    hint: { es: 'Hay dos huecos que llenar, no uno: primero el gasto que se paga pase lo que pase y encima la meta que el dueño quiere en la mano. Y antes de dividir, revisa qué parte del precio queda realmente disponible una vez pagado el material de la pieza.',
            en: 'There are two holes to fill, not one: first the expense that is paid whatever happens and on top of it the target the owner wants in hand. And before dividing, check which part of the price is really available once the material of the piece is paid for.' },
    opts: { es: o5.es, en: o5.en },
    exp: { es: 'Cada pieza deja ' + money(p5m) + ' después de pagar su propio material, y hay que cubrir ' + money(p5F) + ' de gasto fijo más ' + money(p5U) + ' de meta, es decir ' + money(p5F + p5U) + ' en total, lo que exige ' + intN(p5t1) + ' piezas. Como al dividir entre un número positivo el sentido no cambia, la condición se lee al menos ' + intN(p5t1) + ' piezas: cualquier volumen mayor también sirve, y por eso la respuesta es un rango abierto hacia arriba. La opción que dice cuando mucho ' + intN(p5t1) + ' invierte el sentido y convertiría una meta en un tope, dejando fuera precisamente los meses buenos. Las dos opciones con ' + intN(p5t2) + ' dividen entre el precio de venta completo en lugar del aporte por pieza, y con eso suponen que el barro sale gratis.',
           en: 'Every piece leaves ' + money(p5m) + ' after paying for its own material, and there is ' + money(p5F) + ' of fixed expense plus ' + money(p5U) + ' of target to cover, that is ' + money(p5F + p5U) + ' in all, which calls for ' + intN(p5t1) + ' pieces. Since dividing by a positive number does not change the direction, the condition reads at least ' + intN(p5t1) + ' pieces: any larger volume works too, and that is why the answer is a range open upwards. The option saying at most ' + intN(p5t1) + ' reverses the direction and would turn a target into a cap, ruling out precisely the good months. The two options with ' + intN(p5t2) + ' divide by the full selling price instead of the contribution per piece, and with that assume the clay comes free.' }
  }, o5.correctIdx, true);

  /* ── Reactivo 6 · el tope que impone la reserva de barro ── */
  var p6A = Math.floor(p6M / p6k);
  var o6es = [
    'Cuando mucho ' + intN(p6q) + ' piezas',
    'Al menos ' + intN(p6q) + ' piezas',
    'Cuando mucho ' + intN(p6A) + ' piezas',
    'Al menos ' + intN(p6A) + ' piezas'
  ];
  var o6en = [
    'At most ' + intN(p6q) + ' pieces',
    'At least ' + intN(p6q) + ' pieces',
    'At most ' + intN(p6A) + ' pieces',
    'At least ' + intN(p6A) + ' pieces'
  ];
  var o6 = shuffleOpts(o6es, o6en, rng);
  addItem({
    title: { es: 'El barro que no se toca', en: 'The clay that is not touched' },
    q: { es: 'En el almacén del taller hay ' + intN(p6M) + ' kg de barro y cada pieza consume ' + intN(p6k) + ' kg. El dueño tiene la regla de terminar siempre el mes con al menos ' + intN(p6R) + ' kg guardados, porque los pedidos urgentes de la temporada de fiestas llegan sin aviso. ¿Qué condición debe cumplir el número de piezas producidas en el mes?',
        en: 'There are ' + intN(p6M) + ' kg of clay in the store of the workshop and every piece uses ' + intN(p6k) + ' kg. The owner has a rule of always ending the month with at least ' + intN(p6R) + ' kg kept back, because the urgent orders of the festive season arrive without warning. What condition must the number of pieces produced in the month satisfy?' },
    hint: { es: 'Aquí las piezas restan barro en lugar de sumarlo, así que la incógnita queda con signo negativo. Cuando llegues al paso de dividir, detente un segundo y pregúntate qué le pasa al sentido de la desigualdad. Y recuerda que la reserva no está disponible para producir.',
            en: 'Here the pieces subtract clay instead of adding it, so the unknown ends up with a negative sign. When you reach the dividing step, stop for a second and ask what happens to the direction of the inequality. And remember the reserve is not available for production.' },
    opts: { es: o6.es, en: o6.en },
    exp: { es: 'Del almacén solo se pueden gastar ' + intN(p6M - p6R) + ' kg, porque los otros ' + intN(p6R) + ' kg están apartados, y a ' + intN(p6k) + ' kg por pieza eso alcanza para ' + intN(p6q) + ' piezas exactas. Al despejar, el término con la incógnita queda negativo porque cada pieza descuenta barro, y al dividir entre ese número negativo el sentido se voltea: la condición correcta es cuando mucho ' + intN(p6q) + ' piezas. La opción que dice al menos ' + intN(p6q) + ' es justamente el error de no voltear el signo, y en la práctica significaría producir hasta agotar la reserva. Las dos opciones con ' + intN(p6A) + ' reparten todo el barro del almacén sin apartar nada, y con ese plan el taller terminaría el mes sin material para el primer pedido urgente.',
           en: 'Only ' + intN(p6M - p6R) + ' kg can be spent from the store, because the other ' + intN(p6R) + ' kg are set aside, and at ' + intN(p6k) + ' kg per piece that is enough for exactly ' + intN(p6q) + ' pieces. When the unknown is isolated its term is negative, because every piece takes clay away, and dividing by that negative number flips the direction: the right condition is at most ' + intN(p6q) + ' pieces. The option saying at least ' + intN(p6q) + ' is precisely the mistake of not flipping the sign, and in practice it would mean producing until the reserve is gone. The two options with ' + intN(p6A) + ' share out all the clay in the store without setting anything aside, and with that plan the workshop would end the month with no material for the first urgent order.' }
  }, o6.correctIdx, true);

  /* ═══════════════════════ EVALUACIÓN FINAL ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Evaluación final</div>' +
      '<h2>Cuatro decisiones del taller</h2>' +
      '<p>Los cuatro reactivos que siguen no vienen acompañados de explicación. Cada uno describe una decisión real de Cerámica Suchitlán y te toca a ti decidir si la situación pide una igualdad o un límite, plantearla y resolverla. Vale la pena comprobar cada resultado sustituyéndolo en la condición original antes de elegir una opción.</p>';
    return '' +
      '<div class="stag">Final assessment</div>' +
      '<h2>Four decisions in the workshop</h2>' +
      '<p>The four items that follow come with no explanation before them. Each one describes a real decision at Cerámica Suchitlán and it is up to you to decide whether the situation calls for an equality or for a limit, to set it up and to solve it. It is worth checking every result by substituting it back into the original condition before choosing an option.</p>';
  });

  /* ── Reactivo 7 · el precio que cierra la cuenta ── */
  var p7p = p7v + p7fq;
  var o7es = [ money(p7p), money(p7fq), money(p7v), money(p7v + p7F) ];
  var o7en = [ money(p7p), money(p7fq), money(p7v), money(p7v + p7F) ];
  var o7 = shuffleOpts(o7es, o7en, rng);
  addItem({
    title: { es: 'El precio que hay que fijar', en: 'The price that has to be set' },
    q: { es: 'Para la temporada alta el taller ya tiene comprometida la producción: ' + intN(p7q) + ' piezas, ni una más. Los gastos que no dependen del volumen suman ' + money(p7F) + ' al mes y cada pieza consume ' + money(p7v) + ' de material. El dueño quiere fijar un precio que le permita cerrar el mes sin pérdida vendiendo exactamente esas piezas. ¿En cuánto debe vender cada una?',
        en: 'For the high season the workshop already has its production committed: ' + intN(p7q) + ' pieces, not one more. The expenses that do not depend on volume add up to ' + money(p7F) + ' a month and every piece takes ' + money(p7v) + ' of material. The owner wants to set a price that closes the month with no loss selling exactly those pieces. What should each one sell for?' },
    hint: { es: 'Ahora la incógnita es el precio y el volumen es un dato. Cada pieza tiene que pagar dos cosas distintas: lo que ella misma consume y la parte del gasto fijo que le toca cargar. Piensa cuánto le toca a cada una de ese gasto mensual.',
            en: 'Now the unknown is the price and the volume is given. Every piece has to pay for two different things: what it uses up itself and the share of the fixed expense it has to carry. Think how much of that monthly expense falls to each one.' },
    opts: { es: o7.es, en: o7.en },
    exp: { es: 'Repartido entre ' + intN(p7q) + ' piezas, el gasto fijo de ' + money(p7F) + ' le toca a cada una en ' + money(p7fq) + ', y a eso hay que sumarle los ' + money(p7v) + ' de material que consume, de modo que el precio debe ser ' + money(p7p) + '. La comprobación cierra: a ese precio el ingreso del mes es ' + money(p7p * p7q) + ' y el costo total también. La opción de ' + money(p7fq) + ' cubre solo la parte fija y regala el material. La de ' + money(p7v) + ' cubre solo el material y deja el gasto fijo sin pagar, que es como se quiebran muchos talleres que se creen baratos. Y la de ' + money(p7v + p7F) + ' le carga a una sola pieza el gasto fijo de todo el mes, un precio que ningún cliente pagaría.',
           en: 'Shared out over ' + intN(p7q) + ' pieces, the fixed expense of ' + money(p7F) + ' falls to each one at ' + money(p7fq) + ', and to that the ' + money(p7v) + ' of material it uses must be added, so the price has to be ' + money(p7p) + '. The check closes: at that price the revenue of the month is ' + money(p7p * p7q) + ' and so is total cost. The option of ' + money(p7fq) + ' covers only the fixed part and gives the material away. The one of ' + money(p7v) + ' covers only the material and leaves the fixed expense unpaid, which is how many workshops that believe themselves cheap go under. And the one of ' + money(p7v + p7F) + ' loads the fixed expense of the whole month onto a single piece, a price no customer would pay.' }
  }, o7.correctIdx, true);

  /* ── Reactivo 8 · el tope que impone el presupuesto ── */
  var p8A = Math.floor(p8B / p8v);
  var p8C = Math.floor((p8B + p8F) / p8v);
  var p8D = Math.floor(p8B / (p8F + p8v));
  var o8es = [ intN(p8q) + ' piezas', intN(p8A) + ' piezas', intN(p8C) + ' piezas', intN(p8D) + ' piezas' ];
  var o8en = [ intN(p8q) + ' pieces', intN(p8A) + ' pieces', intN(p8C) + ' pieces', intN(p8D) + ' pieces' ];
  var o8 = shuffleOpts(o8es, o8en, rng);
  addItem({
    title: { es: 'El techo del presupuesto', en: 'The ceiling of the budget' },
    q: { es: 'El consejo familiar autorizó ' + money(p8B) + ' para operar el mes y ni un peso más. De esa bolsa salen los ' + money(p8F) + ' de gastos que se pagan aunque el horno no se encienda, y cada pieza producida consume ' + money(p8v) + ' de material. ¿Cuántas piezas puede producir el taller como máximo sin rebasar lo autorizado?',
        en: 'The family board authorised ' + money(p8B) + ' to run the month and not a peso more. Out of that pot come the ' + money(p8F) + ' of expenses paid even if the kiln is never lit, and every piece produced uses ' + money(p8v) + ' of material. How many pieces can the workshop produce at most without going over what was authorised?' },
    hint: { es: 'No todo el presupuesto está disponible para producir: una parte ya está apartada antes de encender el horno. Averigua cuánto queda realmente libre y solo entonces reparte esa bolsa entre las piezas.',
            en: 'Not all of the budget is available for producing: part of it is already set aside before the kiln is lit. Work out how much is really free and only then share that pot out over the pieces.' },
    opts: { es: o8.es, en: o8.en },
    exp: { es: 'De los ' + money(p8B) + ' autorizados hay que apartar primero los ' + money(p8F) + ' que se pagan pase lo que pase, y quedan ' + money(p8B - p8F) + ' libres para material. A ' + money(p8v) + ' por pieza eso alcanza para ' + intN(p8q) + ' piezas exactas, y con una más el presupuesto se rebasa. La opción de ' + intN(p8A) + ' reparte todo el presupuesto en material y deja sin pagar la renta y los sueldos. La de ' + intN(p8C) + ' suma el gasto fijo en lugar de restarlo, con lo cual autoriza un gasto mayor que el aprobado. Y la de ' + intN(p8D) + ' suma el gasto fijo mensual al costo unitario, como si la renta se pagara en cada pieza, y por eso da una cifra ridículamente pequeña.',
           en: 'Out of the ' + money(p8B) + ' authorised, the ' + money(p8F) + ' paid whatever happens must be set aside first, leaving ' + money(p8B - p8F) + ' free for material. At ' + money(p8v) + ' per piece that is enough for exactly ' + intN(p8q) + ' pieces, and one more goes over the budget. The option of ' + intN(p8A) + ' spends the whole budget on material and leaves rent and salaries unpaid. The one of ' + intN(p8C) + ' adds the fixed expense instead of subtracting it, authorising a larger outlay than the one approved. And the one of ' + intN(p8D) + ' adds the monthly fixed expense to the unit cost, as if the rent were paid on every piece, which is why it gives a ridiculously small figure.' }
  }, o8.correctIdx, true);

  /* ── Reactivo 9 · el paso que cambia de signo ── */
  var p9w = Math.round((p9T + p9F) / p9v);
  var o9es = [
    'Sumó el gasto fijo cuando debía restarlo: al pasarlo al otro lado de la igualdad ese término cambia de signo, y el resultado correcto es ' + intN(p9q) + ' piezas.',
    'El procedimiento es correcto y las ' + intN(p9w) + ' piezas son el número de piezas producidas ese mes.',
    'El error fue dividir al final: primero hay que dividir entre el costo unitario y después quitar el gasto fijo.',
    'El error fue usar el costo unitario para dividir: en una cuenta de costos siempre se divide entre el precio de venta.'
  ];
  var o9en = [
    'They added the fixed expense when it had to be subtracted: moving that term to the other side of the equality changes its sign, and the right result is ' + intN(p9q) + ' pieces.',
    'The procedure is correct and the ' + intN(p9w) + ' pieces are the number of pieces produced that month.',
    'The mistake was dividing at the end: the division by the unit cost has to come first and the fixed expense is taken off afterwards.',
    'The mistake was using the unit cost to divide: in a cost calculation the division is always by the selling price.'
  ];
  var o9 = shuffleOpts(o9es, o9en, rng);
  addItem({
    title: { es: 'La hoja del asistente', en: 'The sheet of the assistant' },
    q: { es: 'El costo total del mes pasado fue de ' + money(p9T) + ', el gasto fijo mensual del taller es ' + money(p9F) + ' y cada pieza consume ' + money(p9v) + ' de material. Un asistente quería saber cuántas piezas se produjeron. En su hoja tomó el costo total, le agregó el gasto fijo y dividió el resultado entre el costo de material de una pieza, y anotó ' + intN(p9w) + ' piezas. ¿Cuál es la observación correcta sobre ese procedimiento?',
        en: 'Total cost last month came to ' + money(p9T) + ', the monthly fixed expense of the workshop is ' + money(p9F) + ' and every piece uses ' + money(p9v) + ' of material. An assistant wanted to know how many pieces had been produced. On the sheet they took total cost, added the fixed expense to it, divided the result by the material cost of one piece, and wrote down ' + intN(p9w) + ' pieces. What is the correct observation about that procedure?' },
    hint: { es: 'Pregúntate qué operación armó el costo total y deshazla al revés. Si el gasto fijo se sumó para formar el total, lo que hay que hacer para recuperar la parte del material es lo contrario de sumar.',
            en: 'Ask which operation built total cost and undo it backwards. If the fixed expense was added to form the total, what has to be done to recover the material part is the opposite of adding.' },
    opts: { es: o9.es, en: o9.en },
    exp: { es: 'El costo total se formó sumando el gasto fijo al material, así que para recuperar solo el material hay que restar ese gasto fijo, no sumarlo: quedan ' + money(p9T - p9F) + ', y al repartirlos entre ' + money(p9v) + ' por pieza resultan ' + intN(p9q) + ' piezas. El asistente sumó ' + money(p9F) + ' de más y por eso su cifra, ' + intN(p9w) + ' piezas, exagera la producción en ' + intN(p9w - p9q) + ' piezas. La opción que defiende el procedimiento pasa por alto que ese gasto ya estaba dentro del total. La que propone dividir primero también es incorrecta: las operaciones inversas se aplican en orden contrario al que armaron la cuenta, y aquí la suma se hizo al final, así que la resta va primero. Y la que exige dividir entre el precio de venta confunde una cuenta de costos con una de ingresos.',
           en: 'Total cost was formed by adding the fixed expense to the material, so to recover the material on its own that fixed expense has to be subtracted, not added: ' + money(p9T - p9F) + ' are left, and sharing them out at ' + money(p9v) + ' per piece gives ' + intN(p9q) + ' pieces. The assistant added ' + money(p9F) + ' too much, which is why their figure, ' + intN(p9w) + ' pieces, overstates production by ' + intN(p9w - p9q) + ' pieces. The option defending the procedure overlooks that the expense was already inside the total. The one proposing to divide first is wrong too: inverse operations are applied in the reverse order to the one that built the calculation, and here the addition came last, so the subtraction goes first. And the one demanding division by the selling price confuses a cost calculation with a revenue one.' }
  }, o9.correctIdx, false);

  /* ── Reactivo 10 · el decimal que hay que leer al derecho ── */
  var p10t  = (p10B - p10F) / p10v;
  var p10lo = Math.floor(p10t);
  var p10hi = Math.ceil(p10t);
  var o10es = [
    'Hasta ' + intN(p10lo) + ' piezas, porque con una más el presupuesto se rebasa y las piezas se cuentan enteras.',
    'Hasta ' + intN(p10hi) + ' piezas, porque el resultado de la división se redondea hacia arriba.',
    'Exactamente ' + nfD(p10t, 1) + ' piezas, tal como sale la división.',
    'Cualquier cantidad sirve mientras el pedido se entregue a tiempo, porque el presupuesto no limita el número de piezas.'
  ];
  var o10en = [
    'Up to ' + intN(p10lo) + ' pieces, because one more goes over the budget and pieces are counted whole.',
    'Up to ' + intN(p10hi) + ' pieces, because the result of the division is rounded up.',
    'Exactly ' + nfD(p10t, 1) + ' pieces, just as the division comes out.',
    'Any quantity will do as long as the order is delivered on time, because the budget puts no limit on the number of pieces.'
  ];
  var o10 = shuffleOpts(o10es, o10en, rng);
  addItem({
    title: { es: 'Cuando la cuenta no sale exacta', en: 'When the calculation does not come out even' },
    q: { es: 'Para un pedido especial el taller dispone de ' + money(p10B) + ' y de esa bolsa salen ' + money(p10F) + ' de gastos que se pagan aunque no se produzca nada. Cada pieza del pedido consume ' + money(p10v) + ' de material. ¿Cuántas piezas puede comprometer el taller sin rebasar lo disponible?',
        en: 'For a special order the workshop has ' + money(p10B) + ' available and out of that pot come ' + money(p10F) + ' of expenses paid even if nothing is produced. Every piece in the order uses ' + money(p10v) + ' of material. How many pieces can the workshop commit to without going over what is available?' },
    hint: { es: 'Esta cuenta no sale en números redondos, y ahí está la pregunta de verdad. Cuando el resultado cae entre dos enteros, decide cuál de los dos respeta la condición: prueba mentalmente los dos y quédate con el que no rebasa el dinero disponible.',
            en: 'This calculation does not come out in round numbers, and that is where the real question lies. When the result falls between two whole numbers, decide which of the two respects the condition: try both in your head and keep the one that does not go over the money available.' },
    opts: { es: o10.es, en: o10.en },
    exp: { es: 'Apartados los ' + money(p10F) + ' que se pagan pase lo que pase, quedan ' + money(p10B - p10F) + ' para material, y a ' + money(p10v) + ' por pieza la cuenta cae en ' + nfD(p10t, 1) + ' piezas. Como el presupuesto es un tope, la respuesta útil es el entero de abajo, ' + intN(p10lo) + ': con ' + intN(p10hi) + ' piezas el gasto sube a ' + money(p10F + p10v * p10hi) + ' y rebasa lo disponible. Redondear hacia arriba es correcto cuando la condición fija un mínimo, no un máximo, y confundir esos dos casos es el error clásico del tema. La opción del decimal olvida que las piezas no se producen por fracciones. Y la que afirma que el presupuesto no limita el número de piezas niega la condición misma del problema, que es precisamente un tope de dinero.',
           en: 'Once the ' + money(p10F) + ' paid whatever happens are set aside, ' + money(p10B - p10F) + ' are left for material, and at ' + money(p10v) + ' per piece the calculation falls at ' + nfD(p10t, 1) + ' pieces. Since the budget is a cap, the useful answer is the integer below, ' + intN(p10lo) + ': at ' + intN(p10hi) + ' pieces the outlay rises to ' + money(p10F + p10v * p10hi) + ' and goes over what is available. Rounding up is right when the condition sets a minimum, not a maximum, and confusing those two cases is the classic mistake of the topic. The option with the decimal forgets that pieces are not produced in fractions. And the one claiming the budget puts no limit on the number of pieces denies the very condition of the problem, which is exactly a cap on money.' }
  }, o10.correctIdx, true);
}

/* ════════════════════════════════════════════════════════════════════════
   LANGUAGE
   Switching rebuilds visible text only. The numbers were drawn once by the
   seeded rng and never change with the language.
   ════════════════════════════════════════════════════════════════════════ */
function applyUIStrings() {
  var set = function(id, txt) { var e = document.getElementById(id); if (e) e.textContent = txt; };
  var ph  = function(id, txt) { var e = document.getElementById(id); if (e) e.placeholder = txt; };
  set('wtitle-el',    SCHOOL.guideTitle[LANG]);
  set('wcourse-el',   SCHOOL.courseName[LANG]);
  set('htitle-el',    SCHOOL.guideTitle[LANG]);
  set('lbl-name-el',  t('lbl-name'));
  set('lbl-group-el', t('lbl-group'));
  set('startBtn',     t('btn-start'));
  set('restoreTitle', t('restore-title'));
  set('restoreMsg',   t('restore-msg'));
  set('restoreBtn',   t('btn-restore'));
  set('dismissBtn',   t('btn-dismiss'));
  set('dlBtn',        t('btn-pdf'));
  ph('sName',  t('ph-name'));
  ph('sGroup', t('ph-group'));
  var ll = document.getElementById('logo-left');  if (ll) ll.alt = SCHOOL.logoLeftAlt;
  var lr = document.getElementById('logo-right'); if (lr) lr.alt = SCHOOL.logoRightAlt;
}
/* Rebuilds the visible text of every card without touching the numbers. */
function applyProblemLang() {
  problems.forEach(function(p, i) {
    var card = document.getElementById('pc' + i);
    if (!card || !p.i18n) return;
    p.title = p.i18n.title[LANG];
    p.q     = p.i18n.q[LANG];
    p.hint  = p.i18n.hint[LANG];
    p.exp   = p.i18n.exp[LANG];
    p.opts  = p.i18n.opts[LANG].slice();
    var ti = card.querySelector('.ptitle'); if (ti) ti.textContent = p.title;
    var st = card.querySelector('.pstmt');  if (st) st.innerHTML = p.q;
    var hb = card.querySelector('.hintbox'); if (hb) hb.innerHTML = p.hint;
    var hbtn = card.querySelector('.hintbtn'); if (hbtn) hbtn.textContent = t('btn-hint');
    card.querySelectorAll('.mcopt').forEach(function(o, oi) {
      if (p.opts[oi] !== undefined) o.innerHTML = p.opts[oi];
    });
    var tabs = card.querySelectorAll('.wtab');
    if (tabs.length === 3) {
      tabs[0].textContent = t('tab-draw');
      tabs[1].textContent = t('tab-type');
      tabs[2].textContent = t('tab-photo');
    }
    var tools = card.querySelectorAll('.tbtn2');
    if (tools.length === 3) {
      tools[0].textContent = t('tool-pen');
      tools[1].textContent = t('tool-mark');
      tools[2].textContent = t('tool-erase');
    }
    var clr = card.querySelector('.clrbtn'); if (clr) clr.textContent = t('tool-clear');
    var ta  = card.querySelector('.wtextarea'); if (ta) ta.placeholder = t('ph-work');
    var pzt = card.querySelector('.pztxt'); if (pzt) pzt.textContent = t('ph-photo');
    var lab = card.querySelector('.pbody > div:last-child > div:first-child');
    if (lab) lab.textContent = t('lbl-answer');
    var fb = card.querySelector('.mcfb');
    if (fb && fb.classList.contains('show')) {
      var isOk = (p.studentChoice === p.correctIdx);
      fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + p.exp;
    }
  });
}
function setLang(l) {
  LANG = l;
  try { localStorage.setItem(LANG_KEY, l); } catch(e) {}
  document.documentElement.setAttribute('lang', l);
  var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
  if (be) be.classList.toggle('active', l === 'es');
  if (bn) bn.classList.toggle('active', l === 'en');
  applyUIStrings();
  applySectionLang();
  applyProblemLang();
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
  document.querySelectorAll('#lessonBody .section').forEach(function(s) { s.classList.add('vis'); });
}
(function() {
  try { var stored = localStorage.getItem(LANG_KEY); if (stored === 'es' || stored === 'en') LANG = stored; } catch(e) {}
  document.addEventListener('DOMContentLoaded', function() {
    document.documentElement.setAttribute('lang', LANG);
    var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
    if (be) be.classList.toggle('active', LANG === 'es');
    if (bn) bn.classList.toggle('active', LANG === 'en');
    applyUIStrings();
  });
})();

/* ════════════════════════════════════════════════════════════════════════
   LOGO INJECTION  (welcome card + sticky bar)
   ════════════════════════════════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', function() {
  var wl = document.getElementById('logo-left');
  if (wl && SCHOOL.logoLeftB64) { wl.src = SCHOOL.logoLeftB64; wl.style.display = 'inline-block'; }
  var wr = document.getElementById('logo-right');
  var ws = document.getElementById('wlogsep');
  if (wr && SCHOOL.logoRightB64) { wr.src = SCHOOL.logoRightB64; wr.style.display = 'inline-block'; }
  else { if (wr) wr.style.display = 'none'; if (ws) ws.style.display = 'none'; }
  var hl = document.getElementById('hlogo-left');
  if (hl && SCHOOL.logoLeftB64) { hl.src = SCHOOL.logoLeftB64; hl.style.display = 'inline-block'; }
  var hr = document.getElementById('hlogo-right');
  if (hr && SCHOOL.logoRightB64) { hr.src = SCHOOL.logoRightB64; hr.style.display = 'inline-block'; }
});

/* ════════════════════════════════════════════════════════════════════════
   PDF
   ════════════════════════════════════════════════════════════════════════ */
async function generatePDF() {
  var btn = document.getElementById('dlBtn');
  btn.textContent = t('pdf-busy');
  btn.disabled = true;

  var jspdf   = window.jspdf;
  var doc     = new jspdf.jsPDF({ orientation:'portrait', unit:'mm', format:'letter' });
  var PW      = 215.9;
  var M       = 18;
  var TW      = PW - M * 2;
  var PH      = doc.internal.pageSize.height;
  var name    = studentData.name;
  var group   = studentData.group;
  var total   = problems.length;
  var pct     = Math.round(correctCount / total * 100);
  var dateStr = new Date().toLocaleString(LANG === 'es' ? 'es-MX' : 'en-US', { dateStyle:'long', timeStyle:'short' });

  var raw = name + '|' + group + '|' + correctCount + '|' + total + '|' + new Date().toDateString();
  var h = 0;
  for (var ci = 0; ci < raw.length; ci++) h = (Math.imul(31, h) + raw.charCodeAt(ci)) | 0;
  var code = Math.abs(h).toString(36).toUpperCase().slice(0, 8);

  var pBR = SCHOOL.pBR, pBG = SCHOOL.pBG, pBB = SCHOOL.pBB;
  var pAR = SCHOOL.pAR, pAG = SCHOOL.pAG, pAB = SCHOOL.pAB;

  /* Flattens the fraction markup into a slash before the tags are stripped,
     so a rational expression stays readable in the printed sheet. */
  function pdfText(html) {
    if (!html) return '';
    return html
      .replace(/<span class="mf-den">/g, ' / ')
      .replace(/<[^>]+>/g,'').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&')
      .replace(/&nbsp;/g,' ').replace(/&#[0-9]+;/g,'')
      .replace(/’/g, String.fromCharCode(39))
      .replace(/→/g,'->').replace(/−/g,'-').replace(/²/g,'^2')
      .replace(/³/g,'^3').replace(/×/g,'x').replace(/÷/g,'/')
      .replace(/≠/g,'!=').replace(/≤/g,'<=').replace(/≥/g,'>=')
      .replace(/√/g,'sqrt').replace(/π/g,'pi').replace(/…/g,'...')
      .replace(/·/g,'*').replace(/\s+/g,' ').trim();
  }

  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,2,'F');
  doc.setFillColor(255,255,255); doc.rect(0,2,PW,26,'F');
  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,28,PW,2,'F');
  doc.setFillColor(pBR,pBG,pBB); doc.rect(0,30,PW,34,'F');

  var fmtL = SCHOOL.logoLeftB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  var fmtR = SCHOOL.logoRightB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  try { doc.addImage(SCHOOL.logoLeftB64,  fmtL, M,  4.0, 22, 22); } catch(e) {}
  try { doc.addImage(SCHOOL.logoRightB64, fmtR, 48, 4.5, 48, 21); } catch(e) {}

  var lx = PW - M - 36;
  var ly = 10;
  doc.setDrawColor(pBR,pBG,pBB); doc.setLineWidth(0.7);
  doc.lines([[2.57-1.03,4.63-6.17],[4.11-2.57,5.14-4.63],[5.66-4.11,2.57-5.14]], lx+1.03, ly+6.17);
  doc.setFillColor(pAR,pAG,pAB); doc.circle(lx+5.66, ly+2.57, 0.9, 'F');
  doc.setDrawColor(pAR,pAG,pAB); doc.setLineWidth(0.7);
  doc.line(lx+8.23, ly+1.54, lx+8.23, ly+7.2);
  doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text('LIAXA', lx+10, ly+6.8);

  doc.setTextColor(240,244,238); doc.setFontSize(15); doc.setFont('helvetica','bold');
  doc.text(SCHOOL.guideTitle[LANG], M, 49);
  doc.setTextColor(198,214,192); doc.setFontSize(8); doc.setFont('helvetica','normal');
  doc.text(dateStr, M, 59);

  doc.setFillColor(237,240,245); doc.roundedRect(M,72,TW,20,3,3,'F');
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
  doc.text(t('pdf-student'), M+4, 79); doc.text(t('pdf-group'), 130, 79);
  doc.setTextColor(20,24,32); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text(name, M+4, 87); doc.text(group, 130, 87);

  var sc = pct>=70?[26,106,74]:pct>=50?[224,123,26]:[176,48,16];
  doc.setFillColor(255,255,255); doc.roundedRect(M,100,TW,34,4,4,'F');
  doc.setDrawColor(sc[0],sc[1],sc[2]); doc.setLineWidth(0.8);
  doc.roundedRect(M,100,TW,34,4,4,'S');
  doc.setTextColor(sc[0],sc[1],sc[2]); doc.setFontSize(40); doc.setFont('helvetica','bold');
  doc.text(pct+'%', PW/2, 124, {align:'center'});
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
  doc.text(correctCount+' '+t('pdf-score')+' '+total+' '+t('pdf-questions'), PW/2, 131, {align:'center'});

  doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
  doc.setFontSize(7); doc.setFont('helvetica','bold');
  doc.rect(M,142,TW,8,'F'); doc.text(t('pdf-summary'), M+4, 148);
  var sy = 154;
  problems.forEach(function(prob, i) {
    if (sy + 12 > PH - 15) {
      doc.addPage(); sy = 20;
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,sy,TW,8,'F'); doc.text(t('pdf-summary2'), M+4, sy+6);
      sy += 12;
    }
    var ok = document.getElementById('pc'+i).classList.contains('ok');
    doc.setFillColor(ok?232:255, ok?240:232, ok?232:228);
    doc.roundedRect(M,sy,TW,10,2,2,'F');
    doc.setFillColor(ok?26:176, ok?106:48, ok?74:16);
    doc.circle(M+6, sy+5, 2.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(7); doc.setFont('helvetica','bold');
    doc.text(ok?'v':'x', M+4.5, sy+6.5);
    doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('helvetica','normal');
    doc.text(t('pdf-item')+' '+(i+1)+': '+pdfText(prob.title), M+12, sy+6.5);
    doc.setTextColor(ok?26:176, ok?106:48, ok?74:16);
    doc.text(ok?t('pdf-ok'):t('pdf-bad'), PW-M-24, sy+6.5);
    sy += 12;
  });

  for (var i = 0; i < problems.length; i++) {
    var prob = problems[i];
    doc.addPage();
    var wy = 0;

    doc.setFillColor(pBR,pBG,pBB); doc.rect(0,0,PW,20,'F');
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,3,'F');
    doc.setTextColor(pAR,pAG,pAB); doc.setFontSize(7); doc.setFont('helvetica','normal');
    doc.text(SCHOOL.courseName[LANG]+'  ·  '+SCHOOL.guideTitle[LANG], M, 10);
    doc.setTextColor(240,244,238); doc.setFontSize(10.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-item')+' '+(i+1)+' '+t('pdf-of')+' '+total+'  ·  '+pdfText(prob.title), M, 17);
    wy = 25;

    var qRaw = pdfText(prob.q);
    doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qLines = doc.splitTextToSize(qRaw, TW-10);
    var qBoxH  = 8 + qLines.length*5 + 3;
    doc.setFillColor(237,240,245); doc.roundedRect(M,wy,TW,qBoxH,2,2,'F');
    doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(6.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-question'), M+4, wy+6);
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qy = wy+12;
    qLines.forEach(function(ln,li){ doc.text(ln, M+4, qy+li*5); });
    wy += qBoxH + 4;

    var isOk   = document.getElementById('pc'+i).classList.contains('ok');
    var chosen = prob.studentChoice != null ? pdfText(prob.opts[prob.studentChoice]||'') : '';
    var corr   = pdfText(prob.opts[prob.correctIdx]||'');
    var expRaw = pdfText(prob.exp||'');
    doc.setFontSize(8.5); var chLines = doc.splitTextToSize(t('pdf-yours')+chosen, TW-18);
    doc.setFontSize(8);   var coLines = doc.splitTextToSize(t('pdf-key')+corr, TW-18);
    doc.setFontSize(7.5); var exLines = doc.splitTextToSize(t('pdf-sol')+expRaw, TW-18).slice(0,4);
    var ansBoxH = 8 + chLines.length*5.5 + coLines.length*5 + exLines.length*5 + 6;
    doc.setFillColor(isOk?232:255, isOk?240:232, isOk?232:228);
    doc.roundedRect(M,wy,TW,ansBoxH,2,2,'F');
    doc.setFillColor(isOk?26:176, isOk?106:48, isOk?74:16);
    doc.circle(M+7, wy+8, 3.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(9); doc.setFont('helvetica','bold');
    doc.text(isOk?'v':'x', M+5.2, wy+10.5);
    var ay = wy+7;
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
    chLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5.5); });
    ay += chLines.length*5.5 + 3;
    doc.setTextColor(26,106,74); doc.setFontSize(8); doc.setFont('helvetica','normal');
    coLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    ay += coLines.length*5 + 3;
    doc.setTextColor(90,85,80); doc.setFontSize(7.5);
    exLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    wy += ansBoxH + 5;

    var dc = document.getElementById('dc'+i);
    if (dc) {
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,wy,TW,8,'F'); doc.text(t('pdf-work'), M+4, wy+5.5);
      wy += 11;
      try {
        var imgD = dc.toDataURL('image/png');
        var ar   = dc.height / dc.width;
        var iw   = TW;
        var ih   = Math.min(iw * ar, 68);
        doc.addImage(imgD, 'PNG', M, wy, iw, ih);
        wy += ih + 4;
      } catch(e) {}
    }

    var ta = document.getElementById('ta'+i);
    if (ta && ta.value.trim()) {
      if (wy > PH-30) { doc.addPage(); wy = 20; }
      doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('courier','normal');
      var taLines = doc.splitTextToSize(ta.value, TW);
      taLines.slice(0,16).forEach(function(ln) {
        if (wy > PH-15) { doc.addPage(); wy = 20; }
        doc.text(ln, M, wy); wy += 5;
      });
      wy += 2;
    }

    var pp = document.getElementById('pp'+i);
    if (pp && pp.src && pp.src.indexOf('data:') === 0) {
      if (wy > PH-55) { doc.addPage(); wy = 20; }
      try { doc.addImage(pp.src, 'JPEG', M, wy, TW, 68); wy += 72; } catch(e) {}
    }
  }

  var pages = doc.internal.getNumberOfPages();
  for (var p = 1; p <= pages; p++) {
    doc.setPage(p);
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0, PH-3, PW, 3, 'F');
    doc.setTextColor(130,140,160); doc.setFontSize(6.5); doc.setFont('helvetica','normal');
    doc.text(name+'  ·  '+group+'  ·  '+t('pdf-code')+code+'  ·  '+t('pdf-page')+p+'/'+pages,
      PW/2, PH-5, {align:'center'});
  }

  doc.save(SCHOOL.filePrefix + '_' + name.replace(/\s+/g,'_') + '_' + group.replace(/\s+/g,'_') + '.pdf');
  btn.textContent = t('btn-pdf');
  btn.disabled  = false;
}
</script>
</body>
</html>
