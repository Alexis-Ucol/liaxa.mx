var LANG = 'es';
var LANG_KEY = 'fac_econ_est__lang';
function t(k) { return (TX[LANG] && TX[LANG][k]) || TX.es[k] || k; }

/* ════════════════════════════════════════════════════════════════════════
   STATE
   ════════════════════════════════════════════════════════════════════════ */
var studentData   = {};
var problems      = [];
var sectionDefs   = [];
var widgets       = [];
var answeredCount = 0;
var correctCount  = 0;

/* ════════════════════════════════════════════════════════════════════════
   THEME
   ════════════════════════════════════════════════════════════════════════ */
var THEME_KEY = 'fac_econ_est__theme';
function applyThemeVars(mode) {
  var r = document.documentElement.style;
  if (mode === 'dark') {
    r.setProperty('--green',      SCHOOL.darkPrimary);
    r.setProperty('--green-dark', SCHOOL.darkPrimaryDark);
    r.setProperty('--green-bg',   SCHOOL.darkPrimaryBg);
    r.setProperty('--gold',       SCHOOL.darkAccent);
    r.setProperty('--gold-bg',    SCHOOL.darkAccentBg);
  } else {
    r.setProperty('--green',      SCHOOL.primary);
    r.setProperty('--green-dark', SCHOOL.primaryDark);
    r.setProperty('--green-bg',   SCHOOL.primaryBg);
    r.setProperty('--gold',       SCHOOL.accent);
    r.setProperty('--gold-bg',    SCHOOL.accentBg);
  }
}
function toggleTheme() {
  var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  applyThemeVars(next);
  document.getElementById('themeBtn').textContent = next === 'dark' ? '☀️' : '🌙';
  try { localStorage.setItem(THEME_KEY, next); } catch(e) {}
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
}
(function() {
  document.documentElement.setAttribute('data-theme', 'light');
  applyThemeVars('light');
  try {
    var th = localStorage.getItem(THEME_KEY);
    if (th === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      applyThemeVars('dark');
      document.addEventListener('DOMContentLoaded', function() {
        var b = document.getElementById('themeBtn');
        if (b) b.textContent = '☀️';
      });
    }
  } catch(e) {}
})();

/* ════════════════════════════════════════════════════════════════════════
   ATTEMPT COUNTER + SEEDED RNG
   ════════════════════════════════════════════════════════════════════════ */
function getAttemptKey(name, group) {
  return 'fac_econ_est__att__' + (name + '__' + group).replace(/\s+/g, '_');
}
function nextAttempt(name, group) {
  var k = getAttemptKey(name, group), n = 0;
  try { n = parseInt(localStorage.getItem(k) || '0', 10) || 0; } catch(e) {}
  n++;
  try { localStorage.setItem(k, String(n)); } catch(e) {}
  return n;
}
function currentAttempt(name, group) {
  var k = getAttemptKey(name, group);
  try { return parseInt(localStorage.getItem(k) || '1', 10) || 1; } catch(e) { return 1; }
}
function seededRng(seed) {
  var s = 0;
  for (var i = 0; i < seed.length; i++) s = (Math.imul(31, s) + seed.charCodeAt(i)) | 0;
  return function() {
    s = (s + 0x9e3779b9) | 0;
    var t2 = s ^ (s >>> 16);
    t2 = Math.imul(t2, 0x21f0aaad);
    t2 ^= (t2 >>> 15);
    t2 = Math.imul(t2, 0x735a2d97);
    return ((t2 ^ (t2 >>> 15)) >>> 0) / 4294967296;
  };
}
function pick(arr, rng) { return arr[Math.floor(rng() * arr.length)]; }
function shuffle(arr, rng) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(rng() * (i + 1));
    var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
  }
  return a;
}
/* Shuffles the four options once and keeps both language versions aligned. */
function shuffleOpts(rawEs, rawEn, rng) {
  var p = shuffle([0, 1, 2, 3], rng);
  return {
    es: p.map(function(j) { return rawEs[j]; }),
    en: p.map(function(j) { return rawEn[j]; }),
    correctIdx: p.indexOf(0)
  };
}

/* ════════════════════════════════════════════════════════════════════════
   NUMBER HELPERS + NORMAL MODEL
   ════════════════════════════════════════════════════════════════════════ */
function nf(x) {
  var neg = x < 0, v = Math.abs(x);
  var s = (Math.round(v * 10) / 10).toString().split('.');
  s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return (neg ? '−' : '') + s.join('.');
}
function money(v) { return '$' + nf(Math.round(v)); }
function pr(x)    { return x.toFixed(4); }
function dec2(x)  { return x.toFixed(2); }
/* Percentage with one decimal, identical in both languages. */
function pct1(x)  { return (Math.round(x * 1000) / 10).toFixed(1); }

/* ── NORMAL · X measures a continuous magnitude of the business ── */
function erfc(x) {
  var z = Math.abs(x), tt = 1 / (1 + 0.5 * z);
  var ans = tt * Math.exp(-z * z - 1.26551223 + tt * (1.00002368 + tt * (0.37409196 +
    tt * (0.09678418 + tt * (-0.18628806 + tt * (0.27886807 + tt * (-1.13520398 +
    tt * (1.48851587 + tt * (-0.82215223 + tt * 0.17087277)))))))));
  return x >= 0 ? ans : 2 - ans;
}
function nPdf(z)  { return Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI); }
function nCdf(z)  { return 0.5 * erfc(-z / Math.SQRT2); }
function zOf(x, mu, sd)     { return (x - mu) / sd; }
function pLe(x, mu, sd)     { return nCdf(zOf(x, mu, sd)); }
function pGt(x, mu, sd)     { return 1 - pLe(x, mu, sd); }
function pBet(a, b, mu, sd) { return Math.max(0, pLe(b, mu, sd) - pLe(a, mu, sd)); }
/* Inverse of the standard normal, rational approximation of Acklam. */
function nInv(p) {
  if (p <= 0) return -8; if (p >= 1) return 8;
  var a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02,
           1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00];
  var b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02,
           6.680131188771972e+01, -1.328068155288572e+01];
  var c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00,
           -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00];
  var d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00,
           3.754408661907416e+00];
  var pl = 0.02425, ph = 1 - pl, q, r;
  if (p < pl) {
    q = Math.sqrt(-2 * Math.log(p));
    return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /
           ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
  }
  if (p > ph) {
    q = Math.sqrt(-2 * Math.log(1 - p));
    return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /
            ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
  }
  q = p - 0.5; r = q * q;
  return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5]) * q /
         (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);
}
function xOfP(p, mu, sd) { return mu + nInv(p) * sd; }

/* Four distinct probability strings; the key is always the first value fed in. */
function probOpts(correct, wrongs, rng) {
  var seen = {}, vals = [];
  function add(v) {
    if (typeof v !== 'number' || !isFinite(v)) return;
    if (v <= 0.00005 || v >= 0.99995) return;
    var s = pr(v);
    if (seen[s]) return;
    seen[s] = 1; vals.push(s);
  }
  add(correct);
  for (var i = 0; i < wrongs.length && vals.length < 4; i++) add(wrongs[i]);
  for (var j = 1; vals.length < 4 && j < 900; j++) add(correct * (1 + j * 0.06 * (j % 2 ? 1 : -1)));
  for (var m = 1; vals.length < 4 && m < 900; m++) add(correct + m * 0.0013 * (m % 2 ? 1 : -1));
  return shuffleOpts(vals, vals, rng);
}
/* Same idea for peso amounts. */
function moneyOpts(correct, wrongs, rng) {
  var seen = {}, vals = [];
  function add(v) {
    if (typeof v !== 'number' || !isFinite(v) || v <= 0) return;
    var s = money(v);
    if (seen[s]) return;
    seen[s] = 1; vals.push(s);
  }
  add(correct);
  for (var i = 0; i < wrongs.length && vals.length < 4; i++) add(wrongs[i]);
  for (var j = 1; vals.length < 4 && j < 900; j++) add(correct * (1 + j * 0.07 * (j % 2 ? 1 : -1)));
  return shuffleOpts(vals, vals, rng);
}
/* Four distinct magnitudes with two decimals, aligned across languages. */
function countOpts(correct, wrongs, rng) {
  var seen = {}, vals = [];
  function add(v) {
    if (typeof v !== 'number' || !isFinite(v) || v <= 0) return;
    var s = dec2(v);
    if (seen[s]) return;
    seen[s] = 1; vals.push(s);
  }
  add(correct);
  for (var i = 0; i < wrongs.length && vals.length < 4; i++) add(wrongs[i]);
  for (var j = 1; vals.length < 4 && j < 900; j++) add(correct * (1 + j * 0.09 * (j % 2 ? 1 : -1)));
  return shuffleOpts(vals, vals, rng);
}
function cssv(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }

/* ════════════════════════════════════════════════════════════════════════
   SESSION PERSISTENCE
   ════════════════════════════════════════════════════════════════════════ */
function lsKey() {
  var n = (studentData.name || '').trim(), g = (studentData.group || '').trim();
  return 'fac_econ_est__' + (n + '__' + g).replace(/\s+/g, '_');
}
function saveSession() {
  if (!studentData.name) return;
  var drawings = [], texts = [], photos = [];
  problems.forEach(function(p, i) {
    var dc = document.getElementById('dc' + i);
    if (dc && dc.width) {
      var blank = document.createElement('canvas');
      blank.width = dc.width; blank.height = dc.height;
      drawings.push(dc.toDataURL() === blank.toDataURL() ? null : dc.toDataURL('image/png'));
    } else { drawings.push(null); }
    var ta = document.getElementById('ta' + i);
    texts.push(ta ? ta.value : '');
    var pp = document.getElementById('pp' + i);
    photos.push((pp && pp.src && pp.src.indexOf('data:') === 0) ? pp.src : null);
  });
  var state = {
    name: studentData.name, group: studentData.group,
    answeredCount: answeredCount, correctCount: correctCount,
    choices: problems.map(function(p) { return p.studentChoice; }),
    drawings: drawings, texts: texts, photos: photos
  };
  try { localStorage.setItem(lsKey(), JSON.stringify(state)); } catch(e) {}
}
function loadSession(name, group) {
  var key = 'fac_econ_est__' + (name + '__' + group).replace(/\s+/g, '_');
  try { var r = localStorage.getItem(key); return r ? JSON.parse(r) : null; } catch(e) { return null; }
}
function dismissRestore() { document.getElementById('restoreBar').style.display = 'none'; }
function checkForSavedSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  if (!name || !group) { document.getElementById('restoreBar').style.display = 'none'; return; }
  var saved = loadSession(name, group);
  var bar = document.getElementById('restoreBar');
  bar.style.display = (saved && saved.choices && saved.choices.some(function(c) { return c !== null; })) ? 'block' : 'none';
}
function observeSections() {
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('vis'); });
  }, { threshold: 0.05 });
  document.querySelectorAll('.section').forEach(function(s) { obs.observe(s); });
}

/* ════════════════════════════════════════════════════════════════════════
   START / RESTORE
   ════════════════════════════════════════════════════════════════════════ */
function startLesson() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var err   = document.getElementById('startErr');
  if (!name || !group) { err.textContent = t('err-fields'); return; }
  err.textContent = '';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = nextAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
}
function restoreSession() {
  var name  = document.getElementById('sName').value.trim();
  var group = document.getElementById('sGroup').value.trim();
  var saved = loadSession(name, group);
  if (!saved) return;
  document.getElementById('restoreBar').style.display = 'none';
  studentData = { name: name, group: group };
  answeredCount = 0; correctCount = 0;
  var att = currentAttempt(name, group);
  var rng = seededRng(name + group + att);
  buildLesson(rng);
  document.getElementById('welcomeScreen').style.display = 'none';
  document.getElementById('lessonScreen').style.display  = 'block';
  document.getElementById('studentChip').textContent = name + ' · ' + group;
  observeSections();
  saved.choices.forEach(function(choice, idx) {
    if (choice !== null && choice !== undefined) confirmMC(idx, choice);
  });
  setTimeout(function() {
    if (saved.drawings) saved.drawings.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var dc = document.getElementById('dc' + i);
      if (!dc || !dc.width) return;
      var img = new Image();
      img.onload = function() {
        var dpr = window.devicePixelRatio || 1;
        dc.getContext('2d').drawImage(img, 0, 0, dc.width / dpr, dc.height / dpr);
      };
      img.src = dataUrl;
    });
    if (saved.texts) saved.texts.forEach(function(txt, i) {
      if (!txt) return;
      var ta = document.getElementById('ta' + i);
      if (ta) ta.value = txt;
    });
    if (saved.photos) saved.photos.forEach(function(dataUrl, i) {
      if (!dataUrl) return;
      var pp = document.getElementById('pp' + i);
      if (!pp) return;
      pp.src = dataUrl; pp.style.display = 'block';
      var pz = document.getElementById('pz' + i);
      if (pz) pz.style.opacity = '0.4';
    });
  }, 300);
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS / TABS / PHOTO / HINT / RESULTS
   ════════════════════════════════════════════════════════════════════════ */
function initCanvas(canvas) {
  var dpr  = window.devicePixelRatio || 1;
  var rect = canvas.getBoundingClientRect();
  canvas.width  = rect.width  * dpr;
  canvas.height = rect.height * dpr;
  var ctx = canvas.getContext('2d');
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.scale(dpr, dpr);
  ctx.strokeStyle = '#2d5a27';
  ctx.lineWidth   = 2;
  ctx.lineCap     = 'round';
  ctx.lineJoin    = 'round';
  var drawing = false, lx = 0, ly = 0;
  var tb = canvas.closest('.cvwrap').querySelector('.ctoolbar');
  function getPos(e) {
    var r = canvas.getBoundingClientRect();
    var src = e.touches ? e.touches[0] : e;
    return [src.clientX - r.left, src.clientY - r.top];
  }
  function onDown(e) { e.preventDefault(); drawing = true; var p = getPos(e); lx = p[0]; ly = p[1]; }
  function onMove(e) { e.preventDefault(); if (!drawing) return; var p = getPos(e); ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p[0], p[1]); ctx.stroke(); lx = p[0]; ly = p[1]; }
  function onUp() { drawing = false; saveSession(); }
  canvas.addEventListener('mousedown',  onDown, { passive:false });
  canvas.addEventListener('mousemove',  onMove, { passive:false });
  canvas.addEventListener('mouseup',    onUp);
  canvas.addEventListener('mouseleave', onUp);
  canvas.addEventListener('touchstart', onDown, { passive:false });
  canvas.addEventListener('touchmove',  onMove, { passive:false });
  canvas.addEventListener('touchend',   onUp);
  tb.querySelectorAll('.tbtn2').forEach(function(btn) {
    btn.addEventListener('click', function() {
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      if (btn.classList.contains('bpen'))    { ctx.lineWidth = 2; }
      if (btn.classList.contains('bmarker')) { ctx.lineWidth = 10; ctx.globalAlpha = 0.45; }
      if (btn.classList.contains('beraser')) { ctx.globalCompositeOperation = 'destination-out'; ctx.lineWidth = 20; }
    });
  });
  tb.querySelectorAll('.cdot').forEach(function(dot) {
    dot.addEventListener('click', function() {
      tb.querySelectorAll('.cdot').forEach(function(d) { d.classList.remove('sel'); });
      dot.classList.add('sel');
      ctx.strokeStyle = dot.dataset.color;
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      tb.querySelectorAll('.tbtn2').forEach(function(b) { b.classList.remove('on'); });
      tb.querySelector('.bpen').classList.add('on');
    });
  });
  tb.querySelector('.clrbtn').addEventListener('click', function() {
    ctx.clearRect(0, 0, canvas.width / dpr, canvas.height / dpr);
  });
}
function switchTab(idx, panel, btn) {
  var prefix = 'wp_' + idx + '_';
  document.querySelectorAll('[id^="' + prefix + '"]').forEach(function(p) { p.classList.remove('active'); });
  document.getElementById(prefix + panel).classList.add('active');
  btn.closest('.wtabs').querySelectorAll('.wtab').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
}
function handlePhoto(idx, input) {
  if (!input.files || !input.files[0]) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var img = document.getElementById('pp' + idx);
    img.src = e.target.result;
    img.style.display = 'block';
    document.getElementById('pz' + idx).style.opacity = '0.4';
    saveSession();
  };
  reader.readAsDataURL(input.files[0]);
}
function toggleHint(idx) { document.getElementById('hint' + idx).classList.toggle('show'); }
function showResults() {
  var rb = document.getElementById('s_results');
  if (!rb) return;
  rb.style.display = 'block';
  setTimeout(function() {
    rb.classList.add('vis');
    rb.scrollIntoView({ behavior:'smooth', block:'center' });
  }, 50);
}

/* ════════════════════════════════════════════════════════════════════════
   ANSWER HANDLER · two taps to confirm
   ════════════════════════════════════════════════════════════════════════ */
function handleMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  if (prob.pendingChoice === chosenIdx) {
    prob.studentChoice = chosenIdx;
    prob.pendingChoice = null;
    var isOk = (chosenIdx === prob.correctIdx);
    opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
    opts.forEach(function(o, i) {
      if (i === prob.correctIdx) o.classList.add('rc');
      if (i === chosenIdx && isOk)  o.classList.add('sc');
      if (i === chosenIdx && !isOk) o.classList.add('sw');
    });
    var fb = document.getElementById('fb' + probIdx);
    fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.explanation;
    fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
    document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
    if (isOk) correctCount++;
    answeredCount++;
    document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
    saveSession();
    if (answeredCount === problems.length) setTimeout(showResults, 700);
    return;
  }
  prob.pendingChoice = chosenIdx;
  opts.forEach(function(o) { o.classList.remove('pending'); });
  opts[chosenIdx].classList.add('pending');
}
function confirmMC(probIdx, chosenIdx) {
  var prob = problems[probIdx];
  if (!prob || prob.studentChoice !== null) return;
  var opts = document.querySelectorAll('#pc' + probIdx + ' .mcopt');
  prob.studentChoice = chosenIdx;
  prob.pendingChoice = null;
  var isOk = (chosenIdx === prob.correctIdx);
  opts.forEach(function(o) { o.classList.add('dis'); o.classList.remove('pending'); });
  opts.forEach(function(o, i) {
    if (i === prob.correctIdx) o.classList.add('rc');
    if (i === chosenIdx && isOk)  o.classList.add('sc');
    if (i === chosenIdx && !isOk) o.classList.add('sw');
  });
  var fb = document.getElementById('fb' + probIdx);
  fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + prob.explanation;
  fb.className = 'mcfb show ' + (isOk ? 'fbok' : 'fbbad');
  document.getElementById('pc' + probIdx).classList.add(isOk ? 'ok' : 'bad');
  if (isOk) correctCount++;
  answeredCount++;
  document.getElementById('progFill').style.width = (answeredCount / problems.length * 100) + '%';
  saveSession();
  if (answeredCount === problems.length) setTimeout(showResults, 700);
}

/* ════════════════════════════════════════════════════════════════════════
   BUILD ONE CARD · appended inline, right after its concept
   ════════════════════════════════════════════════════════════════════════ */
function buildOneCard(prob, i) {
  var opts = prob.options.map(function(opt, oi) {
    return '<div class="mcopt" onclick="handleMC(' + i + ',' + oi + ')">' + opt + '</div>';
  }).join('');
  var work = '';
  if (prob.showWork) {
    work =
      '<div style="margin-bottom:.85rem">' +
        '<div class="wtabs">' +
          '<button class="wtab active" onclick="switchTab(' + i + ',\'draw\',this)">' + t('tab-draw') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'type\',this)">' + t('tab-type') + '</button>' +
          '<button class="wtab"        onclick="switchTab(' + i + ',\'photo\',this)">' + t('tab-photo') + '</button>' +
        '</div>' +
        '<div class="wpanel active" id="wp_' + i + '_draw">' +
          '<div class="cvwrap">' +
            '<canvas class="dcanvas" id="dc' + i + '"></canvas>' +
            '<div class="ctoolbar">' +
              '<button class="tbtn2 bpen on">' + t('tool-pen') + '</button>' +
              '<button class="tbtn2 bmarker">' + t('tool-mark') + '</button>' +
              '<button class="tbtn2 beraser">' + t('tool-erase') + '</button>' +
              '<div class="cdot sel" data-color="#2d5a27" style="background:#2d5a27"></div>' +
              '<div class="cdot"     data-color="#1a1a16" style="background:#1a1a16"></div>' +
              '<div class="cdot"     data-color="#8b2500" style="background:#8b2500"></div>' +
              '<div class="cdot"     data-color="#1d4e89" style="background:#1d4e89"></div>' +
              '<button class="clrbtn">' + t('tool-clear') + '</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_type">' +
          '<textarea class="wtextarea" id="ta' + i + '" placeholder="' + t('ph-work') + '" oninput="saveSession()"></textarea>' +
        '</div>' +
        '<div class="wpanel" id="wp_' + i + '_photo">' +
          '<div class="pzone" id="pz' + i + '">' +
            '<input type="file" accept="image/*" onchange="handlePhoto(' + i + ',this)">' +
            '<div class="pzicon">📸</div>' +
            '<div class="pztxt">' + t('ph-photo') + '</div>' +
          '</div>' +
          '<img class="ppreview" id="pp' + i + '" alt="' + t('alt-work') + '">' +
        '</div>' +
      '</div>';
  }
  var card = document.createElement('div');
  card.className = 'pcrd section';
  card.id = 'pc' + i;
  card.innerHTML =
    '<div class="phdr"><div class="pnum">' + (i + 1) + '</div><div class="ptitle">' + prob.title + '</div></div>' +
    '<div class="pbody">' +
      '<div class="pstmt">' + prob.questionText + '<span class="pfn">' + (prob.fn || '') + '</span></div>' +
      work +
      '<button class="hintbtn" onclick="toggleHint(' + i + ')">' + t('btn-hint') + '</button>' +
      '<div class="hintbox" id="hint' + i + '">' + (prob.hint || '') + '</div>' +
      '<div style="margin-top:.7rem">' +
        '<div style="font-family:\'IBM Plex Mono\',monospace;font-size:.65rem;letter-spacing:.1em;color:var(--text3);text-transform:uppercase;margin-bottom:.5rem">' + t('lbl-answer') + '</div>' +
        '<div class="mcopts">' + opts + '</div>' +
        '<div class="mcfb" id="fb' + i + '"></div>' +
      '</div>' +
    '</div>';
  document.getElementById('lessonBody').appendChild(card);
  if (prob.showWork) setTimeout(function() { var c = document.getElementById('dc' + i); if (c) initCanvas(c); }, 80);
}

/* ════════════════════════════════════════════════════════════════════════
   SECTION REGISTRY  (concept text is re-rendered on language switch)
   ════════════════════════════════════════════════════════════════════════ */
function addSection(fn) {
  var d = document.createElement('div');
  d.className = 'section';
  d.innerHTML = fn(LANG);
  document.getElementById('lessonBody').appendChild(d);
  sectionDefs.push({ el: d, fn: fn });
}
function applySectionLang() {
  sectionDefs.forEach(function(s) { s.el.innerHTML = s.fn(LANG); });
}

/* ════════════════════════════════════════════════════════════════════════
   CANVAS PRIMITIVES FOR THE WIDGETS
   ════════════════════════════════════════════════════════════════════════ */
function fitCanvas(cv, h) {
  var dpr = window.devicePixelRatio || 1;
  var w = Math.max(240, cv.clientWidth || cv.parentNode.clientWidth || 300);
  cv.style.height = h + 'px';
  cv.width  = Math.round(w * dpr);
  cv.height = Math.round(h * dpr);
  var ctx = cv.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);
  return { ctx: ctx, w: w, h: h };
}
function palette() {
  return {
    green: cssv('--green'), dark: cssv('--green-dark'), tint: cssv('--green-bg'),
    gold: cssv('--gold'), bad: cssv('--bad'), border: cssv('--border'),
    text: cssv('--text'), text2: cssv('--text2'), text3: cssv('--text3')
  };
}
/* Draws the density curve of a normal model over four standard deviations
   on each side. bands is a list of regions to shade, each one with a kind:
   0 pale, 1 green for the region that answers the question, 2 gold for the
   tail that is left out. opts may carry a label formatter and edge marks. */
function drawCurve(g, mu, sd, bands, opts) {
  var ctx = g.ctx, P = palette(), W = g.w, H = g.h;
  var padL = 12, padR = 12, padT = 16, padB = 22;
  var x0 = mu - 4 * sd, x1 = mu + 4 * sd, i;
  opts = opts || {};
  var fmt = opts.fmt || function(v) { return nf(v); };
  function X(v) { return padL + (v - x0) / (x1 - x0) * (W - padL - padR); }
  var peak = nPdf(0) / sd;
  function Y(d) { return H - padB - d / peak * (H - padT - padB); }
  function dens(v) { return nPdf((v - mu) / sd) / sd; }
  var step = (x1 - x0) / 260;
  (bands || []).forEach(function(b) {
    var a = Math.max(x0, b.a), c = Math.min(x1, b.b), v;
    if (c <= a) return;
    ctx.beginPath();
    ctx.moveTo(X(a), H - padB);
    for (v = a; v <= c; v += step) ctx.lineTo(X(v), Y(dens(v)));
    ctx.lineTo(X(c), Y(dens(c)));
    ctx.lineTo(X(c), H - padB);
    ctx.closePath();
    ctx.fillStyle = b.kind === 2 ? P.gold : b.kind === 1 ? P.green : P.tint;
    ctx.globalAlpha = b.kind === 0 ? 1 : 0.42;
    ctx.fill();
    ctx.globalAlpha = 1;
  });
  ctx.strokeStyle = P.border; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(padL, H - padB); ctx.lineTo(W - padR, H - padB); ctx.stroke();
  ctx.strokeStyle = P.dark; ctx.lineWidth = 2;
  ctx.beginPath();
  for (i = 0; i <= 260; i++) {
    var vv = x0 + i * step;
    if (i === 0) ctx.moveTo(X(vv), Y(dens(vv))); else ctx.lineTo(X(vv), Y(dens(vv)));
  }
  ctx.stroke();
  (opts.marks || []).forEach(function(m) {
    if (m < x0 || m > x1) return;
    ctx.save();
    ctx.strokeStyle = P.gold; ctx.lineWidth = 1.8;
    ctx.beginPath(); ctx.moveTo(X(m), H - padB); ctx.lineTo(X(m), Y(dens(m))); ctx.stroke();
    ctx.restore();
  });
  ctx.save();
  ctx.strokeStyle = P.dark; ctx.lineWidth = 1.6; ctx.setLineDash([4, 3]);
  ctx.beginPath(); ctx.moveTo(X(mu), padT - 8); ctx.lineTo(X(mu), H - padB); ctx.stroke();
  ctx.restore();
  if (opts.muLabel) {
    ctx.fillStyle = P.dark; ctx.font = '600 10px "IBM Plex Sans", sans-serif';
    var lw = ctx.measureText(opts.muLabel).width;
    ctx.fillText(opts.muLabel, Math.min(Math.max(2, X(mu) - lw / 2), W - lw - 2), 11);
  }
  ctx.fillStyle = P.text3; ctx.font = '9px "IBM Plex Mono", monospace';
  for (i = -2; i <= 2; i++) {
    var tv = mu + i * sd, lab = fmt(tv), tw = ctx.measureText(lab).width;
    ctx.fillText(lab, Math.min(Math.max(1, X(tv) - tw / 2), W - tw - 1), H - padB + 13);
  }
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 1 · the bell, its two parameters and the empirical rule
   ════════════════════════════════════════════════════════════════════════ */
function widgetBell(mu0, sd0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { mu: Math.round(mu0 / 1000), sd: Math.round(sd0 / 1000), k: 1 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 1, es: 'Una desviación',    en: 'One deviation' },
      { id: 2, es: 'Dos desviaciones',  en: 'Two deviations' },
      { id: 3, es: 'Tres desviaciones', en: 'Three deviations' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.k ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="campana-y-regla-empirica">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'La campana de las ventas diarias' : 'The bell of daily sales') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Una sucursal comercial registra el monto vendido cada día. Mueve el promedio y la desviación estándar y observa dos cosas distintas: el promedio desplaza la campana completa sin cambiar su forma, mientras que la desviación estándar la ensancha o la angosta sin moverla de lugar. Cambia también el número de desviaciones sombreadas y compara la proporción de días que quedan dentro con la regla empírica.'
          : 'A retail branch records the amount sold each day. Move the average and the standard deviation and watch two different things: the average shifts the whole bell without changing its shape, while the standard deviation widens or narrows it without moving it. Change the number of shaded deviations as well and compare the share of days that fall inside with the empirical rule.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Venta promedio del día' : 'Average daily sales') + ': <span class="cval" id="b1ml"></span></label>' +
          '<input type="range" min="30" max="90" step="2" id="b1m" value="' + state.mu + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Desviación estándar' : 'Standard deviation') + ': <span class="cval" id="b1sl"></span></label>' +
          '<input type="range" min="2" max="14" step="1" id="b1s" value="' + state.sd + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="b1cv"></canvas>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Límite inferior' : 'Lower limit') + '</div><div class="mnum ts" id="b1lo"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Límite superior' : 'Upper limit') + '</div><div class="mnum ts" id="b1hi"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Días dentro del rango' : 'Days inside the range') + '</div><div class="mnum cs" id="b1in"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Días del mes dentro' : 'Days of the month inside') + '</div><div class="mnum cs" id="b1mo"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Días arriba del límite' : 'Days above the limit') + '</div><div class="mnum ps" id="b1up"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Variación relativa' : 'Relative variation') + '</div><div class="mnum ts" id="b1cv2"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="b1read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.k = parseInt(b.getAttribute('data-m'), 10);
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#b1m').addEventListener('input', function() { state.mu = parseInt(this.value, 10); update(); });
    host.querySelector('#b1s').addEventListener('input', function() { state.sd = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var mu = state.mu * 1000, sd = state.sd * 1000, k = state.k;
    var lo = mu - k * sd, hi = mu + k * sd;
    var inside = pBet(lo, hi, mu, sd), up = pGt(hi, mu, sd);
    host.querySelector('#b1ml').textContent  = money(mu);
    host.querySelector('#b1sl').textContent  = money(sd);
    host.querySelector('#b1lo').textContent  = money(lo);
    host.querySelector('#b1hi').textContent  = money(hi);
    host.querySelector('#b1in').textContent  = pr(inside);
    host.querySelector('#b1mo').textContent  = dec2(inside * 30);
    host.querySelector('#b1up').textContent  = pr(up);
    host.querySelector('#b1cv2').textContent = dec2(sd / mu);
    host.querySelector('#b1read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> con una venta promedio de ' + money(mu) + ' y una desviación estándar de ' + money(sd) + ', el ' + pct1(inside) + ' por ciento de los días la sucursal vende entre ' + money(lo) + ' y ' + money(hi) + '. Eso equivale a ' + dec2(inside * 30) + ' días de un mes de treinta. La cola dorada del lado derecho vale ' + pr(up) + ': son los días excepcionalmente buenos, y su espejo del lado izquierdo son los días en que la caja no alcanza para cubrir el gasto fijo. Hay que notar que la desviación estándar mide ' + dec2(sd / mu) + ' veces el promedio, y esa razón es la que permite comparar la estabilidad de esta sucursal contra otra que vende volúmenes distintos.'
      : '<strong>Business reading:</strong> with average sales of ' + money(mu) + ' and a standard deviation of ' + money(sd) + ', on ' + pct1(inside) + ' percent of the days the branch sells between ' + money(lo) + ' and ' + money(hi) + '. That amounts to ' + dec2(inside * 30) + ' days in a month of thirty. The gold tail on the right is worth ' + pr(up) + ': those are the exceptionally good days, and its mirror image on the left holds the days when the till does not cover fixed costs. It is worth noting that the standard deviation measures ' + dec2(sd / mu) + ' times the average, and that ratio is what allows the stability of this branch to be compared with another one selling different volumes.';
    var g = fitCanvas(host.querySelector('#b1cv'), 160);
    drawCurve(g, mu, sd,
      [{ a: mu - 4 * sd, b: lo, kind: 2 }, { a: lo, b: hi, kind: 1 }, { a: hi, b: mu + 4 * sd, kind: 2 }],
      { marks: [lo, hi], fmt: function(v) { return money(v); },
        muLabel: (es ? 'Promedio ' : 'Average ') + money(mu) });
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 2 · the z score turns any question into the same question
   ════════════════════════════════════════════════════════════════════════ */
function widgetZScore(mu0, sd0, x0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { mode: 'le', mu: mu0, sd: sd0, x: x0 };
  function mount() {
    var es = LANG === 'es';
    var MODES = [
      { id: 'le', es: 'Dentro del plazo', en: 'Within the deadline' },
      { id: 'gt', es: 'Fuera del plazo',  en: 'Past the deadline' }
    ];
    var tabs = MODES.map(function(m) {
      return '<button class="mtab' + (m.id === state.mode ? ' active' : '') + '" data-m="' + m.id + '">' + m[LANG] + '</button>';
    }).join('');
    host.innerHTML =
      '<div class="gcrd" data-widget="puntaje-z-y-area">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'El plazo contratado medido en desviaciones' : 'The contracted deadline measured in deviations') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Un proveedor entrega pedidos en un tiempo que varía alrededor de un promedio. Mueve el plazo que aparece en el contrato y observa el puntaje z: es la distancia entre el plazo y el promedio, contada en desviaciones estándar. Fija el plazo en distintos puntos y verifica que dos escenarios con promedios y desviaciones muy distintos dan la misma área siempre que su puntaje z coincida.'
          : 'A supplier delivers orders in a time that varies around an average. Move the deadline written in the contract and watch the z score: it is the distance between the deadline and the average, counted in standard deviations. Set the deadline at different points and check that two scenarios with very different averages and deviations give the same area whenever their z score matches.') + '</div>' +
        '<div class="mtabs">' + tabs + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Tiempo promedio de entrega en horas' : 'Average delivery time in hours') + ': <span class="cval" id="z2ml"></span></label>' +
          '<input type="range" min="20" max="80" step="2" id="z2m" value="' + state.mu + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Desviación estándar en horas' : 'Standard deviation in hours') + ': <span class="cval" id="z2sl"></span></label>' +
          '<input type="range" min="2" max="16" step="1" id="z2s" value="' + state.sd + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Plazo del contrato en horas' : 'Contract deadline in hours') + ': <span class="cval" id="z2xl"></span></label>' +
          '<input type="range" min="10" max="110" step="1" id="z2x" value="' + state.x + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Franja verde' : 'Green band') + '</label>' +
          '<div style="font-size:.74rem;color:var(--text3)">' + (es ? 'Es el área que responde a la pregunta elegida' : 'It is the area answering the question you chose') + '</div>' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="z2cv"></canvas>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Puntaje z del plazo' : 'z score of the deadline') + '</div><div class="mnum ps" id="z2z"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Entregas dentro del plazo' : 'Deliveries within the deadline') + '</div><div class="mnum cs" id="z2le"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Entregas fuera del plazo' : 'Deliveries past the deadline') + '</div><div class="mnum ps" id="z2gt"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Retrasos de cada 100 pedidos' : 'Late orders out of 100') + '</div><div class="mnum ts" id="z2100"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Holgura sobre el promedio' : 'Slack over the average') + '</div><div class="mnum ts" id="z2sl2"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Plazo del 95 por ciento' : 'Deadline for 95 percent') + '</div><div class="mnum cs" id="z295"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="z2read"></div>' +
      '</div>';
    host.querySelectorAll('.mtab').forEach(function(b) {
      b.addEventListener('click', function() {
        state.mode = b.getAttribute('data-m');
        host.querySelectorAll('.mtab').forEach(function(x) { x.classList.remove('active'); });
        b.classList.add('active');
        update();
      });
    });
    host.querySelector('#z2m').addEventListener('input', function() { state.mu = parseInt(this.value, 10); update(); });
    host.querySelector('#z2s').addEventListener('input', function() { state.sd = parseInt(this.value, 10); update(); });
    host.querySelector('#z2x').addEventListener('input', function() { state.x  = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var mu = state.mu, sd = state.sd, x = state.x;
    var z = zOf(x, mu, sd), le = pLe(x, mu, sd), gt = 1 - le;
    var p95 = xOfP(0.95, mu, sd);
    host.querySelector('#z2ml').textContent  = dec2(mu);
    host.querySelector('#z2sl').textContent  = dec2(sd);
    host.querySelector('#z2xl').textContent  = dec2(x);
    host.querySelector('#z2z').textContent   = dec2(z);
    host.querySelector('#z2le').textContent  = pr(le);
    host.querySelector('#z2gt').textContent  = pr(gt);
    host.querySelector('#z2100').textContent = dec2(gt * 100);
    host.querySelector('#z2sl2').textContent = dec2(x - mu);
    host.querySelector('#z295').textContent  = dec2(p95);
    var msg = (state.mode === 'le')
      ? (es
        ? 'La franja verde acumula todo lo que queda por debajo del plazo: ' + pr(le) + ' de las entregas llegan a tiempo.'
        : 'The green band accumulates everything below the deadline: ' + pr(le) + ' of the deliveries arrive on time.')
      : (es
        ? 'La franja verde recoge la cola derecha: ' + pr(gt) + ' de las entregas rebasan el plazo y disparan la penalización del contrato.'
        : 'The green band picks up the right tail: ' + pr(gt) + ' of the deliveries go past the deadline and trigger the contract penalty.');
    host.querySelector('#z2read').innerHTML = (es
      ? '<strong>Lectura de negocio:</strong> el plazo de ' + dec2(x) + ' horas está a ' + dec2(x - mu) + ' horas del promedio, que en unidades de desviación estándar equivale a un puntaje z de ' + dec2(z) + '. '
      : '<strong>Business reading:</strong> the deadline of ' + dec2(x) + ' hours sits ' + dec2(x - mu) + ' hours away from the average, which in units of standard deviation amounts to a z score of ' + dec2(z) + '. ') + msg + (es
      ? ' De cada cien pedidos, ' + dec2(gt * 100) + ' llegarían tarde. Si el área comercial quisiera prometer el plazo con un cumplimiento del noventa y cinco por ciento tendría que ofrecer ' + dec2(p95) + ' horas, y esa diferencia es justo lo que se negocia con el cliente.'
      : ' Out of every hundred orders, ' + dec2(gt * 100) + ' would arrive late. If the sales team wanted to promise the deadline with ninety five percent compliance it would have to offer ' + dec2(p95) + ' hours, and that difference is exactly what gets negotiated with the client.');
    var g = fitCanvas(host.querySelector('#z2cv'), 160);
    var bands = (state.mode === 'le')
      ? [{ a: mu - 4 * sd, b: x, kind: 1 }, { a: x, b: mu + 4 * sd, kind: 2 }]
      : [{ a: mu - 4 * sd, b: x, kind: 0 }, { a: x, b: mu + 4 * sd, kind: 1 }];
    drawCurve(g, mu, sd, bands,
      { marks: [x], fmt: function(v) { return dec2(v); },
        muLabel: (es ? 'Promedio ' : 'Average ') + dec2(mu) });
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 3 · a tolerance band and the units it leaves out
   ════════════════════════════════════════════════════════════════════════ */
function widgetTolerance(mu0, sd0, a0, b0, c0, n0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { sd: sd0, a: a0, b: b0, c: c0 };
  var mu = mu0, n = n0;
  function mount() {
    var es = LANG === 'es';
    host.innerHTML =
      '<div class="gcrd" data-widget="banda-de-tolerancia">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Tolerancia de llenado y unidades reprocesadas' : 'Filling tolerance and reprocessed units') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Una planta envasa producto con un peso objetivo y una máquina que nunca da el mismo peso dos veces. El contrato con el cliente fija una tolerancia por abajo y otra por arriba, y cada pieza fuera de la banda se reprocesa con un costo. Mueve las dos tolerancias por separado y la precisión de la máquina, y observa qué hace bajar más el costo del lote: abrir la tolerancia o comprar precisión.'
          : 'A plant packs product with a target weight and a machine that never gives the same weight twice. The contract with the client sets one tolerance below and another above, and every piece outside the band is reprocessed at a cost. Move the two tolerances separately and the precision of the machine, and watch which one cuts the cost of the lot faster: opening the tolerance or buying precision.') + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Tolerancia por abajo en gramos' : 'Tolerance below in grams') + ': <span class="cval" id="t3al"></span></label>' +
          '<input type="range" min="4" max="34" step="2" id="t3a" value="' + state.a + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Tolerancia por arriba en gramos' : 'Tolerance above in grams') + ': <span class="cval" id="t3bl"></span></label>' +
          '<input type="range" min="4" max="34" step="2" id="t3b" value="' + state.b + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Desviación estándar de la máquina' : 'Standard deviation of the machine') + ': <span class="cval" id="t3sl"></span></label>' +
          '<input type="range" min="2" max="20" step="1" id="t3s" value="' + state.sd + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Costo de reprocesar una pieza' : 'Cost of reprocessing one piece') + ': <span class="cval" id="t3cl"></span></label>' +
          '<input type="range" min="5" max="60" step="5" id="t3c" value="' + state.c + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="t3cv"></canvas>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Dentro de la tolerancia' : 'Inside the tolerance') + '</div><div class="mnum cs" id="t3in"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Fuera de la tolerancia' : 'Outside the tolerance') + '</div><div class="mnum ps" id="t3out"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Puntaje z del límite bajo' : 'z score of the low limit') + '</div><div class="mnum ts" id="t3za"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Puntaje z del límite alto' : 'z score of the high limit') + '</div><div class="mnum ts" id="t3zb"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Piezas del lote reprocesadas' : 'Pieces of the lot reprocessed') + '</div><div class="mnum ps" id="t3u"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Costo del lote' : 'Cost of the lot') + '</div><div class="mnum cs" id="t3cost"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="t3read"></div>' +
      '</div>';
    host.querySelector('#t3a').addEventListener('input', function() { state.a  = parseInt(this.value, 10); update(); });
    host.querySelector('#t3b').addEventListener('input', function() { state.b  = parseInt(this.value, 10); update(); });
    host.querySelector('#t3s').addEventListener('input', function() { state.sd = parseInt(this.value, 10); update(); });
    host.querySelector('#t3c').addEventListener('input', function() { state.c  = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var sd = state.sd, lo = mu - state.a, hi = mu + state.b;
    var inside = pBet(lo, hi, mu, sd), out = 1 - inside;
    var units = n * out, cost = units * state.c;
    var lowTail = pLe(lo, mu, sd), highTail = pGt(hi, mu, sd);
    host.querySelector('#t3al').textContent   = dec2(state.a);
    host.querySelector('#t3bl').textContent   = dec2(state.b);
    host.querySelector('#t3sl').textContent   = dec2(sd);
    host.querySelector('#t3cl').textContent   = money(state.c);
    host.querySelector('#t3in').textContent   = pr(inside);
    host.querySelector('#t3out').textContent  = pr(out);
    host.querySelector('#t3za').textContent   = dec2(zOf(lo, mu, sd));
    host.querySelector('#t3zb').textContent   = dec2(zOf(hi, mu, sd));
    host.querySelector('#t3u').textContent    = dec2(units);
    host.querySelector('#t3cost').textContent = money(cost);
    var heavier = (lowTail > highTail)
      ? (es ? 'La cola que más pesa es la de abajo, con ' + pr(lowTail) + ', de modo que el problema principal son las piezas que salen con menos producto del prometido, y esas son las que el cliente reclama.'
            : 'The heavier tail is the lower one, at ' + pr(lowTail) + ', so the main problem is the pieces leaving with less product than promised, and those are the ones the client complains about.')
      : (es ? 'La cola que más pesa es la de arriba, con ' + pr(highTail) + ', de modo que el problema principal es el producto regalado: cada pieza sobrellenada se entrega sin cobrarse.'
            : 'The heavier tail is the upper one, at ' + pr(highTail) + ', so the main problem is giveaway: every overfilled piece is delivered without being charged for.');
    host.querySelector('#t3read').innerHTML = (es
      ? '<strong>Lectura de negocio:</strong> con una desviación estándar de ' + dec2(sd) + ' gramos, el ' + pct1(inside) + ' por ciento de las piezas cae entre ' + dec2(lo) + ' y ' + dec2(hi) + ' gramos. En un lote de ' + n + ' piezas eso deja ' + dec2(units) + ' piezas fuera de especificación y un costo de reproceso de ' + money(cost) + '. '
      : '<strong>Business reading:</strong> with a standard deviation of ' + dec2(sd) + ' grams, ' + pct1(inside) + ' percent of the pieces fall between ' + dec2(lo) + ' and ' + dec2(hi) + ' grams. In a lot of ' + n + ' pieces that leaves ' + dec2(units) + ' pieces out of specification and a reprocessing cost of ' + money(cost) + '. ') + heavier + (es
      ? ' Conviene probar las dos palancas: abrir la tolerancia es gratis pero hay que negociarlo con el cliente, mientras que reducir la desviación estándar exige inversión en la máquina y no requiere el permiso de nadie.'
      : ' It pays to test both levers: opening the tolerance is free but has to be negotiated with the client, while reducing the standard deviation demands investment in the machine and requires nobody else consent.');
    var g = fitCanvas(host.querySelector('#t3cv'), 160);
    drawCurve(g, mu, sd,
      [{ a: mu - 4 * sd, b: lo, kind: 2 }, { a: lo, b: hi, kind: 1 }, { a: hi, b: mu + 4 * sd, kind: 2 }],
      { marks: [lo, hi], fmt: function(v) { return dec2(v); },
        muLabel: (es ? 'Objetivo ' : 'Target ') + dec2(mu) });
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   WIDGET 4 · reading the curve backwards to set a service level
   ════════════════════════════════════════════════════════════════════════ */
function widgetServiceLevel(mu0, sd0, c0, sl0) {
  var host = document.createElement('div');
  host.className = 'section';
  document.getElementById('lessonBody').appendChild(host);
  var state = { mu: mu0, sd: sd0, c: c0, sl: sl0 };
  function mount() {
    var es = LANG === 'es';
    host.innerHTML =
      '<div class="gcrd" data-widget="nivel-de-servicio-inventario">' +
        '<div class="iw-head"><span class="iw-tag">' + (es ? 'Herramienta' : 'Tool') + '</span>' +
        '<span class="iw-title">' + (es ? 'Del nivel de servicio al punto de reorden' : 'From the service level to the reorder point') + '</span></div>' +
        '<div class="iw-sub">' + (es
          ? 'Un almacén decide cuánto inventario tener disponible durante el tiempo que tarda el proveedor en surtir. Aquí la pregunta se lee al revés: primero eliges el porcentaje de semanas que quieres cubrir y después la curva devuelve el nivel de inventario que hace falta. Sube el nivel de servicio poco a poco y observa qué le pasa al inventario de seguridad conforme te acercas al cien por ciento.'
          : 'A warehouse decides how much stock to hold during the time the supplier takes to replenish. Here the question is read backwards: you first choose the percentage of weeks you want to cover and then the curve returns the stock level needed. Raise the service level little by little and watch what happens to the safety stock as you approach one hundred percent.') + '</div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Nivel de servicio en por ciento' : 'Service level in percent') + ': <span class="cval" id="s4sll"></span></label>' +
          '<input type="range" min="50" max="99" step="1" id="s4sl" value="' + state.sl + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Demanda promedio de la semana' : 'Average weekly demand') + ': <span class="cval" id="s4ml"></span></label>' +
          '<input type="range" min="200" max="800" step="20" id="s4m" value="' + state.mu + '">' +
        '</div></div>' +
        '<div class="cgrid"><div class="cg">' +
          '<label>' + (es ? 'Desviación estándar de la demanda' : 'Standard deviation of demand') + ': <span class="cval" id="s4sdl"></span></label>' +
          '<input type="range" min="20" max="120" step="10" id="s4sd" value="' + state.sd + '">' +
        '</div><div class="cg">' +
          '<label>' + (es ? 'Costo anual de mantener una unidad' : 'Annual cost of holding one unit') + ': <span class="cval" id="s4cl"></span></label>' +
          '<input type="range" min="5" max="60" step="5" id="s4c" value="' + state.c + '">' +
        '</div></div>' +
        '<canvas class="iw-canvas" id="s4cv"></canvas>' +
        '<div class="metrics">' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Puntaje z del nivel' : 'z score of the level') + '</div><div class="mnum ps" id="s4z"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Punto de reorden' : 'Reorder point') + '</div><div class="mnum cs" id="s4rp"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Inventario de seguridad' : 'Safety stock') + '</div><div class="mnum cs" id="s4ss"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Costo del inventario de seguridad' : 'Cost of the safety stock') + '</div><div class="mnum ts" id="s4cost"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Riesgo de desabasto' : 'Stockout risk') + '</div><div class="mnum ps" id="s4risk"></div></div>' +
          '<div class="metric"><div class="mlbl">' + (es ? 'Semanas con faltante al año' : 'Weeks short per year') + '</div><div class="mnum ts" id="s4wk"></div></div>' +
        '</div>' +
        '<div class="iw-read" id="s4read"></div>' +
      '</div>';
    host.querySelector('#s4sl').addEventListener('input', function() { state.sl = parseInt(this.value, 10); update(); });
    host.querySelector('#s4m').addEventListener('input',  function() { state.mu = parseInt(this.value, 10); update(); });
    host.querySelector('#s4sd').addEventListener('input', function() { state.sd = parseInt(this.value, 10); update(); });
    host.querySelector('#s4c').addEventListener('input',  function() { state.c  = parseInt(this.value, 10); update(); });
    update();
  }
  function update() {
    var es = LANG === 'es';
    var mu = state.mu, sd = state.sd, p = state.sl / 100;
    var z = nInv(p), rp = mu + z * sd, ss = z * sd;
    var cost = Math.max(0, ss) * state.c, risk = 1 - p;
    var step99 = xOfP(0.99, mu, sd) - rp;
    host.querySelector('#s4sll').textContent   = dec2(state.sl);
    host.querySelector('#s4ml').textContent    = dec2(mu);
    host.querySelector('#s4sdl').textContent   = dec2(sd);
    host.querySelector('#s4cl').textContent    = money(state.c);
    host.querySelector('#s4z').textContent     = dec2(z);
    host.querySelector('#s4rp').textContent    = dec2(rp);
    host.querySelector('#s4ss').textContent    = dec2(ss);
    host.querySelector('#s4cost').textContent  = money(cost);
    host.querySelector('#s4risk').textContent  = pr(risk);
    host.querySelector('#s4wk').textContent    = dec2(risk * 52);
    host.querySelector('#s4read').innerHTML = es
      ? '<strong>Lectura de negocio:</strong> cubrir el ' + dec2(state.sl) + ' por ciento de las semanas exige un puntaje z de ' + dec2(z) + ', es decir un punto de reorden de ' + dec2(rp) + ' unidades. De esas, ' + dec2(mu) + ' cubren la demanda promedio y ' + dec2(ss) + ' son inventario de seguridad, que cuesta ' + money(cost) + ' al año en almacenaje. El riesgo que queda es ' + pr(risk) + ', equivalente a ' + dec2(risk * 52) + ' semanas al año con faltante. Para pasar de este nivel al noventa y nueve por ciento harían falta ' + dec2(step99) + ' unidades más, y ese salto muestra por qué los últimos puntos porcentuales de servicio son los más caros de la cadena.'
      : '<strong>Business reading:</strong> covering ' + dec2(state.sl) + ' percent of the weeks demands a z score of ' + dec2(z) + ', that is a reorder point of ' + dec2(rp) + ' units. Of those, ' + dec2(mu) + ' cover the average demand and ' + dec2(ss) + ' are safety stock, which costs ' + money(cost) + ' a year in storage. The remaining risk is ' + pr(risk) + ', equivalent to ' + dec2(risk * 52) + ' weeks a year running short. Moving from this level to ninety nine percent would take ' + dec2(step99) + ' more units, and that jump shows why the last percentage points of service are the most expensive ones in the chain.';
    var g = fitCanvas(host.querySelector('#s4cv'), 160);
    drawCurve(g, mu, sd,
      [{ a: mu - 4 * sd, b: rp, kind: 1 }, { a: rp, b: mu + 4 * sd, kind: 2 }],
      { marks: [rp], fmt: function(v) { return dec2(v); },
        muLabel: (es ? 'Demanda promedio ' : 'Average demand ') + dec2(mu) });
  }
  widgets.push(mount);
  mount();
}

/* ════════════════════════════════════════════════════════════════════════
   LESSON CONTENT
   ════════════════════════════════════════════════════════════════════════ */
function mk(i18n, correctIdx, showWork) {
  return {
    i18n: i18n, correctIdx: correctIdx, showWork: showWork,
    title: i18n.title[LANG], questionText: i18n.q[LANG],
    hint: i18n.hint[LANG], explanation: i18n.exp[LANG],
    options: i18n.opts[LANG].slice()
  };
}
function frac(a, b) {
  return '<span class="mf-outer"><span class="mf-num">' + a + '</span><span class="mf-den">' + b + '</span></span>';
}

function buildLesson(rng) {
  problems = []; sectionDefs = []; widgets = [];
  document.getElementById('lessonBody').innerHTML = '';

  /* ── every number in the guide comes from the seeded rng ── */
  var mu1  = pick([48000, 52000, 56000, 60000], rng);   // concept 1 example
  var sd1  = pick([6000, 7000, 8000], rng);
  var muW1 = pick([44000, 50000, 56000], rng);          // widget 1 start
  var sdW1 = pick([5000, 7000, 9000], rng);
  var mu2  = pick([54, 58, 62, 66], rng);               // problem 1
  var sd2  = pick([6, 8, 10], rng);
  var n2   = 30 + Math.floor(rng() * 5) * 10;
  var mu3  = pick([46, 48, 52, 54], rng);               // concept 2 example
  var sd3  = pick([5, 6, 7], rng);
  var x3   = mu3 + pick([4, 6, 8], rng);
  var muW2 = pick([40, 46, 52], rng);                   // widget 2 start
  var sdW2 = pick([5, 7, 9], rng);
  var xW2  = muW2 + pick([5, 8, 12], rng);
  var mu4  = pick([34, 36, 38, 40], rng);               // problem 2
  var sd4  = pick([4, 5, 6], rng);
  var x4   = mu4 + pick([3, 5, 7], rng);
  var mu5  = pick([82000, 86000, 90000, 94000], rng);   // problem 3
  var sd5  = pick([6000, 7000, 8000], rng);
  var x5   = mu5 + pick([5000, 8000, 11000], rng);
  var mu6  = pick([500, 505, 510], rng);                // concept 3 example
  var sd6  = pick([6, 8, 10], rng);
  var lo6  = mu6 - pick([10, 12, 15], rng);
  var hi6  = mu6 + pick([12, 16, 20], rng);
  var n6   = 800 + Math.floor(rng() * 5) * 100;
  var cst6 = 10 + Math.floor(rng() * 5) * 5;
  var muW3 = pick([500, 505, 510], rng);                // widget 3 start
  var sdW3 = pick([6, 9, 12], rng);
  var aW3  = pick([10, 14, 18], rng);
  var bW3  = pick([12, 16, 20], rng);
  var cW3  = pick([10, 20, 30], rng);
  var nW3  = 900 + Math.floor(rng() * 4) * 100;
  var mu7  = pick([248, 250, 252], rng);                // problem 4
  var sd7  = pick([3, 4, 5], rng);
  var lo7  = mu7 - pick([5, 6, 8], rng);
  var hi7  = mu7 + pick([6, 9, 10], rng);
  var mu8  = pick([740, 750, 760], rng);                // problem 5
  var sd8  = pick([8, 10, 12], rng);
  var lo8  = mu8 - pick([15, 18, 20], rng);
  var hi8  = mu8 + pick([16, 20, 24], rng);
  var n8   = 1200 + Math.floor(rng() * 5) * 100;
  var cst8 = 6 + Math.floor(rng() * 7);
  var mu9  = pick([420, 450, 480], rng);                // concept 4 example
  var sd9  = pick([40, 50, 60], rng);
  var sl9  = pick([0.90, 0.95, 0.975], rng);
  var cst9 = 20 + Math.floor(rng() * 5) * 5;
  var muW4 = pick([360, 440, 520], rng);                // widget 4 start
  var sdW4 = pick([40, 60, 80], rng);
  var cW4  = pick([10, 20, 30], rng);
  var slW4 = pick([80, 85, 90], rng);
  var muA  = pick([260, 280, 300], rng);                // problem 6
  var sdA  = pick([25, 30, 35], rng);
  var slA  = pick([0.90, 0.95, 0.98], rng);
  var muB  = pick([7.5, 8.0, 8.5], rng);                // problem 7
  var sdB  = pick([1.2, 1.5, 1.8], rng);
  var xB   = muB + pick([1.5, 2.0, 2.5], rng);
  var muC  = pick([420, 450, 480], rng);                // problem 8
  var sdC  = pick([60, 75, 90], rng);
  var loC  = muC - pick([50, 60, 75], rng);
  var hiC  = muC + pick([60, 90, 120], rng);
  var nC   = 300 + Math.floor(rng() * 5) * 50;
  var muD  = pick([16500, 17500, 18500], rng);          // problem 9
  var sdD  = pick([2200, 2500, 3000], rng);
  var tD   = pick([0.10, 0.15, 0.20], rng);
  var muE  = pick([2400, 2600, 2800], rng);             // problem 10
  var sdE  = pick([180, 200, 220], rng);

  /* ═══════════════════════ CONCEPTO 1 ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    var p1 = pBet(mu1 - sd1, mu1 + sd1, mu1, sd1);
    var p2 = pBet(mu1 - 2 * sd1, mu1 + 2 * sd1, mu1, sd1);
    var pLow = pLe(mu1 - 2 * sd1, mu1, sd1);
    if (es) return '' +
      '<div class="stag">Concepto 1</div>' +
      '<h2>De contar eventos a medir magnitudes</h2>' +
      '<p>Los modelos que has trabajado hasta aquí cuentan cosas: clientes que llegan, créditos que incumplen, turnos que se saturan. Buena parte de la información que produce una empresa no se cuenta sino que se mide. El monto vendido en un día, el tiempo que tarda una entrega, el peso de un empaque, el sueldo de un puesto, el rendimiento mensual de un fondo de inversión. Esas magnitudes no saltan de un entero al siguiente: entre dos valores cualesquiera siempre cabe otro, y por eso la probabilidad ya no se puede repartir barra por barra.</p>' +
      '<p>Cuando la variable es continua la probabilidad se representa como área bajo una curva de densidad, y el área total vale uno. La consecuencia inmediata desconcierta a muchos estudiantes: la probabilidad de que una venta valga exactamente cierto monto al centavo es cero, porque un punto no encierra área. Las preguntas que sí tienen respuesta son de intervalo. Qué tan probable es que la venta del día quede por debajo de un monto, por arriba de otro, o entre dos límites que fija el presupuesto.</p>' +
      '<p>La <strong>distribución normal</strong> es la curva de densidad que describe una enorme cantidad de esas magnitudes. Tiene forma de campana simétrica y queda determinada por dos parámetros: la media, que fija dónde está el centro, y la desviación estándar, que fija qué tan ancha es. En una normal la media, la mediana y la moda coinciden en el mismo punto, algo que casi nunca ocurre con datos reales sesgados como el ingreso de los hogares. La razón por la que aparece tan seguido en la operación de una empresa es que las magnitudes de negocio suelen ser la suma de muchos efectos pequeños e independientes: la venta de un día es la suma de decenas de tickets, y esa acumulación tiende a producir una campana aunque cada ticket por separado no la tenga.</p>' +
      '<p>Antes de calcular cualquier área conviene tener a la mano la <strong>regla empírica</strong>, que describe la campana en tres cifras aproximadas. Cerca del sesenta y ocho por ciento de las observaciones cae a menos de una desviación estándar del promedio, cerca del noventa y cinco por ciento a menos de dos, y cerca del noventa y nueve punto siete por ciento a menos de tres. Sirve para dos cosas distintas: para estimar de memoria en una junta, y para detectar cuando alguien reporta un dato imposible bajo el modelo que dice estar usando.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Variable</div><div class="rform">X = magnitud medida</div><div class="rnote">Continua, no hay eventos que contar.</div></div>' +
        '<div class="rcard"><div class="rname">Parámetros</div><div class="rform">media y desviación estándar</div><div class="rnote">Centro y ancho de la campana.</div></div>' +
        '<div class="rcard"><div class="rname">Probabilidad</div><div class="rform">Área bajo la curva</div><div class="rnote">Un punto aislado tiene área cero.</div></div>' +
        '<div class="rcard"><div class="rname">Regla empírica</div><div class="rform">68, 95 y 99.7 por ciento</div><div class="rnote">Dentro de una, dos y tres desviaciones.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Una sucursal de una cadena de conveniencia registra la venta de cada día. El histórico del último año muestra una venta promedio de ' + money(mu1) + ' diarios con una desviación estándar de ' + money(sd1) + ', y el histograma tiene la forma de campana simétrica que caracteriza al modelo. La gerencia quiere saber en qué rango se mueve la venta de un día típico para planear el efectivo de la caja.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El centro de la campana es la media, ' + money(mu1) + ', y su ancho lo fija la desviación estándar, ' + money(sd1) + '.<br>' +
      '<strong>Paso 2.</strong> A una desviación del promedio el rango va de ' + money(mu1 - sd1) + ' a ' + money(mu1 + sd1) + ', y ahí cae el ' + pct1(p1) + ' por ciento de los días.<br>' +
      '<strong>Paso 3.</strong> A dos desviaciones el rango se abre de ' + money(mu1 - 2 * sd1) + ' a ' + money(mu1 + 2 * sd1) + ', que cubre el ' + pct1(p2) + ' por ciento de los días.<br>' +
      '<strong>Paso 4.</strong> Por debajo del límite inferior de ese rango amplio queda apenas el ' + pct1(pLow) + ' por ciento de los días.<br>' +
      '<strong>Lectura de negocio.</strong> La gerencia no debe planear la caja con el promedio sino con el rango. Un día de ' + money(mu1 - 2 * sd1) + ' ocurre en cerca de uno de cada cuarenta días y no es una emergencia; un día por debajo de eso sí amerita revisar si algo cambió en la plaza, en el surtido o en la competencia.</p></div>';
    return '' +
      '<div class="stag">Concept 1</div>' +
      '<h2>From counting events to measuring magnitudes</h2>' +
      '<p>The models you have worked with so far count things: customers arriving, loans defaulting, shifts running out of capacity. A good share of the information a company produces is not counted but measured. The amount sold in a day, the time a delivery takes, the weight of a package, the salary of a position, the monthly return of an investment fund. Those magnitudes do not jump from one whole number to the next: between any two values there is always another one, and that is why probability can no longer be handed out bar by bar.</p>' +
      '<p>When the variable is continuous, probability is represented as area under a density curve, and the total area is worth one. The immediate consequence puzzles many students: the probability that a sale is worth exactly a certain amount down to the cent is zero, because a point encloses no area. The questions that do have an answer are interval questions. How likely is it that the sales of the day fall below an amount, above another one, or between two limits set by the budget.</p>' +
      '<p>The <strong>normal distribution</strong> is the density curve describing an enormous number of those magnitudes. It has the shape of a symmetric bell and is fixed by two parameters: the mean, which sets where the centre is, and the standard deviation, which sets how wide it is. In a normal model the mean, the median and the mode coincide at the same point, something that almost never happens with skewed real data such as household income. The reason it shows up so often in company operations is that business magnitudes tend to be the sum of many small independent effects: the sales of one day are the sum of dozens of tickets, and that accumulation tends to produce a bell even when no single ticket has one.</p>' +
      '<p>Before computing any area it pays to keep the <strong>empirical rule</strong> at hand, which describes the bell in three approximate figures. About sixty eight percent of the observations fall within one standard deviation of the average, about ninety five percent within two, and about ninety nine point seven percent within three. It serves two different purposes: estimating from memory in a meeting, and spotting when somebody reports a figure that is impossible under the model they claim to be using.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Variable</div><div class="rform">X = measured magnitude</div><div class="rnote">Continuous, no events to count.</div></div>' +
        '<div class="rcard"><div class="rname">Parameters</div><div class="rform">mean and standard deviation</div><div class="rnote">Centre and width of the bell.</div></div>' +
        '<div class="rcard"><div class="rname">Probability</div><div class="rform">Area under the curve</div><div class="rnote">An isolated point has zero area.</div></div>' +
        '<div class="rcard"><div class="rname">Empirical rule</div><div class="rform">68, 95 and 99.7 percent</div><div class="rnote">Within one, two and three deviations.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> A branch of a convenience chain records the sales of every day. The history of the last year shows average sales of ' + money(mu1) + ' a day with a standard deviation of ' + money(sd1) + ', and the histogram has the symmetric bell shape that characterises the model. Management wants to know the range within which a typical day moves in order to plan the cash in the till.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The centre of the bell is the mean, ' + money(mu1) + ', and its width is set by the standard deviation, ' + money(sd1) + '.<br>' +
      '<strong>Step 2.</strong> Within one deviation of the average the range runs from ' + money(mu1 - sd1) + ' to ' + money(mu1 + sd1) + ', and ' + pct1(p1) + ' percent of the days fall there.<br>' +
      '<strong>Step 3.</strong> Within two deviations the range opens from ' + money(mu1 - 2 * sd1) + ' to ' + money(mu1 + 2 * sd1) + ', covering ' + pct1(p2) + ' percent of the days.<br>' +
      '<strong>Step 4.</strong> Below the lower limit of that wide range there is barely ' + pct1(pLow) + ' percent of the days.<br>' +
      '<strong>Business reading.</strong> Management should not plan the till with the average but with the range. A day of ' + money(mu1 - 2 * sd1) + ' happens on about one day out of forty and is not an emergency; a day below that does deserve a review of whether something changed in the location, in the assortment or in the competition.</p></div>';
  });

  widgetBell(muW1, sdW1);

  /* ── Item 1 ── */
  var o1 = shuffleOpts(
    ['X es el tiempo de traslado de la próxima ruta, una variable continua que se modela con la distribución normal de media ' + dec2(mu2) + ' minutos y desviación estándar ' + dec2(sd2) + ' minutos.',
     'X es el número de rutas que llegan a tiempo entre las ' + n2 + ' del día, una variable de conteo que se modela con la distribución binomial.',
     'X es el número de retrasos que ocurren en una hora, una variable de conteo que se modela con la distribución de Poisson con promedio ' + dec2(sd2) + ' por hora.',
     'X es el tiempo de traslado de la próxima ruta y se modela con la distribución normal, pero de media ' + dec2(mu2) + ' minutos y desviación estándar ' + dec2(sd2 * sd2) + ' minutos.'],
    ['X is the travel time of the next route, a continuous variable modelled with the normal distribution of mean ' + dec2(mu2) + ' minutes and standard deviation ' + dec2(sd2) + ' minutes.',
     'X is the number of routes arriving on time among the ' + n2 + ' of the day, a count variable modelled with the binomial distribution.',
     'X is the number of delays occurring in one hour, a count variable modelled with the Poisson distribution with average ' + dec2(sd2) + ' per hour.',
     'X is the travel time of the next route and is modelled with the normal distribution, but with mean ' + dec2(mu2) + ' minutes and standard deviation ' + dec2(sd2 * sd2) + ' minutes.'], rng);
  var q1i = {
    title: { es: 'Qué modelo describe el tiempo de una ruta', en: 'Which model describes the time of a route' },
    q: { es: 'Una empresa de mensajería mide el tiempo de traslado de una ruta urbana de reparto. El histórico de los últimos meses muestra un tiempo promedio de ' + dec2(mu2) + ' minutos con una desviación estándar de ' + dec2(sd2) + ' minutos, y el histograma tiene forma de campana simétrica alrededor del promedio. La empresa opera ' + n2 + ' rutas urbanas cada día. El área de operaciones quiere modelar el tiempo que tardará la próxima ruta. ¿Qué variable y qué modelo corresponden a la situación?',
        en: 'A courier company measures the travel time of an urban delivery route. The history of recent months shows an average travel time of ' + dec2(mu2) + ' minutes with a standard deviation of ' + dec2(sd2) + ' minutes, and the histogram has a symmetric bell shape around the average. The company runs ' + n2 + ' urban routes every day. The operations team wants to model the time the next route will take. Which variable and which model fit the situation?' },
    opts: { es: o1.es, en: o1.en },
    hint: { es: 'Pregúntate si lo que interesa se cuenta o se mide. Un tiempo admite cualquier valor intermedio, y revisa con cuidado cuál de los dos parámetros describe el ancho de la campana.',
            en: 'Ask yourself whether what matters is counted or measured. A time admits any intermediate value, and check carefully which of the two parameters describes the width of the bell.' },
    exp: { es: 'El tiempo de traslado es una magnitud continua, así que la describe una curva de densidad y no un conjunto de barras: el modelo normal con media ' + dec2(mu2) + ' y desviación estándar ' + dec2(sd2) + ' es el que corresponde. Contar cuántas de las ' + n2 + ' rutas llegan a tiempo es una pregunta binomial legítima, pero es otra pregunta y exige conocer una probabilidad individual que aquí no se dio. Contar retrasos por hora convierte la variable en un conteo de eventos y desperdicia la información del histograma. La última opción usa el modelo correcto pero pone ' + dec2(sd2 * sd2) + ' en el lugar de la desviación estándar, que es la varianza, y con eso ensancha la campana muchísimo más de lo que muestra el histórico.',
           en: 'Travel time is a continuous magnitude, so it is described by a density curve and not by a set of bars: the normal model with mean ' + dec2(mu2) + ' and standard deviation ' + dec2(sd2) + ' is the right one. Counting how many of the ' + n2 + ' routes arrive on time is a legitimate binomial question, but it is a different question and it demands an individual probability that was not given here. Counting delays per hour turns the variable into a count of events and wastes the information in the histogram. The last option uses the right model but puts ' + dec2(sd2 * sd2) + ' where the standard deviation belongs, which is the variance, and that widens the bell far beyond what the history shows.' }
  };
  var d1 = mk(q1i, o1.correctIdx, false);
  problems.push({ i18n: d1.i18n, title: d1.title, questionText: d1.questionText, options: d1.options, correctIdx: d1.correctIdx, explanation: d1.explanation, hint: d1.hint, showWork: false, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPTO 2 ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    var z3 = zOf(x3, mu3, sd3), le3 = pLe(x3, mu3, sd3);
    if (es) return '' +
      '<div class="stag">Concepto 2</div>' +
      '<h2>Estandarizar: el puntaje z y la tabla que sirve para todo</h2>' +
      '<p>Cada magnitud de la empresa tiene su propia campana. Las ventas diarias viven alrededor de decenas de miles de pesos, los tiempos de entrega alrededor de unas cuantas decenas de horas y los pesos de empaque alrededor de medio kilo. Sería absurdo construir una tabla de áreas para cada una. La solución es medir cualquier valor no en su unidad original sino en desviaciones estándar de distancia respecto de su propio promedio, y esa medida es el <strong>puntaje z</strong>.</p>' +
      '<p>El puntaje z responde a una sola pregunta: a cuántas desviaciones estándar está este valor de su promedio. Un puntaje de dos significa dos desviaciones por arriba, uno de menos uno y medio significa una desviación y media por abajo, y un puntaje de cero cae justo en el promedio. Una vez traducido el valor a puntaje z, la probabilidad se lee en una sola tabla, la de la normal estándar, que tiene media cero y desviación estándar uno.</p>' +
      '<p>Ese cambio de unidad hace algo más valioso que ahorrar tablas: permite comparar cosas que no se pueden comparar en sus unidades originales. Una sucursal que vendió dos desviaciones arriba de su promedio tuvo un mes mejor que otra que vendió una desviación arriba del suyo, aunque la segunda haya facturado más pesos. Los puntajes z son la razón por la que un director puede poner en la misma tabla el desempeño de áreas que miden cosas distintas.</p>' +
      '<p>Dos propiedades de la simetría ahorran trabajo. El área a la izquierda de menos z es igual al área a la derecha de z, y el área a la derecha de cualquier valor es uno menos el área a su izquierda. Con esas dos reglas cualquier pregunta se convierte en una consulta de área acumulada, y quien las tiene claras rara vez se equivoca de cola.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Puntaje z</div><div class="rform">z = ' + frac('x − media', 'desviación') + '</div><div class="rnote">Distancia medida en desviaciones.</div></div>' +
        '<div class="rcard"><div class="rname">Normal estándar</div><div class="rform">media 0 y desviación 1</div><div class="rnote">Una sola tabla para todas las campanas.</div></div>' +
        '<div class="rcard"><div class="rname">Cola derecha</div><div class="rform">P(X &gt; x) = 1 − P(X ≤ x)</div><div class="rnote">Siempre por complemento.</div></div>' +
        '<div class="rcard"><div class="rname">Simetría</div><div class="rform">Área a la izquierda de −z igual a la derecha de z</div><div class="rnote">Evita repetir la mitad de la tabla.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Un proveedor de refacciones entrega los pedidos de una armadora en un tiempo promedio de ' + dec2(mu3) + ' horas con una desviación estándar de ' + dec2(sd3) + ' horas, y el histórico se ajusta bien a una campana. El contrato marca una penalización cada vez que un pedido tarda más de ' + dec2(x3) + ' horas. El área de compras quiere estimar qué proporción de pedidos llegará dentro del plazo.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El plazo del contrato está ' + dec2(x3 - mu3) + ' horas arriba del promedio.<br>' +
      '<strong>Paso 2.</strong> Esa distancia, medida en desviaciones estándar, da un puntaje z de ' + dec2(z3) + '.<br>' +
      '<strong>Paso 3.</strong> El área acumulada hasta ese puntaje vale ' + pr(le3) + '.<br>' +
      '<strong>Paso 4.</strong> La cola que queda del otro lado, ' + pr(1 - le3) + ', es la proporción de pedidos que se penalizan.<br>' +
      '<strong>Lectura de negocio.</strong> El ' + pct1(le3) + ' por ciento de los pedidos entra en plazo. Dicho de otro modo, de cada cien pedidos ' + dec2((1 - le3) * 100) + ' generan penalización, y ese número multiplicado por el monto de la multa es el costo anual que compras puede llevar a la mesa de negociación con el proveedor.</p></div>';
    return '' +
      '<div class="stag">Concept 2</div>' +
      '<h2>Standardising: the z score and the table that works for everything</h2>' +
      '<p>Every magnitude in the company has its own bell. Daily sales live around tens of thousands of pesos, delivery times around a few dozen hours and package weights around half a kilo. Building a table of areas for each one would be absurd. The solution is to measure any value not in its original unit but in standard deviations of distance from its own average, and that measure is the <strong>z score</strong>.</p>' +
      '<p>The z score answers a single question: how many standard deviations this value sits away from its average. A score of two means two deviations above, one of minus one and a half means one and a half deviations below, and a score of zero lands exactly on the average. Once the value is translated into a z score, the probability is read from a single table, the standard normal one, which has mean zero and standard deviation one.</p>' +
      '<p>That change of unit does something more valuable than saving tables: it allows things that cannot be compared in their original units to be compared. A branch that sold two deviations above its own average had a better month than one that sold one deviation above its own, even if the second one billed more pesos. z scores are the reason a director can put in the same table the performance of areas measuring different things.</p>' +
      '<p>Two properties of symmetry save work. The area to the left of minus z equals the area to the right of z, and the area to the right of any value is one minus the area to its left. With those two rules any question becomes a query of cumulative area, and whoever keeps them clear rarely picks the wrong tail.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">z score</div><div class="rform">z = ' + frac('x − mean', 'deviation') + '</div><div class="rnote">Distance measured in deviations.</div></div>' +
        '<div class="rcard"><div class="rname">Standard normal</div><div class="rform">mean 0 and deviation 1</div><div class="rnote">One table for every bell.</div></div>' +
        '<div class="rcard"><div class="rname">Right tail</div><div class="rform">P(X &gt; x) = 1 − P(X ≤ x)</div><div class="rnote">Always through the complement.</div></div>' +
        '<div class="rcard"><div class="rname">Symmetry</div><div class="rform">Area left of −z equals area right of z</div><div class="rnote">Saves repeating half the table.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> A spare parts supplier delivers the orders of a car plant in an average time of ' + dec2(mu3) + ' hours with a standard deviation of ' + dec2(sd3) + ' hours, and the history fits a bell well. The contract sets a penalty every time an order takes more than ' + dec2(x3) + ' hours. The purchasing team wants to estimate what share of orders will arrive within the deadline.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The contract deadline sits ' + dec2(x3 - mu3) + ' hours above the average.<br>' +
      '<strong>Step 2.</strong> That distance, measured in standard deviations, gives a z score of ' + dec2(z3) + '.<br>' +
      '<strong>Step 3.</strong> The cumulative area up to that score is worth ' + pr(le3) + '.<br>' +
      '<strong>Step 4.</strong> The tail left on the other side, ' + pr(1 - le3) + ', is the share of orders that get penalised.<br>' +
      '<strong>Business reading.</strong> ' + pct1(le3) + ' percent of the orders arrive within the deadline. Put another way, out of every hundred orders ' + dec2((1 - le3) * 100) + ' trigger a penalty, and that number multiplied by the amount of the fine is the annual cost purchasing can take to the negotiating table with the supplier.</p></div>';
  });

  widgetZScore(muW2, sdW2, xW2);

  /* ── Item 2 ── */
  var c2 = pLe(x4, mu4, sd4);
  var o2 = probOpts(c2, [
    pGt(x4, mu4, sd4),
    nCdf((x4 - mu4) / (sd4 * sd4)),
    nCdf(x4 - mu4),
    nCdf((mu4 - x4) / sd4)
  ], rng);
  var q2i = {
    title: { es: 'Pedidos surtidos dentro del plazo prometido', en: 'Orders filled within the promised deadline' },
    q: { es: 'Un centro de distribución surte pedidos de tiendas afiliadas en un tiempo que se ajusta bien a una campana, con un promedio de ' + dec2(mu4) + ' horas y una desviación estándar de ' + dec2(sd4) + ' horas. El área comercial promete a las tiendas que el pedido llega en un máximo de ' + dec2(x4) + ' horas. ¿Cuál es la probabilidad de que un pedido cualquiera se surta dentro de ese plazo prometido?',
        en: 'A distribution centre fills orders from affiliated stores in a time that fits a bell well, with an average of ' + dec2(mu4) + ' hours and a standard deviation of ' + dec2(sd4) + ' hours. The sales team promises the stores that the order arrives in at most ' + dec2(x4) + ' hours. What is the probability that any given order is filled within that promised deadline?' },
    opts: { es: o2.es, en: o2.en },
    hint: { es: 'Traduce primero el plazo prometido a distancia en desviaciones estándar respecto del promedio. La tabla te entrega directamente el área acumulada hacia la izquierda, que es la que corresponde a cumplir el plazo.',
            en: 'First translate the promised deadline into distance in standard deviations from the average. The table hands you the cumulative area to the left directly, and that is the one matching compliance with the deadline.' },
    exp: { es: 'El plazo está ' + dec2(x4 - mu4) + ' horas arriba del promedio, lo que da un puntaje z de ' + dec2(zOf(x4, mu4, sd4)) + ' y un área acumulada de ' + pr(c2) + '. El valor ' + pr(pGt(x4, mu4, sd4)) + ' es la cola derecha y describe los pedidos que llegan tarde, es decir lo contrario de lo que se preguntó. El valor ' + pr(nCdf((x4 - mu4) / (sd4 * sd4))) + ' sale de dividir entre la varianza en lugar de la desviación estándar, un error que aplasta el puntaje z y hace ver el proceso peor de lo que es. El valor ' + pr(nCdf(x4 - mu4)) + ' olvida dividir y trata la diferencia en horas como si ya fuera un puntaje z.',
           en: 'The deadline sits ' + dec2(x4 - mu4) + ' hours above the average, which gives a z score of ' + dec2(zOf(x4, mu4, sd4)) + ' and a cumulative area of ' + pr(c2) + '. The value ' + pr(pGt(x4, mu4, sd4)) + ' is the right tail and describes the orders arriving late, that is the opposite of what was asked. The value ' + pr(nCdf((x4 - mu4) / (sd4 * sd4))) + ' comes from dividing by the variance instead of the standard deviation, a mistake that flattens the z score and makes the process look worse than it is. The value ' + pr(nCdf(x4 - mu4)) + ' forgets to divide and treats the difference in hours as if it were already a z score.' }
  };
  var d2 = mk(q2i, o2.correctIdx, true);
  problems.push({ i18n: d2.i18n, title: d2.title, questionText: d2.questionText, options: d2.options, correctIdx: d2.correctIdx, explanation: d2.explanation, hint: d2.hint, showWork: true, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 3 ── */
  var c3 = pGt(x5, mu5, sd5);
  var o3 = probOpts(c3, [
    pLe(x5, mu5, sd5),
    1 - nCdf((x5 - mu5) / (sd5 * sd5)),
    0.5,
    pGt(x5 + sd5, mu5, sd5)
  ], rng);
  var q3i = {
    title: { es: 'Meses en que el gasto rebasa el techo autorizado', en: 'Months where spending exceeds the authorised cap' },
    q: { es: 'El gasto mensual de operación de una planta se comporta como una campana, con un promedio de ' + money(mu5) + ' y una desviación estándar de ' + money(sd5) + '. El consejo autorizó un techo de gasto de ' + money(x5) + ' al mes, y cada vez que el gasto lo rebasa la dirección debe presentar una justificación por escrito. ¿Cuál es la probabilidad de que en un mes cualquiera el gasto rebase el techo autorizado?',
        en: 'The monthly operating expense of a plant behaves like a bell, with an average of ' + money(mu5) + ' and a standard deviation of ' + money(sd5) + '. The board authorised a spending cap of ' + money(x5) + ' a month, and every time the expense goes above it management must file a written justification. What is the probability that in any given month the expense exceeds the authorised cap?' },
    opts: { es: o3.es, en: o3.en },
    hint: { es: 'La tabla de la normal estándar entrega áreas acumuladas hacia la izquierda. Calcula primero la parte que sí queda dentro del techo y recuerda que el área total bajo la curva vale uno.',
            en: 'The standard normal table hands out cumulative areas to the left. Work out first the part that does stay within the cap and remember that the total area under the curve is worth one.' },
    exp: { es: 'El techo está ' + money(x5 - mu5) + ' arriba del promedio, lo que equivale a un puntaje z de ' + dec2(zOf(x5, mu5, sd5)) + '. El área acumulada hasta ahí es ' + pr(pLe(x5, mu5, sd5)) + ', así que la probabilidad de rebasar el techo es su complemento, ' + pr(c3) + '. El valor ' + pr(pLe(x5, mu5, sd5)) + ' describe los meses que sí cierran dentro del techo. El valor ' + pr(0.5) + ' supone que el techo coincide con el promedio, cosa que no ocurre porque el consejo dejó holgura. Y dividir entre la varianza en lugar de la desviación estándar produce ' + pr(1 - nCdf((x5 - mu5) / (sd5 * sd5))) + ', una cifra que exagera el riesgo y llevaría a pedir un techo mucho más alto del necesario.',
           en: 'The cap sits ' + money(x5 - mu5) + ' above the average, which amounts to a z score of ' + dec2(zOf(x5, mu5, sd5)) + '. The cumulative area up to that point is ' + pr(pLe(x5, mu5, sd5)) + ', so the probability of exceeding the cap is its complement, ' + pr(c3) + '. The value ' + pr(pLe(x5, mu5, sd5)) + ' describes the months that do close within the cap. The value ' + pr(0.5) + ' assumes the cap coincides with the average, which it does not because the board left slack. And dividing by the variance instead of the standard deviation produces ' + pr(1 - nCdf((x5 - mu5) / (sd5 * sd5))) + ', a figure that overstates the risk and would lead to asking for a cap far higher than needed.' }
  };
  var d3 = mk(q3i, o3.correctIdx, true);
  problems.push({ i18n: d3.i18n, title: d3.title, questionText: d3.questionText, options: d3.options, correctIdx: d3.correctIdx, explanation: d3.explanation, hint: d3.hint, showWork: true, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPTO 3 ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    var inside = pBet(lo6, hi6, mu6, sd6), out = 1 - inside;
    var lowT = pLe(lo6, mu6, sd6), highT = pGt(hi6, mu6, sd6);
    if (es) return '' +
      '<div class="stag">Concepto 3</div>' +
      '<h2>Entre dos límites: tolerancias, conteos esperados y pesos</h2>' +
      '<p>La mayor parte de las decisiones de calidad y de control presupuestal no preguntan por una cola sino por una banda. El contrato con el cliente no dice que la pieza debe pesar menos de cierta cantidad, dice que debe pesar entre un mínimo y un máximo. El presupuesto no aprueba un techo sin más, aprueba un rango dentro del cual el gerente puede moverse sin autorización adicional. Para responder ese tipo de pregunta se calculan dos áreas acumuladas y se restan: la del límite superior menos la del límite inferior.</p>' +
      '<p>Ese procedimiento exige dos puntajes z en lugar de uno, y ahí aparece el error más común. Muchos estudiantes suponen que la banda es simétrica alrededor del promedio y calculan solo una cola para luego duplicarla. En la práctica industrial la tolerancia por arriba y la tolerancia por abajo casi nunca son iguales, y el proceso rara vez está centrado justo en medio de la especificación. Conviene calcular los dos puntajes por separado, incluso cuando parecen iguales, porque el segundo cálculo cuesta un minuto y el error cuesta un lote completo.</p>' +
      '<p>Las dos colas que quedan fuera de la banda no son intercambiables desde el punto de vista del negocio, aunque en la aritmética se sumen igual. La cola de abajo es producto incompleto que el cliente reclama y que puede costar la cuenta; la cola de arriba es producto regalado que se entrega sin cobrarse. Un buen análisis reporta las dos por separado y no solo su suma, porque las acciones correctivas son distintas.</p>' +
      '<p>El último paso convierte la proporción en algo que la dirección pueda usar. Si en un lote de cierto tamaño la proporción fuera de especificación es conocida, el número esperado de piezas afectadas es el tamaño del lote multiplicado por esa proporción, y multiplicando otra vez por el costo unitario de reproceso se obtienen pesos. Ese encadenamiento de proporción a piezas y de piezas a pesos es lo que convierte un ejercicio de tabla en un argumento de inversión.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Entre dos límites</div><div class="rform">P(a ≤ X ≤ b) = P(X ≤ b) − P(X ≤ a)</div><div class="rnote">Dos puntajes z, nunca uno solo.</div></div>' +
        '<div class="rcard"><div class="rname">Fuera de la banda</div><div class="rform">1 − P(a ≤ X ≤ b)</div><div class="rnote">Suma de las dos colas.</div></div>' +
        '<div class="rcard"><div class="rname">Piezas esperadas</div><div class="rform">Tamaño del lote por la proporción</div><div class="rnote">De proporción a unidades físicas.</div></div>' +
        '<div class="rcard"><div class="rname">Costo esperado</div><div class="rform">Piezas por costo unitario</div><div class="rnote">De unidades a pesos presupuestables.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Una envasadora llena bolsas con un peso promedio de ' + dec2(mu6) + ' gramos y una desviación estándar de ' + dec2(sd6) + ' gramos. El cliente acepta las bolsas que pesen entre ' + dec2(lo6) + ' y ' + dec2(hi6) + ' gramos; el resto se abre y se reprocesa con un costo de ' + money(cst6) + ' por bolsa. El lote del turno es de ' + n6 + ' bolsas y la gerencia de planta quiere el costo esperado del reproceso.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El límite inferior queda en un puntaje z de ' + dec2(zOf(lo6, mu6, sd6)) + ' y el superior en uno de ' + dec2(zOf(hi6, mu6, sd6)) + '.<br>' +
      '<strong>Paso 2.</strong> Restando las dos áreas acumuladas, la proporción dentro de especificación es ' + pr(inside) + ' y la que queda fuera es ' + pr(out) + '.<br>' +
      '<strong>Paso 3.</strong> Sobre ' + n6 + ' bolsas eso da ' + dec2(n6 * out) + ' bolsas reprocesadas, de las cuales ' + dec2(n6 * lowT) + ' salen abajo del mínimo y ' + dec2(n6 * highT) + ' arriba del máximo.<br>' +
      '<strong>Paso 4.</strong> El costo esperado del turno es ' + money(n6 * out * cst6) + '.<br>' +
      '<strong>Lectura de negocio.</strong> Las dos colas piden acciones distintas. Las bolsas cortas ponen en riesgo la relación con el cliente y las bolsas pasadas son producto que se regala. Si la mayor parte del costo viene de un solo lado, mover el peso objetivo unos gramos sale mucho más barato que comprar una envasadora más precisa.</p></div>';
    return '' +
      '<div class="stag">Concept 3</div>' +
      '<h2>Between two limits: tolerances, expected counts and pesos</h2>' +
      '<p>Most quality and budget control decisions do not ask about a tail but about a band. The contract with the client does not say the piece must weigh less than a certain amount, it says it must weigh between a minimum and a maximum. The budget does not simply approve a cap, it approves a range within which the manager can move without further authorisation. To answer that kind of question two cumulative areas are computed and subtracted: the one for the upper limit minus the one for the lower limit.</p>' +
      '<p>That procedure demands two z scores instead of one, and this is where the most common mistake appears. Many students assume the band is symmetric around the average and compute only one tail to then double it. In industrial practice the tolerance above and the tolerance below are almost never equal, and the process is rarely centred exactly in the middle of the specification. It pays to compute both scores separately, even when they look equal, because the second calculation costs a minute and the mistake costs a whole lot.</p>' +
      '<p>The two tails left outside the band are not interchangeable from a business point of view, even though the arithmetic adds them the same way. The lower tail is incomplete product that the client complains about and that can cost the account; the upper tail is giveaway product delivered without being charged. A good analysis reports both separately and not only their sum, because the corrective actions are different.</p>' +
      '<p>The last step turns the proportion into something management can use. If in a lot of a given size the proportion out of specification is known, the expected number of affected pieces is the size of the lot multiplied by that proportion, and multiplying once more by the unit reprocessing cost gives pesos. That chain from proportion to pieces and from pieces to pesos is what turns a table exercise into an investment argument.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Between two limits</div><div class="rform">P(a ≤ X ≤ b) = P(X ≤ b) − P(X ≤ a)</div><div class="rnote">Two z scores, never just one.</div></div>' +
        '<div class="rcard"><div class="rname">Outside the band</div><div class="rform">1 − P(a ≤ X ≤ b)</div><div class="rnote">Sum of the two tails.</div></div>' +
        '<div class="rcard"><div class="rname">Expected pieces</div><div class="rform">Lot size times the proportion</div><div class="rnote">From proportion to physical units.</div></div>' +
        '<div class="rcard"><div class="rname">Expected cost</div><div class="rform">Pieces times unit cost</div><div class="rnote">From units to budgetable pesos.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> A packing line fills bags with an average weight of ' + dec2(mu6) + ' grams and a standard deviation of ' + dec2(sd6) + ' grams. The client accepts bags weighing between ' + dec2(lo6) + ' and ' + dec2(hi6) + ' grams; the rest are opened and reprocessed at a cost of ' + money(cst6) + ' per bag. The lot of the shift is ' + n6 + ' bags and plant management wants the expected reprocessing cost.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The lower limit lands on a z score of ' + dec2(zOf(lo6, mu6, sd6)) + ' and the upper one on a score of ' + dec2(zOf(hi6, mu6, sd6)) + '.<br>' +
      '<strong>Step 2.</strong> Subtracting the two cumulative areas, the proportion inside specification is ' + pr(inside) + ' and the one left outside is ' + pr(out) + '.<br>' +
      '<strong>Step 3.</strong> Over ' + n6 + ' bags that gives ' + dec2(n6 * out) + ' reprocessed bags, of which ' + dec2(n6 * lowT) + ' come out below the minimum and ' + dec2(n6 * highT) + ' above the maximum.<br>' +
      '<strong>Step 4.</strong> The expected cost of the shift is ' + money(n6 * out * cst6) + '.<br>' +
      '<strong>Business reading.</strong> The two tails call for different actions. Short bags put the relationship with the client at risk and heavy bags are product given away. If most of the cost comes from one side alone, moving the target weight by a few grams is far cheaper than buying a more precise packing machine.</p></div>';
  });

  widgetTolerance(muW3, sdW3, aW3, bW3, cW3, nW3);

  /* ── Item 4 ── */
  var c4 = pBet(lo7, hi7, mu7, sd7);
  var o4 = probOpts(c4, [
    pLe(hi7, mu7, sd7),
    1 - c4,
    2 * pLe(hi7, mu7, sd7) - 1,
    pBet(lo7, mu7, mu7, sd7)
  ], rng);
  var q4i = {
    title: { es: 'Botellas que cumplen la especificación de llenado', en: 'Bottles meeting the filling specification' },
    q: { es: 'Una embotelladora llena presentaciones cuyo contenido se comporta como una campana, con un promedio de ' + dec2(mu7) + ' mililitros y una desviación estándar de ' + dec2(sd7) + ' mililitros. La norma de la cadena que le compra el producto acepta las botellas cuyo contenido quede entre ' + dec2(lo7) + ' y ' + dec2(hi7) + ' mililitros. ¿Cuál es la probabilidad de que una botella tomada al azar de la línea cumpla la especificación?',
        en: 'A bottling plant fills presentations whose content behaves like a bell, with an average of ' + dec2(mu7) + ' millilitres and a standard deviation of ' + dec2(sd7) + ' millilitres. The standard of the chain buying the product accepts bottles whose content falls between ' + dec2(lo7) + ' and ' + dec2(hi7) + ' millilitres. What is the probability that a bottle taken at random from the line meets the specification?' },
    opts: { es: o4.es, en: o4.en },
    hint: { es: 'La banda tiene dos límites y cada uno tiene su propio puntaje z. Revisa si el promedio está justo a la mitad de la banda antes de suponer que las dos colas valen lo mismo.',
            en: 'The band has two limits and each one has its own z score. Check whether the average sits exactly in the middle of the band before assuming the two tails are worth the same.' },
    exp: { es: 'El límite inferior da un puntaje z de ' + dec2(zOf(lo7, mu7, sd7)) + ' y el superior uno de ' + dec2(zOf(hi7, mu7, sd7)) + '. Restando las áreas acumuladas, la proporción dentro de especificación es ' + pr(c4) + '. El valor ' + pr(pLe(hi7, mu7, sd7)) + ' se queda con toda el área por debajo del límite alto e incluye por error las botellas que salieron demasiado vacías. El valor ' + pr(1 - c4) + ' es justo el desperdicio, no la producción aceptable. Y ' + pr(2 * pLe(hi7, mu7, sd7) - 1) + ' aparece cuando se supone que la banda es simétrica alrededor del promedio y se duplica una sola cola, cosa que aquí no se cumple porque las dos tolerancias son distintas.',
           en: 'The lower limit gives a z score of ' + dec2(zOf(lo7, mu7, sd7)) + ' and the upper one a score of ' + dec2(zOf(hi7, mu7, sd7)) + '. Subtracting the cumulative areas, the proportion inside specification is ' + pr(c4) + '. The value ' + pr(pLe(hi7, mu7, sd7)) + ' keeps all the area below the high limit and mistakenly includes the bottles that came out too empty. The value ' + pr(1 - c4) + ' is precisely the waste, not the acceptable output. And ' + pr(2 * pLe(hi7, mu7, sd7) - 1) + ' shows up when the band is assumed symmetric around the average and a single tail is doubled, which does not hold here because the two tolerances are different.' }
  };
  var d4 = mk(q4i, o4.correctIdx, true);
  problems.push({ i18n: d4.i18n, title: d4.title, questionText: d4.questionText, options: d4.options, correctIdx: d4.correctIdx, explanation: d4.explanation, hint: d4.hint, showWork: true, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 5 ── */
  var in8  = pBet(lo8, hi8, mu8, sd8);
  var out8 = 1 - in8;
  var c5   = n8 * out8 * cst8;
  var o5 = moneyOpts(c5, [
    n8 * in8 * cst8,
    out8 * cst8,
    n8 * out8,
    n8 * pGt(hi8, mu8, sd8) * cst8
  ], rng);
  var q5i = {
    title: { es: 'Costo diario de reempacar bolsas de café', en: 'Daily cost of repacking coffee bags' },
    q: { es: 'Una tostadora empaca bolsas de café cuyo peso sigue una campana, con un promedio de ' + dec2(mu8) + ' gramos y una desviación estándar de ' + dec2(sd8) + ' gramos. El supermercado que las distribuye solo recibe las bolsas que pesan entre ' + dec2(lo8) + ' y ' + dec2(hi8) + ' gramos, y las demás regresan a la planta para reempacarse con un costo de ' + money(cst8) + ' cada una. La producción diaria es de ' + n8 + ' bolsas. ¿Cuál es el costo esperado del reempaque de un día?',
        en: 'A coffee roaster packs bags whose weight follows a bell, with an average of ' + dec2(mu8) + ' grams and a standard deviation of ' + dec2(sd8) + ' grams. The supermarket distributing them only receives bags weighing between ' + dec2(lo8) + ' and ' + dec2(hi8) + ' grams, and the rest go back to the plant to be repacked at a cost of ' + money(cst8) + ' each. Daily output is ' + n8 + ' bags. What is the expected repacking cost of one day?' },
    opts: { es: o5.es, en: o5.en },
    hint: { es: 'Encadena tres pasos: primero la proporción que el supermercado rechaza, después cuántas bolsas de la producción diaria representa esa proporción, y hasta el final el costo en pesos.',
            en: 'Chain three steps: first the proportion the supermarket rejects, then how many bags of the daily output that proportion represents, and only at the end the cost in pesos.' },
    exp: { es: 'La proporción aceptada entre los dos límites es ' + pr(in8) + ', de modo que se rechaza ' + pr(out8) + ' de la producción. Sobre ' + n8 + ' bolsas diarias eso equivale a ' + dec2(n8 * out8) + ' bolsas reempacadas y a un costo de ' + money(c5) + '. El valor ' + money(n8 * in8 * cst8) + ' aplica el costo a las bolsas que sí se aceptaron, que son precisamente las que no generan gasto. El valor ' + money(out8 * cst8) + ' olvida multiplicar por la producción del día y reporta el costo de una sola bolsa. El valor ' + money(n8 * out8) + ' se detiene en el número de bolsas y lo presenta como si fueran pesos.',
           en: 'The proportion accepted between the two limits is ' + pr(in8) + ', so ' + pr(out8) + ' of the output is rejected. Over ' + n8 + ' bags a day that amounts to ' + dec2(n8 * out8) + ' repacked bags and a cost of ' + money(c5) + '. The value ' + money(n8 * in8 * cst8) + ' applies the cost to the bags that were accepted, which are precisely the ones generating no expense. The value ' + money(out8 * cst8) + ' forgets to multiply by the output of the day and reports the cost of a single bag. The value ' + money(n8 * out8) + ' stops at the number of bags and presents it as if it were pesos.' }
  };
  var d5 = mk(q5i, o5.correctIdx, true);
  problems.push({ i18n: d5.i18n, title: d5.title, questionText: d5.questionText, options: d5.options, correctIdx: d5.correctIdx, explanation: d5.explanation, hint: d5.hint, showWork: true, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ CONCEPTO 4 ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    var z9 = nInv(sl9), rp9 = mu9 + z9 * sd9, ss9 = z9 * sd9;
    var rp99 = xOfP(0.99, mu9, sd9);
    if (es) return '' +
      '<div class="stag">Concepto 4</div>' +
      '<h2>El problema inverso: del nivel de servicio al valor de corte</h2>' +
      '<p>Hasta aquí todas las preguntas iban en la misma dirección: se conocía un valor y se buscaba un área. La operación de una empresa plantea la pregunta al revés con la misma frecuencia. Cuánto inventario hay que tener para cubrir el noventa y cinco por ciento de las semanas. Qué plazo se puede prometer para cumplirlo nueve de cada diez veces. A partir de qué sueldo empieza el diez por ciento mejor pagado de la nómina. En todos esos casos el dato es la probabilidad y la incógnita es el valor.</p>' +
      '<p>El procedimiento es la lectura inversa de la tabla. Se busca dentro del cuerpo de la tabla el área acumulada que se pidió, se identifica el puntaje z que le corresponde y después se deshace la estandarización: el valor buscado es la media más ese puntaje multiplicado por la desviación estándar. Cuando el puntaje sale positivo el corte queda arriba del promedio, y cuando sale negativo queda abajo.</p>' +
      '<p>Conviene memorizar tres puntajes porque aparecen todo el tiempo en los contratos: el noventa por ciento corresponde a un puntaje cercano a uno punto veintiocho, el noventa y cinco por ciento a uno punto sesenta y cinco, y el noventa y nueve por ciento a dos punto treinta y tres. Lo importante no son los números sino cómo se separan entre sí: pasar del noventa al noventa y cinco cuesta menos de la mitad de lo que cuesta pasar del noventa y cinco al noventa y nueve, aunque el segundo salto sea de menos puntos porcentuales.</p>' +
      '<p>Esa aceleración explica una de las decisiones más discutidas en la cadena de suministro. La diferencia entre el nivel de servicio prometido y el inventario que exige no es proporcional: los últimos puntos porcentuales requieren cantidades de inventario que crecen muy rápido, porque la cola de la campana se aplana. Por eso casi ninguna empresa promete un cien por ciento de disponibilidad: no es imposible, es que el inventario necesario no lo paga ningún margen.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Lectura inversa</div><div class="rform">Del área al puntaje z</div><div class="rnote">Se busca dentro del cuerpo de la tabla.</div></div>' +
        '<div class="rcard"><div class="rname">Valor de corte</div><div class="rform">x = media + z por desviación</div><div class="rnote">Deshace la estandarización.</div></div>' +
        '<div class="rcard"><div class="rname">Inventario de seguridad</div><div class="rform">z por desviación de la demanda</div><div class="rnote">Lo que se tiene de más por el riesgo.</div></div>' +
        '<div class="rcard"><div class="rname">Costo del servicio</div><div class="rform">Crece más rápido que el nivel</div><div class="rnote">Los últimos puntos son los caros.</div></div>' +
      '</div>' +
      '<p><strong>Ejemplo resuelto.</strong> Un centro de distribución surte un producto cuya demanda semanal se comporta como una campana, con un promedio de ' + dec2(mu9) + ' unidades y una desviación estándar de ' + dec2(sd9) + ' unidades. La dirección quiere cubrir la demanda en el ' + pct1(sl9) + ' por ciento de las semanas. Mantener una unidad en almacén cuesta ' + money(cst9) + ' al año.</p>' +
      '<div class="callout"><p><strong>Paso 1.</strong> El nivel de servicio pedido corresponde a un puntaje z de ' + dec2(z9) + '.<br>' +
      '<strong>Paso 2.</strong> Deshaciendo la estandarización, el punto de reorden queda en ' + dec2(rp9) + ' unidades.<br>' +
      '<strong>Paso 3.</strong> De esas, ' + dec2(mu9) + ' cubren la demanda promedio y ' + dec2(ss9) + ' son inventario de seguridad.<br>' +
      '<strong>Paso 4.</strong> Ese inventario de seguridad cuesta ' + money(ss9 * cst9) + ' al año en almacenaje.<br>' +
      '<strong>Lectura de negocio.</strong> El riesgo que queda es ' + pr(1 - sl9) + ', es decir alrededor de ' + dec2((1 - sl9) * 52) + ' semanas al año con faltante. Subir la meta al noventa y nueve por ciento exigiría ' + dec2(rp99) + ' unidades, y esa diferencia es el precio real de la promesa que el área comercial quiere hacerle al cliente.</p></div>';
    return '' +
      '<div class="stag">Concept 4</div>' +
      '<h2>The inverse problem: from the service level to the cut-off value</h2>' +
      '<p>So far every question ran in the same direction: a value was known and an area was wanted. Company operations pose the question the other way round just as often. How much stock is needed to cover ninety five percent of the weeks. What deadline can be promised so that it is met nine times out of ten. Above what salary does the best paid ten percent of the payroll begin. In all those cases the given figure is the probability and the unknown is the value.</p>' +
      '<p>The procedure is the table read backwards. The cumulative area that was asked for is looked up inside the body of the table, the z score matching it is identified, and then the standardisation is undone: the value wanted is the mean plus that score multiplied by the standard deviation. When the score comes out positive the cut-off sits above the average, and when it comes out negative it sits below.</p>' +
      '<p>Three scores are worth memorising because they show up in contracts all the time: ninety percent matches a score close to one point twenty eight, ninety five percent one point sixty five, and ninety nine percent two point thirty three. What matters is not the numbers but how they pull apart: moving from ninety to ninety five costs less than half of what it costs to move from ninety five to ninety nine, even though the second jump is worth fewer percentage points.</p>' +
      '<p>That acceleration explains one of the most argued decisions in the supply chain. The relation between the promised service level and the stock it demands is not proportional: the last percentage points require stock amounts that grow very fast, because the tail of the bell flattens out. That is why almost no company promises one hundred percent availability: it is not impossible, it is that no margin pays for the stock it would take.</p>' +
      '<div class="rules-grid">' +
        '<div class="rcard"><div class="rname">Reverse reading</div><div class="rform">From the area to the z score</div><div class="rnote">Looked up inside the body of the table.</div></div>' +
        '<div class="rcard"><div class="rname">Cut-off value</div><div class="rform">x = mean + z times deviation</div><div class="rnote">Undoes the standardisation.</div></div>' +
        '<div class="rcard"><div class="rname">Safety stock</div><div class="rform">z times deviation of demand</div><div class="rnote">What is held extra because of risk.</div></div>' +
        '<div class="rcard"><div class="rname">Cost of service</div><div class="rform">Grows faster than the level</div><div class="rnote">The last points are the expensive ones.</div></div>' +
      '</div>' +
      '<p><strong>Worked example.</strong> A distribution centre supplies a product whose weekly demand behaves like a bell, with an average of ' + dec2(mu9) + ' units and a standard deviation of ' + dec2(sd9) + ' units. Management wants to cover demand in ' + pct1(sl9) + ' percent of the weeks. Holding one unit in the warehouse costs ' + money(cst9) + ' a year.</p>' +
      '<div class="callout"><p><strong>Step 1.</strong> The requested service level matches a z score of ' + dec2(z9) + '.<br>' +
      '<strong>Step 2.</strong> Undoing the standardisation, the reorder point lands at ' + dec2(rp9) + ' units.<br>' +
      '<strong>Step 3.</strong> Of those, ' + dec2(mu9) + ' cover the average demand and ' + dec2(ss9) + ' are safety stock.<br>' +
      '<strong>Step 4.</strong> That safety stock costs ' + money(ss9 * cst9) + ' a year in storage.<br>' +
      '<strong>Business reading.</strong> The remaining risk is ' + pr(1 - sl9) + ', that is around ' + dec2((1 - sl9) * 52) + ' weeks a year running short. Raising the target to ninety nine percent would demand ' + dec2(rp99) + ' units, and that difference is the real price of the promise the sales team wants to make to the client.</p></div>';
  });

  widgetServiceLevel(muW4, sdW4, cW4, slW4);

  /* ── Item 6 ── */
  var zA = nInv(slA);
  var c6 = muA + zA * sdA;
  var o6 = countOpts(c6, [
    muA + nInv(1 - slA) * sdA,
    muA + slA * sdA,
    muA + zA,
    zA * sdA
  ], rng);
  var q6i = {
    title: { es: 'Inventario para cubrir el tiempo de resurtido', en: 'Stock to cover the replenishment time' },
    q: { es: 'Una farmacia de cadena vende un medicamento cuya demanda durante el tiempo de resurtido se comporta como una campana, con un promedio de ' + dec2(muA) + ' cajas y una desviación estándar de ' + dec2(sdA) + ' cajas. La dirección quiere que el inventario alcance en el ' + pct1(slA) + ' por ciento de los ciclos de resurtido. ¿Cuántas cajas debe tener disponibles al momento de levantar el pedido?',
        en: 'A pharmacy chain sells a medicine whose demand during the replenishment time behaves like a bell, with an average of ' + dec2(muA) + ' boxes and a standard deviation of ' + dec2(sdA) + ' boxes. Management wants the stock to be enough in ' + pct1(slA) + ' percent of the replenishment cycles. How many boxes should be available at the moment the order is placed?' },
    opts: { es: o6.es, en: o6.en },
    hint: { es: 'Aquí el dato es la probabilidad y la incógnita es la cantidad, así que la tabla se lee al revés. Fíjate en el signo del puntaje que obtienes: cubrir la mayoría de los ciclos exige quedar arriba del promedio.',
            en: 'Here the given figure is the probability and the unknown is the quantity, so the table is read backwards. Watch the sign of the score you obtain: covering most of the cycles requires ending up above the average.' },
    exp: { es: 'Cubrir el ' + pct1(slA) + ' por ciento de los ciclos corresponde a un puntaje z de ' + dec2(zA) + ', y deshaciendo la estandarización el inventario necesario es ' + dec2(c6) + ' cajas. De esas, ' + dec2(muA) + ' cubren la demanda promedio y ' + dec2(zA * sdA) + ' son inventario de seguridad. El valor ' + dec2(muA + nInv(1 - slA) * sdA) + ' usa el puntaje de la cola equivocada y deja el inventario abajo del promedio, con lo que la farmacia quedaría corta en la mayoría de los ciclos. El valor ' + dec2(muA + slA * sdA) + ' usa la probabilidad como si fuera el puntaje z, y el valor ' + dec2(zA * sdA) + ' se queda solo con el inventario de seguridad y olvida la demanda promedio.',
           en: 'Covering ' + pct1(slA) + ' percent of the cycles matches a z score of ' + dec2(zA) + ', and undoing the standardisation the stock needed is ' + dec2(c6) + ' boxes. Of those, ' + dec2(muA) + ' cover the average demand and ' + dec2(zA * sdA) + ' are safety stock. The value ' + dec2(muA + nInv(1 - slA) * sdA) + ' uses the score of the wrong tail and leaves the stock below the average, which would leave the pharmacy short in most of the cycles. The value ' + dec2(muA + slA * sdA) + ' uses the probability as if it were the z score, and the value ' + dec2(zA * sdA) + ' keeps only the safety stock and forgets the average demand.' }
  };
  var d6 = mk(q6i, o6.correctIdx, true);
  problems.push({ i18n: d6.i18n, title: d6.title, questionText: d6.questionText, options: d6.options, correctIdx: d6.correctIdx, explanation: d6.explanation, hint: d6.hint, showWork: true, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ═══════════════════════ EVALUACIÓN FINAL ═══════════════════════ */
  addSection(function(L) {
    var es = L === 'es';
    if (es) return '' +
      '<div class="stag">Evaluación final</div>' +
      '<h2>Cuatro decisiones con la curva normal</h2>' +
      '<p>Los siguientes cuatro reactivos no vienen precedidos de explicación. En cada uno tendrás que decidir por tu cuenta si la pregunta va de un valor hacia un área o de un área hacia un valor, si se pide una cola, una banda o un conteo, y si la respuesta se reporta en probabilidad, en unidades o en pesos. Lee la situación completa antes de escribir el primer número y usa el área de trabajo para dejar tu procedimiento.</p>';
    return '' +
      '<div class="stag">Final assessment</div>' +
      '<h2>Four decisions with the normal curve</h2>' +
      '<p>The next four items come with no explanation before them. In each one you will have to decide on your own whether the question runs from a value towards an area or from an area towards a value, whether a tail, a band or a count is wanted, and whether the answer is reported as a probability, in units or in pesos. Read the whole situation before writing the first number and use the work area to leave your steps.</p>';
  });

  /* ── Item 7 ── */
  var c7 = pGt(xB, muB, sdB);
  var o7 = probOpts(c7, [
    pLe(xB, muB, sdB),
    1 - nCdf(xB - muB),
    1 - nCdf((xB - muB) / (sdB * sdB)),
    0.5
  ], rng);
  var q7i = {
    title: { es: 'Llamadas que rebasan el estándar de atención', en: 'Calls exceeding the handling standard' },
    q: { es: 'Un centro de contacto mide la duración de las llamadas de soporte, que se ajusta bien a una campana con un promedio de ' + dec2(muB) + ' minutos y una desviación estándar de ' + dec2(sdB) + ' minutos. El manual de servicio establece que una llamada de más de ' + dec2(xB) + ' minutos debe escalarse a un supervisor. ¿Cuál es la probabilidad de que una llamada cualquiera tenga que escalarse?',
        en: 'A contact centre measures the duration of support calls, which fits a bell well with an average of ' + dec2(muB) + ' minutes and a standard deviation of ' + dec2(sdB) + ' minutes. The service manual states that a call longer than ' + dec2(xB) + ' minutes must be escalated to a supervisor. What is the probability that any given call has to be escalated?' },
    opts: { es: o7.es, en: o7.en },
    hint: { es: 'Escalar ocurre solo cuando la duración supera el estándar, así que la respuesta vive en la cola derecha. Obtén primero el área acumulada hasta el estándar.',
            en: 'Escalation happens only when the duration goes past the standard, so the answer lives in the right tail. Work out the cumulative area up to the standard first.' },
    exp: { es: 'El estándar está ' + dec2(xB - muB) + ' minutos arriba del promedio, lo que da un puntaje z de ' + dec2(zOf(xB, muB, sdB)) + '. El área acumulada hasta ahí vale ' + pr(pLe(xB, muB, sdB)) + ', así que la probabilidad de escalar es su complemento, ' + pr(c7) + '. El valor ' + pr(pLe(xB, muB, sdB)) + ' describe las llamadas que se resuelven sin escalar. El valor ' + pr(1 - nCdf(xB - muB)) + ' trata la diferencia en minutos como si ya fuera un puntaje z y olvida dividir entre la desviación estándar. Y ' + pr(0.5) + ' supondría que el estándar del manual coincide exactamente con la duración promedio.',
           en: 'The standard sits ' + dec2(xB - muB) + ' minutes above the average, which gives a z score of ' + dec2(zOf(xB, muB, sdB)) + '. The cumulative area up to that point is worth ' + pr(pLe(xB, muB, sdB)) + ', so the probability of escalating is its complement, ' + pr(c7) + '. The value ' + pr(pLe(xB, muB, sdB)) + ' describes the calls resolved without escalation. The value ' + pr(1 - nCdf(xB - muB)) + ' treats the difference in minutes as if it were already a z score and forgets to divide by the standard deviation. And ' + pr(0.5) + ' would assume the standard in the manual coincides exactly with the average duration.' }
  };
  var d7 = mk(q7i, o7.correctIdx, true);
  problems.push({ i18n: d7.i18n, title: d7.title, questionText: d7.questionText, options: d7.options, correctIdx: d7.correctIdx, explanation: d7.explanation, hint: d7.hint, showWork: true, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 8 ── */
  var inC = pBet(loC, hiC, muC, sdC);
  var c8x = nC * inC;
  var o8 = countOpts(c8x, [
    nC * (1 - inC),
    nC * pLe(hiC, muC, sdC),
    nC * Math.max(0.001, 2 * pLe(hiC, muC, sdC) - 1),
    nC * pGt(loC, muC, sdC)
  ], rng);
  var q8i = {
    title: { es: 'Clientes que califican para la promoción del día', en: 'Customers qualifying for the promotion of the day' },
    q: { es: 'Una tienda de autoservicio observa que el monto de compra por cliente se comporta como una campana, con un promedio de ' + money(muC) + ' y una desviación estándar de ' + money(sdC) + '. El área de mercadotecnia lanza una promoción dirigida a los clientes cuyo monto de compra quede entre ' + money(loC) + ' y ' + money(hiC) + '. Si en un día atienden ' + nC + ' clientes, ¿cuántos se espera que califiquen para la promoción?',
        en: 'A supermarket observes that the purchase amount per customer behaves like a bell, with an average of ' + money(muC) + ' and a standard deviation of ' + money(sdC) + '. The marketing team launches a promotion aimed at customers whose purchase amount falls between ' + money(loC) + ' and ' + money(hiC) + '. If they serve ' + nC + ' customers in one day, how many are expected to qualify for the promotion?' },
    opts: { es: o8.es, en: o8.en },
    hint: { es: 'Primero obtén la proporción de clientes que cae dentro de la banda de la promoción, con un puntaje z para cada límite. Solo al final conviértela en número de clientes del día.',
            en: 'First work out the proportion of customers falling inside the promotion band, with one z score for each limit. Only at the end turn it into a number of customers for the day.' },
    exp: { es: 'El límite inferior da un puntaje z de ' + dec2(zOf(loC, muC, sdC)) + ' y el superior uno de ' + dec2(zOf(hiC, muC, sdC)) + ', de modo que la proporción dentro de la banda es ' + pr(inC) + '. Sobre ' + nC + ' clientes eso da ' + dec2(c8x) + ' clientes que califican. El valor ' + dec2(nC * (1 - inC)) + ' cuenta a los que quedan fuera de la promoción. El valor ' + dec2(nC * pLe(hiC, muC, sdC)) + ' incluye por error a todos los clientes de ticket bajo, que no alcanzan el monto mínimo de la promoción. Conviene notar que la banda no está centrada en el promedio, así que duplicar una sola cola tampoco funciona.',
           en: 'The lower limit gives a z score of ' + dec2(zOf(loC, muC, sdC)) + ' and the upper one a score of ' + dec2(zOf(hiC, muC, sdC)) + ', so the proportion inside the band is ' + pr(inC) + '. Over ' + nC + ' customers that gives ' + dec2(c8x) + ' qualifying customers. The value ' + dec2(nC * (1 - inC)) + ' counts those left outside the promotion. The value ' + dec2(nC * pLe(hiC, muC, sdC)) + ' mistakenly includes every low ticket customer, who do not reach the minimum amount of the promotion. It is worth noting that the band is not centred on the average, so doubling a single tail does not work either.' }
  };
  var d8 = mk(q8i, o8.correctIdx, true);
  problems.push({ i18n: d8.i18n, title: d8.title, questionText: d8.questionText, options: d8.options, correctIdx: d8.correctIdx, explanation: d8.explanation, hint: d8.hint, showWork: true, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 9 ── */
  var zD = nInv(1 - tD);
  var c9 = muD + zD * sdD;
  var o9 = moneyOpts(c9, [
    muD + nInv(tD) * sdD,
    muD + tD * sdD,
    muD * (1 + tD),
    muD + zD
  ], rng);
  var q9i = {
    title: { es: 'Sueldo a partir del cual aplica el bono', en: 'Salary from which the bonus applies' },
    q: { es: 'El área de capital humano de una empresa revisó la nómina del personal operativo y encontró que el sueldo mensual se comporta como una campana, con un promedio de ' + money(muD) + ' y una desviación estándar de ' + money(sdD) + '. La dirección aprobó un bono de productividad para el ' + pct1(tD) + ' por ciento del personal mejor pagado. ¿A partir de qué sueldo mensual empieza a aplicar el bono?',
        en: 'The human capital team of a company reviewed the payroll of operating staff and found that the monthly salary behaves like a bell, with an average of ' + money(muD) + ' and a standard deviation of ' + money(sdD) + '. Management approved a productivity bonus for the ' + pct1(tD) + ' percent of the best paid staff. From what monthly salary does the bonus start to apply?' },
    opts: { es: o9.es, en: o9.en },
    hint: { es: 'El grupo que recibe el bono es una cola, no una banda. Traduce esa cola a un área acumulada antes de buscar el puntaje z, y revisa que el corte quede arriba del promedio.',
            en: 'The group receiving the bonus is a tail, not a band. Translate that tail into a cumulative area before looking for the z score, and check that the cut-off ends up above the average.' },
    exp: { es: 'Si el ' + pct1(tD) + ' por ciento mejor pagado queda por arriba del corte, entonces por debajo del corte queda el ' + pct1(1 - tD) + ' por ciento, y esa área acumulada corresponde a un puntaje z de ' + dec2(zD) + '. Deshaciendo la estandarización, el bono aplica a partir de ' + money(c9) + '. El valor ' + money(muD + nInv(tD) * sdD) + ' usa el área de la cola directamente y coloca el corte abajo del promedio, con lo que el bono lo cobraría el personal peor pagado. El valor ' + money(muD + tD * sdD) + ' usa la proporción como si fuera el puntaje z. El valor ' + money(muD * (1 + tD)) + ' aumenta el promedio en ese porcentaje, cosa que ignora por completo la dispersión de la nómina.',
           en: 'If the best paid ' + pct1(tD) + ' percent sit above the cut-off, then below the cut-off there is ' + pct1(1 - tD) + ' percent, and that cumulative area matches a z score of ' + dec2(zD) + '. Undoing the standardisation, the bonus applies from ' + money(c9) + ' upwards. The value ' + money(muD + nInv(tD) * sdD) + ' uses the tail area directly and places the cut-off below the average, which would hand the bonus to the worst paid staff. The value ' + money(muD + tD * sdD) + ' uses the proportion as if it were the z score. The value ' + money(muD * (1 + tD)) + ' raises the average by that percentage, which ignores the spread of the payroll entirely.' }
  };
  var d9 = mk(q9i, o9.correctIdx, true);
  problems.push({ i18n: d9.i18n, title: d9.title, questionText: d9.questionText, options: d9.options, correctIdx: d9.correctIdx, explanation: d9.explanation, hint: d9.hint, showWork: true, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);

  /* ── Item 10 ── */
  var p1E = pBet(muE - sdE, muE + sdE, muE, sdE);
  var p2E = pBet(muE - 2 * sdE, muE + 2 * sdE, muE, sdE);
  var upE = pGt(muE + 2 * sdE, muE, sdE);
  var o10 = shuffleOpts(
    ['El director se equivoca al citar la regla: dentro de una desviación cae cerca del ' + pct1(p1E) + ' por ciento de las semanas y para llegar al ' + pct1(p2E) + ' por ciento hacen falta dos desviaciones. Una semana de ' + nf(muE + 2 * sdE) + ' piezas queda en el borde de lo habitual y la superan cerca del ' + pct1(upE) + ' por ciento de las semanas, así que por sí sola no es evidencia de un problema.',
     'El director cita bien la regla: dentro de una desviación cae cerca del ' + pct1(p2E) + ' por ciento de las semanas, de modo que una semana de ' + nf(muE + 2 * sdE) + ' piezas queda fuera de lo que el modelo permite y obliga a auditar la línea.',
     'El director se equivoca en la cifra pero acierta en la conclusión: dentro de una desviación cae cerca del ' + pct1(p1E) + ' por ciento de las semanas y cualquier valor que rebase ese rango es una anomalía que debe investigarse de inmediato.',
     'La regla empírica no aplica a este caso porque describe conteos de piezas, que son valores enteros, y para datos enteros la curva normal no permite hacer afirmaciones sobre una semana individual.'],
    ['The director is wrong when quoting the rule: within one deviation there is about ' + pct1(p1E) + ' percent of the weeks and reaching ' + pct1(p2E) + ' percent takes two deviations. A week of ' + nf(muE + 2 * sdE) + ' pieces sits at the edge of the usual range and about ' + pct1(upE) + ' percent of the weeks go above it, so on its own it is not evidence of a problem.',
     'The director quotes the rule correctly: within one deviation there is about ' + pct1(p2E) + ' percent of the weeks, so a week of ' + nf(muE + 2 * sdE) + ' pieces falls outside what the model allows and forces an audit of the line.',
     'The director is wrong on the figure but right on the conclusion: within one deviation there is about ' + pct1(p1E) + ' percent of the weeks and any value going beyond that range is an anomaly to be investigated immediately.',
     'The empirical rule does not apply to this case because it describes counts of pieces, which are whole values, and for whole data the normal curve does not allow statements about an individual week.'], rng);
  var q10i = {
    title: { es: 'Una semana alta en la línea de producción', en: 'A high week on the production line' },
    q: { es: 'La producción semanal de una línea se comporta como una campana, con un promedio de ' + nf(muE) + ' piezas y una desviación estándar de ' + nf(sdE) + ' piezas. La semana pasada la línea produjo ' + nf(muE + 2 * sdE) + ' piezas. En la junta de operaciones el director afirma que, como la regla empírica dice que el noventa y cinco por ciento de las semanas cae dentro de una desviación estándar del promedio, ese resultado está fuera de rango y hay que auditar la línea. ¿Qué observación describe correctamente la situación?',
        en: 'The weekly output of a line behaves like a bell, with an average of ' + nf(muE) + ' pieces and a standard deviation of ' + nf(sdE) + ' pieces. Last week the line produced ' + nf(muE + 2 * sdE) + ' pieces. In the operations meeting the director claims that, since the empirical rule says ninety five percent of the weeks fall within one standard deviation of the average, that result is out of range and the line has to be audited. Which observation correctly describes the situation?' },
    opts: { es: o10.es, en: o10.en },
    hint: { es: 'Revisa a qué porcentaje corresponde cada número de desviaciones en la regla empírica y calcula a cuántas desviaciones está la semana que se discute.',
            en: 'Check which percentage matches each number of deviations in the empirical rule and work out how many deviations away the week under discussion sits.' },
    exp: { es: 'La regla empírica asigna cerca del ' + pct1(p1E) + ' por ciento a una desviación y cerca del ' + pct1(p2E) + ' por ciento a dos, de modo que el director intercambió las dos cifras. La semana en discusión está exactamente a dos desviaciones del promedio, y por arriba de ese punto queda cerca del ' + pct1(upE) + ' por ciento de las semanas, es decir alrededor de una de cada cuarenta. Un resultado así aparece en una línea sana un par de veces al año y no basta para ordenar una auditoría; lo que sí ameritaría investigarse es una racha sostenida de semanas altas o un valor a más de tres desviaciones.',
           en: 'The empirical rule assigns about ' + pct1(p1E) + ' percent to one deviation and about ' + pct1(p2E) + ' percent to two, so the director swapped the two figures. The week under discussion sits exactly two deviations from the average, and above that point there is about ' + pct1(upE) + ' percent of the weeks, that is around one in forty. A result like that shows up in a healthy line a couple of times a year and is not enough to order an audit; what would deserve investigation is a sustained run of high weeks or a value more than three deviations out.' }
  };
  var d10 = mk(q10i, o10.correctIdx, false);
  problems.push({ i18n: d10.i18n, title: d10.title, questionText: d10.questionText, options: d10.options, correctIdx: d10.correctIdx, explanation: d10.explanation, hint: d10.hint, showWork: false, fn: '', studentChoice: null, pendingChoice: null });
  buildOneCard(problems[problems.length - 1], problems.length - 1);
}

/* ════════════════════════════════════════════════════════════════════════
   LANGUAGE SWITCHING
   ════════════════════════════════════════════════════════════════════════ */
function applyUIStrings() {
  var set = function(id, txt) { var e = document.getElementById(id); if (e) e.textContent = txt; };
  var ph  = function(id, txt) { var e = document.getElementById(id); if (e) e.placeholder = txt; };
  set('wtitle-el',    SCHOOL.guideTitle[LANG]);
  set('wcourse-el',   SCHOOL.courseName[LANG]);
  set('htitle-el',    SCHOOL.guideTitle[LANG]);
  set('lbl-name-el',  t('lbl-name'));
  set('lbl-group-el', t('lbl-group'));
  set('startBtn',     t('btn-start'));
  set('restoreTitle', t('restore-title'));
  set('restoreMsg',   t('restore-msg'));
  set('restoreBtn',   t('btn-restore'));
  set('dismissBtn',   t('btn-dismiss'));
  set('dlBtn',        t('btn-pdf'));
  ph('sName',  t('ph-name'));
  ph('sGroup', t('ph-group'));
  var ll = document.getElementById('logo-left');   if (ll) ll.alt = SCHOOL.logoLeftAlt;
  var lr = document.getElementById('logo-right');  if (lr) lr.alt = SCHOOL.logoRightAlt;
}
/* Rebuilds the visible text of every card without touching the numbers. */
function applyProblemLang() {
  problems.forEach(function(p, i) {
    var card = document.getElementById('pc' + i);
    if (!card || !p.i18n) return;
    p.title        = p.i18n.title[LANG];
    p.questionText = p.i18n.q[LANG];
    p.hint         = p.i18n.hint[LANG];
    p.explanation  = p.i18n.exp[LANG];
    p.options      = p.i18n.opts[LANG].slice();
    var ti = card.querySelector('.ptitle'); if (ti) ti.textContent = p.title;
    var st = card.querySelector('.pstmt');
    if (st) st.innerHTML = p.questionText + '<span class="pfn">' + (p.fn || '') + '</span>';
    var hb = card.querySelector('.hintbox'); if (hb) hb.innerHTML = p.hint;
    var hbtn = card.querySelector('.hintbtn'); if (hbtn) hbtn.textContent = t('btn-hint');
    card.querySelectorAll('.mcopt').forEach(function(o, oi) {
      if (p.options[oi] !== undefined) o.innerHTML = p.options[oi];
    });
    var tabs = card.querySelectorAll('.wtab');
    if (tabs.length === 3) {
      tabs[0].textContent = t('tab-draw');
      tabs[1].textContent = t('tab-type');
      tabs[2].textContent = t('tab-photo');
    }
    var tools = card.querySelectorAll('.tbtn2');
    if (tools.length === 3) {
      tools[0].textContent = t('tool-pen');
      tools[1].textContent = t('tool-mark');
      tools[2].textContent = t('tool-erase');
    }
    var clr = card.querySelector('.clrbtn'); if (clr) clr.textContent = t('tool-clear');
    var ta  = card.querySelector('.wtextarea'); if (ta) ta.placeholder = t('ph-work');
    var pzt = card.querySelector('.pztxt'); if (pzt) pzt.textContent = t('ph-photo');
    var lab = card.querySelector('.pbody > div:last-child > div:first-child');
    if (lab) lab.textContent = t('lbl-answer');
    var fb = card.querySelector('.mcfb');
    if (fb && fb.classList.contains('show')) {
      var isOk = (p.studentChoice === p.correctIdx);
      fb.innerHTML = '<strong>' + (isOk ? t('fb-correct') : t('fb-wrong')) + '</strong> ' + p.explanation;
    }
  });
}
function setLang(l) {
  LANG = l;
  try { localStorage.setItem(LANG_KEY, l); } catch(e) {}
  document.documentElement.setAttribute('lang', l);
  var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
  if (be) be.classList.toggle('active', l === 'es');
  if (bn) bn.classList.toggle('active', l === 'en');
  applyUIStrings();
  applySectionLang();
  applyProblemLang();
  widgets.forEach(function(f) { try { f(); } catch(e) {} });
  document.querySelectorAll('#lessonBody .section').forEach(function(s) { s.classList.add('vis'); });
}
(function() {
  try { var stored = localStorage.getItem(LANG_KEY); if (stored === 'es' || stored === 'en') LANG = stored; } catch(e) {}
  document.addEventListener('DOMContentLoaded', function() {
    document.documentElement.setAttribute('lang', LANG);
    var be = document.getElementById('btn-es'), bn = document.getElementById('btn-en');
    if (be) be.classList.toggle('active', LANG === 'es');
    if (bn) bn.classList.toggle('active', LANG === 'en');
    applyUIStrings();
  });
})();

/* LOGO INJECTION */
document.addEventListener('DOMContentLoaded', function() {
  var wl = document.getElementById('logo-left');
  if (wl && SCHOOL.logoLeftB64) { wl.src = SCHOOL.logoLeftB64; wl.style.display = 'inline-block'; }
  var hl = document.getElementById('hlogo-left');
  if (hl && SCHOOL.logoLeftB64) { hl.src = SCHOOL.logoLeftB64; hl.style.display = 'inline-block'; }
});
/* ════════════════════════════════════════════════════════════════════════
   PDF
   ════════════════════════════════════════════════════════════════════════ */
async function generatePDF() {
  var btn = document.getElementById('dlBtn');
  btn.textContent = t('pdf-busy');
  btn.disabled = true;

  var jspdf   = window.jspdf;
  var doc     = new jspdf.jsPDF({ orientation:'portrait', unit:'mm', format:'letter' });
  var PW      = 215.9;
  var M       = 18;
  var TW      = PW - M * 2;
  var PH      = doc.internal.pageSize.height;
  var name    = studentData.name;
  var group   = studentData.group;
  var total   = problems.length;
  var pct     = Math.round(correctCount / total * 100);
  var dateStr = new Date().toLocaleString(LANG === 'es' ? 'es-MX' : 'en-US', { dateStyle:'long', timeStyle:'short' });

  var raw = name + '|' + group + '|' + correctCount + '|' + total + '|' + new Date().toDateString();
  var h = 0;
  for (var ci = 0; ci < raw.length; ci++) h = (Math.imul(31, h) + raw.charCodeAt(ci)) | 0;
  var code = Math.abs(h).toString(36).toUpperCase().slice(0, 8);

  var pBR = SCHOOL.pBR, pBG = SCHOOL.pBG, pBB = SCHOOL.pBB;
  var pAR = SCHOOL.pAR, pAG = SCHOOL.pAG, pAB = SCHOOL.pAB;

  function pdfText(html) {
    if (!html) return '';
    return html
      .replace(/<[^>]+>/g,'').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&')
      .replace(/&nbsp;/g,' ').replace(/&#[0-9]+;/g,'')
      .replace(/→/g,'->').replace(/−/g,'-').replace(/²/g,'^2')
      .replace(/³/g,'^3').replace(/×/g,'x').replace(/÷/g,'/')
      .replace(/≠/g,'!=').replace(/≤/g,'<=').replace(/≥/g,'>=')
      .replace(/√/g,'sqrt').replace(/π/g,'pi').replace(/…/g,'...')
      .replace(/\s+/g,' ').trim();
  }

  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,2,'F');
  doc.setFillColor(255,255,255); doc.rect(0,2,PW,26,'F');
  doc.setFillColor(pAR,pAG,pAB); doc.rect(0,28,PW,2,'F');
  doc.setFillColor(pBR,pBG,pBB); doc.rect(0,30,PW,34,'F');

  var fmtL = SCHOOL.logoLeftB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  var fmtR = SCHOOL.logoRightB64.indexOf('/9j/') > -1 ? 'JPEG' : 'PNG';
  try { doc.addImage(SCHOOL.logoLeftB64,  fmtL, M,  4.0, 22, 22); } catch(e) {}
  try { doc.addImage(SCHOOL.logoRightB64, fmtR, 48, 4.5, 48, 21); } catch(e) {}

  var lx = PW - M - 36;
  var ly = 10;
  doc.setDrawColor(pBR,pBG,pBB); doc.setLineWidth(0.7);
  doc.lines([[2.57-1.03,4.63-6.17],[4.11-2.57,5.14-4.63],[5.66-4.11,2.57-5.14]], lx+1.03, ly+6.17);
  doc.setFillColor(pAR,pAG,pAB); doc.circle(lx+5.66, ly+2.57, 0.9, 'F');
  doc.setDrawColor(pAR,pAG,pAB); doc.setLineWidth(0.7);
  doc.line(lx+8.23, ly+1.54, lx+8.23, ly+7.2);
  doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text('LIAXA', lx+10, ly+6.8);

  doc.setTextColor(240,244,238); doc.setFontSize(15); doc.setFont('helvetica','bold');
  doc.text(SCHOOL.guideTitle[LANG], M, 49);
  doc.setTextColor(198,214,192); doc.setFontSize(8); doc.setFont('helvetica','normal');
  doc.text(dateStr, M, 59);

  doc.setFillColor(237,240,245); doc.roundedRect(M,72,TW,20,3,3,'F');
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
  doc.text(t('pdf-student'), M+4, 79); doc.text(t('pdf-group'), 130, 79);
  doc.setTextColor(20,24,32); doc.setFontSize(11); doc.setFont('helvetica','bold');
  doc.text(name, M+4, 87); doc.text(group, 130, 87);

  var sc = pct>=70?[26,106,74]:pct>=50?[224,123,26]:[176,48,16];
  doc.setFillColor(255,255,255); doc.roundedRect(M,100,TW,34,4,4,'F');
  doc.setDrawColor(sc[0],sc[1],sc[2]); doc.setLineWidth(0.8);
  doc.roundedRect(M,100,TW,34,4,4,'S');
  doc.setTextColor(sc[0],sc[1],sc[2]); doc.setFontSize(40); doc.setFont('helvetica','bold');
  doc.text(pct+'%', PW/2, 124, {align:'center'});
  doc.setTextColor(130,140,160); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
  doc.text(correctCount+' '+t('pdf-score')+' '+total+' '+t('pdf-questions'), PW/2, 131, {align:'center'});

  doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
  doc.setFontSize(7); doc.setFont('helvetica','bold');
  doc.rect(M,142,TW,8,'F'); doc.text(t('pdf-summary'), M+4, 148);
  var sy = 154;
  problems.forEach(function(prob, i) {
    if (sy + 12 > PH - 15) {
      doc.addPage(); sy = 20;
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,sy,TW,8,'F'); doc.text(t('pdf-summary2'), M+4, sy+6);
      sy += 12;
    }
    var ok = document.getElementById('pc'+i).classList.contains('ok');
    doc.setFillColor(ok?232:255, ok?240:232, ok?232:228);
    doc.roundedRect(M,sy,TW,10,2,2,'F');
    doc.setFillColor(ok?26:176, ok?106:48, ok?74:16);
    doc.circle(M+6, sy+5, 2.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(7); doc.setFont('helvetica','bold');
    doc.text(ok?'v':'x', M+4.5, sy+6.5);
    doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('helvetica','normal');
    doc.text(t('pdf-item')+' '+(i+1)+': '+pdfText(prob.title), M+12, sy+6.5);
    doc.setTextColor(ok?26:176, ok?106:48, ok?74:16);
    doc.text(ok?t('pdf-ok'):t('pdf-bad'), PW-M-24, sy+6.5);
    sy += 12;
  });

  for (var i = 0; i < problems.length; i++) {
    var prob = problems[i];
    doc.addPage();
    var wy = 0;

    doc.setFillColor(pBR,pBG,pBB); doc.rect(0,0,PW,20,'F');
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0,0,PW,3,'F');
    doc.setTextColor(pAR,pAG,pAB); doc.setFontSize(7); doc.setFont('helvetica','normal');
    doc.text(SCHOOL.courseName[LANG]+'  ·  '+SCHOOL.guideTitle[LANG], M, 10);
    doc.setTextColor(240,244,238); doc.setFontSize(10.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-item')+' '+(i+1)+' '+t('pdf-of')+' '+total+'  ·  '+pdfText(prob.title), M, 17);
    wy = 25;

    var qRaw = pdfText(prob.questionText);
    doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qLines = doc.splitTextToSize(qRaw, TW-10);
    var qBoxH  = 8 + qLines.length*5 + 3;
    doc.setFillColor(237,240,245); doc.roundedRect(M,wy,TW,qBoxH,2,2,'F');
    doc.setTextColor(pBR,pBG,pBB); doc.setFontSize(6.5); doc.setFont('helvetica','bold');
    doc.text(t('pdf-question'), M+4, wy+6);
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','normal');
    var qy = wy+12;
    qLines.forEach(function(ln,li){ doc.text(ln, M+4, qy+li*5); });
    wy += qBoxH + 4;

    var isOk   = document.getElementById('pc'+i).classList.contains('ok');
    var chosen = prob.studentChoice != null ? pdfText(prob.options[prob.studentChoice]||'') : '';
    var corr   = pdfText(prob.options[prob.correctIdx]||'');
    var expRaw = pdfText(prob.explanation||'');
    doc.setFontSize(8.5); var chLines = doc.splitTextToSize(t('pdf-yours')+chosen, TW-18);
    doc.setFontSize(8);   var coLines = doc.splitTextToSize(t('pdf-key')+corr, TW-18);
    doc.setFontSize(7.5); var exLines = doc.splitTextToSize(t('pdf-sol')+expRaw, TW-18).slice(0,4);
    var ansBoxH = 8 + chLines.length*5.5 + coLines.length*5 + exLines.length*5 + 6;
    doc.setFillColor(isOk?232:255, isOk?240:232, isOk?232:228);
    doc.roundedRect(M,wy,TW,ansBoxH,2,2,'F');
    doc.setFillColor(isOk?26:176, isOk?106:48, isOk?74:16);
    doc.circle(M+7, wy+8, 3.5, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(9); doc.setFont('helvetica','bold');
    doc.text(isOk?'v':'x', M+5.2, wy+10.5);
    var ay = wy+7;
    doc.setTextColor(20,24,32); doc.setFontSize(8.5); doc.setFont('helvetica','bold');
    chLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5.5); });
    ay += chLines.length*5.5 + 3;
    doc.setTextColor(26,106,74); doc.setFontSize(8); doc.setFont('helvetica','normal');
    coLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    ay += coLines.length*5 + 3;
    doc.setTextColor(90,85,80); doc.setFontSize(7.5);
    exLines.forEach(function(ln,li){ doc.text(ln, M+14, ay+li*5); });
    wy += ansBoxH + 5;

    var dc = document.getElementById('dc'+i);
    if (dc) {
      doc.setFillColor(pBR,pBG,pBB); doc.setTextColor(255,255,255);
      doc.setFontSize(7); doc.setFont('helvetica','bold');
      doc.rect(M,wy,TW,8,'F'); doc.text(t('pdf-work'), M+4, wy+5.5);
      wy += 11;
      try {
        var imgD = dc.toDataURL('image/png');
        var ar   = dc.height / dc.width;
        var iw   = TW;
        var ih   = Math.min(iw * ar, 68);
        doc.addImage(imgD, 'PNG', M, wy, iw, ih);
        wy += ih + 4;
      } catch(e) {}
    }

    var ta = document.getElementById('ta'+i);
    if (ta && ta.value.trim()) {
      if (wy > PH-30) { doc.addPage(); wy = 20; }
      doc.setTextColor(20,24,32); doc.setFontSize(8); doc.setFont('courier','normal');
      var taLines = doc.splitTextToSize(ta.value, TW);
      taLines.slice(0,16).forEach(function(ln) {
        if (wy > PH-15) { doc.addPage(); wy = 20; }
        doc.text(ln, M, wy); wy += 5;
      });
      wy += 2;
    }

    var pp = document.getElementById('pp'+i);
    if (pp && pp.src && pp.src.indexOf('data:') === 0) {
      if (wy > PH-55) { doc.addPage(); wy = 20; }
      try { doc.addImage(pp.src, 'JPEG', M, wy, TW, 68); wy += 72; } catch(e) {}
    }
  }

  var pages = doc.internal.getNumberOfPages();
  for (var p = 1; p <= pages; p++) {
    doc.setPage(p);
    doc.setFillColor(pAR,pAG,pAB); doc.rect(0, PH-3, PW, 3, 'F');
    doc.setTextColor(130,140,160); doc.setFontSize(6.5); doc.setFont('helvetica','normal');
    doc.text(name+'  ·  '+group+'  ·  '+t('pdf-code')+code+'  ·  '+t('pdf-page')+p+'/'+pages,
      PW/2, PH-5, {align:'center'});
  }

  var _fn = SCHOOL.filePrefix + '_' + name.replace(/\s+/g,'_') + '_' + group.replace(/\s+/g,'_') + '.pdf';
  var _pdfBlob = doc.output('blob');
  var _blobUrl = URL.createObjectURL(_pdfBlob);
  var _a = document.createElement('a');
  _a.href = _blobUrl;
  _a.download = _fn;
  document.body.appendChild(_a);
  _a.click();
  setTimeout(function(){ document.body.removeChild(_a); URL.revokeObjectURL(_blobUrl); }, 200);
  btn.textContent = t('btn-pdf');
  btn.disabled  = false;
}
</script>
</body>
</html>
